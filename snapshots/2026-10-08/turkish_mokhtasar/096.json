{"result":[{"id":"6107","sura":"96","aya":"1","arabic_text":"\u0671\u0642\u06e1\u0631\u064e\u0623\u06e1 \u0628\u0650\u0671\u0633\u06e1\u0645\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a \u062e\u064e\u0644\u064e\u0642\u064e","translation":"-Ey Peygamber!- B\u00fct\u00fcn varl\u0131klar\u0131 yaratan Rabbinin ad\u0131yla ba\u015flayarak Allah\u2019\u0131n sana vahyettiklerini oku!","footnotes":null},{"id":"6108","sura":"96","aya":"2","arabic_text":"\u062e\u064e\u0644\u064e\u0642\u064e \u0671\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u064e \u0645\u0650\u0646\u06e1 \u0639\u064e\u0644\u064e\u0642\u064d","translation":"O insan\u0131, bir damla meni olduktan sonra donmu\u015f kandan yaratt\u0131.","footnotes":null},{"id":"6109","sura":"96","aya":"3","arabic_text":"\u0671\u0642\u06e1\u0631\u064e\u0623\u06e1 \u0648\u064e\u0631\u064e\u0628\u0651\u064f\u0643\u064e \u0671\u0644\u06e1\u0623\u064e\u0643\u06e1\u0631\u064e\u0645\u064f","translation":"-Ey Peygamber!- Allah\u2019\u0131n sana vahyettiklerini oku! Senin Rabbin hi\u00e7bir kerem sahibinin O'nun c\u00f6mertli\u011fine yakla\u015famayaca\u011f\u0131 en b\u00fcy\u00fck kerem sahibi oland\u0131r. O, \u00e7ok b\u00fcy\u00fck c\u00f6mertlik ve ihsan sahibidir.","footnotes":null},{"id":"6110","sura":"96","aya":"4","arabic_text":"\u0671\u0644\u0651\u064e\u0630\u0650\u064a \u0639\u064e\u0644\u0651\u064e\u0645\u064e \u0628\u0650\u0671\u0644\u06e1\u0642\u064e\u0644\u064e\u0645\u0650","translation":"Kalemle harfleri ve yaz\u0131 yazmay\u0131 \u00f6\u011fretendir.","footnotes":null},{"id":"6111","sura":"96","aya":"5","arabic_text":"\u0639\u064e\u0644\u0651\u064e\u0645\u064e \u0671\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u064e \u0645\u064e\u0627 \u0644\u064e\u0645\u06e1 \u064a\u064e\u0639\u06e1\u0644\u064e\u0645\u06e1","translation":"\u0130nsana bilmediklerini \u00f6\u011fretti.","footnotes":null},{"id":"6112","sura":"96","aya":"6","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627\u0653 \u0625\u0650\u0646\u0651\u064e \u0671\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u064e \u0644\u064e\u064a\u064e\u0637\u06e1\u063a\u064e\u0649\u0670\u0653","translation":"Ger\u00e7ekten Ebu Cehil gibi facir insanlar, Allah\u2019\u0131n s\u0131n\u0131rlar\u0131n\u0131 ihlal ederek \u00e7i\u011fner.","footnotes":null},{"id":"6113","sura":"96","aya":"7","arabic_text":"\u0623\u064e\u0646 \u0631\u0651\u064e\u0621\u064e\u0627\u0647\u064f \u0671\u0633\u06e1\u062a\u064e\u063a\u06e1\u0646\u064e\u0649\u0670\u0653","translation":"\u0130nsan sahip oldu\u011fu makam ve maldan \u00f6t\u00fcr\u00fc kendisini yeterli g\u00f6rd\u00fc\u011f\u00fc i\u00e7in azg\u0131nl\u0131k eder.","footnotes":null},{"id":"6114","sura":"96","aya":"8","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0625\u0650\u0644\u064e\u0649\u0670 \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0671\u0644\u0631\u0651\u064f\u062c\u06e1\u0639\u064e\u0649\u0670\u0653","translation":"-Ey Peygamber!- Muhakkak k\u0131yamet g\u00fcn\u00fc d\u00f6n\u00fc\u015f Rabbine olacak ve O da herkese hak etti\u011fi kar\u015f\u0131l\u0131\u011f\u0131 verecektir.","footnotes":null},{"id":"6115","sura":"96","aya":"9","arabic_text":"\u0623\u064e\u0631\u064e\u0621\u064e\u064a\u06e1\u062a\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a \u064a\u064e\u0646\u06e1\u0647\u064e\u0649\u0670","translation":"Engel olmaya \u00e7al\u0131\u015fan Ebu Cehil\u2019in yapt\u0131\u011f\u0131ndan daha \u00e7ok \u015fa\u015f\u0131lacak bir \u015fey g\u00f6rd\u00fcn m\u00fc?","footnotes":null},{"id":"6116","sura":"96","aya":"10","arabic_text":"\u0639\u064e\u0628\u06e1\u062f\u064b\u0627 \u0625\u0650\u0630\u064e\u0627 \u0635\u064e\u0644\u0651\u064e\u0649\u0670\u0653","translation":"Kulumuz Muhammed -sallallahu aleyhi ve sellem- K\u00e2be\u2019de namaz k\u0131ld\u0131\u011f\u0131 zaman.","footnotes":null},{"id":"6117","sura":"96","aya":"11","arabic_text":"\u0623\u064e\u0631\u064e\u0621\u064e\u064a\u06e1\u062a\u064e \u0625\u0650\u0646 \u0643\u064e\u0627\u0646\u064e \u0639\u064e\u0644\u064e\u0649 \u0671\u0644\u06e1\u0647\u064f\u062f\u064e\u0649\u0670\u0653","translation":"Bu engellenen kimse, Rabbinden hidayet ve basiret \u00fczerineyse ne dersin?","footnotes":null},{"id":"6118","sura":"96","aya":"12","arabic_text":"\u0623\u064e\u0648\u06e1 \u0623\u064e\u0645\u064e\u0631\u064e \u0628\u0650\u0671\u0644\u062a\u0651\u064e\u0642\u06e1\u0648\u064e\u0649\u0670\u0653","translation":"Veya insanlara emirlerini yerine getirip, yasaklar\u0131ndan sak\u0131narak Allah\u2019tan korkmalar\u0131n\u0131 emreden bir kimse engellenir mi?","footnotes":null},{"id":"6119","sura":"96","aya":"13","arabic_text":"\u0623\u064e\u0631\u064e\u0621\u064e\u064a\u06e1\u062a\u064e \u0625\u0650\u0646 \u0643\u064e\u0630\u0651\u064e\u0628\u064e \u0648\u064e\u062a\u064e\u0648\u064e\u0644\u0651\u064e\u0649\u0670\u0653","translation":"Ona engel olan ki\u015finin de, Peygamber'in getirdi\u011fini yalanlay\u0131p, ondan y\u00fcz \u00e7evirmesine ne dersin? Allah\u2019tan hi\u00e7 korkmuyor mu?","footnotes":null},{"id":"6120","sura":"96","aya":"14","arabic_text":"\u0623\u064e\u0644\u064e\u0645\u06e1 \u064a\u064e\u0639\u06e1\u0644\u064e\u0645 \u0628\u0650\u0623\u064e\u0646\u0651\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064e \u064a\u064e\u0631\u064e\u0649\u0670","translation":"Bu kulu namazdan al\u0131koyan kimse, Allah\u2019\u0131n onun ne yapt\u0131\u011f\u0131n\u0131 g\u00f6rd\u00fc\u011f\u00fcn\u00fc, bunlardan hi\u00e7 birinin O'na gizli kalmad\u0131\u011f\u0131n\u0131 bilmiyor mu?","footnotes":null},{"id":"6121","sura":"96","aya":"15","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627 \u0644\u064e\u0626\u0650\u0646 \u0644\u0651\u064e\u0645\u06e1 \u064a\u064e\u0646\u062a\u064e\u0647\u0650 \u0644\u064e\u0646\u064e\u0633\u06e1\u0641\u064e\u0639\u064e\u06e2\u0627 \u0628\u0650\u0671\u0644\u0646\u0651\u064e\u0627\u0635\u0650\u064a\u064e\u0629\u0650","translation":"Durum hi\u00e7 de bu cahilin tasavvur etti\u011fi gibi de\u011fildir. E\u011fer kulumuza eziyet etmeyi ve onu yalanlamay\u0131 b\u0131rakmazsa, onu ba\u015f\u0131n\u0131n \u00f6n\u00fcnden\/per\u00e7eminden yakalay\u0131p zorla cehennemin i\u00e7ine \u00e7ekece\u011fiz.","footnotes":null},{"id":"6122","sura":"96","aya":"16","arabic_text":"\u0646\u064e\u0627\u0635\u0650\u064a\u064e\u0629\u0656 \u0643\u064e\u0670\u0630\u0650\u0628\u064e\u0629\u064d \u062e\u064e\u0627\u0637\u0650\u0626\u064e\u0629\u0656","translation":"Bu per\u00e7emin sahibi s\u00f6z\u00fcnde yalanc\u0131, yapt\u0131klar\u0131nda ise g\u00fcnahk\u00e2rd\u0131r.","footnotes":null},{"id":"6123","sura":"96","aya":"17","arabic_text":"\u0641\u064e\u0644\u06e1\u064a\u064e\u062f\u06e1\u0639\u064f \u0646\u064e\u0627\u062f\u0650\u064a\u064e\u0647\u064f\u06e5","translation":"Ba\u015f\u0131n\u0131n \u00f6n\u00fcnden cehenneme do\u011fru yakalad\u0131\u011f\u0131m\u0131zda, aile halk\u0131n\u0131 ve a\u015firetini onu azaptan kurtarmalar\u0131 i\u00e7in onlardan yard\u0131m isteyerek \u00e7a\u011f\u0131rs\u0131n bakal\u0131m.","footnotes":null},{"id":"6124","sura":"96","aya":"18","arabic_text":"\u0633\u064e\u0646\u064e\u062f\u06e1\u0639\u064f \u0671\u0644\u0632\u0651\u064e\u0628\u064e\u0627\u0646\u0650\u064a\u064e\u0629\u064e","translation":"Biz de Allah Te\u00e2l\u00e2'n\u0131n kendilerine yapmalar\u0131n\u0131 emrettiklerinde O'na kar\u015f\u0131 gelmeyen ve emredileni yerine getiren cehennemin sert yap\u0131l\u0131 meleklerinden olan muhaf\u0131zlar\u0131n\u0131 \u00e7a\u011f\u0131raca\u011f\u0131z. Bir baks\u0131n bakal\u0131m hangi taraf daha g\u00fc\u00e7l\u00fc ve daha kudretlidir.","footnotes":null},{"id":"6125","sura":"96","aya":"19","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627 \u0644\u064e\u0627 \u062a\u064f\u0637\u0650\u0639\u06e1\u0647\u064f \u0648\u064e\u0671\u0633\u06e1\u062c\u064f\u062f\u06e1\u06e4 \u0648\u064e\u0671\u0642\u06e1\u062a\u064e\u0631\u0650\u0628\u06e9","translation":"\u0130\u015f, bu zalimin k\u00f6t\u00fcl\u00fck yaparak sana zarar vermeyi hayal etti\u011fi gibi de\u011fildir. Sak\u0131n ola onun emir ve yasaklar\u0131na itaat etme! Allah Te\u00e2l\u00e2\u2019ya secde et ve O'na ibadet ederek yakla\u015f. \u015e\u00fcphesiz bunlar, O'na yak\u0131nla\u015fma sebebidir.","footnotes":null}]}