{"result":[{"id":"5713","sura":"79","aya":"1","arabic_text":"\u0648\u064e\u0671\u0644\u0646\u0651\u064e\u0670\u0632\u0650\u0639\u064e\u0670\u062a\u0650 \u063a\u064e\u0631\u06e1\u0642\u0657\u0627","translation":"Allah, k\u00e2firlerin ruhlar\u0131n\u0131 g\u00fc\u00e7 ve \u015fiddetle \u00e7ekip alan melekler ad\u0131na yemin etmi\u015ftir.","footnotes":null},{"id":"5714","sura":"79","aya":"2","arabic_text":"\u0648\u064e\u0671\u0644\u0646\u0651\u064e\u0670\u0634\u0650\u0637\u064e\u0670\u062a\u0650 \u0646\u064e\u0634\u06e1\u0637\u0657\u0627","translation":"Ve M\u00fcminlerin ruhlar\u0131n\u0131 kolayl\u0131kla ve hafif\u00e7e \u00e7ekip alan melekler ad\u0131na yemin etmi\u015ftir.","footnotes":null},{"id":"5715","sura":"79","aya":"3","arabic_text":"\u0648\u064e\u0671\u0644\u0633\u0651\u064e\u0670\u0628\u0650\u062d\u064e\u0670\u062a\u0650 \u0633\u064e\u0628\u06e1\u062d\u0657\u0627","translation":"Ve Allah\u2019\u0131n emriyle g\u00f6ky\u00fcz\u00fcnden yery\u00fcz\u00fcne gelen melekler ad\u0131na yemin etmi\u015ftir.","footnotes":null},{"id":"5716","sura":"79","aya":"4","arabic_text":"\u0641\u064e\u0671\u0644\u0633\u0651\u064e\u0670\u0628\u0650\u0642\u064e\u0670\u062a\u0650 \u0633\u064e\u0628\u06e1\u0642\u0657\u0627","translation":"Ve Allah Te\u00e2l\u00e2\u2019n\u0131n emrini yerine getirmek i\u00e7in birbiriyle yar\u0131\u015fan melekler ad\u0131na yemin etmi\u015ftir.","footnotes":null},{"id":"5717","sura":"79","aya":"5","arabic_text":"\u0641\u064e\u0671\u0644\u06e1\u0645\u064f\u062f\u064e\u0628\u0651\u0650\u0631\u064e\u0670\u062a\u0650 \u0623\u064e\u0645\u06e1\u0631\u0657\u0627","translation":"Ve Y\u00fcce Allah kullar\u0131n amellerinden sorumlu olan melekler gibi, kendisinin takdir etti\u011fi emirleri yerine getiren b\u00fct\u00fcn melekler ad\u0131na yemin etmi\u015ftir. Hesaba \u00e7ekmek ve kar\u015f\u0131l\u0131klar\u0131n\u0131 vermek i\u00e7in onlar\u0131 yeniden diriltece\u011fine yemin etmi\u015ftir.","footnotes":null},{"id":"5718","sura":"79","aya":"6","arabic_text":"\u064a\u064e\u0648\u06e1\u0645\u064e \u062a\u064e\u0631\u06e1\u062c\u064f\u0641\u064f \u0671\u0644\u0631\u0651\u064e\u0627\u062c\u0650\u0641\u064e\u0629\u064f","translation":"O g\u00fcn birinci \u00fcflemeyle yery\u00fcz\u00fc sars\u0131l\u0131r.","footnotes":null},{"id":"5719","sura":"79","aya":"7","arabic_text":"\u062a\u064e\u062a\u06e1\u0628\u064e\u0639\u064f\u0647\u064e\u0627 \u0671\u0644\u0631\u0651\u064e\u0627\u062f\u0650\u0641\u064e\u0629\u064f","translation":"Bu \u00fcflemenin ard\u0131ndan ikinci \u00fcfleme gelir.","footnotes":null},{"id":"5720","sura":"79","aya":"8","arabic_text":"\u0642\u064f\u0644\u064f\u0648\u0628\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0648\u064e\u0627\u062c\u0650\u0641\u064e\u0629\u064c","translation":"O g\u00fcn k\u00e2fir ve g\u00fcnahk\u00e2rlar\u0131n kalpleri korku i\u00e7indedir.","footnotes":null},{"id":"5721","sura":"79","aya":"9","arabic_text":"\u0623\u064e\u0628\u06e1\u0635\u064e\u0670\u0631\u064f\u0647\u064e\u0627 \u062e\u064e\u0670\u0634\u0650\u0639\u064e\u0629\u065e","translation":"Onlar\u0131n g\u00f6zlerinde zilletin izi g\u00f6r\u00fcl\u00fcr.","footnotes":null},{"id":"5722","sura":"79","aya":"10","arabic_text":"\u064a\u064e\u0642\u064f\u0648\u0644\u064f\u0648\u0646\u064e \u0623\u064e\u0621\u0650\u0646\u0651\u064e\u0627 \u0644\u064e\u0645\u064e\u0631\u06e1\u062f\u064f\u0648\u062f\u064f\u0648\u0646\u064e \u0641\u0650\u064a \u0671\u0644\u06e1\u062d\u064e\u0627\u0641\u0650\u0631\u064e\u0629\u0650","translation":"\u015e\u00f6yle diyorlard\u0131: \u201c\u00d6ld\u00fckten sonra tekrar hayata m\u0131 d\u00f6nece\u011fiz?\"","footnotes":null},{"id":"5723","sura":"79","aya":"11","arabic_text":"\u0623\u064e\u0621\u0650\u0630\u064e\u0627 \u0643\u064f\u0646\u0651\u064e\u0627 \u0639\u0650\u0638\u064e\u0670\u0645\u0657\u0627 \u0646\u0651\u064e\u062e\u0650\u0631\u064e\u0629\u0657","translation":"\u201c\u00c7\u00fcr\u00fcm\u00fc\u015f bo\u015f kemik y\u0131\u011f\u0131n\u0131 olmam\u0131z\u0131n ard\u0131ndan geri mi d\u00f6nece\u011fiz?\"","footnotes":null},{"id":"5724","sura":"79","aya":"12","arabic_text":"\u0642\u064e\u0627\u0644\u064f\u0648\u0627\u0652 \u062a\u0650\u0644\u06e1\u0643\u064e \u0625\u0650\u0630\u0657\u0627 \u0643\u064e\u0631\u0651\u064e\u0629\u064c \u062e\u064e\u0627\u0633\u0650\u0631\u064e\u0629\u065e","translation":"\u015e\u00f6yle dediler: \u201cE\u011fer bir daha geri d\u00f6nersek, bu d\u00f6n\u00fc\u015f sahibi i\u00e7in bir h\u00fcsran, bir aldan\u0131\u015f olur.\u201d","footnotes":null},{"id":"5725","sura":"79","aya":"13","arabic_text":"\u0641\u064e\u0625\u0650\u0646\u0651\u064e\u0645\u064e\u0627 \u0647\u0650\u064a\u064e \u0632\u064e\u062c\u06e1\u0631\u064e\u0629\u065e \u0648\u064e\u0670\u062d\u0650\u062f\u064e\u0629\u065e","translation":"Yeniden dirili\u015f i\u015fi \u00e7ok kolayd\u0131r. O sadece S\u00fbr'a \u00fcflemekle sorumlu melekten gelen bir hayk\u0131r\u0131\u015ft\u0131r.","footnotes":null},{"id":"5726","sura":"79","aya":"14","arabic_text":"\u0641\u064e\u0625\u0650\u0630\u064e\u0627 \u0647\u064f\u0645 \u0628\u0650\u0671\u0644\u0633\u0651\u064e\u0627\u0647\u0650\u0631\u064e\u0629\u0650","translation":"Yerin alt\u0131nda \u00f6l\u00fc olduklar\u0131 halde, bir anda b\u00fct\u00fcn hepsi yery\u00fcz\u00fcn\u00fcn \u00fczerinde canlan\u0131verirler.","footnotes":null},{"id":"5727","sura":"79","aya":"15","arabic_text":"\u0647\u064e\u0644\u06e1 \u0623\u064e\u062a\u064e\u0649\u0670\u0643\u064e \u062d\u064e\u062f\u0650\u064a\u062b\u064f \u0645\u064f\u0648\u0633\u064e\u0649\u0670\u0653","translation":"-Ey Peygamber!- Musa\u2019n\u0131n, Rabbiyle ve d\u00fc\u015fman\u0131 olan Firavun'la ilgili haberi sana geldi mi?","footnotes":null},{"id":"5728","sura":"79","aya":"16","arabic_text":"\u0625\u0650\u0630\u06e1 \u0646\u064e\u0627\u062f\u064e\u0649\u0670\u0647\u064f \u0631\u064e\u0628\u0651\u064f\u0647\u064f\u06e5 \u0628\u0650\u0671\u0644\u06e1\u0648\u064e\u0627\u062f\u0650 \u0671\u0644\u06e1\u0645\u064f\u0642\u064e\u062f\u0651\u064e\u0633\u0650 \u0637\u064f\u0648\u064b\u0649","translation":"Rabbi ona, ar\u0131nd\u0131r\u0131lm\u0131\u015f Tuva vadisinde seslenmi\u015fti.","footnotes":null},{"id":"5729","sura":"79","aya":"17","arabic_text":"\u0671\u0630\u06e1\u0647\u064e\u0628\u06e1 \u0625\u0650\u0644\u064e\u0649\u0670 \u0641\u0650\u0631\u06e1\u0639\u064e\u0648\u06e1\u0646\u064e \u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0637\u064e\u063a\u064e\u0649\u0670","translation":"S\u00f6yledikleri aras\u0131nda \u015funu dedi: \u201cFiravun'a git! \u015e\u00fcphesiz o zul\u00fcm ve kibirlenmekte haddini a\u015ft\u0131.''","footnotes":null},{"id":"5730","sura":"79","aya":"18","arabic_text":"\u0641\u064e\u0642\u064f\u0644\u06e1 \u0647\u064e\u0644 \u0644\u0651\u064e\u0643\u064e \u0625\u0650\u0644\u064e\u0649\u0670\u0653 \u0623\u064e\u0646 \u062a\u064e\u0632\u064e\u0643\u0651\u064e\u0649\u0670","translation":"Ve ona de ki: \"Ey Firavun! K\u00fcf\u00fcr ve g\u00fcnahlardan ar\u0131nmak ister misin?''","footnotes":null},{"id":"5731","sura":"79","aya":"19","arabic_text":"\u0648\u064e\u0623\u064e\u0647\u06e1\u062f\u0650\u064a\u064e\u0643\u064e \u0625\u0650\u0644\u064e\u0649\u0670 \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0641\u064e\u062a\u064e\u062e\u06e1\u0634\u064e\u0649\u0670","translation":"Seni yaratan ve g\u00f6zeten Rabbine y\u00f6nlendireyim ki, b\u00f6ylece O'ndan korkarak raz\u0131 oldu\u011fu i\u015fleri yapar ve onu \u00f6fkelendiren i\u015flerden ka\u00e7\u0131n\u0131rs\u0131n.","footnotes":null},{"id":"5732","sura":"79","aya":"20","arabic_text":"\u0641\u064e\u0623\u064e\u0631\u064e\u0649\u0670\u0647\u064f \u0671\u0644\u06e1\u0623\u0653\u064a\u064e\u0629\u064e \u0671\u0644\u06e1\u0643\u064f\u0628\u06e1\u0631\u064e\u0649\u0670","translation":"Musa -aleyhisselam- ona, kendisinin Rabbinden gelen bir el\u00e7i oldu\u011funa delalet eden b\u00fcy\u00fck mucizeleri g\u00f6sterdi. Bunlar el ve asa mucizeleridir.","footnotes":null},{"id":"5733","sura":"79","aya":"21","arabic_text":"\u0641\u064e\u0643\u064e\u0630\u0651\u064e\u0628\u064e \u0648\u064e\u0639\u064e\u0635\u064e\u0649\u0670","translation":"Firavun ise bu mucizeleri yalanlay\u0131p, Musa -aleyhisselam-'\u0131n ona emretti\u011fine kar\u015f\u0131 gelmekten ba\u015fka bir \u015fey yapmad\u0131.","footnotes":null},{"id":"5734","sura":"79","aya":"22","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0623\u064e\u062f\u06e1\u0628\u064e\u0631\u064e \u064a\u064e\u0633\u06e1\u0639\u064e\u0649\u0670","translation":"Sonra da M\u00fbs\u00e2\u2019n\u0131n getirdiklerine iman etmekten y\u00fcz \u00e7evirerek Allah'a isyan etmeye ve hakka muhalefet etmeye \u00e7al\u0131\u015ft\u0131.","footnotes":null},{"id":"5735","sura":"79","aya":"23","arabic_text":"\u0641\u064e\u062d\u064e\u0634\u064e\u0631\u064e \u0641\u064e\u0646\u064e\u0627\u062f\u064e\u0649\u0670","translation":"Sonra da M\u00fbs\u00e2\u2019ya galip gelmek i\u00e7in kavmini ve yanda\u015flar\u0131n\u0131 toplayarak onlara \u015f\u00f6yle seslendi:","footnotes":null},{"id":"5736","sura":"79","aya":"24","arabic_text":"\u0641\u064e\u0642\u064e\u0627\u0644\u064e \u0623\u064e\u0646\u064e\u0627\u06e0 \u0631\u064e\u0628\u0651\u064f\u0643\u064f\u0645\u064f \u0671\u0644\u06e1\u0623\u064e\u0639\u06e1\u0644\u064e\u0649\u0670","translation":"\"Sizin en \u00fcst\u00fcn Rabbiniz benim! Siz, benden ba\u015fkas\u0131na itaat edemezsiniz.\"","footnotes":null},{"id":"5737","sura":"79","aya":"25","arabic_text":"\u0641\u064e\u0623\u064e\u062e\u064e\u0630\u064e\u0647\u064f \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0646\u064e\u0643\u064e\u0627\u0644\u064e \u0671\u0644\u06e1\u0623\u0653\u062e\u0650\u0631\u064e\u0629\u0650 \u0648\u064e\u0671\u0644\u06e1\u0623\u064f\u0648\u0644\u064e\u0649\u0670\u0653","translation":"Allah da onu d\u00fcnyada denizde bo\u011farak, ahirette de onu daha \u015fiddetli bir azaba sokarak cezaland\u0131rd\u0131.","footnotes":null},{"id":"5738","sura":"79","aya":"26","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0641\u0650\u064a \u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0644\u064e\u0639\u0650\u0628\u06e1\u0631\u064e\u0629\u0657 \u0644\u0651\u0650\u0645\u064e\u0646 \u064a\u064e\u062e\u06e1\u0634\u064e\u0649\u0670\u0653","translation":"Muhakkak d\u00fcnya ve ahirette Firavun\u2019u cezaland\u0131rd\u0131\u011f\u0131m\u0131z bu azapta Allah\u2019tan korkan kimseler i\u00e7in bir \u00f6\u011f\u00fct vard\u0131r. Zira nasihatlerden faydalanan kimseler onlard\u0131r.","footnotes":null},{"id":"5739","sura":"79","aya":"27","arabic_text":"\u0621\u064e\u0623\u064e\u0646\u062a\u064f\u0645\u06e1 \u0623\u064e\u0634\u064e\u062f\u0651\u064f \u062e\u064e\u0644\u06e1\u0642\u064b\u0627 \u0623\u064e\u0645\u0650 \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0627\u0653\u0621\u064f\u06da \u0628\u064e\u0646\u064e\u0649\u0670\u0647\u064e\u0627","translation":"-Ey yeniden dirili\u015fi yalanlayanlar!- Sizi yoktan var etmesi mi Allah'a daha zordur, yoksa var etti\u011fi g\u00f6ky\u00fcz\u00fcn\u00fc yaratmas\u0131 m\u0131?","footnotes":null},{"id":"5740","sura":"79","aya":"28","arabic_text":"\u0631\u064e\u0641\u064e\u0639\u064e \u0633\u064e\u0645\u06e1\u0643\u064e\u0647\u064e\u0627 \u0641\u064e\u0633\u064e\u0648\u0651\u064e\u0649\u0670\u0647\u064e\u0627","translation":"\u00dcst k\u0131sm\u0131n\u0131 y\u00fckseltti; kusur, yar\u0131k ve hatalar olmayacak \u015fekilde onu d\u00fczg\u00fcn k\u0131ld\u0131.","footnotes":null},{"id":"5741","sura":"79","aya":"29","arabic_text":"\u0648\u064e\u0623\u064e\u063a\u06e1\u0637\u064e\u0634\u064e \u0644\u064e\u064a\u06e1\u0644\u064e\u0647\u064e\u0627 \u0648\u064e\u0623\u064e\u062e\u06e1\u0631\u064e\u062c\u064e \u0636\u064f\u062d\u064e\u0649\u0670\u0647\u064e\u0627","translation":"G\u00fcne\u015f'i batt\u0131\u011f\u0131 zaman gecesini karartt\u0131 ve do\u011fdu\u011fu zamanda \u0131\u015f\u0131\u011f\u0131n\u0131 g\u00f6sterdi.","footnotes":null},{"id":"5742","sura":"79","aya":"30","arabic_text":"\u0648\u064e\u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u064e \u0628\u064e\u0639\u06e1\u062f\u064e \u0630\u064e\u0670\u0644\u0650\u0643\u064e \u062f\u064e\u062d\u064e\u0649\u0670\u0647\u064e\u0627\u0653","translation":"G\u00f6ky\u00fcz\u00fcn\u00fc yaratmas\u0131n\u0131n ard\u0131ndan yery\u00fcz\u00fcn\u00fc yayd\u0131 ve oraya b\u00fct\u00fcn faydal\u0131 \u015feyleri yerle\u015ftirdi.","footnotes":null},{"id":"5743","sura":"79","aya":"31","arabic_text":"\u0623\u064e\u062e\u06e1\u0631\u064e\u062c\u064e \u0645\u0650\u0646\u06e1\u0647\u064e\u0627 \u0645\u064e\u0627\u0653\u0621\u064e\u0647\u064e\u0627 \u0648\u064e\u0645\u064e\u0631\u06e1\u0639\u064e\u0649\u0670\u0647\u064e\u0627","translation":"Orada akan kaynaklarla suyunu \u00e7\u0131kard\u0131 ve hayvanlar\u0131n otlad\u0131\u011f\u0131 bitkiler yeti\u015ftirdi.","footnotes":null},{"id":"5744","sura":"79","aya":"32","arabic_text":"\u0648\u064e\u0671\u0644\u06e1\u062c\u0650\u0628\u064e\u0627\u0644\u064e \u0623\u064e\u0631\u06e1\u0633\u064e\u0649\u0670\u0647\u064e\u0627","translation":"Ve da\u011flar\u0131 da topra\u011fa sabit k\u0131ld\u0131.","footnotes":null},{"id":"5745","sura":"79","aya":"33","arabic_text":"\u0645\u064e\u062a\u064e\u0670\u0639\u0657\u0627 \u0644\u0651\u064e\u0643\u064f\u0645\u06e1 \u0648\u064e\u0644\u0650\u0623\u064e\u0646\u06e1\u0639\u064e\u0670\u0645\u0650\u0643\u064f\u0645\u06e1","translation":"-Ey insanlar!- B\u00fct\u00fcn bu nimetler sizin ve hayvanlar\u0131n\u0131z i\u00e7indir. B\u00fct\u00fcn bunlar\u0131 yaratan, bunlar\u0131 yeni ba\u015ftan yaratmaktan da aciz de\u011fildir.","footnotes":null},{"id":"5746","sura":"79","aya":"34","arabic_text":"\u0641\u064e\u0625\u0650\u0630\u064e\u0627 \u062c\u064e\u0627\u0653\u0621\u064e\u062a\u0650 \u0671\u0644\u0637\u0651\u064e\u0627\u0653\u0645\u0651\u064e\u0629\u064f \u0671\u0644\u06e1\u0643\u064f\u0628\u06e1\u0631\u064e\u0649\u0670","translation":"Her \u015feyin deh\u015fetine kap\u0131laca\u011f\u0131 ikinci \u00fcfleme ger\u00e7ekle\u015fince k\u0131yamet kopacak.","footnotes":null},{"id":"5747","sura":"79","aya":"35","arabic_text":"\u064a\u064e\u0648\u06e1\u0645\u064e \u064a\u064e\u062a\u064e\u0630\u064e\u0643\u0651\u064e\u0631\u064f \u0671\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u064f \u0645\u064e\u0627 \u0633\u064e\u0639\u064e\u0649\u0670","translation":"O g\u00fcn geldi\u011finde insan hay\u0131r veya \u015fer olarak yapt\u0131\u011f\u0131 b\u00fct\u00fcn amellerini hat\u0131rlayacakt\u0131r.","footnotes":null},{"id":"5748","sura":"79","aya":"36","arabic_text":"\u0648\u064e\u0628\u064f\u0631\u0651\u0650\u0632\u064e\u062a\u0650 \u0671\u0644\u06e1\u062c\u064e\u062d\u0650\u064a\u0645\u064f \u0644\u0650\u0645\u064e\u0646 \u064a\u064e\u0631\u064e\u0649\u0670","translation":"Ve cehennem getirilerek onu g\u00f6renlere a\u00e7\u0131k\u00e7a g\u00f6sterilir.","footnotes":null},{"id":"5749","sura":"79","aya":"37","arabic_text":"\u0641\u064e\u0623\u064e\u0645\u0651\u064e\u0627 \u0645\u064e\u0646 \u0637\u064e\u063a\u064e\u0649\u0670","translation":"Fakat kim sap\u0131kl\u0131kta haddini a\u015fm\u0131\u015fsa.","footnotes":null},{"id":"5750","sura":"79","aya":"38","arabic_text":"\u0648\u064e\u0621\u064e\u0627\u062b\u064e\u0631\u064e \u0671\u0644\u06e1\u062d\u064e\u064a\u064e\u0648\u0670\u0629\u064e \u0671\u0644\u062f\u0651\u064f\u0646\u06e1\u064a\u064e\u0627","translation":"Ve ge\u00e7ici d\u00fcnya hayat\u0131n\u0131 kal\u0131c\u0131 ahiret hayat\u0131na tercih ettiyse.","footnotes":null},{"id":"5751","sura":"79","aya":"39","arabic_text":"\u0641\u064e\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u06e1\u062c\u064e\u062d\u0650\u064a\u0645\u064e \u0647\u0650\u064a\u064e \u0671\u0644\u06e1\u0645\u064e\u0623\u06e1\u0648\u064e\u0649\u0670","translation":"Muhakkak cehennem ate\u015fi onun bar\u0131naca\u011f\u0131 yerle\u015fim yeri olacakt\u0131r.","footnotes":null},{"id":"5752","sura":"79","aya":"40","arabic_text":"\u0648\u064e\u0623\u064e\u0645\u0651\u064e\u0627 \u0645\u064e\u0646\u06e1 \u062e\u064e\u0627\u0641\u064e \u0645\u064e\u0642\u064e\u0627\u0645\u064e \u0631\u064e\u0628\u0651\u0650\u0647\u0650\u06e6 \u0648\u064e\u0646\u064e\u0647\u064e\u0649 \u0671\u0644\u0646\u0651\u064e\u0641\u06e1\u0633\u064e \u0639\u064e\u0646\u0650 \u0671\u0644\u06e1\u0647\u064e\u0648\u064e\u0649\u0670","translation":"40-41 Her kim de Rabbinin huzurunda olmaktan korkarak kendini Allah\u2019\u0131n haram k\u0131ld\u0131\u011f\u0131 arzular\u0131ndan al\u0131koyarsa, muhakkak cennet onun bar\u0131naca\u011f\u0131 yerle\u015fim yeridir.","footnotes":null},{"id":"5753","sura":"79","aya":"41","arabic_text":"\u0641\u064e\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u06e1\u062c\u064e\u0646\u0651\u064e\u0629\u064e \u0647\u0650\u064a\u064e \u0671\u0644\u06e1\u0645\u064e\u0623\u06e1\u0648\u064e\u0649\u0670","translation":"40-41 Her kim de Rabbinin huzurunda olmaktan korkarak kendini Allah\u2019\u0131n haram k\u0131ld\u0131\u011f\u0131 arzular\u0131ndan al\u0131koyarsa, muhakkak cennet onun bar\u0131naca\u011f\u0131 yerle\u015fim yeridir.","footnotes":null},{"id":"5754","sura":"79","aya":"42","arabic_text":"\u064a\u064e\u0633\u06e1\u0640\u0654\u064e\u0644\u064f\u0648\u0646\u064e\u0643\u064e \u0639\u064e\u0646\u0650 \u0671\u0644\u0633\u0651\u064e\u0627\u0639\u064e\u0629\u0650 \u0623\u064e\u064a\u0651\u064e\u0627\u0646\u064e \u0645\u064f\u0631\u06e1\u0633\u064e\u0649\u0670\u0647\u064e\u0627","translation":"-Ey Peygamber!- Yeniden dirili\u015fi yalanlayan o kimseler sana soruyorlar: \"K\u0131yamet ne zaman kopacak?\"","footnotes":null},{"id":"5755","sura":"79","aya":"43","arabic_text":"\u0641\u0650\u064a\u0645\u064e \u0623\u064e\u0646\u062a\u064e \u0645\u0650\u0646 \u0630\u0650\u0643\u06e1\u0631\u064e\u0649\u0670\u0647\u064e\u0627\u0653","translation":"Senin buna dair bir bilgin yok ki, onlara s\u00f6yleyesin ve zaten bu senin i\u015fin de de\u011fildir. Asl\u0131nda senin g\u00f6revin sadece insanlar\u0131 ona haz\u0131rlamakt\u0131r.","footnotes":null},{"id":"5756","sura":"79","aya":"44","arabic_text":"\u0625\u0650\u0644\u064e\u0649\u0670 \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0645\u064f\u0646\u062a\u064e\u0647\u064e\u0649\u0670\u0647\u064e\u0627\u0653","translation":"K\u0131yametin nihai bilgisi sadece Rabbinde vard\u0131r.","footnotes":null},{"id":"5757","sura":"79","aya":"45","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0645\u064e\u0627\u0653 \u0623\u064e\u0646\u062a\u064e \u0645\u064f\u0646\u0630\u0650\u0631\u064f \u0645\u064e\u0646 \u064a\u064e\u062e\u06e1\u0634\u064e\u0649\u0670\u0647\u064e\u0627","translation":"\u015e\u00fcphesiz sen, ancak k\u0131yametten korkan kimseler i\u00e7in bir uyar\u0131c\u0131s\u0131n. \u00c7\u00fcnk\u00fc senin uyar\u0131ndan istifade edecek yaln\u0131zca onlard\u0131r.","footnotes":null},{"id":"5758","sura":"79","aya":"46","arabic_text":"\u0643\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u0645\u06e1 \u064a\u064e\u0648\u06e1\u0645\u064e \u064a\u064e\u0631\u064e\u0648\u06e1\u0646\u064e\u0647\u064e\u0627 \u0644\u064e\u0645\u06e1 \u064a\u064e\u0644\u06e1\u0628\u064e\u062b\u064f\u0648\u0653\u0627\u0652 \u0625\u0650\u0644\u0651\u064e\u0627 \u0639\u064e\u0634\u0650\u064a\u0651\u064e\u0629\u064b \u0623\u064e\u0648\u06e1 \u0636\u064f\u062d\u064e\u0649\u0670\u0647\u064e\u0627","translation":"K\u0131yamete \u015fahit olduklar\u0131 o g\u00fcn, sanki d\u00fcnya hayatlar\u0131nda sadece bir g\u00fcn\u00fcn arifesi veyahut sabah\u0131n\u0131n ilk vakitleri kadar kalm\u0131\u015f gibidirler.","footnotes":null}]}