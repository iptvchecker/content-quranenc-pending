{"result":[{"id":"5376","sura":"70","aya":"1","arabic_text":"\u0633\u064e\u0623\u064e\u0644\u064e \u0633\u064e\u0627\u0653\u0626\u0650\u0644\u064f\u06e2 \u0628\u0650\u0639\u064e\u0630\u064e\u0627\u0628\u0656 \u0648\u064e\u0627\u0642\u0650\u0639\u0656","translation":"M\u00fc\u015friklerden dua eden bir davet\u00e7i, e\u011fer bir azap ger\u00e7ekle\u015fecekse bu azab\u0131n kendine ve kavmine olmas\u0131 i\u00e7in dua etti. Bunu yaparak dalga ge\u00e7iyordu. Oysa bu k\u0131yamet g\u00fcn\u00fc ger\u00e7ekle\u015fecektir.","footnotes":null},{"id":"5377","sura":"70","aya":"2","arabic_text":"\u0644\u0651\u0650\u0644\u06e1\u0643\u064e\u0670\u0641\u0650\u0631\u0650\u064a\u0646\u064e \u0644\u064e\u064a\u06e1\u0633\u064e \u0644\u064e\u0647\u064f\u06e5 \u062f\u064e\u0627\u0641\u0650\u0639\u065e","translation":"Allah'\u0131n k\u00e2fir olanlar\u0131n \u00fczerine g\u00f6nderece\u011fi bu azab\u0131 hi\u00e7 kimse engelleyemez.","footnotes":null},{"id":"5378","sura":"70","aya":"3","arabic_text":"\u0645\u0651\u0650\u0646\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0630\u0650\u064a \u0671\u0644\u06e1\u0645\u064e\u0639\u064e\u0627\u0631\u0650\u062c\u0650","translation":"Bu, y\u00fccelik, y\u00fckseklik mertebe, erdem ve nimetlerin sahibi Allah taraf\u0131ndand\u0131r.","footnotes":null},{"id":"5379","sura":"70","aya":"4","arabic_text":"\u062a\u064e\u0639\u06e1\u0631\u064f\u062c\u064f \u0671\u0644\u06e1\u0645\u064e\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064e\u0629\u064f \u0648\u064e\u0671\u0644\u0631\u0651\u064f\u0648\u062d\u064f \u0625\u0650\u0644\u064e\u064a\u06e1\u0647\u0650 \u0641\u0650\u064a \u064a\u064e\u0648\u06e1\u0645\u0656 \u0643\u064e\u0627\u0646\u064e \u0645\u0650\u0642\u06e1\u062f\u064e\u0627\u0631\u064f\u0647\u064f\u06e5 \u062e\u064e\u0645\u06e1\u0633\u0650\u064a\u0646\u064e \u0623\u064e\u0644\u06e1\u0641\u064e \u0633\u064e\u0646\u064e\u0629\u0656","translation":"Melekler ve Cebrail, k\u0131yamet g\u00fcn\u00fc bu derecelerde O'na y\u00fckselir ve o g\u00fcn, elli bin sene kadar uzun bir g\u00fcnd\u00fcr.","footnotes":null},{"id":"5380","sura":"70","aya":"5","arabic_text":"\u0641\u064e\u0671\u0635\u06e1\u0628\u0650\u0631\u06e1 \u0635\u064e\u0628\u06e1\u0631\u0657\u0627 \u062c\u064e\u0645\u0650\u064a\u0644\u064b\u0627","translation":"-Ey Peygamber!- O halde h\u00fczne d\u00fc\u015fmeden ve \u015fikayet etmeden sabret!","footnotes":null},{"id":"5381","sura":"70","aya":"6","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u0645\u06e1 \u064a\u064e\u0631\u064e\u0648\u06e1\u0646\u064e\u0647\u064f\u06e5 \u0628\u064e\u0639\u0650\u064a\u062f\u0657\u0627","translation":"\u015e\u00fcphesiz onlar; bu azab\u0131n ger\u00e7ekle\u015fmesini imk\u00e2ns\u0131z, \u00e7ok uzak bir ihtimal olarak g\u00f6r\u00fcyorlar.","footnotes":null},{"id":"5382","sura":"70","aya":"7","arabic_text":"\u0648\u064e\u0646\u064e\u0631\u064e\u0649\u0670\u0647\u064f \u0642\u064e\u0631\u0650\u064a\u0628\u0657\u0627","translation":"Oysa biz onun ka\u00e7\u0131n\u0131lmaz olarak \u00e7ok yak\u0131nda ger\u00e7ekle\u015fece\u011fini g\u00f6r\u00fcyoruz.","footnotes":null},{"id":"5383","sura":"70","aya":"8","arabic_text":"\u064a\u064e\u0648\u06e1\u0645\u064e \u062a\u064e\u0643\u064f\u0648\u0646\u064f \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0627\u0653\u0621\u064f \u0643\u064e\u0671\u0644\u06e1\u0645\u064f\u0647\u06e1\u0644\u0650","translation":"O g\u00fcn; g\u00f6ky\u00fcz\u00fc erimi\u015f bak\u0131r, alt\u0131n ve di\u011fer madenler gibi olur.","footnotes":null},{"id":"5384","sura":"70","aya":"9","arabic_text":"\u0648\u064e\u062a\u064e\u0643\u064f\u0648\u0646\u064f \u0671\u0644\u06e1\u062c\u0650\u0628\u064e\u0627\u0644\u064f \u0643\u064e\u0671\u0644\u06e1\u0639\u0650\u0647\u06e1\u0646\u0650","translation":"Da\u011flar ise at\u0131lm\u0131\u015f (u\u00e7u\u015fan, hafif) y\u00fcn gibi olur.","footnotes":null},{"id":"5385","sura":"70","aya":"10","arabic_text":"\u0648\u064e\u0644\u064e\u0627 \u064a\u064e\u0633\u06e1\u0640\u0654\u064e\u0644\u064f \u062d\u064e\u0645\u0650\u064a\u0645\u064c \u062d\u064e\u0645\u0650\u064a\u0645\u0657\u0627","translation":"Hi\u00e7bir yak\u0131n dost hi\u00e7bir yak\u0131n\u0131n\u0131n halini sormaz bile. \u00c7\u00fcnk\u00fc herkes kendisiyle me\u015fguld\u00fcr.","footnotes":null},{"id":"5386","sura":"70","aya":"11","arabic_text":"\u064a\u064f\u0628\u064e\u0635\u0651\u064e\u0631\u064f\u0648\u0646\u064e\u0647\u064f\u0645\u06e1\u06da \u064a\u064e\u0648\u064e\u062f\u0651\u064f \u0671\u0644\u06e1\u0645\u064f\u062c\u06e1\u0631\u0650\u0645\u064f \u0644\u064e\u0648\u06e1 \u064a\u064e\u0641\u06e1\u062a\u064e\u062f\u0650\u064a \u0645\u0650\u0646\u06e1 \u0639\u064e\u0630\u064e\u0627\u0628\u0650 \u064a\u064e\u0648\u06e1\u0645\u0650\u0626\u0650\u0630\u0650\u06ed \u0628\u0650\u0628\u064e\u0646\u0650\u064a\u0647\u0650","translation":"Her insan yak\u0131nlar\u0131n\u0131 g\u00f6r\u00fcr, ona gizli kalmazlar. Bununla beraber hi\u00e7 kimse o durumun deh\u015feti sebebiyle kimseyi soru\u015fturmaz. Cehennemi hak eden kimseler ise, kendileri yerine azap g\u00f6rmeleri i\u00e7in \u00e7ocuklar\u0131n\u0131 sunmay\u0131 arzular.","footnotes":null},{"id":"5387","sura":"70","aya":"12","arabic_text":"\u0648\u064e\u0635\u064e\u0670\u062d\u0650\u0628\u064e\u062a\u0650\u0647\u0650\u06e6 \u0648\u064e\u0623\u064e\u062e\u0650\u064a\u0647\u0650","translation":"Kar\u0131s\u0131n\u0131 ve karde\u015fini feda eder.","footnotes":null},{"id":"5388","sura":"70","aya":"13","arabic_text":"\u0648\u064e\u0641\u064e\u0635\u0650\u064a\u0644\u064e\u062a\u0650\u0647\u0650 \u0671\u0644\u0651\u064e\u062a\u0650\u064a \u062a\u064f\u0640\u0654\u06e1\u0648\u0650\u064a\u0647\u0650","translation":"Ve s\u0131k\u0131nt\u0131lar kar\u015f\u0131s\u0131nda onun yan\u0131nda duran akrabalar\u0131n\u0131 s\u00fclalesini feda eder.","footnotes":null},{"id":"5389","sura":"70","aya":"14","arabic_text":"\u0648\u064e\u0645\u064e\u0646 \u0641\u0650\u064a \u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u0650 \u062c\u064e\u0645\u0650\u064a\u0639\u0657\u0627 \u062b\u064f\u0645\u0651\u064e \u064a\u064f\u0646\u062c\u0650\u064a\u0647\u0650","translation":"Ve yery\u00fcz\u00fcnde bulunan insan, cin ve di\u011fer herkesi feda etmek ister ki; bu fedak\u00e2rl\u0131k onu cehennem azab\u0131ndan esenlikte k\u0131l\u0131p, kurtars\u0131n.","footnotes":null},{"id":"5390","sura":"70","aya":"15","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627\u0653\u06d6 \u0625\u0650\u0646\u0651\u064e\u0647\u064e\u0627 \u0644\u064e\u0638\u064e\u0649\u0670","translation":"Durum bu g\u00fcnahk\u00e2r\u0131n temenni etti\u011fi gibi de\u011fildir. \u015e\u00fcphesiz ahiret yurdunun ate\u015fi yanm\u0131\u015f ve alevlenmi\u015ftir.","footnotes":null},{"id":"5391","sura":"70","aya":"16","arabic_text":"\u0646\u064e\u0632\u0651\u064e\u0627\u0639\u064e\u0629\u0657 \u0644\u0651\u0650\u0644\u0634\u0651\u064e\u0648\u064e\u0649\u0670","translation":"S\u0131cakl\u0131\u011f\u0131n\u0131n ve alevlerinin \u015fiddetinden kafan\u0131n derisi h\u0131zl\u0131ca soyulup ayr\u0131l\u0131r.","footnotes":null},{"id":"5392","sura":"70","aya":"17","arabic_text":"\u062a\u064e\u062f\u06e1\u0639\u064f\u0648\u0627\u0652 \u0645\u064e\u0646\u06e1 \u0623\u064e\u062f\u06e1\u0628\u064e\u0631\u064e \u0648\u064e\u062a\u064e\u0648\u064e\u0644\u0651\u064e\u0649\u0670","translation":"Haktan y\u00fcz \u00e7eviren, ondan uzakla\u015farak ona iman etmeyen ve amel i\u015flemeyen kimseyi \u00e7a\u011f\u0131r\u0131r.","footnotes":null},{"id":"5393","sura":"70","aya":"18","arabic_text":"\u0648\u064e\u062c\u064e\u0645\u064e\u0639\u064e \u0641\u064e\u0623\u064e\u0648\u06e1\u0639\u064e\u0649\u0670\u0653","translation":"Mal toplayan\u0131 ve Allah yolunda harcamakta cimrilik yapan\u0131 \u00e7a\u011f\u0131r\u0131r.","footnotes":null},{"id":"5394","sura":"70","aya":"19","arabic_text":"\u06de\u00a0\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u064e \u062e\u064f\u0644\u0650\u0642\u064e \u0647\u064e\u0644\u064f\u0648\u0639\u064b\u0627","translation":"\u015e\u00fcphesiz insan, a\u015f\u0131r\u0131 h\u0131rsl\u0131 yarat\u0131lm\u0131\u015ft\u0131r.","footnotes":null},{"id":"5395","sura":"70","aya":"20","arabic_text":"\u0625\u0650\u0630\u064e\u0627 \u0645\u064e\u0633\u0651\u064e\u0647\u064f \u0671\u0644\u0634\u0651\u064e\u0631\u0651\u064f \u062c\u064e\u0632\u064f\u0648\u0639\u0657\u0627","translation":"Kendisine hastal\u0131k veya fakirlik s\u0131k\u0131nt\u0131s\u0131 isabet etse \u00e7ok az sabreder.","footnotes":null},{"id":"5396","sura":"70","aya":"21","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0645\u064e\u0633\u0651\u064e\u0647\u064f \u0671\u0644\u06e1\u062e\u064e\u064a\u06e1\u0631\u064f \u0645\u064e\u0646\u064f\u0648\u0639\u064b\u0627","translation":"E\u011fer ona insan\u0131 mutlu eden bir bolluk veya zenginlik isabet ederse de onu Allah yolunda harcamaz, \u00e7ok cimrilik eder.","footnotes":null},{"id":"5397","sura":"70","aya":"22","arabic_text":"\u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0644\u06e1\u0645\u064f\u0635\u064e\u0644\u0651\u0650\u064a\u0646\u064e","translation":"Ama namaz k\u0131lanlar bundan m\u00fcstesna. Onlar bu k\u00f6t\u00fc s\u0131fatlardan esenliktedirler.","footnotes":null},{"id":"5398","sura":"70","aya":"23","arabic_text":"\u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0647\u064f\u0645\u06e1 \u0639\u064e\u0644\u064e\u0649\u0670 \u0635\u064e\u0644\u064e\u0627\u062a\u0650\u0647\u0650\u0645\u06e1 \u062f\u064e\u0627\u0653\u0626\u0650\u0645\u064f\u0648\u0646\u064e","translation":"Onlar, d\u00fczenli olarak namazlar\u0131na devam ederler. Ondan ba\u015fka \u015feylerle me\u015fgul olmaz ve namazlar\u0131n\u0131 onun i\u00e7in belirlenmi\u015f vaktinde eda ederler.","footnotes":null},{"id":"5399","sura":"70","aya":"24","arabic_text":"\u0648\u064e\u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0641\u0650\u064a\u0653 \u0623\u064e\u0645\u06e1\u0648\u064e\u0670\u0644\u0650\u0647\u0650\u0645\u06e1 \u062d\u064e\u0642\u0651\u065e \u0645\u0651\u064e\u0639\u06e1\u0644\u064f\u0648\u0645\u065e","translation":"Onlar\u0131n mallar\u0131nda farz k\u0131l\u0131nm\u0131\u015f belirli bir pay vard\u0131r.","footnotes":null},{"id":"5400","sura":"70","aya":"25","arabic_text":"\u0644\u0651\u0650\u0644\u0633\u0651\u064e\u0627\u0653\u0626\u0650\u0644\u0650 \u0648\u064e\u0671\u0644\u06e1\u0645\u064e\u062d\u06e1\u0631\u064f\u0648\u0645\u0650","translation":"Onlar, mallar\u0131n\u0131 kendilerine gelip isteyenlere ve herhangi bir sebepten \u00f6t\u00fcr\u00fc r\u0131z\u0131ktan mahrum kal\u0131p, istemeyenlere verirler.","footnotes":null},{"id":"5401","sura":"70","aya":"26","arabic_text":"\u0648\u064e\u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u064a\u064f\u0635\u064e\u062f\u0651\u0650\u0642\u064f\u0648\u0646\u064e \u0628\u0650\u064a\u064e\u0648\u06e1\u0645\u0650 \u0671\u0644\u062f\u0651\u0650\u064a\u0646\u0650","translation":"Onlar ki; Allah\u2019\u0131n herkese hak etti\u011fi kar\u015f\u0131l\u0131\u011f\u0131 verece\u011fi o g\u00fcn\u00fc k\u0131yamet g\u00fcn\u00fcn\u00fc tasdik ederler.","footnotes":null},{"id":"5402","sura":"70","aya":"27","arabic_text":"\u0648\u064e\u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0647\u064f\u0645 \u0645\u0651\u0650\u0646\u06e1 \u0639\u064e\u0630\u064e\u0627\u0628\u0650 \u0631\u064e\u0628\u0651\u0650\u0647\u0650\u0645 \u0645\u0651\u064f\u0634\u06e1\u0641\u0650\u0642\u064f\u0648\u0646\u064e","translation":"Onlar ki, i\u015flemi\u015f olduklar\u0131 salih amellere ra\u011fmen Rablerinin azab\u0131ndan korkarlar.","footnotes":null},{"id":"5403","sura":"70","aya":"28","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0639\u064e\u0630\u064e\u0627\u0628\u064e \u0631\u064e\u0628\u0651\u0650\u0647\u0650\u0645\u06e1 \u063a\u064e\u064a\u06e1\u0631\u064f \u0645\u064e\u0623\u06e1\u0645\u064f\u0648\u0646\u0656","translation":"\u015e\u00fcphesiz Rablerinin azab\u0131 korkutucudur. Ak\u0131ll\u0131 kimse kendini g\u00fcvende hissetmez.","footnotes":null},{"id":"5404","sura":"70","aya":"29","arabic_text":"\u0648\u064e\u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0647\u064f\u0645\u06e1 \u0644\u0650\u0641\u064f\u0631\u064f\u0648\u062c\u0650\u0647\u0650\u0645\u06e1 \u062d\u064e\u0670\u0641\u0650\u0638\u064f\u0648\u0646\u064e","translation":"Onlar, iffetlerini (haram i\u015flemekten) koruyup, fuhu\u015ftan uzak tutarak muhafaza ederler.","footnotes":null},{"id":"5405","sura":"70","aya":"30","arabic_text":"\u0625\u0650\u0644\u0651\u064e\u0627 \u0639\u064e\u0644\u064e\u0649\u0670\u0653 \u0623\u064e\u0632\u06e1\u0648\u064e\u0670\u062c\u0650\u0647\u0650\u0645\u06e1 \u0623\u064e\u0648\u06e1 \u0645\u064e\u0627 \u0645\u064e\u0644\u064e\u0643\u064e\u062a\u06e1 \u0623\u064e\u064a\u06e1\u0645\u064e\u0670\u0646\u064f\u0647\u064f\u0645\u06e1 \u0641\u064e\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u0645\u06e1 \u063a\u064e\u064a\u06e1\u0631\u064f \u0645\u064e\u0644\u064f\u0648\u0645\u0650\u064a\u0646\u064e","translation":"Ancak e\u015fleri veya sahip olduklar\u0131 cariyeleri bunun d\u0131\u015f\u0131ndad\u0131r. \u015e\u00fcphesiz ki onlar; bu cariyeler ile cinsel ili\u015fkiye girmeleri ve bunun d\u0131\u015f\u0131nda onlardan istifade etmelerinden dolay\u0131 k\u0131nanmazlar.","footnotes":null},{"id":"5406","sura":"70","aya":"31","arabic_text":"\u0641\u064e\u0645\u064e\u0646\u0650 \u0671\u0628\u06e1\u062a\u064e\u063a\u064e\u0649\u0670 \u0648\u064e\u0631\u064e\u0627\u0653\u0621\u064e \u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0641\u064e\u0623\u064f\u0648\u0652\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064e \u0647\u064f\u0645\u064f \u0671\u0644\u06e1\u0639\u064e\u0627\u062f\u064f\u0648\u0646\u064e","translation":"Her kim de zikri ge\u00e7en e\u015fler ve cariyeler d\u0131\u015f\u0131ndakilerden faydalanmak isterse, \u015f\u00fcphesiz onlar Allah\u2019\u0131n s\u0131n\u0131rlar\u0131n\u0131 a\u015fan kimseler olurlar.","footnotes":null},{"id":"5407","sura":"70","aya":"32","arabic_text":"\u0648\u064e\u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0647\u064f\u0645\u06e1 \u0644\u0650\u0623\u064e\u0645\u064e\u0670\u0646\u064e\u0670\u062a\u0650\u0647\u0650\u0645\u06e1 \u0648\u064e\u0639\u064e\u0647\u06e1\u062f\u0650\u0647\u0650\u0645\u06e1 \u0631\u064e\u0670\u0639\u064f\u0648\u0646\u064e","translation":"Onlar kendilerine emanet edilen mallar\u0131, s\u0131rlar\u0131 ve di\u011fer \u015feyleri koruyup, muhafaza ederler. \u0130nsanlara verdikleri s\u00f6zleri tutarlar. Emanetlerine ihanet etmez, verdikleri s\u00f6zleri bozmazlar.","footnotes":null},{"id":"5408","sura":"70","aya":"33","arabic_text":"\u0648\u064e\u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0647\u064f\u0645 \u0628\u0650\u0634\u064e\u0647\u064e\u0670\u062f\u064e\u0670\u062a\u0650\u0647\u0650\u0645\u06e1 \u0642\u064e\u0627\u0653\u0626\u0650\u0645\u064f\u0648\u0646\u064e","translation":"Onlar \u015fahitliklerini, yak\u0131nl\u0131k veya d\u00fc\u015fmanl\u0131\u011f\u0131n etkisi alt\u0131nda kalmadan olmas\u0131 gerekti\u011fi gibi yerine getirirler.","footnotes":null},{"id":"5409","sura":"70","aya":"34","arabic_text":"\u0648\u064e\u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0647\u064f\u0645\u06e1 \u0639\u064e\u0644\u064e\u0649\u0670 \u0635\u064e\u0644\u064e\u0627\u062a\u0650\u0647\u0650\u0645\u06e1 \u064a\u064f\u062d\u064e\u0627\u0641\u0650\u0638\u064f\u0648\u0646\u064e","translation":"Onlar; namazlar\u0131n\u0131 zaman\u0131nda, g\u00fczel abdest alarak ve tadil-i erkana riayet ederek s\u00fcrekli k\u0131larlar. Hi\u00e7bir \u015fey onlar\u0131 namazlar\u0131ndan al\u0131koymaz.","footnotes":null},{"id":"5410","sura":"70","aya":"35","arabic_text":"\u0623\u064f\u0648\u0652\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064e \u0641\u0650\u064a \u062c\u064e\u0646\u0651\u064e\u0670\u062a\u0656 \u0645\u0651\u064f\u0643\u06e1\u0631\u064e\u0645\u064f\u0648\u0646\u064e","translation":"\u0130\u015fte bu s\u0131fatlarla nitelenen o kimseler, kar\u015f\u0131la\u015facaklar\u0131 kal\u0131c\u0131 nimetlerle ve Allah\u2019\u0131n kerim y\u00fcz\u00fcne bakarak, cennetlerde a\u011f\u0131rlanacaklard\u0131r.","footnotes":null},{"id":"5411","sura":"70","aya":"36","arabic_text":"\u0641\u064e\u0645\u064e\u0627\u0644\u0650 \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0643\u064e\u0641\u064e\u0631\u064f\u0648\u0627\u0652 \u0642\u0650\u0628\u064e\u0644\u064e\u0643\u064e \u0645\u064f\u0647\u06e1\u0637\u0650\u0639\u0650\u064a\u0646\u064e","translation":"-Ey Peygamber!- Halk\u0131ndan olan bu m\u00fc\u015frikleri, senin etraf\u0131na s\u00fcr\u00fckleyerek seni yalanlamak i\u00e7in acele ettiren \u015fey nedir?","footnotes":null},{"id":"5412","sura":"70","aya":"37","arabic_text":"\u0639\u064e\u0646\u0650 \u0671\u0644\u06e1\u064a\u064e\u0645\u0650\u064a\u0646\u0650 \u0648\u064e\u0639\u064e\u0646\u0650 \u0671\u0644\u0634\u0651\u0650\u0645\u064e\u0627\u0644\u0650 \u0639\u0650\u0632\u0650\u064a\u0646\u064e","translation":"Sa\u011f\u0131ndan ve solundan, \u00e7epe\u00e7evre, b\u00f6l\u00fck b\u00f6l\u00fck seni ku\u015fatm\u0131\u015flar.","footnotes":null},{"id":"5413","sura":"70","aya":"38","arabic_text":"\u0623\u064e\u064a\u064e\u0637\u06e1\u0645\u064e\u0639\u064f \u0643\u064f\u0644\u0651\u064f \u0671\u0645\u06e1\u0631\u0650\u064a\u0655\u0656 \u0645\u0651\u0650\u0646\u06e1\u0647\u064f\u0645\u06e1 \u0623\u064e\u0646 \u064a\u064f\u062f\u06e1\u062e\u064e\u0644\u064e \u062c\u064e\u0646\u0651\u064e\u0629\u064e \u0646\u064e\u0639\u0650\u064a\u0645\u0656","translation":"Yoksa onlardan her biri k\u00e2fir olarak kald\u0131\u011f\u0131 halde Allah\u2019\u0131n onlar\u0131, i\u00e7inde bulunan kal\u0131c\u0131 nimetlerden faydalanaca\u011f\u0131, nimetlerle dolu cennetine yerle\u015ftirece\u011fini mi \u00fcmit ediyor?","footnotes":null},{"id":"5414","sura":"70","aya":"39","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627\u0653\u06d6 \u0625\u0650\u0646\u0651\u064e\u0627 \u062e\u064e\u0644\u064e\u0642\u06e1\u0646\u064e\u0670\u0647\u064f\u0645 \u0645\u0651\u0650\u0645\u0651\u064e\u0627 \u064a\u064e\u0639\u06e1\u0644\u064e\u0645\u064f\u0648\u0646\u064e","translation":"Durum hi\u00e7 de onlar\u0131n tasavvur etti\u011fi gibi de\u011fildir. Biz onlar\u0131 bildikleri o \u015feyden yaratt\u0131k. Do\u011frusu biz onlar\u0131 de\u011fersiz bir sudan yaratt\u0131k. Onlar, kendilerine ne bir fayda sa\u011flayabilecek, ne de bir zarar verebilecek kadar \u00e7ok zay\u0131ft\u0131rlar. \u00d6yleyse nas\u0131l oluyor da kibirleniyorlar?","footnotes":null},{"id":"5415","sura":"70","aya":"40","arabic_text":"\u0641\u064e\u0644\u064e\u0627\u0653 \u0623\u064f\u0642\u06e1\u0633\u0650\u0645\u064f \u0628\u0650\u0631\u064e\u0628\u0651\u0650 \u0671\u0644\u06e1\u0645\u064e\u0634\u064e\u0670\u0631\u0650\u0642\u0650 \u0648\u064e\u0671\u0644\u06e1\u0645\u064e\u063a\u064e\u0670\u0631\u0650\u0628\u0650 \u0625\u0650\u0646\u0651\u064e\u0627 \u0644\u064e\u0642\u064e\u0670\u062f\u0650\u0631\u064f\u0648\u0646\u064e","translation":"Do\u011funun, bat\u0131n\u0131n, G\u00fcne\u015f'in, Ay'\u0131n ve b\u00fct\u00fcn y\u0131ld\u0131zlar\u0131n Rabbi olan Y\u00fcce Allah, kendisi ad\u0131na yemin ederek demi\u015ftir ki; \u201c\u015e\u00fcphesiz bizim g\u00fcc\u00fcm\u00fcz yeter.''","footnotes":null},{"id":"5416","sura":"70","aya":"41","arabic_text":"\u0639\u064e\u0644\u064e\u0649\u0670\u0653 \u0623\u064e\u0646 \u0646\u0651\u064f\u0628\u064e\u062f\u0651\u0650\u0644\u064e \u062e\u064e\u064a\u06e1\u0631\u0657\u0627 \u0645\u0651\u0650\u0646\u06e1\u0647\u064f\u0645\u06e1 \u0648\u064e\u0645\u064e\u0627 \u0646\u064e\u062d\u06e1\u0646\u064f \u0628\u0650\u0645\u064e\u0633\u06e1\u0628\u064f\u0648\u0642\u0650\u064a\u0646\u064e","translation":"Onlar\u0131, Allah Te\u00e2l\u00e2'ya itaat eden ba\u015fka kimselerle de\u011fi\u015ftirmeye ve helak etmeye g\u00fcc\u00fcm\u00fcz yeter. Bunu yapmaktan aciz de de\u011filiz. \u0130stedi\u011fimiz zaman onlar\u0131 yok ederek ba\u015fkalar\u0131yla de\u011fi\u015ftirmekten yenik d\u00fc\u015fm\u00fc\u015f de de\u011filiz.","footnotes":null},{"id":"5417","sura":"70","aya":"42","arabic_text":"\u0641\u064e\u0630\u064e\u0631\u06e1\u0647\u064f\u0645\u06e1 \u064a\u064e\u062e\u064f\u0648\u0636\u064f\u0648\u0627\u0652 \u0648\u064e\u064a\u064e\u0644\u06e1\u0639\u064e\u0628\u064f\u0648\u0627\u0652 \u062d\u064e\u062a\u0651\u064e\u0649\u0670 \u064a\u064f\u0644\u064e\u0670\u0642\u064f\u0648\u0627\u0652 \u064a\u064e\u0648\u06e1\u0645\u064e\u0647\u064f\u0645\u064f \u0671\u0644\u0651\u064e\u0630\u0650\u064a \u064a\u064f\u0648\u0639\u064e\u062f\u064f\u0648\u0646\u064e","translation":"-Ey Peygamber!- Kur\u2019an\u2019da onlara vadedilen k\u0131yamet g\u00fcn\u00fcyle kar\u015f\u0131la\u015f\u0131ncaya kadar onlar\u0131 i\u00e7inde bulunduklar\u0131 bat\u0131l ve dalalette b\u0131rak, oyalans\u0131nlar ve d\u00fcnya hayat\u0131nda oynay\u0131p dursunlar.","footnotes":null},{"id":"5418","sura":"70","aya":"43","arabic_text":"\u064a\u064e\u0648\u06e1\u0645\u064e \u064a\u064e\u062e\u06e1\u0631\u064f\u062c\u064f\u0648\u0646\u064e \u0645\u0650\u0646\u064e \u0671\u0644\u06e1\u0623\u064e\u062c\u06e1\u062f\u064e\u0627\u062b\u0650 \u0633\u0650\u0631\u064e\u0627\u0639\u0657\u0627 \u0643\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u0645\u06e1 \u0625\u0650\u0644\u064e\u0649\u0670 \u0646\u064f\u0635\u064f\u0628\u0656 \u064a\u064f\u0648\u0641\u0650\u0636\u064f\u0648\u0646\u064e","translation":"O g\u00fcn onlar, sanki bir sanca\u011fa do\u011fru yar\u0131\u015f\u0131yorlarm\u0131\u015f gibi, kabirlerinden aceleyle ko\u015farak \u00e7\u0131karlar.","footnotes":null},{"id":"5419","sura":"70","aya":"44","arabic_text":"\u062e\u064e\u0670\u0634\u0650\u0639\u064e\u0629\u064b \u0623\u064e\u0628\u06e1\u0635\u064e\u0670\u0631\u064f\u0647\u064f\u0645\u06e1 \u062a\u064e\u0631\u06e1\u0647\u064e\u0642\u064f\u0647\u064f\u0645\u06e1 \u0630\u0650\u0644\u0651\u064e\u0629\u065e\u06da \u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0671\u0644\u06e1\u064a\u064e\u0648\u06e1\u0645\u064f \u0671\u0644\u0651\u064e\u0630\u0650\u064a \u0643\u064e\u0627\u0646\u064f\u0648\u0627\u0652 \u064a\u064f\u0648\u0639\u064e\u062f\u064f\u0648\u0646\u064e","translation":"Bak\u0131\u015flar\u0131 utan\u00e7 i\u00e7inde, onlar\u0131 zillet kaplam\u0131\u015f bir haldedirler. \u0130\u015fte, d\u00fcnyada kendilerine vadedilen ve umursamad\u0131klar\u0131 g\u00fcn, bu g\u00fcnd\u00fcr.","footnotes":null}]}