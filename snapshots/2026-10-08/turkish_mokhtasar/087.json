{"result":[{"id":"5949","sura":"87","aya":"1","arabic_text":"\u0633\u064e\u0628\u0651\u0650\u062d\u0650 \u0671\u0633\u06e1\u0645\u064e \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0671\u0644\u06e1\u0623\u064e\u0639\u06e1\u0644\u064e\u0649","translation":"B\u00fct\u00fcn yaratt\u0131klar\u0131ndan y\u00fcce olan Rabbini hat\u0131rlad\u0131\u011f\u0131n ve tazim etti\u011fin zaman O'nun ismini s\u00f6yleyerek tenzih et.","footnotes":null},{"id":"5950","sura":"87","aya":"2","arabic_text":"\u0671\u0644\u0651\u064e\u0630\u0650\u064a \u062e\u064e\u0644\u064e\u0642\u064e \u0641\u064e\u0633\u064e\u0648\u0651\u064e\u0649\u0670","translation":"\u0130nsan\u0131 tastamam ve dosdo\u011fru yaratand\u0131r.","footnotes":null},{"id":"5951","sura":"87","aya":"3","arabic_text":"\u0648\u064e\u0671\u0644\u0651\u064e\u0630\u0650\u064a \u0642\u064e\u062f\u0651\u064e\u0631\u064e \u0641\u064e\u0647\u064e\u062f\u064e\u0649\u0670","translation":"B\u00fct\u00fcn varl\u0131klar\u0131n cinslerini, t\u00fcrlerini ve \u00f6zelliklerini takdir eden, her varl\u0131\u011f\u0131 kendisi i\u00e7in m\u00fcnasip ve uygun olana y\u00f6nlendirendir.","footnotes":null},{"id":"5952","sura":"87","aya":"4","arabic_text":"\u0648\u064e\u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0653 \u0623\u064e\u062e\u06e1\u0631\u064e\u062c\u064e \u0671\u0644\u06e1\u0645\u064e\u0631\u06e1\u0639\u064e\u0649\u0670","translation":"Hayvanlar\u0131n\u0131z\u0131n otlad\u0131\u011f\u0131 otlar\u0131 topraktan ye\u015fertendir.","footnotes":null},{"id":"5953","sura":"87","aya":"5","arabic_text":"\u0641\u064e\u062c\u064e\u0639\u064e\u0644\u064e\u0647\u064f\u06e5 \u063a\u064f\u062b\u064e\u0627\u0653\u0621\u064b \u0623\u064e\u062d\u06e1\u0648\u064e\u0649\u0670","translation":"Diri ve yemye\u015fil olmas\u0131n\u0131n ard\u0131ndan onu siyaha d\u00f6n\u00fck kupkuru bir ota \u00e7evirmi\u015ftir.","footnotes":null},{"id":"5954","sura":"87","aya":"6","arabic_text":"\u0633\u064e\u0646\u064f\u0642\u06e1\u0631\u0650\u0626\u064f\u0643\u064e \u0641\u064e\u0644\u064e\u0627 \u062a\u064e\u0646\u0633\u064e\u0649\u0670\u0653","translation":"-Ey Peygamber!- Sana Kur\u2019an\u2019\u0131 okutaca\u011f\u0131z ve onu senin kalbinde toplayaca\u011f\u0131z ki, b\u00f6ylece onu unutmayacaks\u0131n. \u00d6yleyse Cebrail\u2019le okuyu\u015funda onu unutmamak i\u00e7in yapt\u0131\u011f\u0131n gibi yar\u0131\u015fma.","footnotes":null},{"id":"5955","sura":"87","aya":"7","arabic_text":"\u0625\u0650\u0644\u0651\u064e\u0627 \u0645\u064e\u0627 \u0634\u064e\u0627\u0653\u0621\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f\u06da \u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u064a\u064e\u0639\u06e1\u0644\u064e\u0645\u064f \u0671\u0644\u06e1\u062c\u064e\u0647\u06e1\u0631\u064e \u0648\u064e\u0645\u064e\u0627 \u064a\u064e\u062e\u06e1\u0641\u064e\u0649\u0670","translation":"Ancak bir hikmetten dolay\u0131, Allah\u2019\u0131n unutman\u0131 diledikleri bundan m\u00fcstesnad\u0131r. \u015e\u00fcphesiz Allah -Subhanehu ve Te\u00e2l\u00e2- a\u00e7\u0131ktan yap\u0131lan\u0131 da, gizleneni de bilir. Hi\u00e7bir \u015fey O'na gizli kalmaz.","footnotes":null},{"id":"5956","sura":"87","aya":"8","arabic_text":"\u0648\u064e\u0646\u064f\u064a\u064e\u0633\u0651\u0650\u0631\u064f\u0643\u064e \u0644\u0650\u0644\u06e1\u064a\u064f\u0633\u06e1\u0631\u064e\u0649\u0670","translation":"Allah\u2019\u0131n raz\u0131 oldu\u011fu ve cennete sokan amelleri senin i\u00e7in kolayla\u015ft\u0131raca\u011f\u0131z.","footnotes":null},{"id":"5957","sura":"87","aya":"9","arabic_text":"\u0641\u064e\u0630\u064e\u0643\u0651\u0650\u0631\u06e1 \u0625\u0650\u0646 \u0646\u0651\u064e\u0641\u064e\u0639\u064e\u062a\u0650 \u0671\u0644\u0630\u0651\u0650\u0643\u06e1\u0631\u064e\u0649\u0670","translation":"\u00d6yleyse insanlara Kur\u2019an\u2019dan sana vahyetti\u011fimiz \u00f6\u011f\u00fctler ver. Ve nasihat dinlemeye devam ettikleri s\u00fcrece onlara nasihat et.","footnotes":null},{"id":"5958","sura":"87","aya":"10","arabic_text":"\u0633\u064e\u064a\u064e\u0630\u0651\u064e\u0643\u0651\u064e\u0631\u064f \u0645\u064e\u0646 \u064a\u064e\u062e\u06e1\u0634\u064e\u0649\u0670","translation":"Allah'tan korkan kimseler senin verdi\u011fin nasihatten \u00f6\u011f\u00fct alacakt\u0131r. \u00c7\u00fcnk\u00fc \u00f6\u011f\u00fctlerden faydalanan onlard\u0131r.","footnotes":null},{"id":"5959","sura":"87","aya":"11","arabic_text":"\u0648\u064e\u064a\u064e\u062a\u064e\u062c\u064e\u0646\u0651\u064e\u0628\u064f\u0647\u064e\u0627 \u0671\u0644\u06e1\u0623\u064e\u0634\u06e1\u0642\u064e\u0649","translation":"K\u00e2fir kimse ise \u00f6\u011f\u00fct almaktan uzak durur ve ka\u00e7\u0131n\u0131r. \u00c7\u00fcnk\u00fc o, cehennem ate\u015fine girdi\u011fi i\u00e7in ahirette insanlar\u0131n en bedbaht\u0131d\u0131r.","footnotes":null},{"id":"5960","sura":"87","aya":"12","arabic_text":"\u0671\u0644\u0651\u064e\u0630\u0650\u064a \u064a\u064e\u0635\u06e1\u0644\u064e\u0649 \u0671\u0644\u0646\u0651\u064e\u0627\u0631\u064e \u0671\u0644\u06e1\u0643\u064f\u0628\u06e1\u0631\u064e\u0649\u0670","translation":"Ahirette b\u00fcy\u00fck bir ate\u015fe girerek sonsuza kadar onun s\u0131cakl\u0131\u011f\u0131n\u0131n \u0131zd\u0131rab\u0131n\u0131 ve ac\u0131s\u0131n\u0131 \u00e7eker.","footnotes":null},{"id":"5961","sura":"87","aya":"13","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0644\u064e\u0627 \u064a\u064e\u0645\u064f\u0648\u062a\u064f \u0641\u0650\u064a\u0647\u064e\u0627 \u0648\u064e\u0644\u064e\u0627 \u064a\u064e\u062d\u06e1\u064a\u064e\u0649\u0670","translation":"Sonra da sonsuza kadar cehennem ate\u015fine girer. \u00d6yle ki, orada ne \u00e7ekmekte oldu\u011fu azaptan dolay\u0131 rahata kavu\u015faca\u011f\u0131 \u015fekilde \u00f6l\u00fcr, ne de de\u011ferli, iyi ve g\u00fczel bir hayat ya\u015far.","footnotes":null},{"id":"5962","sura":"87","aya":"14","arabic_text":"\u0642\u064e\u062f\u06e1 \u0623\u064e\u0641\u06e1\u0644\u064e\u062d\u064e \u0645\u064e\u0646 \u062a\u064e\u0632\u064e\u0643\u0651\u064e\u0649\u0670","translation":"\u015eirkten ve g\u00fcnahlardan ar\u0131nan kimse ise kesinlikle istedi\u011fini kazanm\u0131\u015ft\u0131r.","footnotes":null},{"id":"5963","sura":"87","aya":"15","arabic_text":"\u0648\u064e\u0630\u064e\u0643\u064e\u0631\u064e \u0671\u0633\u06e1\u0645\u064e \u0631\u064e\u0628\u0651\u0650\u0647\u0650\u06e6 \u0641\u064e\u0635\u064e\u0644\u0651\u064e\u0649\u0670","translation":"Rabbini, dinin belirledi\u011fi zikir \u00e7e\u015fitleriyle zikretmi\u015f ve namaz\u0131 da eda edilmesi istenilen \u015fekliyle k\u0131lm\u0131\u015ft\u0131r.","footnotes":null},{"id":"5964","sura":"87","aya":"16","arabic_text":"\u0628\u064e\u0644\u06e1 \u062a\u064f\u0624\u06e1\u062b\u0650\u0631\u064f\u0648\u0646\u064e \u0671\u0644\u06e1\u062d\u064e\u064a\u064e\u0648\u0670\u0629\u064e \u0671\u0644\u062f\u0651\u064f\u0646\u06e1\u064a\u064e\u0627","translation":"Fakat siz, aralar\u0131nda \u00e7ok b\u00fcy\u00fck fark oldu\u011fu halde d\u00fcnya hayat\u0131n\u0131 \u00f6nceliyor ve ahirete tercih ediyorsunuz.","footnotes":null},{"id":"5965","sura":"87","aya":"17","arabic_text":"\u0648\u064e\u0671\u0644\u06e1\u0623\u0653\u062e\u0650\u0631\u064e\u0629\u064f \u062e\u064e\u064a\u06e1\u0631\u065e \u0648\u064e\u0623\u064e\u0628\u06e1\u0642\u064e\u0649\u0670\u0653","translation":"Oysa ahiret i\u00e7inde bulunan mal ve zevkler bak\u0131m\u0131ndan d\u00fcnyadan daha hay\u0131rl\u0131, daha \u00fcst\u00fcn ve s\u00fcreklidir. \u00c7\u00fcnk\u00fc i\u00e7inde bulunan nimetler asla t\u00fckenmez.","footnotes":null},{"id":"5966","sura":"87","aya":"18","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0647\u064e\u0670\u0630\u064e\u0627 \u0644\u064e\u0641\u0650\u064a \u0671\u0644\u0635\u0651\u064f\u062d\u064f\u0641\u0650 \u0671\u0644\u06e1\u0623\u064f\u0648\u0644\u064e\u0649\u0670","translation":"\u015e\u00fcphesiz size zikretti\u011fimiz bu emirler ve haberler, Kur'an'dan \u00f6nce indirilmi\u015f sahifelerde de bulunmaktad\u0131r.","footnotes":null},{"id":"5967","sura":"87","aya":"19","arabic_text":"\u0635\u064f\u062d\u064f\u0641\u0650 \u0625\u0650\u0628\u06e1\u0631\u064e\u0670\u0647\u0650\u064a\u0645\u064e \u0648\u064e\u0645\u064f\u0648\u0633\u064e\u0649\u0670","translation":"Onlar \u0130brahim\u2019e ve Musa -aleyhimesselam-'a indirilmi\u015f olan sahifelerdir.","footnotes":null}]}