{"result":[{"id":"6024","sura":"90","aya":"1","arabic_text":"\u0644\u064e\u0627\u0653 \u0623\u064f\u0642\u06e1\u0633\u0650\u0645\u064f \u0628\u0650\u0647\u064e\u0670\u0630\u064e\u0627 \u0671\u0644\u06e1\u0628\u064e\u0644\u064e\u062f\u0650","translation":"Y\u00fcce Allah, Mekke-i M\u00fckerreme'ye, o haram olan topraklara yemin etmi\u015ftir.","footnotes":null},{"id":"6025","sura":"90","aya":"2","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u062a\u064e \u062d\u0650\u0644\u0651\u064f\u06e2 \u0628\u0650\u0647\u064e\u0670\u0630\u064e\u0627 \u0671\u0644\u06e1\u0628\u064e\u0644\u064e\u062f\u0650","translation":"-Ey Peygamber!- Orada yapt\u0131klar\u0131 sebebiyle \u00f6ld\u00fcr\u00fclmeyi hak edenin \u00f6ld\u00fcr\u00fclmesi ve tutsak edilmeyi hak edenin tutsak edilmesi sana helaldir.","footnotes":null},{"id":"6026","sura":"90","aya":"3","arabic_text":"\u0648\u064e\u0648\u064e\u0627\u0644\u0650\u062f\u0656 \u0648\u064e\u0645\u064e\u0627 \u0648\u064e\u0644\u064e\u062f\u064e","translation":"Allah Te\u00e2l\u00e2, be\u015feriyetin babas\u0131na ve ondan \u00e7o\u011fal\u0131p \u00fcreyen \u00e7ocuklara da yemin etmi\u015ftir.","footnotes":null},{"id":"6027","sura":"90","aya":"4","arabic_text":"\u0644\u064e\u0642\u064e\u062f\u06e1 \u062e\u064e\u0644\u064e\u0642\u06e1\u0646\u064e\u0627 \u0671\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u064e \u0641\u0650\u064a \u0643\u064e\u0628\u064e\u062f\u064d","translation":"Do\u011frusu biz insan\u0131, d\u00fcnyada \u00e7ekti\u011fi zorluklar sebebiyle bir gayret ve me\u015fakkatin i\u00e7inde yaratt\u0131k.","footnotes":null},{"id":"6028","sura":"90","aya":"5","arabic_text":"\u0623\u064e\u064a\u064e\u062d\u06e1\u0633\u064e\u0628\u064f \u0623\u064e\u0646 \u0644\u0651\u064e\u0646 \u064a\u064e\u0642\u06e1\u062f\u0650\u0631\u064e \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u0650 \u0623\u064e\u062d\u064e\u062f\u065e","translation":"\u0130nsan; g\u00fcnah i\u015fledi\u011fi zaman hi\u00e7 kimsenin hatta onu yaratan Rabbinin bile kendisine g\u00fc\u00e7 yetiremeyece\u011fini ve ondan intikam alamayaca\u011f\u0131n\u0131 m\u0131 zannediyor?","footnotes":null},{"id":"6029","sura":"90","aya":"6","arabic_text":"\u064a\u064e\u0642\u064f\u0648\u0644\u064f \u0623\u064e\u0647\u06e1\u0644\u064e\u0643\u06e1\u062a\u064f \u0645\u064e\u0627\u0644\u0657\u0627 \u0644\u0651\u064f\u0628\u064e\u062f\u064b\u0627","translation":"\"Birbiri \u00fczerine y\u0131\u011f\u0131lm\u0131\u015f pek \u00e7ok mal harcad\u0131m'' der.","footnotes":null},{"id":"6030","sura":"90","aya":"7","arabic_text":"\u0623\u064e\u064a\u064e\u062d\u06e1\u0633\u064e\u0628\u064f \u0623\u064e\u0646 \u0644\u0651\u064e\u0645\u06e1 \u064a\u064e\u0631\u064e\u0647\u064f\u06e5\u0653 \u0623\u064e\u062d\u064e\u062f\u064c","translation":"Harcad\u0131\u011f\u0131 \u015feyle b\u00f6b\u00fcrlenen bu kimse, Allah\u2019\u0131n onu g\u00f6rmedi\u011fini ve mal\u0131n\u0131 nereden kazand\u0131\u011f\u0131n\u0131 ve onu nerede harcad\u0131\u011f\u0131n\u0131 sorup onu hesaba \u00e7ekmeyece\u011fini mi zannediyor?","footnotes":null},{"id":"6031","sura":"90","aya":"8","arabic_text":"\u0623\u064e\u0644\u064e\u0645\u06e1 \u0646\u064e\u062c\u06e1\u0639\u064e\u0644 \u0644\u0651\u064e\u0647\u064f\u06e5 \u0639\u064e\u064a\u06e1\u0646\u064e\u064a\u06e1\u0646\u0650","translation":"Biz, ona g\u00f6rebilece\u011fi iki g\u00f6z vermedik mi?","footnotes":null},{"id":"6032","sura":"90","aya":"9","arabic_text":"\u0648\u064e\u0644\u0650\u0633\u064e\u0627\u0646\u0657\u0627 \u0648\u064e\u0634\u064e\u0641\u064e\u062a\u064e\u064a\u06e1\u0646\u0650","translation":"Konu\u015fabilece\u011fi bir dil ve iki dudak vermedik mi?","footnotes":null},{"id":"6033","sura":"90","aya":"10","arabic_text":"\u0648\u064e\u0647\u064e\u062f\u064e\u064a\u06e1\u0646\u064e\u0670\u0647\u064f \u0671\u0644\u0646\u0651\u064e\u062c\u06e1\u062f\u064e\u064a\u06e1\u0646\u0650","translation":"Ona, hak yolu ve bat\u0131l yolu \u00f6\u011fretmedik mi?","footnotes":null},{"id":"6034","sura":"90","aya":"11","arabic_text":"\u0641\u064e\u0644\u064e\u0627 \u0671\u0642\u06e1\u062a\u064e\u062d\u064e\u0645\u064e \u0671\u0644\u06e1\u0639\u064e\u0642\u064e\u0628\u064e\u0629\u064e","translation":"Kendisini cennetten ay\u0131ran engeli a\u015fmas\u0131 gerekir. B\u00f6ylece o da onu a\u015far ve ge\u00e7er.","footnotes":null},{"id":"6035","sura":"90","aya":"12","arabic_text":"\u0648\u064e\u0645\u064e\u0627\u0653 \u0623\u064e\u062f\u06e1\u0631\u064e\u0649\u0670\u0643\u064e \u0645\u064e\u0627 \u0671\u0644\u06e1\u0639\u064e\u0642\u064e\u0628\u064e\u0629\u064f","translation":"-Ey Peygamber!- cennete girmek i\u00e7in a\u015faca\u011f\u0131n engelin ne oldu\u011funu sana ne \u00f6\u011fretti?","footnotes":null},{"id":"6036","sura":"90","aya":"13","arabic_text":"\u0641\u064e\u0643\u0651\u064f \u0631\u064e\u0642\u064e\u0628\u064e\u0629\u064d","translation":"O, erkek veya di\u015fi bir k\u00f6le azat etmektir.","footnotes":null},{"id":"6037","sura":"90","aya":"14","arabic_text":"\u0623\u064e\u0648\u06e1 \u0625\u0650\u0637\u06e1\u0639\u064e\u0670\u0645\u065e \u0641\u0650\u064a \u064a\u064e\u0648\u06e1\u0645\u0656 \u0630\u0650\u064a \u0645\u064e\u0633\u06e1\u063a\u064e\u0628\u064e\u0629\u0656","translation":"Veya yiyece\u011fin nadir bulundu\u011fu a\u00e7l\u0131k zaman\u0131nda yemek yedirmektir.","footnotes":null},{"id":"6038","sura":"90","aya":"15","arabic_text":"\u064a\u064e\u062a\u0650\u064a\u0645\u0657\u0627 \u0630\u064e\u0627 \u0645\u064e\u0642\u06e1\u0631\u064e\u0628\u064e\u0629\u064d","translation":"Onunla akrabal\u0131k ba\u011f\u0131 bulunan babas\u0131n\u0131 kaybetmi\u015f bir \u00e7ocu\u011fa.","footnotes":null},{"id":"6039","sura":"90","aya":"16","arabic_text":"\u0623\u064e\u0648\u06e1 \u0645\u0650\u0633\u06e1\u0643\u0650\u064a\u0646\u0657\u0627 \u0630\u064e\u0627 \u0645\u064e\u062a\u06e1\u0631\u064e\u0628\u064e\u0629\u0656","translation":"Veya hi\u00e7bir \u015feye sahip olmayan bir fakiri.","footnotes":null},{"id":"6040","sura":"90","aya":"17","arabic_text":"\u062b\u064f\u0645\u06