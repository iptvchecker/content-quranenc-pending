23\u064e\u0644\u064e\u0645\u06e1 \u064a\u064e\u062c\u0650\u062f\u06e1\u0643\u064e \u064a\u064e\u062a\u0650\u064a\u0645\u0657\u0627 \u0641\u064e\u0640\u0654\u064e\u0627\u0648\u064e\u0649\u0670","translation":"Seni, k\u00fc\u00e7\u00fckken baban \u00f6lm\u00fc\u015f bir halde buldu ve \u00f6nce sana merhamet eden deden Abd\u00fclmuttalib\u2019i, ard\u0131ndan amcan Ebu Talib\u2019i sana s\u0131\u011f\u0131nak k\u0131ld\u0131.","footnotes":null},{"id":"6086","sura":"93","aya":"7","arabic_text":"\u0648\u064e\u0648\u064e\u062c\u064e\u062f\u064e\u0643\u064e \u0636\u064e\u0627\u0653\u0644\u0651\u0657\u0627 \u0641\u064e\u0647\u064e\u062f\u064e\u0649\u0670","translation":"Seni, kitab\u0131n ve iman\u0131n ne oldu\u011funu bilmez bir halde buldu da, sana bunlardan bilmediklerini \u00f6\u011fretti.","footnotes":null},{"id":"6087","sura":"93","aya":"8","arabic_text":"\u0648\u064e\u0648\u064e\u062c\u064e\u062f\u064e\u0643\u064e \u0639\u064e\u0627\u0653\u0626\u0650\u0644\u0657\u0627 \u0641\u064e\u0623\u064e\u063a\u06e1\u0646\u064e\u0649\u0670","translation":"Seni fakir bir halde buldu ve seni zengin k\u0131ld\u0131.","footnotes":null},{"id":"6088","sura":"93","aya":"9","arabic_text":"\u0641\u064e\u0623\u064e\u0645\u0651\u064e\u0627 \u0671\u0644\u06e1\u064a\u064e\u062a\u0650\u064a\u0645\u064e \u0641\u064e\u0644\u064e\u0627 \u062a\u064e\u0642\u06e1\u0647\u064e\u0631\u06e1","translation":"K\u00fc\u00e7\u00fck ya\u015fta babas\u0131n\u0131 kaybetmi\u015f kimselere k\u00f6t\u00fc muamele etme ve onlar\u0131 k\u00fc\u00e7\u00fcmseme.","footnotes":null},{"id":"6089","sura":"93","aya":"10","arabic_text":"\u0648\u064e\u0623\u064e\u0645\u0651\u064e\u0627 \u0671\u0644\u0633\u0651\u064e\u0627\u0653\u0626\u0650\u0644\u064e \u0641\u064e\u0644\u064e\u0627 \u062a\u064e\u0646\u06e1\u0647\u064e\u0631\u06e1","translation":"\u0130htiya\u00e7 sahibi olan dilenciyi de azarlama.","footnotes":null},{"id":"6090","sura":"93","aya":"11","arabic_text":"\u0648\u064e\u0623\u064e\u0645\u0651\u064e\u0627 \u0628