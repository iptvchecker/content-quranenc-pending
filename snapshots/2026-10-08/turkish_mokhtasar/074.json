31ld\u0131\u011f\u0131, servetinin \u00e7oklu\u011fu sebebiyle herhangi bir yolculuk i\u00e7in yan\u0131ndan ayr\u0131lmayan, s\u00fcrekli yan\u0131nda bulunan erkek evlatlar verdim.","footnotes":null},{"id":"5509","sura":"74","aya":"14","arabic_text":"\u0648\u064e\u0645\u064e\u0647\u0651\u064e\u062f\u062a\u0651\u064f \u0644\u064e\u0647\u064f\u06e5 \u062a\u064e\u0645\u06e1\u0647\u0650\u064a\u062f\u0657\u0627","translation":"Ge\u00e7imini, r\u0131zk\u0131n\u0131 ve evlatlar\u0131n\u0131 art\u0131rd\u0131k\u00e7a art\u0131rd\u0131m.","footnotes":null},{"id":"5510","sura":"74","aya":"15","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u064a\u064e\u0637\u06e1\u0645\u064e\u0639\u064f \u0623\u064e\u0646\u06e1 \u0623\u064e\u0632\u0650\u064a\u062f\u064e","translation":"B\u00fct\u00fcn bunlar\u0131 verdikten sonra bana kar\u015f\u0131 ink\u00e2rc\u0131l\u0131\u011f\u0131yla beraber bir de daha da art\u0131rmam\u0131 bekliyor.","footnotes":null},{"id":"5511","sura":"74","aya":"16","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627\u0653\u06d6 \u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0643\u064e\u0627\u0646\u064e \u0644\u0650\u0623\u0653\u064a\u064e\u0670\u062a\u0650\u0646\u064e\u0627 \u0639\u064e\u0646\u0650\u064a\u062f\u0657\u0627","translation":"Durum hi\u00e7 de tasavvur etti\u011fi gibi de\u011fildir. \u015e\u00fcphesiz o, resul\u00fcm\u00fcze indirilmi\u015f ayetlerimizi yalanlayarak onlara kar\u015f\u0131 inat\u00e7\u0131l\u0131k ediyordu.","footnotes":null},{"id":"5512","sura":"74","aya":"17","arabic_text":"\u0633\u064e\u0623\u064f\u0631\u06e1\u0647\u0650\u0642\u064f\u0647\u064f\u06e5 \u0635\u064e\u0639\u064f\u0648\u062f\u064b\u0627","translation":"Onu dayanamayaca\u011f\u0131 azap dolu bir s\u0131k\u0131nt\u0131ya sokaca\u011f\u0131m.","footnotes":null},{"id":"5513","sura":"74","aya":"18","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0641\u064e\u0643\u0651\u064e\u0631\u064e \u0648\u064e\u0642\u064e\u062f\u0651\u064e\u0631\u064e","translation":"O nimetler ile nimetlendirdi\u011fim bu k\u00e2fir, onu (Kur'an'\u0131) ge\u00e7ersiz k\u0131lmak i\u00e7in Kur\u2019an hakk\u0131nda s\u00f6yledi\u011fi s\u00f6z\u00fc d\u00fc\u015f\u00fcnd\u00fc, sonra da bunu kendince takdir etti.","footnotes":null},{"id":"5514","sura":"74","aya":"19","arabic_text":"\u0641\u064e\u0642\u064f\u062a\u0650\u0644\u064e \u0643\u064e\u064a\u06e1\u0641\u064e \u0642\u064e\u062f\u0651\u064e\u0631\u064e","translation":"Hay lanet olas\u0131 ve geberesice nas\u0131l da \u00f6l\u00e7\u00fcp bi\u00e7ti!","footnotes":null},{"id":"5515","sura":"74","aya":"20","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0642\u064f\u062a\u0650\u0644\u064e \u0643\u064e\u064a\u06e1\u0641\u064e \u0642\u064e\u062f\u0651\u064e\u0631\u064e","translation":"O lanet olas\u0131 ve geberesice, sonra yine nas\u0131l da \u00f6l\u00e7\u00fcp bi\u00e7ti!","footnotes":null},{"id":"5516","sura":"74","aya":"21","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0646\u064e\u0638\u064e\u0631\u064e","translation":"Sonras\u0131nda bir daha bakt\u0131 ve s\u00f6yledi\u011fi s\u00f6zleri tekrar d\u00fc\u015f\u00fcnd\u00fc.","footnotes":null},{"id":"5517","sura":"74","aya":"22","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0639\u064e\u0628\u064e\u0633\u064e \u0648\u064e\u0628\u064e\u0633\u064e\u0631\u064e","translation":"Sonra da Kur\u2019an\u2019da aleyhine konu\u015fabilece\u011fi bir \u015fey bulamay\u0131nca ka\u015flar\u0131n\u0131 \u00e7atarak surat\u0131n\u0131 ek\u015fitti.","footnotes":null},{"id":"5518","sura":"74","aya":"23","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0623\u064e\u062f\u06e1\u0628\u064e\u0631\u064e \u0648\u064e\u0671\u0633\u06e1\u062a\u064e\u0643\u06e1\u0628\u064e\u0631\u064e","translation":"Sonra iman etmekten y\u00fcz \u00e7evirdi ve Peygamber -sallallahu aleyhi ve sellem-'e ittiba etmeye kibirlendi.","footnotes":null},{"id":"5519","sura":"74","aya":"24","arabic_text":"\u0641\u064e\u0642\u064e\u0627\u0644\u064e \u0625\u0650\u0646\u06e1 \u0647\u064e\u0670\u0630\u064e\u0627\u0653 \u0625\u0650\u0644\u0651\u064e\u0627 \u0633\u0650\u062d\u06e1\u0631\u065e \u064a\u064f\u0624\u06e1\u062b\u064e\u0631\u064f","translation":"Ve \u015f\u00f6yle dedi: \"Muhammed\u2019in getirmi\u015f oldu\u011fu bu \u015fey Allah\u2019\u0131n kelam\u0131 de\u011fildir. Bilakis o, ba\u015fkalar\u0131ndan aktard\u0131\u011f\u0131 bir sihirdir.''","footnotes":null},{"id":"5520","sura":"74","aya":"25","arabic_text":"\u0625\u0650\u0646\u06e1 \u0647\u064e\u0670\u0630\u064e\u0627\u0653 \u0625\u0650\u0644\u0651\u064e\u0627 \u0642\u064e\u0648\u06e1\u0644\u064f \u0671\u0644\u06e1\u0628\u064e\u0634\u064e\u0631\u0650","translation":"\"Bu Allah\u2019\u0131n s\u00f6z\u00fc de\u011fildir, bilakis insan s\u00f6z\u00fcd\u00fcr.\"","footnotes":null},{"id":"5521","sura":"74","aya":"26","arabic_text":"\u0633\u064e\u0623\u064f\u0635\u06e1\u0644\u0650\u064a\u0647\u0650 \u0633\u064e\u0642\u064e\u0631\u064e","translation":"Ben bu k\u00e2firi, s\u0131cakl\u0131\u011f\u0131n\u0131n \u0131zd\u0131rab\u0131n\u0131 \u00e7ekece\u011fi cehennem ate\u015finin tabakalar\u0131ndan bir tabaka olan Sekar\u2019a sokaca\u011f\u0131m.","footnotes":null},{"id":"5522","sura":"74","aya":"27","arabic_text":"\u0648\u064e\u0645\u064e\u0627\u0653 \u0623\u064e\u062f\u06e1\u0631\u064e\u0649\u0670\u0643\u064e \u0645\u064e\u0627 \u0633\u064e\u0642\u064e\u0631\u064f","translation":"-Ey Muhammed!- Sekar'\u0131n ne oldu\u011fu hakk\u0131nda sen ne biliyorsun?","footnotes":null},{"id":"5523","sura":"74","aya":"28","arabic_text":"\u0644\u064e\u0627 \u062a\u064f\u0628\u06e1\u0642\u0650\u064a \u0648\u064e\u0644\u064e\u0627 \u062a\u064e\u0630\u064e\u0631\u064f","translation":"Bu ate\u015f, i\u00e7inde azap g\u00f6ren kimseden geride hi\u00e7bir \u015fey kalmayana kadar onu peri\u015fan eder ve asla onun pe\u015fini b\u0131rakmaz. Eski haline geri d\u00f6nd\u00fckten sonra tekrar onu peri\u015fan eder ve bu hal arka arkaya devam eder.","footnotes":null},{"id":"5524","sura":"74","aya":"29","arabic_text":"\u0644\u064e\u0648\u0651\u064e\u0627\u062d\u064e\u0629\u065e \u0644\u0651\u0650\u0644\u06e1\u0628\u064e\u0634\u064e\u0631\u0650","translation":"Derileri \u00e7ok g\u00fc\u00e7l\u00fc bir \u015fekilde yakar ve de\u011fi\u015ftirir.","footnotes":null},{"id":"5525","sura":"74","aya":"30","arabic_text":"\u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u064e\u0627 \u062a\u0650\u0633\u06e1\u0639\u064e\u0629\u064e \u0639\u064e\u0634\u064e\u0631\u064e","translation":"\u00dczerinde oran\u0131n muhaf\u0131zlar\u0131 olan on dokuz melek vard\u0131r.","footnotes":null},{"id":"5526","sura":"74","aya":"31","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u062c\u064e\u0639\u064e\u0644\u06e1\u0646\u064e\u0627\u0653 \u0623\u064e\u0635\u06e1\u062d\u064e\u0670\u0628\u064e \u0671\u0644\u0646\u0651\u064e\u0627\u0631\u0650 \u0625\u0650\u0644\u0651\u064e\u0627 \u0645\u064e\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064e\u0629\u0657\u06d6 \u0648\u064e\u0645\u064e\u0627 \u062c\u064e\u0639\u064e\u0644\u06e1\u0646\u064e\u0627 \u0639\u0650\u062f\u0651\u064e\u062a\u064e\u0647\u064f\u0645\u06e1 \u0625\u0650\u0644\u0651\u064e\u0627 \u0641\u0650\u062a\u06e1\u0646\u064e\u0629\u0657 \u0644\u0651\u0650\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0643\u064e\u0641\u064e\u0631\u064f\u0648\u0627\u0652 \u0644\u0650\u064a\u064e\u0633\u06e1\u062a\u064e\u064a\u06e1\u0642\u0650\u0646\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0623\u064f\u0648\u062a\u064f\u0648\u0627\u0652 \u0671\u0644\u06e1\u0643\u0650\u062a\u064e\u0670\u0628\u064e \u0648\u064e\u064a\u064e\u0632\u06e1\u062f\u064e\u0627\u062f\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0653\u0627\u0652 \u0625\u0650\u064a\u0645\u064e\u0670\u0646\u0657\u0627 \u0648\u064e\u0644\u064e\u0627 \u064a\u064e\u0631\u06e1\u062a\u064e\u0627\u0628\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0623\u064f\u0648\u062a\u064f\u0648\u0627\u0652 \u0671\u0644\u06e1\u0643\u0650\u062a\u064e\u0670\u0628\u064e \u0648\u064e\u0671\u0644\u06e1\u0645\u064f\u0624\u06e1\u0645\u0650\u0646\u064f\u0648\u0646\u064e \u0648\u064e\u0644\u0650\u064a\u064e\u0642\u064f\u0648\u0644\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0641\u0650\u064a \u0642\u064f\u0644\u064f\u0648\u0628\u0650\u0647\u0650\u0645 \u0645\u0651\u064e\u0631\u064e\u0636\u065e \u0648\u064e\u0671\u0644\u06e1\u0643\u064e\u0670\u0641\u0650\u0631\u064f\u0648\u0646\u064e \u0645\u064e\u0627\u0630\u064e\u0627\u0653 \u0623\u064e\u0631\u064e\u0627\u062f\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0628\u0650\u0647\u064e\u0670\u0630\u064e\u0627 \u0645\u064e\u062b\u064e\u0644\u0657\u0627\u06da \u0643\u064e\u0630\u064e\u0670\u0644\u0650\u0643\u064e \u064a\u064f\u0636\u0650\u0644\u0651\u064f \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0645\u064e\u0646 \u064a\u064e\u0634\u064e\u0627\u0653\u0621\u064f \u0648\u064e\u064a\u064e\u0647\u06e1\u062f\u0650\u064a \u0645\u064e\u0646 \u064a\u064e\u0634\u064e\u0627\u0653\u0621\u064f\u06da \u0648\u064e\u0645\u064e\u0627 \u064a\u064e\u0639\u06e1\u0644\u064e\u0645\u064f \u062c\u064f\u0646\u064f\u0648\u062f\u064e \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0647\u064f\u0648\u064e\u06da \u0648\u064e\u0645\u064e\u0627 \u0647\u0650\u064a\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0630\u0650\u0643\u06e1\u0631\u064e\u0649\u0670 \u0644\u0650\u0644\u06e1\u0628\u064e\u0634\u064e\u0631\u0650","translation":"Biz, Cehennem'in muhaf\u0131zlar\u0131n\u0131 yaln\u0131zca meleklerden k\u0131ld\u0131k. \u00c7\u00fcnk\u00fc be\u015ferin buna g\u00fcc\u00fc yetmezdi. Biz, bu say\u0131y\u0131 Allah\u2019a kar\u015f\u0131 ink\u00e2rc\u0131 olanlar i\u00e7in bir imtihan vesilesi k\u0131ld\u0131k. Onlar da b\u00f6ylece s\u00f6ylemi\u015f olduklar\u0131 s\u00f6zleri dile getirdiler ve azaplar\u0131 kat kat art\u0131r\u0131ld\u0131. Ayn\u0131 zamanda bu imtihan\u0131, kendilerine Tevrat verilen Yahudiler'in ve kendilerine \u0130ncil verilen Hristiyanlar'\u0131n kitaplar\u0131nda bulunanlar\u0131 tasdik eden Kur\u2019an indi\u011finde, \u015f\u00fcphe duymadan iman etmeleri, ehli kitap onlara muvafakat g\u00f6sterdi\u011finde M\u00fcminler'in iman\u0131n\u0131n artmas\u0131, iman etmekte teredd\u00fct edenlerin ve k\u00e2firlerin; \"Allah, bu garip say\u0131yla neyi murat etti?\u201d diye sormas\u0131 i\u00e7in bir vesile k\u0131ld\u0131k. Bu say\u0131s\u0131 ink\u00e2r eden ki\u015finin sapt\u0131r\u0131lmas\u0131, bunu tasdik edene hidayet olunmas\u0131 Y\u00fcce Allah\u2019\u0131n sap\u0131tmas\u0131n\u0131 diledi\u011fi kimseyi sapt\u0131rmas\u0131 ve hidayete ermeyi diledi\u011fi kimseye de hidayet etmesi bab\u0131ndand\u0131r. Say\u0131lar\u0131n\u0131n \u00e7oklu\u011fu sebebiyle, Allah'\u0131n ordusunu Allah -Subh\u00e2neh\u00fb ve Te\u00e2l\u00e2-'dan ba\u015fkas\u0131 bilemez. Cehennem, insano\u011flunun Allah -Subh\u00e2neh\u00fb ve Te\u00e2l\u00e2-\u2019n\u0131n azametini \u00f6\u011frendi\u011fi bir hat\u0131rlatmadan ba\u015fka bir \u015fey de\u011fildir.","footnotes":null},{"id":"5527","sura":"74","aya":"32","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627 \u0648\u064e\u0671\u0644\u06e1\u0642\u064e\u0645\u064e\u0631\u0650","translation":"Hay\u0131r durum baz\u0131 m\u00fc\u015friklerin iddia etti\u011fi gibi de\u011fildir. Zira onlar baz\u0131 arkada\u015flar\u0131n\u0131n cehennemdeki g\u00f6revli meleklere \u00fcst\u00fcn geleceklerini ileri s\u00fcrm\u00fc\u015flerdir. Ard\u0131ndan Y\u00fcce Allah, Ay\u2019a yemin etmi\u015ftir.","footnotes":null},{"id":"5528","sura":"74","aya":"33","arabic_text":"\u0648\u064e\u0671\u0644\u0651\u064e\u064a\u06e1\u0644\u0650 \u0625\u0650\u0630\u06e1 \u0623\u064e\u062f\u06e1\u0628\u064e\u0631\u064e","translation":"Ve d\u00f6n\u00fcp geldi\u011fi zaman geceye yemin etmi\u015ftir.","footnotes":null},{"id":"5529","sura":"74","aya":"34","arabic_text":"\u0648\u064e\u0671\u0644\u0635\u0651\u064f\u0628\u06e1\u062d\u0650 \u0625\u0650\u0630\u064e\u0627\u0653 \u0623\u064e\u0633\u06e1\u0641\u064e\u0631\u064e","translation":"Ayd\u0131nlatt\u0131\u011f\u0131 zaman sabah vaktine yemin etmi\u015ftir.","footnotes":null},{"id":"5530","sura":"74","aya":"35","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064e\u0627 \u0644\u064e\u0625\u0650\u062d\u06e1\u062f\u064e\u0649 \u0671\u0644\u06e1\u0643\u064f\u0628\u064e\u0631\u0650","translation":"\u015e\u00fcphesiz cehennem ate\u015fi b\u00fcy\u00fck belalardan biridir.","footnotes":null},{"id":"5531","sura":"74","aya":"36","arabic_text":"\u0646\u064e\u0630\u0650\u064a\u0631\u0657\u0627 \u0644\u0651\u0650\u0644\u06e1\u0628\u064e\u0634\u064e\u0631\u0650","translation":"\u0130nsanlar i\u00e7in korkutucu ve tehdit edicidir.","footnotes":null},{"id":"5532","sura":"74","aya":"37","arabic_text":"\u0644\u0650\u0645\u064e\u0646 \u0634\u064e\u0627\u0653\u0621\u064e \u0645\u0650\u0646\u0643\u064f\u0645\u06e1 \u0623\u064e\u0646 \u064a\u064e\u062a\u064e\u0642\u064e\u062f\u0651\u064e\u0645\u064e \u0623\u064e\u0648\u06e1 \u064a\u064e\u062a\u064e\u0623\u064e\u062e\u0651\u064e\u0631\u064e","translation":"-Ey insanlar!- \u0130\u00e7inizden Allah\u2019a iman edip, salih amel i\u015fleyerek \u00f6ne ge\u00e7meyi veya k\u00fcf\u00fcr ve g\u00fcnahlarla geri kalmay\u0131 dileyen kimseler i\u00e7in.","footnotes":null},{"id":"5533","sura":"74","aya":"38","arabic_text":"\u0643\u064f\u0644\u0651\u064f \u0646\u064e\u0641\u06e1\u0633\u0650\u06ed \u0628\u0650\u0645\u064e\u0627 \u0643\u064e\u0633\u064e\u0628\u064e\u062a\u06e1 \u0631\u064e\u0647\u0650\u064a\u0646\u064e\u0629\u064c","translation":"Her bir kimse yapt\u0131\u011f\u0131 amelleriyle al\u0131konulacakt\u0131r. Amelleri onu helak edecek ya da onu helak olmaktan kurtaracak ve koruyacakt\u0131r.","footnotes":null},{"id":"5534","sura":"74","aya":"39","arabic_text":"\u0625\u0650\u0644\u0651\u064e\u0627\u0653 \u0623\u064e\u0635\u06e1\u062d\u064e\u0670\u0628\u064e \u0671\u0644\u06e1\u064a\u064e\u0645\u0650\u064a\u0646\u0650","translation":"Ancak M\u00fcminler b\u00f6yle de\u011fildirler. Do\u011frusu onlar g\u00fcnahlar\u0131ndan \u00f6t\u00fcr\u00fc sorumlu tutulmayacak, bilakis sahip olduklar\u0131 salih ameller sebebiyle o g\u00fcnahlar\u0131 ba\u011f\u0131\u015flanacakt\u0131r.","footnotes":null},{"id":"5535","sura":"74","aya":"40","arabic_text":"\u0641\u0650\u064a \u062c\u064e\u0646\u0651\u064e\u0670\u062a\u0656 \u064a\u064e\u062a\u064e\u0633\u064e\u0627\u0653\u0621\u064e\u0644\u064f\u0648\u0646\u064e","translation":"Onlar k\u0131yamet g\u00fcn\u00fc cennetler i\u00e7inde birbirlerini soracaklar.","footnotes":null},{"id":"5536","sura":"74","aya":"41","arabic_text":"\u0639\u064e\u0646\u0650 \u0671\u0644\u06e1\u0645\u064f\u062c\u06e1\u0631\u0650\u0645\u0650\u064a\u0646\u064e","translation":"\u0130\u015fledikleri g\u00fcnahlar y\u00fcz\u00fcnden kendilerini helak etmi\u015f olan k\u00e2firlere \u015f\u00f6yle sorarlar:","footnotes":null},{"id":"5537","sura":"74","aya":"42","arabic_text":"\u0645\u064e\u0627 \u0633\u064e\u0644\u064e\u0643\u064e\u0643\u064f\u0645\u06e1 \u0641\u0650\u064a \u0633\u064e\u0642\u064e\u0631\u064e","translation":"Onlara: \"Sizi cehenneme sokan \u015fey neydi?\" derler.","footnotes":null},{"id":"5538","sura":"74","aya":"43","arabic_text":"\u0642\u064e\u0627\u0644\u064f\u0648\u0627\u0652 \u0644\u064e\u0645\u06e1 \u0646\u064e\u0643\u064f \u0645\u0650\u0646\u064e \u0671\u0644\u06e1\u0645\u064f\u0635\u064e\u0644\u0651\u0650\u064a\u0646\u064e","translation":"K\u00e2firler de onlara cevap olarak \u015f\u00f6yle derler: \"Biz, d\u00fcnya hayat\u0131nda farz olan namaz\u0131 k\u0131lan kimseler de\u011fildik.\"","footnotes":null},{"id":"5539","sura":"74","aya":"44","arabic_text":"\u0648\u064e\u0644\u064e\u0645\u06e1 \u0646\u064e\u0643\u064f \u0646\u064f\u0637\u06e1\u0639\u0650\u0645\u064f \u0671\u0644\u06e1\u0645\u0650\u0633\u06e1\u0643\u0650\u064a\u0646\u064e","translation":"\u201cVe Allah\u2019\u0131n bize vermi\u015f oldu\u011fu yemeklerin bir b\u00f6l\u00fcm\u00fcyle fakirleri de doyurmuyorduk.''","footnotes":null},{"id":"5540","sura":"74","aya":"45","arabic_text":"\u0648\u064e\u0643\u064f\u0646\u0651\u064e\u0627 \u0646\u064e\u062e\u064f\u0648\u0636\u064f \u0645\u064e\u0639\u064e \u0671\u0644\u06e1\u062e\u064e\u0627\u0653\u0626\u0650\u0636\u0650\u064a\u0646\u064e","translation":"\u201cBizler, gittikleri her yerde bat\u0131l ehli insanlarla beraberdik. Sapk\u0131n ve azg\u0131n kimselerle konu\u015fuyorduk.''","footnotes":null},{"id":"5541","sura":"74","aya":"46","arabic_text":"\u0648\u064e\u0643\u064f\u0646\u0651\u064e\u0627 \u0646\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064f \u0628\u0650\u064a\u064e\u0648\u06e1\u0645\u0650 \u0671\u0644\u062f\u0651\u0650\u064a\u0646\u0650","translation":"\u201cHesap g\u00fcn\u00fcn\u00fc de yalanl\u0131yorduk.''","footnotes":null},{"id":"5542","sura":"74","aya":"47","arabic_text":"\u062d\u064e\u062a\u0651\u064e\u0649\u0670\u0653 \u0623\u064e\u062a\u064e\u0649\u0670\u0646\u064e\u0627 \u0671\u0644\u06e1\u064a\u064e\u0642\u0650\u064a\u0646\u064f","translation":"\u201c\u00d6l\u00fcm bize gelip \u00e7at\u0131ncaya dek yalanlamaya devam ettik.''","footnotes":null},{"id":"5543","sura":"74","aya":"48","arabic_text":"\u0641\u064e\u0645\u064e\u0627 \u062a\u064e\u0646\u0641\u064e\u0639\u064f\u0647\u064f\u0645\u06e1 \u0634\u064e\u0641\u064e\u0670\u0639\u064e\u0629\u064f \u0671\u0644\u0634\u0651\u064e\u0670\u0641\u0650\u0639\u0650\u064a\u0646\u064e","translation":"K\u0131yamet g\u00fcn\u00fc meleklerden, peygamberlerden ve salih kimselerden olan \u015fefaat\u00e7ilerin arac\u0131l\u0131klar\u0131 onlara bir fayda vermez. \u00c7\u00fcnk\u00fc \u015fefaatin kabul edilme \u015fartlar\u0131ndan biri de kendisine \u015fefaat edilen kimseden raz\u0131 olunmas\u0131d\u0131r.","footnotes":null},{"id":"5544","sura":"74","aya":"49","arabic_text":"\u0641\u064e\u0645\u064e\u0627 \u0644\u064e\u0647\u064f\u0645\u06e1 \u0639\u064e\u0646\u0650 \u0671\u0644\u062a\u0651\u064e\u0630\u06e1\u0643\u0650\u0631\u064e\u0629\u0650 \u0645\u064f\u0639\u06e1\u0631\u0650\u0636\u0650\u064a\u0646\u064e","translation":"Bu m\u00fc\u015friklerin Kur'an'dan y\u00fcz \u00e7evirmelerine sebep olan nedir?","footnotes":null},{"id":"5545","sura":"74","aya":"50","arabic_text":"\u0643\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u0645\u06e1 \u062d\u064f\u0645\u064f\u0631\u065e \u0645\u0651\u064f\u0633\u06e1\u062a\u064e\u0646\u0641\u0650\u0631\u064e\u0629\u065e","translation":"Onlar, Kur\u2019an\u2019dan y\u00fcz \u00e7evirmelerinde ve ondan ka\u00e7malar\u0131nda sanki s\u00fcratle ka\u00e7an vah\u015fi e\u015fekler gibidirler.","footnotes":null},{"id":"5546","sura":"74","aya":"51","arabic_text":"\u0641\u064e\u0631\u0651\u064e\u062a\u06e1 \u0645\u0650\u0646 \u0642\u064e\u0633\u06e1\u0648\u064e\u0631\u064e\u0629\u0650\u06ed","translation":"Aslandan korkarak ka\u00e7an.","footnotes":null},{"id":"5547","sura":"74","aya":"52","arabic_text":"\u0628\u064e\u0644\u06e1 \u064a\u064f\u0631\u0650\u064a\u062f\u064f \u0643\u064f\u0644\u0651\u064f \u0671\u0645\u06e1\u0631\u0650\u064a\u0655\u0656 \u0645\u0651\u0650\u0646\u06e1\u0647\u064f\u0645\u06e1 \u0623\u064e\u0646 \u064a\u064f\u0624\u06e1\u062a\u064e\u0649\u0670 \u0635\u064f\u062d\u064f\u0641\u0657\u0627 \u0645\u0651\u064f\u0646\u064e\u0634\u0651\u064e\u0631\u064e\u0629\u0657","translation":"Bilakis o m\u00fc\u015friklerden her biri, Muhammed'in Allah\u2019\u0131n g\u00f6nderdi\u011fi bir el\u00e7i oldu\u011funu ona haber veren yan\u0131 ba\u015f\u0131nda a\u00e7\u0131lm\u0131\u015f bir kitap olsun istiyor. Bunun sebebi ise delillerin azl\u0131\u011f\u0131 veya kan\u0131tlar\u0131n zay\u0131fl\u0131\u011f\u0131 de\u011fildir. O ancak inat ve b\u00fcy\u00fckl\u00fck taslamakt\u0131r.","footnotes":null},{"id":"5548","sura":"74","aya":"53","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627\u06d6 \u0628\u064e\u0644 \u0644\u0651\u064e\u0627 \u064a\u064e\u062e\u064e\u0627\u0641\u064f\u0648\u0646\u064e \u0671\u0644\u06e1\u0623\u0653\u062e\u0650\u0631\u064e\u0629\u064e","translation":"Durum hi\u00e7 de \u00f6yle de\u011fildir. Bilakis sap\u0131kl\u0131klar\u0131nda devam etmelerinin as\u0131l sebebi onlar\u0131n ahiret azab\u0131na iman etmiyor olmalar\u0131d\u0131r. Bu y\u00fczden k\u00e2fir olarak kalm\u0131\u015flard\u0131r.","footnotes":null},{"id":"5549","sura":"74","aya":"54","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627\u0653 \u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u062a\u064e\u0630\u06e1\u0643\u0650\u0631\u064e\u0629\u065e","translation":"Dikkat ediniz! Bu Kur\u2019an ancak bir \u00f6\u011f\u00fct ve nasihattir.","footnotes":null},{"id":"5550","sura":"74","aya":"55","arabic_text":"\u0641\u064e\u0645\u064e\u0646 \u0634\u064e\u0627\u0653\u0621\u064e \u0630\u064e\u0643\u064e\u0631\u064e\u0647\u064f\u06e5","translation":"Art\u0131k kim Kur\u2019an\u2019\u0131 okuyup ondan \u00f6\u011f\u00fct almak isterse, onu okusun ve \u00f6\u011f\u00fct als\u0131n.","footnotes":null},{"id":"5551","sura":"74","aya":"56","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u064a\u064e\u0630\u06e1\u0643\u064f\u0631\u064f\u0648\u0646\u064e \u0625\u0650\u0644\u0651\u064e\u0627\u0653 \u0623\u064e\u0646 \u064a\u064e\u0634\u064e\u0627\u0653\u0621\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f\u06da \u0647\u064f\u0648\u064e \u0623\u064e\u0647\u06e1\u0644\u064f \u0671\u0644\u062a\u0651\u064e\u0642\u06e1\u0648\u064e\u0649\u0670 \u0648\u064e\u0623\u064e\u0647\u06e1\u0644\u064f \u0671\u0644\u06e1\u0645\u064e\u063a\u06e1\u0641\u0650\u0631\u064e\u0629\u0650","translation":"Onlar, Allah\u2019\u0131n \u00f6\u011f\u00fct almalar\u0131n\u0131 dilemesi d\u0131\u015f\u0131nda \u00f6\u011f\u00fct almazlar. O -Subhanehu ve Te\u00e2l\u00e2- emirleri yerine getirerek ve yasaklar\u0131ndan sak\u0131narak korkulmaya lay\u0131kt\u0131r. Ayn\u0131 zamanda kendisine t\u00f6vbe eden kullar\u0131n\u0131n g\u00fcnahlar\u0131n\u0131 ba\u011f\u0131\u015flay\u0131c\u0131d\u0131r.","footnotes":null}]}