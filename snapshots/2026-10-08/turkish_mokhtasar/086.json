lation":"O g\u00fcn, insan\u0131n Allah\u2019\u0131n azab\u0131ndan imtina edebilece\u011fi bir g\u00fcc\u00fc ve kendisine yard\u0131m edebilecek hi\u00e7bir yard\u0131mc\u0131s\u0131 yoktur.","footnotes":null},{"id":"5942","sura":"86","aya":"11","arabic_text":"\u0648\u064e\u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0627\u0653\u0621\u0650 \u0630\u064e\u0627\u062a\u0650 \u0671\u0644\u0631\u0651\u064e\u062c\u06e1\u0639\u0650","translation":"Allah Te\u00e2l\u00e2 ya\u011fmurlu g\u00f6ky\u00fcz\u00fcne yemin etmi\u015ftir. \u00c7\u00fcnk\u00fc ya\u011fmur, her seferinde o cihetten ya\u011far.","footnotes":null},{"id":"5943","sura":"86","aya":"12","arabic_text":"\u0648\u064e\u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u0650 \u0630\u064e\u0627\u062a\u0650 \u0671\u0644\u0635\u0651\u064e\u062f\u06e1\u0639\u0650","translation":"Ve i\u00e7inde bulunan bitki, \u00fcr\u00fcn\/meyve ve a\u011fa\u00e7lardan \u00f6t\u00fcr\u00fc yar\u0131lan topra\u011fa yemin etmi\u015ftir.","footnotes":null},{"id":"5944","sura":"86","aya":"13","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0644\u064e\u0642\u064e\u0648\u06e1\u0644\u065e \u0641\u064e\u0635\u06e1\u0644\u065e","translation":"\u015e\u00fcphesiz Muhammed -sallallahu aleyhi ve sellem-\u2019e indirilmi\u015f olan bu Kur\u2019an, hakk\u0131 bat\u0131ldan ve do\u011fruyu yanl\u0131\u015f\u0131 birbirinden ay\u0131ran bir s\u00f6zd\u00fcr.","footnotes":null},{"id":"5945","sura":"86","aya":"14","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u0647\u064f\u0648\u064e \u0628\u0650\u0671\u0644\u06e1\u0647\u064e\u0632\u06e1\u0644\u0650","translation":"O, bir e\u011flence ve yalan de\u011fildir, bilakis bir ciddiyet ve ger\u00e7ektir.","footnotes":null},{"id":"5946","sura":"86","aya":"15","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u0645\u06e1 \u064a\u064e\u0643\u0650\u064a\u062f\u064f\u0648\u0646\u064e \u0643\u064e\u064a\u06e1\u062f\u0657\u0627","translation":"Peygamberlerinin getirdi\u011fini yalanlayanlar, 