},{"id":"5561","sura":"75","aya":"10","arabic_text":"\u064a\u064e\u0642\u064f\u0648\u0644\u064f \u0671\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u064f \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u064d \u0623\u064e\u064a\u06e1\u0646\u064e \u0671\u0644\u06e1\u0645\u064e\u0641\u064e\u0631\u0651\u064f","translation":"O g\u00fcn g\u00fcnahk\u00e2r insanlar \u015f\u00f6yle diyecek: \"Ka\u00e7\u0131\u015f nereye?\"","footnotes":null},{"id":"5562","sura":"75","aya":"11","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627 \u0644\u064e\u0627 \u0648\u064e\u0632\u064e\u0631\u064e","translation":"O g\u00fcn hi\u00e7bir yere ka\u00e7amazlar. G\u00fcnahk\u00e2r kimselerin ne bar\u0131nabilece\u011fi bir bar\u0131nak, ne de s\u0131\u011f\u0131nabilece\u011fi bir s\u0131\u011f\u0131nak vard\u0131r.","footnotes":null},{"id":"5563","sura":"75","aya":"12","arabic_text":"\u0625\u0650\u0644\u064e\u0649\u0670 \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u064d \u0671\u0644\u06e1\u0645\u064f\u0633\u06e1\u062a\u064e\u0642\u064e\u0631\u0651\u064f","translation":"-Ey Peygamber!- O g\u00fcn hesap g\u00f6rmek ve kar\u015f\u0131l\u0131\u011f\u0131n\u0131 almak \u00fczere, d\u00f6n\u00fc\u015f ve var\u0131\u015f yeri yaln\u0131z Rabbinin huzurudur.","footnotes":null},{"id":"5564","sura":"75","aya":"13","arabic_text":"\u064a\u064f\u0646\u064e\u0628\u0651\u064e\u0624\u064f\u0627\u0652 \u0671\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u064f \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0650\u06ed \u0628\u0650\u0645\u064e\u0627 \u0642\u064e\u062f\u0651\u064e\u0645\u064e \u0648\u064e\u0623\u064e\u062e\u0651\u064e\u0631\u064e","translation":"O g\u00fcn insana, yapt\u0131\u011f\u0131 ve yapmad\u0131\u011f\u0131 ameller haber verilir.","footnotes":null},{"id":"5565","sura":"75","aya":"14","arabic_text":"\u0628\u064e\u0644\u0650 \u0671\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u064f \u0639\u064e\u0644\u064e\u0649\u0670 \u0646\u064e\u0641\u06e1\u0633\u0650\u0647\u0650\u06e6 \u0628\u064e\u0635\u0650\u064a\u0631\u064e\u0629\u065e","translation":"Do\u011frusu insan, azalar\u0131n\u0131n i\u015flemi\u015f oldu\u011fu g\u00fcnahlara \u015fahitlik etmesi sebebiyle kendi aleyhine \u015fahitlik edecektir.","footnotes":null},{"id":"5566","sura":"75","aya":"15","arabic_text":"\u0648\u064e\u0644\u064e\u0648\u06e1 \u0623\u064e\u0644\u06e1\u0642\u064e\u0649\u0670 \u0645\u064e\u0639\u064e\u0627\u0630\u0650\u064a\u0631\u064e\u0647\u064f\u06e5","translation":"Kendisini savundu\u011fu mazeretleri getirse bile, \u015f\u00fcphesiz yapt\u0131\u011f\u0131 k\u00f6t\u00fcl\u00fcklerin ona bir faydas\u0131 olmaz.","footnotes":null},{"id":"5567","sura":"75","aya":"16","arabic_text":"\u0644\u064e\u0627 \u062a\u064f\u062d\u064e\u0631\u0651\u0650\u0643\u06e1 \u0628\u0650\u0647\u0650\u06e6 \u0644\u0650\u0633\u064e\u0627\u0646\u064e\u0643\u064e \u0644\u0650\u062a\u064e\u0639\u06e1\u062c\u064e\u0644\u064e \u0628\u0650\u0647\u0650\u06e6\u0653","translation":"-Ey Peygamber!- Senden hi\u00e7bir \u015fey ka\u00e7mas\u0131n diye, Kur'an okurken dilini aceleyle hareket ettirme.","footnotes":null},{"id":"5568","sura":"75","aya":"17","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0639\u064e\u0644\u064e\u064a\u06e1\u0646\u064e\u0627 \u062c\u064e\u0645\u06e1\u0639\u064e\u0647\u064f\u06e5 \u0648\u064e\u0642\u064f\u0631\u06e1\u0621\u064e\u0627\u0646\u064e\u0647\u064f\u06e5","translation":"\u015e\u00fcphesiz onu, senin kalbinde toplamam\u0131z ve okunu\u015funu dilinde sabit k\u0131lmam\u0131z bizim sorumlulu\u011fumuzdur.","footnotes":null},{"id":"5569","sura":"75","aya":"18","arabic_text":"\u0641\u064e\u0625\u0650\u0630\u064e\u0627 \u0642\u064e\u0631\u064e\u0623\u06e1\u0646\u064e\u0670\u0647\u064f \u0641\u064e\u0671\u062a\u0651\u064e\u0628\u0650\u0639\u06e1 \u0642\u064f\u0631\u06e1\u0621\u064e\u0627\u0646\u064e\u0647\u064f\u06e5","translation":"El\u00e7imiz Cebr\u00e2il sana Kur'an okudu\u011fu zaman, susup onun k\u0131raatini dinle!","footnotes":null},{"id":"5570","sura":"75","aya":"19","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0625\u0650\u0646\u0651\u064e \u0639\u064e\u0644\u064e\u064a\u06e1\u0646\u064e\u0627 \u0628\u064e\u064a\u064e\u0627\u0646\u064e\u0647\u064f\u06e5","translation":"Sonra, onun sana tefsir edilmesi de yine bize aittir.","footnotes":null},{"id":"5571","sura":"75","aya":"20","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627 \u0628\u064e\u0644\u06e1 \u062a\u064f\u062d\u0650\u0628\u0651\u064f\u0648\u0646\u064e \u0671\u0644\u06e1\u0639\u064e\u0627\u062c\u0650\u0644\u064e\u0629\u064e","translation":"Kesinlikle hay\u0131r! Durum, sizin yeniden dirili\u015fin imk\u00e2ns\u0131z oldu\u011funu iddia etti\u011finiz gibi de\u011fildir. Siz, \u00e7ok iyi biliyorsunuz ki sizleri yoktan yaratmaya kadir olan, \u00f6l\u00fcm\u00fcn\u00fcz\u00fcn ard\u0131ndan size tekrar hayat vermekten de aciz de\u011fildir. Oysa sizin yeniden dirili\u015fi ink\u00e2r etmenizin ger\u00e7ek sebebi, \u00e7abucak ge\u00e7iveren d\u00fcnya hayat\u0131na olan sevginizdir.","footnotes":null},{"id":"5572","sura":"75","aya":"21","arabic_text":"\u0648\u064e\u062a\u064e\u0630\u064e\u0631\u064f\u0648\u0646\u064e \u0671\u0644\u06e1\u0623\u0653\u062e\u0650\u0631\u064e\u0629\u064e","translation":"Allah\u2019\u0131n size emretti\u011fi ibadetleri yerine getirmek ve size yasaklad\u0131\u011f\u0131 haramlar\u0131 terk etmekle ula\u015f\u0131lan ahiret hayat\u0131n\u0131 ise terk ediyorsunuz.","footnotes":null},{"id":"5573","sura":"75","aya":"22","arabic_text":"\u0648\u064f\u062c\u064f\u0648\u0647\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0646\u0651\u064e\u0627\u0636\u0650\u0631\u064e\u0629\u064c","translation":"O g\u00fcn, iman ve saadet ehli kimselerin y\u00fczleri nur i\u00e7inde parlar.","footnotes":null},{"id":"5574","sura":"75","aya":"23","arabic_text":"\u0625\u0650\u0644\u064e\u0649\u0670 \u0631\u064e\u0628\u0651\u0650\u0647\u064e\u0627 \u0646\u064e\u0627\u0638\u0650\u0631\u064e\u0629\u065e","translation":"Bundan zevk duyarak Rablerine bakarlar.","footnotes":null},{"id":"5575","sura":"75","aya":"24","arabic_text":"\u0648\u064e\u0648\u064f\u062c\u064f\u0648\u0647\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0650\u06ed \u0628\u064e\u0627\u0633\u0650\u0631\u064e\u0629\u065e","translation":"O g\u00fcn, k\u00e2fir ve bedbaht kimselerin y\u00fczleri ise as\u0131kt\u0131r.","footnotes":null},{"id":"5576","sura":"75","aya":"25","arabic_text":"\u062a\u064e\u0638\u064f\u0646\u0651\u064f \u0623\u064e\u0646 \u064a\u064f\u0641\u06e1\u0639\u064e\u0644\u064e \u0628\u0650\u0647\u064e\u0627 \u0641\u064e\u0627\u0642\u0650\u0631\u064e\u0629\u065e","translation":"Ba\u015flar\u0131na \u00e7ok b\u00fcy\u00fck bir cezan\u0131n ve elem verici bir azab\u0131n gelece\u011fini kesin olarak bilirler.","footnotes":null},{"id":"5577","sura":"75","aya":"26","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627\u0653 \u0625\u0650\u0630\u064e\u0627 \u0628\u064e\u0644\u064e\u063a\u064e\u062a\u0650 \u0671\u0644\u062a\u0651\u064e\u0631\u064e\u0627\u0642\u0650\u064a\u064e","translation":"Durum, \u00f6ld\u00fckleri zaman azap g\u00f6rmeyeceklerini zanneden m\u00fc\u015friklerin d\u00fc\u015f\u00fcnd\u00fckleri gibi de\u011fildir. Onlardan birinin can\u0131, g\u00f6\u011fs\u00fcn\u00fcn en \u00fcst\u00fcne ula\u015ft\u0131\u011f\u0131nda.","footnotes":null},{"id":"5578","sura":"75","aya":"27","arabic_text":"\u0648\u064e\u0642\u0650\u064a\u0644\u064e \u0645\u064e\u0646\u06e1\u06dc \u0631\u064e\u0627\u0642\u0656","translation":"\u0130nsanlar birbirine \u015f\u00f6yle dedi\u011finde: \"\u015eifa bulmas\u0131 i\u00e7in bunu kim okur?\"","footnotes":null},{"id":"5579","sura":"75","aya":"28","arabic_text":"\u0648\u064e\u0638\u064e\u0646\u0651\u064e \u0623\u064e\u0646\u0651\u064e\u0647\u064f \u0671\u0644\u06e1\u0641\u0650\u0631\u064e\u0627\u0642\u064f","translation":"Can \u00e7eki\u015fmekte olan kimse o zaman, \u00f6l\u00fcm\u00fcyle birlikte d\u00fcnyadan kesin olarak ayr\u0131lmakta oldu\u011funu kesin olarak anlad\u0131\u011f\u0131nda.","footnotes":null},{"id":"5580","sura":"75","aya":"29","arabic_text":"\u0648\u064e\u0671\u0644\u06e1\u062a\u064e\u0641\u0651\u064e\u062a\u0650 \u0671\u0644\u0633\u0651\u064e\u0627\u0642\u064f \u0628\u0650\u0671\u0644\u0633\u0651\u064e\u0627\u0642\u0650","translation":"D\u00fcnyan\u0131n sonunda ve ahiretin ba\u015flang\u0131c\u0131nda s\u0131k\u0131nt\u0131lar bir araya topland\u0131\u011f\u0131nda.","footnotes":null},{"id":"5581","sura":"75","aya":"30","arabic_text":"\u0625\u0650\u0644\u064e\u0649\u0670 \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u064d \u0671\u0644\u06e1\u0645\u064e\u0633\u064e\u0627\u0642\u064f","translation":"\u0130\u015fte bunlar meydana gelince, \u00f6len kimse Rabbinin huzuruna getirilir.","footnotes":null},{"id":"5582","sura":"75","aya":"31","arabic_text":"\u0641\u064e\u0644\u064e\u0627 \u0635\u064e\u062f\u0651\u064e\u0642\u064e \u0648\u064e\u0644\u064e\u0627 \u0635\u064e\u0644\u0651\u064e\u0649\u0670","translation":"O k\u00e2fir, Peygamberin getirdiklerini tasdik etmemi\u015f ve Allah Te\u00e2l\u00e2 i\u00e7in namaz k\u0131lmam\u0131\u015ft\u0131.","footnotes":null},{"id":"5583","sura":"75","aya":"32","arabic_text":"\u0648\u064e\u0644\u064e\u0670\u0643\u0650\u0646 \u0643\u064e\u0630\u0651\u064e\u0628\u064e \u0648\u064e\u062a\u064e\u0648\u064e\u0644\u0651\u064e\u0649\u0670","translation":"Fakat Peygamberin getirdiklerini yalanlam\u0131\u015f ve ondan y\u00fcz \u00e7evirmi\u015fti.","footnotes":null},{"id":"5584","sura":"75","aya":"33","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0630\u064e\u0647\u064e\u0628\u064e \u0625\u0650\u0644\u064e\u0649\u0670\u0653 \u0623\u064e\u0647\u06e1\u0644\u0650\u0647\u0650\u06e6 \u064a\u064e\u062a\u064e\u0645\u064e\u0637\u0651\u064e\u0649\u0670\u0653","translation":"Bu k\u00e2fir, sonra da kibrinden y\u00fcr\u00fcy\u00fc\u015f\u00fcnde b\u00f6b\u00fcrlenerek ailesine gitmi\u015fti.","footnotes":null},{"id":"5585","sura":"75","aya":"34","arabic_text":"\u0623\u064e\u0648\u06e1\u0644\u064e\u0649\u0670 \u0644\u064e\u0643\u064e \u0641\u064e\u0623\u064e\u0648\u06e1\u0644\u064e\u0649\u0670","translation":"Allah Te\u00e2l\u00e2, azab\u0131n\u0131n pe\u015fine d\u00fc\u015fmesi ve \u00e7ok yakla\u015fmas\u0131yla k\u00e2fire g\u00f6zda\u011f\u0131 vermi\u015ftir.","footnotes":null},{"id":"5586","sura":"75","aya":"35","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0623\u064e\u0648\u06e1\u0644\u064e\u0649\u0670 \u0644\u064e\u0643\u064e \u0641\u064e\u0623\u064e\u0648\u06e1\u0644\u064e\u0649\u0670\u0653","translation":"Ard\u0131ndan c\u00fcmleyi tekit etmek i\u00e7in tekrarlam\u0131\u015f ve; \"Sonra yine lay\u0131ks\u0131n, sana lay\u0131kt\u0131r.\" diye buyurmu\u015ftur.","footnotes":null},{"id":"5587","sura":"75","aya":"36","arabic_text":"\u0623\u064e\u064a\u064e\u062d\u06e1\u0633\u064e\u0628\u064f \u0671\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u064f \u0623\u064e\u0646 \u064a\u064f\u062a\u06e1\u0631\u064e\u0643\u064e \u0633\u064f\u062f\u064b\u0649","translation":"Yoksa insan, Y\u00fcce Allah\u2019\u0131n onu bir din ile sorumlu k\u0131lmadan ba\u015f\u0131bo\u015f b\u0131rakt\u0131\u011f\u0131n\u0131 m\u0131 zannediyor?","footnotes":null},{"id":"5588","sura":"75","aya":"37","arabic_text":"\u0623\u064e\u0644\u064e\u0645\u06e1 \u064a\u064e\u0643\u064f \u0646\u064f\u0637\u06e1\u0641\u064e\u0629\u0657 \u0645\u0651\u0650\u0646 \u0645\u0651\u064e\u0646\u0650\u064a\u0651\u0656 \u064a\u064f\u0645\u06e1\u0646\u064e\u0649\u0670","translation":"Bu insan, bir zamanlar rahme ak\u0131t\u0131lan bir meni damlas\u0131 de\u011fil miydi?","footnotes":null},{"id":"5589","sura":"75","aya":"38","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0643\u064e\u0627\u0646\u064e \u0639\u064e\u0644\u064e\u0642\u064e\u0629\u0657 \u0641\u064e\u062e\u064e\u0644\u064e\u0642\u064e \u0641\u064e\u0633\u064e\u0648\u0651\u064e\u0649\u0670","translation":"Bunun ard\u0131ndan donmu\u015f bir kan p\u0131ht\u0131s\u0131 oldu. Sonra da Allah, onu yaratt\u0131 ve onun \u015feklini d\u00fczenledi.","footnotes":null},{"id":"5590","sura":"75","aya":"39","arabic_text":"\u0641\u064e\u062c\u064e\u0639\u064e\u0644\u064e \u0645\u0650\u0646\u06e1\u0647\u064f \u0671\u0644\u0632\u0651\u064e\u0648\u06e1\u062c\u064e\u064a\u06e1\u0646\u0650 \u0671\u0644\u0630\u0651\u064e\u0643\u064e\u0631\u064e \u0648\u064e\u0671\u0644\u06e1\u0623\u064f\u0646\u062b\u064e\u0649\u0670\u0653","translation":"Sonra da onun t\u00fcr\u00fcnden, erkek ve kad\u0131n iki cins yaratt\u0131.","footnotes":null},{"id":"5591","sura":"75","aya":"40","arabic_text":"\u0623\u064e\u0644\u064e\u064a\u06e1\u0633\u064e \u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0628\u0650\u0642\u064e\u0670\u062f\u0650\u0631\u064d \u0639\u064e\u0644\u064e\u0649\u0670\u0653 \u0623\u064e\u0646 \u064a\u064f\u062d\u06e1\u0640\u06e7\u0650\u064a\u064e \u0671\u0644\u06e1\u0645\u064e\u0648\u06e1\u062a\u064e\u0649\u0670","translation":"\u0130nsanlar\u0131 bir meni damlas\u0131 ve kan p\u0131ht\u0131s\u0131ndan yaratan, hesap g\u00f6rmek ve kar\u015f\u0131l\u0131klar\u0131n\u0131 vermek \u00fczere \u00f6l\u00fcleri yeni ba\u015ftan diriltmeye kadir de\u011fil midir? Tabi ki evet! Muhakkak O'nun bunu yapmaya g\u00fcc\u00fc yeter.","footnotes":null}]}