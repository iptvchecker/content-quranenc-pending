{"result":[{"id":"6044","sura":"91","aya":"1","arabic_text":"\u0648\u064e\u0671\u0644\u0634\u0651\u064e\u0645\u06e1\u0633\u0650 \u0648\u064e\u0636\u064f\u062d\u064e\u0649\u0670\u0647\u064e\u0627","translation":"Allah Te\u00e2l\u00e2, G\u00fcne\u015f'e ve do\u011fudan do\u011fmas\u0131n\u0131n ard\u0131ndan gelen y\u00fckselme vaktine yemin etmi\u015ftir.","footnotes":null},{"id":"6045","sura":"91","aya":"2","arabic_text":"\u0648\u064e\u0671\u0644\u06e1\u0642\u064e\u0645\u064e\u0631\u0650 \u0625\u0650\u0630\u064e\u0627 \u062a\u064e\u0644\u064e\u0649\u0670\u0647\u064e\u0627","translation":"Ve G\u00fcne\u015f'in batmas\u0131n\u0131n ard\u0131ndan izini takip eden Ay\u2019a yemin etmi\u015ftir.","footnotes":null},{"id":"6046","sura":"91","aya":"3","arabic_text":"\u0648\u064e\u0671\u0644\u0646\u0651\u064e\u0647\u064e\u0627\u0631\u0650 \u0625\u0650\u0630\u064e\u0627 \u062c\u064e\u0644\u0651\u064e\u0649\u0670\u0647\u064e\u0627","translation":"Ve yery\u00fcz\u00fcn\u00fcn \u00fczerinde bulunanlar\u0131 \u0131\u015f\u0131\u011f\u0131yla ortaya \u00e7\u0131karan g\u00fcnd\u00fcze yemin etmi\u015ftir.","footnotes":null},{"id":"6047","sura":"91","aya":"4","arabic_text":"\u0648\u064e\u0671\u0644\u0651\u064e\u064a\u06e1\u0644\u0650 \u0625\u0650\u0630\u064e\u0627 \u064a\u064e\u063a\u06e1\u0634\u064e\u0649\u0670\u0647\u064e\u0627","translation":"Ve yery\u00fcz\u00fcn\u00fc kaplay\u0131p karanl\u0131k oldu\u011funda geceye yemin etmi\u015ftir.","footnotes":null},{"id":"6048","sura":"91","aya":"5","arabic_text":"\u0648\u064e\u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0627\u0653\u0621\u0650 \u0648\u064e\u0645\u064e\u0627 \u0628\u064e\u0646\u064e\u0649\u0670\u0647\u064e\u0627","translation":"G\u00f6ky\u00fcz\u00fcne ve sa\u011flamca in\u015fa edilen binas\u0131na yemin etmi\u015ftir.","footnotes":null},{"id":"6049","sura":"91","aya":"6","arabic_text":"\u0648\u064e\u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u0650 \u0648\u064e\u0645\u064e\u0627 \u0637\u064e\u062d\u064e\u0649\u0670\u0647\u064e\u0627","translation":"Yery\u00fcz\u00fcne ve insanlar\u0131n \u00fczerinde ya\u015famas\u0131 i\u00e7in onun yay\u0131p d\u00f6\u015fenmesine yemin etmi\u015ftir.","footnotes":null},{"id":"6050","sura":"91","aya":"7","arabic_text":"\u0648\u064e\u0646\u064e\u0641\u06e1\u0633\u0656 \u0648\u064e\u0645\u064e\u0627 \u0633\u064e\u0648\u0651\u064e\u0649\u0670\u0647\u064e\u0627","translation":"B\u00fct\u00fcn canl\u0131lara ve Allah\u2019\u0131n onlar\u0131 d\u00fczg\u00fcnce yaratmas\u0131na yemin etmi\u015ftir.","footnotes":null},{"id":"6051","sura":"91","aya":"8","arabic_text":"\u0641\u064e\u0623\u064e\u0644\u06e1\u0647\u064e\u0645\u064e\u0647\u064e\u0627 \u0641\u064f\u062c\u064f\u0648\u0631\u064e\u0647\u064e\u0627 \u0648\u064e\u062a\u064e\u0642\u06e1\u0648\u064e\u0649\u0670\u0647\u064e\u0627","translation":"Y\u00fcce Allah uzak durup, ka\u00e7\u0131nmas\u0131 i\u00e7in k\u00f6t\u00fcl\u00fckleri ve amel edip, i\u015flemesi i\u00e7in iyilikleri insana \u00f6\u011fretmeden nefislere yerle\u015ftirip, anlamas\u0131n\u0131 sa\u011flam\u0131\u015ft\u0131r.","footnotes":null},{"id":"6052","sura":"91","aya":"9","arabic_text":"\u0642\u064e\u062f\u06e1 \u0623\u064e\u0641\u06e1\u0644\u064e\u062d\u064e \u0645\u064e\u0646 \u0632\u064e\u0643\u0651\u064e\u0649\u0670\u0647\u064e\u0627","translation":"Nefsini faziletlerle s\u00fcsleyerek ve rezilliklerden temizleyerek ar\u0131nd\u0131ran kimse elbette murad\u0131n\u0131 kazanm\u0131\u015ft\u0131r.","footnotes":null},{"id":"6053","sura":"91","aya":"10","arabic_text":"\u0648\u064e\u0642\u064e\u062f\u06e1 \u062e\u064e\u0627\u0628\u064e \u0645\u064e\u0646 \u062f\u064e\u0633\u0651\u064e\u0649\u0670\u0647\u064e\u0627","translation":"Nefsini gizlice g\u00fcnah ve su\u00e7lar\u0131n i\u00e7ine g\u00f6men ise h\u00fcsrana u\u011fram\u0131\u015ft\u0131r.","footnotes":null},{"id":"6054","sura":"91","aya":"11","arabic_text":"\u0643\u064e\u0630\u0651\u064e\u0628\u064e\u062a\u06e1 \u062b\u064e\u0645\u064f\u0648\u062f\u064f \u0628\u0650\u0637\u064e\u063a\u06e1\u0648\u064e\u0649\u0670\u0647\u064e\u0627\u0653","translation":"Sem\u00fbd kavmi, s\u0131n\u0131rlar\u0131 \u00e7i\u011fneyip, su\u00e7 i\u015flemeleri ve g\u00fcnahlara dalmalar\u0131 sebebiyle peygamberi Salih\u2019i yalanlad\u0131.","footnotes":null},{"id":"6055","sura":"91","aya":"12","arabic_text":"\u0625\u0650\u0630\u0650 \u0671\u0646\u06e2\u0628\u064e\u0639\u064e\u062b\u064e \u0623\u064e\u0634\u06e1\u0642\u064e\u0649\u0670\u0647\u064e\u0627","translation":"Onlar\u0131n en bedbaht\/e\u015fk\u0131ya olan\u0131, kavminin kendisini g\u00f6revlendirmesinin ard\u0131ndan bu i\u015fi yapmaya kalkt\u0131.","footnotes":null},{"id":"6056","sura":"91","aya":"13","arabic_text":"\u0641\u064e\u0642\u064e\u0627\u0644\u064e \u0644\u064e\u0647\u064f\u0645\u06e1 \u0631\u064e\u0633\u064f\u0648\u0644\u064f \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0646\u064e\u0627\u0642\u064e\u0629\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0648\u064e\u0633\u064f\u0642\u06e1\u064a\u064e\u0670\u0647\u064e\u0627","translation":"Allah\u2019\u0131n resul\u00fc Salih -aleyhisselam- onlara \u015f\u00f6yle dedi: \"Allah\u2019\u0131n devesini su i\u00e7menin ona ait oldu\u011fu g\u00fcnde b\u0131rak\u0131n suyunu i\u00e7sin ve ona bir k\u00f6t\u00fcl\u00fck etmeyin!''","footnotes":null},{"id":"6057","sura":"91","aya":"14","arabic_text":"\u0641\u064e\u0643\u064e\u0630\u0651\u064e\u0628\u064f\u0648\u0647\u064f \u0641\u064e\u0639\u064e\u0642\u064e\u0631\u064f\u0648\u0647\u064e\u0627 \u0641\u064e\u062f\u064e\u0645\u06e1\u062f\u064e\u0645\u064e \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u0650\u0645\u06e1 \u0631\u064e\u0628\u0651\u064f\u0647\u064f\u0645 \u0628\u0650\u0630\u064e\u0646\u06e2\u0628\u0650\u0647\u0650\u0645\u06e1 \u0641\u064e\u0633\u064e\u0648\u0651\u064e\u0649\u0670\u0647\u064e\u0627","translation":"Deve hakk\u0131nda peygamberlerini yalanlad\u0131lar. Kavmin en azg\u0131n olan\u0131, yapt\u0131\u011f\u0131 i\u015fe onlar\u0131n r\u0131zas\u0131n\u0131 al\u0131p, deveyi kesip, \u00f6ld\u00fcrd\u00fc. B\u00f6ylece bu g\u00fcnaha ortak oldular. Allah Te\u00e2l\u00e2 da, g\u00fcnahlar\u0131 sebebiyle \u00fczerlerine azab\u0131n\u0131 g\u00f6ndererek onlar\u0131 bir hayk\u0131r\u0131\u015fla helak etti. Onlar\u0131 helak ederek yerle bir etti.","footnotes":null},{"id":"6058","sura":"91","aya":"15","arabic_text":"\u0648\u064e\u0644\u064e\u0627 \u064a\u064e\u062e\u064e\u0627\u0641\u064f \u0639\u064f\u0642\u06e1\u0628\u064e\u0670\u0647\u064e\u0627","translation":"Allah -Subhanehu ve Te\u00e2l\u00e2-, sonucundan korkmadan onlar\u0131 helak eden bir azap g\u00f6nderdi.","footnotes":null}]}