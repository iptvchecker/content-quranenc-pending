{"result":[{"id":"6091","sura":"94","aya":"1","arabic_text":"\u0623\u064e\u0644\u064e\u0645\u06e1 \u0646\u064e\u0634\u06e1\u0631\u064e\u062d\u06e1 \u0644\u064e\u0643\u064e \u0635\u064e\u062f\u06e1\u0631\u064e\u0643\u064e","translation":"G\u00f6\u011fs\u00fcn\u00fc a\u00e7\u0131p geni\u015fleterek sana vahyin indirilmesini sevdirdik.","footnotes":null},{"id":"6092","sura":"94","aya":"2","arabic_text":"\u0648\u064e\u0648\u064e\u0636\u064e\u0639\u06e1\u0646\u064e\u0627 \u0639\u064e\u0646\u0643\u064e \u0648\u0650\u0632\u06e1\u0631\u064e\u0643\u064e","translation":"Ge\u00e7mi\u015f g\u00fcnahlar\u0131n\u0131 ba\u011f\u0131\u015flayarak, \u00f6nceden bulundu\u011fun cahiliye g\u00fcnlerinin a\u011f\u0131rl\u0131\u011f\u0131n\u0131 \u00fczerinden kald\u0131rd\u0131k.","footnotes":null},{"id":"6093","sura":"94","aya":"3","arabic_text":"\u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0653 \u0623\u064e\u0646\u0642\u064e\u0636\u064e \u0638\u064e\u0647\u06e1\u0631\u064e\u0643\u064e","translation":"Neredeyse belini k\u0131racak kadar seni yormu\u015f olan bir y\u00fck.","footnotes":null},{"id":"6094","sura":"94","aya":"4","arabic_text":"\u0648\u064e\u0631\u064e\u0641\u064e\u0639\u06e1\u0646\u064e\u0627 \u0644\u064e\u0643\u064e \u0630\u0650\u0643\u06e1\u0631\u064e\u0643\u064e","translation":"Senin \u015fan\u0131n\u0131 y\u00fckselttik ve b\u00f6ylece ezan, kamet ve bunun d\u0131\u015f\u0131nda ba\u015fka yerlerde ismin zikredilir oldu.","footnotes":null},{"id":"6095","sura":"94","aya":"5","arabic_text":"\u0641\u064e\u0625\u0650\u0646\u0651\u064e \u0645\u064e\u0639\u064e \u0671\u0644\u06e1\u0639\u064f\u0633\u06e1\u0631\u0650 \u064a\u064f\u0633\u06e1\u0631\u064b\u0627","translation":"\u015e\u00fcphesiz her zorluk ve darl\u0131kla beraber bir kolayl\u0131k, geni\u015flik ve rahatl\u0131k vard\u0131r.","footnotes":null},{"id":"6096","sura":"94","aya":"6","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0645\u064e\u0639\u064e \u0671\u0644\u06e1\u0639\u064f\u0633\u06e1\u0631\u0650 \u064a\u064f\u0633\u06e1\u0631\u0657\u0627","translation":"\u015e\u00fcphesiz her zorluk ve darl\u0131kla beraber bir kolayl\u0131k, geni\u015flik ve rahatl\u0131k vard\u0131r. E\u011fer bunu \u00f6\u011frendiysen, kavminin eziyeti seni sarsmayacak ve Allah'a davette sana engel olmayacakt\u0131r.","footnotes":null},{"id":"6097","sura":"94","aya":"7","arabic_text":"\u0641\u064e\u0625\u0650\u0630\u064e\u0627 \u0641\u064e\u0631\u064e\u063a\u06e1\u062a\u064e \u0641\u064e\u0671\u0646\u0635\u064e\u0628\u06e1","translation":"E\u011fer yapt\u0131\u011f\u0131n amellerinden bo\u015fa \u00e7\u0131kar ve bitirirsen, hemen Rabbine ibadet etmede gayretli ol.","footnotes":null},{"id":"6098","sura":"94","aya":"8","arabic_text":"\u0648\u064e\u0625\u0650\u0644\u064e\u0649\u0670 \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0641\u064e\u0671\u0631\u06e1\u063a\u064e\u0628","translation":"Y\u00f6neli\u015fini ve gidi\u015fini bir tek Allah\u2019a do\u011fru yap.","footnotes":null}]}