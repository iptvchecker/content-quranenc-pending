{"result":[{"id":"5994","sura":"89","aya":"1","arabic_text":"\u0648\u064e\u0671\u0644\u06e1\u0641\u064e\u062c\u06e1\u0631\u0650","translation":"Allah -Subhanehu ve Te\u00e2l\u00e2- fecir vaktine yemin etmi\u015ftir.","footnotes":null},{"id":"5995","sura":"89","aya":"2","arabic_text":"\u0648\u064e\u0644\u064e\u064a\u064e\u0627\u0644\u064d \u0639\u064e\u0634\u06e1\u0631\u0656","translation":"Ve zilhicce ay\u0131n\u0131n ilk on gecesine yemin etmi\u015ftir.","footnotes":null},{"id":"5996","sura":"89","aya":"3","arabic_text":"\u0648\u064e\u0671\u0644\u0634\u0651\u064e\u0641\u06e1\u0639\u0650 \u0648\u064e\u0671\u0644\u06e1\u0648\u064e\u062a\u06e1\u0631\u0650","translation":"Ve her \u015feyin \u00e7ift olan\u0131na ve tek olan\u0131na yemin etmi\u015ftir.","footnotes":null},{"id":"5997","sura":"89","aya":"4","arabic_text":"\u0648\u064e\u0671\u0644\u0651\u064e\u064a\u06e1\u0644\u0650 \u0625\u0650\u0630\u064e\u0627 \u064a\u064e\u0633\u06e1\u0631\u0650","translation":"Geldi\u011finde, devam etti\u011finde ve geride kald\u0131\u011f\u0131nda geceye yemin etmi\u015ftir. Bu yeminin cevab\u0131 ise: \u201cElbette yapt\u0131\u011f\u0131n\u0131z amellere g\u00f6re kar\u015f\u0131l\u0131k g\u00f6receksiniz.''","footnotes":null},{"id":"5998","sura":"89","aya":"5","arabic_text":"\u0647\u064e\u0644\u06e1 \u0641\u0650\u064a \u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0642\u064e\u0633\u064e\u0645\u065e \u0644\u0651\u0650\u0630\u0650\u064a \u062d\u0650\u062c\u06e1\u0631\u064d","translation":"Bu zikredilenler de ak\u0131l sahibi kimseleri ikna edecek bir yemin yok mudur?","footnotes":null},{"id":"5999","sura":"89","aya":"6","arabic_text":"\u0623\u064e\u0644\u064e\u0645\u06e1 \u062a\u064e\u0631\u064e \u0643\u064e\u064a\u06e1\u0641\u064e \u0641\u064e\u0639\u064e\u0644\u064e \u0631\u064e\u0628\u0651\u064f\u0643\u064e \u0628\u0650\u0639\u064e\u0627\u062f\u064d","translation":"-Ey Peygamber!- Peygamberini yalanlad\u0131klar\u0131 zaman, Rabbinin H\u00fbd'un kavmi olan \u00c2d (kavmine) neler yapt\u0131\u011f\u0131n\u0131 g\u00f6rmedin mi?","footnotes":null},{"id":"6000","sura":"89","aya":"7","arabic_text":"\u0625\u0650\u0631\u064e\u0645\u064e \u0630\u064e\u0627\u062a\u0650 \u0671\u0644\u06e1\u0639\u0650\u0645\u064e\u0627\u062f\u0650","translation":"Atalar\u0131 \u0130rem'e nispet edilen \u00c2d kabilesi y\u00fcksek s\u00fctunlara sahip idiler.","footnotes":null},{"id":"6001","sura":"89","aya":"8","arabic_text":"\u0671\u0644\u0651\u064e\u062a\u0650\u064a \u0644\u064e\u0645\u06e1 \u064a\u064f\u062e\u06e1\u0644\u064e\u0642\u06e1 \u0645\u0650\u062b\u06e1\u0644\u064f\u0647\u064e\u0627 \u0641\u0650\u064a \u0671\u0644\u06e1\u0628\u0650\u0644\u064e\u0670\u062f\u0650","translation":"\u00d6yle ki Allah Te\u00e2l\u00e2, hi\u00e7bir \u00fclkede bir benzerini yaratmam\u0131\u015ft\u0131.","footnotes":null},{"id":"6002","sura":"89","aya":"9","arabic_text":"\u0648\u064e\u062b\u064e\u0645\u064f\u0648\u062f\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u062c\u064e\u0627\u0628\u064f\u0648\u0627\u0652 \u0671\u0644\u0635\u0651\u064e\u062e\u06e1\u0631\u064e \u0628\u0650\u0671\u0644\u06e1\u0648\u064e\u0627\u062f\u0650","translation":"Da\u011flar\u0131n kayalar\u0131n\u0131 yontarak onlardan odal\u0131 evler yapan Salih\u2019in kavmi Sem\u00fbd'a, Rabbinin neler yapt\u0131\u011f\u0131n\u0131 g\u00f6rmedin mi?","footnotes":null},{"id":"6003","sura":"89","aya":"10","arabic_text":"\u0648\u064e\u0641\u0650\u0631\u06e1\u0639\u064e\u0648\u06e1\u0646\u064e \u0630\u0650\u064a \u0671\u0644\u06e1\u0623\u064e\u0648\u06e1\u062a\u064e\u0627\u062f\u0650","translation":"\u0130nsanlara i\u015fkence etti\u011fi kaz\u0131klar\u0131n sahibi Firavun'a Rabbinin neler yapt\u0131\u011f\u0131n\u0131 g\u00f6rmedin mi?","footnotes":null},{"id":"6004","sura":"89","aya":"11","arabic_text":"\u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0637\u064e\u063a\u064e\u0648\u06e1\u0627\u0652 \u0641\u0650\u064a \u0671\u0644\u06e1\u0628\u0650\u0644\u064e\u0670\u062f\u0650","translation":"Bunlar\u0131n hepsi de zorbal\u0131k ve zul\u00fcmde haddi a\u015ft\u0131lar. Hepsinin haddi a\u015fmas\u0131 da kendi \u00fclkesindeydi.","footnotes":null},{"id":"6005","sura":"89","aya":"12","arabic_text":"\u0641\u064e\u0623\u064e\u0643\u06e1\u062b\u064e\u0631\u064f\u0648\u0627\u0652 \u0641\u0650\u064a\u0647\u064e\u0627 \u0671\u0644\u06e1\u0641\u064e\u0633\u064e\u0627\u062f\u064e","translation":"Yayd\u0131klar\u0131 k\u00fcf\u00fcr ve g\u00fcnahlarla oralarda fesad\u0131 artt\u0131rd\u0131lar.","footnotes":null},{"id":"6006","sura":"89","aya":"13","arabic_text":"\u0641\u064e\u0635\u064e\u0628\u0651\u064e \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u0650\u0645\u06e1 \u0631\u064e\u0628\u0651\u064f\u0643\u064e \u0633\u064e\u0648\u06e1\u0637\u064e \u0639\u064e\u0630\u064e\u0627\u0628\u064d","translation":"Allah Te\u00e2l\u00e2 da onlara \u015fiddetli azab\u0131n\u0131 tatt\u0131rd\u0131 ve yery\u00fcz\u00fcnden k\u00f6klerini kaz\u0131d\u0131.","footnotes":null},{"id":"6007","sura":"89","aya":"14","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0631\u064e\u0628\u0651\u064e\u0643\u064e \u0644\u064e\u0628\u0650\u0671\u0644\u06e1\u0645\u0650\u0631\u06e1\u0635\u064e\u0627\u062f\u0650","translation":"-Ey Peygamber!- Rabbin, iyilik yapanlar\u0131 cennet ile m\u00fck\u00e2fatland\u0131rmak, k\u00f6t\u00fcl\u00fck yapanlar\u0131 da cehennem ile cezaland\u0131rmak i\u00e7in insanlar\u0131n amellerini g\u00f6zlemliyor ve kontrol ediyor.","footnotes":null},{"id":"6008","sura":"89","aya":"15","arabic_text":"\u0641\u064e\u0623\u064e\u0645\u0651\u064e\u0627 \u0671\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u064f \u0625\u0650\u0630\u064e\u0627 \u0645\u064e\u0627 \u0671\u0628\u06e1\u062a\u064e\u0644\u064e\u0649\u0670\u0647\u064f \u0631\u064e\u0628\u0651\u064f\u0647\u064f\u06e5 \u0641\u064e\u0623\u064e\u0643\u06e1\u0631\u064e\u0645\u064e\u0647\u064f\u06e5 \u0648\u064e\u0646\u064e\u0639\u0651\u064e\u0645\u064e\u0647\u064f\u06e5 \u0641\u064e\u064a\u064e\u0642\u064f\u0648\u0644\u064f \u0631\u064e\u0628\u0651\u0650\u064a\u0653 \u0623\u064e\u0643\u06e1\u0631\u064e\u0645\u064e\u0646\u0650","translation":"\u0130nsan tabiat\u0131 gere\u011fi Rabbi onu imtihan ederek ona ikram etti. Ve ona mal, \u00e7ocuk ve \u015fan verince kendisinin Allah\u2019\u0131n kat\u0131nda de\u011ferli oldu\u011funu zannederek \u015f\u00f6yle der: \u201cOnun ikram\u0131n\u0131 hak etti\u011fim i\u00e7in Rabbim bana ikram etti.''","footnotes":null},{"id":"6009","sura":"89","aya":"16","arabic_text":"\u0648\u064e\u0623\u064e\u0645\u0651\u064e\u0627\u0653 \u0625\u0650\u0630\u064e\u0627 \u0645\u064e\u0627 \u0671\u0628\u06e1\u062a\u064e\u0644\u064e\u0649\u0670\u0647\u064f \u0641\u064e\u0642\u064e\u062f\u064e\u0631\u064e \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u0650 \u0631\u0650\u0632\u06e1\u0642\u064e\u0647\u064f\u06e5 \u0641\u064e\u064a\u064e\u0642\u064f\u0648\u0644\u064f \u0631\u064e\u0628\u0651\u0650\u064a\u0653 \u0623\u064e\u0647\u064e\u0670\u0646\u064e\u0646\u0650","translation":"Ama onu imtihan ederek r\u0131zk\u0131n\u0131 daralt\u0131rsa, o zaman Rabbinin onu a\u015fa\u011f\u0131lad\u0131\u011f\u0131n\u0131 zannederek \u015f\u00f6yle der: \u201cRabbim beni a\u015fa\u011f\u0131lad\u0131.''","footnotes":null},{"id":"6010","sura":"89","aya":"17","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627\u06d6 \u0628\u064e\u0644 \u0644\u0651\u064e\u0627 \u062a\u064f\u0643\u06e1\u0631\u0650\u0645\u064f\u0648\u0646\u064e \u0671\u0644\u06e1\u064a\u064e\u062a\u0650\u064a\u0645\u064e","translation":"Kesinlikle hay\u0131r. Durum bu insan\u0131n tasavvur etti\u011fi gibi olmay\u0131p Allah\u2019\u0131n verdi\u011fi nimetler Allah'\u0131n kulundan raz\u0131 oldu\u011funa ve belalar da Rabbinin kulunu hor g\u00f6rd\u00fc\u011f\u00fcne delil de\u011fildir. Bilakis do\u011frusu \u015fudur ki; sizler Allah\u2019\u0131n size verdi\u011fi r\u0131z\u0131klardan yetimlere ikram etmiyorsunuz.","footnotes":null},{"id":"6011","sura":"89","aya":"18","arabic_text":"\u0648\u064e\u0644\u064e\u0627 \u062a\u064e\u062d\u064e\u0670\u0653\u0636\u0651\u064f\u0648\u0646\u064e \u0639\u064e\u0644\u064e\u0649\u0670 \u0637\u064e\u0639\u064e\u0627\u0645\u0650 \u0671\u0644\u06e1\u0645\u0650\u0633\u06e1\u0643\u0650\u064a\u0646\u0650","translation":"Birbirinizi, yiyecek bir \u015fey bulamayan fakirleri doyurmaya te\u015fvik etmiyorsunuz.","footnotes":null},{"id":"6012","sura":"89","aya":"19","arabic_text":"\u0648\u064e\u062a\u064e\u0623\u06e1\u0643\u064f\u0644\u064f\u0648\u0646\u064e \u0671\u0644\u062a\u0651\u064f\u0631\u064e\u0627\u062b\u064e \u0623\u064e\u0643\u06e1\u0644\u0657\u0627 \u0644\u0651\u064e\u0645\u0651\u0657\u0627","translation":"Hi\u00e7bir \u00e7\u00f6z\u00fcm yolu g\u00f6zetmeksizin savunmas\u0131z kad\u0131n ve yetimlerin hakk\u0131n\u0131 \u00e7ok\u00e7a yiyorsunuz.","footnotes":null},{"id":"6013","sura":"89","aya":"20","arabic_text":"\u0648\u064e\u062a\u064f\u062d\u0650\u0628\u0651\u064f\u0648\u0646\u064e \u0671\u0644\u06e1\u0645\u064e\u0627\u0644\u064e \u062d\u064f\u0628\u0651\u0657\u0627 \u062c\u064e\u0645\u0651\u0657\u0627","translation":"Mal\u0131 \u00e7ok a\u015f\u0131r\u0131 bir sevgiyle seviyor ve ona olan d\u00fc\u015fk\u00fcnl\u00fc\u011f\u00fcn\u00fcz sebebiyle onu Allah yolunda harcamakta cimrilik g\u00f6steriyorsunuz.","footnotes":null},{"id":"6014","sura":"89","aya":"21","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627\u0653\u06d6 \u0625\u0650\u0630\u064e\u0627 \u062f\u064f\u0643\u0651\u064e\u062a\u0650 \u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u064f \u062f\u064e\u0643\u0651\u0657\u0627 \u062f\u064e\u0643\u0651\u0657\u0627","translation":"Bunlar\u0131n sizin ameliniz olmamas\u0131 gerekir. \u00d6yleyse yery\u00fcz\u00fcn\u00fcn \u015fiddetle hareket etti\u011fi ve sars\u0131ld\u0131\u011f\u0131 zaman\u0131 hat\u0131rlay\u0131n.","footnotes":null},{"id":"6015","sura":"89","aya":"22","arabic_text":"\u0648\u064e\u062c\u064e\u0627\u0653\u0621\u064e \u0631\u064e\u0628\u0651\u064f\u0643\u064e \u0648\u064e\u0671\u0644\u06e1\u0645\u064e\u0644\u064e\u0643\u064f \u0635\u064e\u0641\u0651\u0657\u0627 \u0635\u064e\u0641\u0651\u0657\u0627","translation":"Ve -Ey Peygamber!- kullar\u0131n\u0131n aras\u0131nda son h\u00fckm\u00fc vermek i\u00e7in Rabbin ve b\u00f6l\u00fck b\u00f6l\u00fck melekler geldikleri zaman.","footnotes":null},{"id":"6016","sura":"89","aya":"23","arabic_text":"\u0648\u064e\u062c\u0650\u0627\u0652\u064a\u0653\u0621\u064e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0650\u06ed \u0628\u0650\u062c\u064e\u0647\u064e\u0646\u0651\u064e\u0645\u064e\u06da \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u064a\u064e\u062a\u064e\u0630\u064e\u0643\u0651\u064e\u0631\u064f \u0671\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u064f \u0648\u064e\u0623\u064e\u0646\u0651\u064e\u0649\u0670 \u0644\u064e\u0647\u064f \u0671\u0644\u0630\u0651\u0650\u0643\u06e1\u0631\u064e\u0649\u0670","translation":"O g\u00fcn, \u00fczerinde yetmi\u015f bin dizgin ve her bir dizginin ba\u015f\u0131nda yetmi\u015f bin mele\u011fin \u00e7ekti\u011fi cehennem getirilir. \u0130\u015fte o g\u00fcn insan, Allah\u2019a kar\u015f\u0131 taksirat\u0131n\u0131 hat\u0131rlar. Oysa o g\u00fcn bunlar\u0131 hat\u0131rlamas\u0131n\u0131n ona hi\u00e7 bir faydas\u0131 yoktur. \u00c7\u00fcnk\u00fc o g\u00fcn, amel i\u015fleme g\u00fcn\u00fc de\u011fil, kar\u015f\u0131l\u0131klar\u0131n g\u00f6r\u00fclece\u011fi g\u00fcnd\u00fcr.","footnotes":null},{"id":"6017","sura":"89","aya":"24","arabic_text":"\u064a\u064e\u0642\u064f\u0648\u0644\u064f \u064a\u064e\u0670\u0644\u064e\u064a\u06e1\u062a\u064e\u0646\u0650\u064a \u0642\u064e\u062f\u0651\u064e\u0645\u06e1\u062a\u064f \u0644\u0650\u062d\u064e\u064a\u064e\u0627\u062a\u0650\u064a","translation":"A\u015f\u0131r\u0131 pi\u015fmanl\u0131ktan \u015f\u00f6yle der: \u201cKe\u015fke ger\u00e7ek hayat olan ahiret hayat\u0131m i\u00e7in salih ameller i\u015fleseydim.''","footnotes":null},{"id":"6018","sura":"89","aya":"25","arabic_text":"\u0641\u064e\u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u064e\u0627 \u064a\u064f\u0639\u064e\u0630\u0651\u0650\u0628\u064f \u0639\u064e\u0630\u064e\u0627\u0628\u064e\u0647\u064f\u06e5\u0653 \u0623\u064e\u062d\u064e\u062f\u065e","translation":"Hi\u00e7 kimse o g\u00fcn, Allah\u2019\u0131n azab\u0131 gibi azap edemez. \u00c7\u00fcnk\u00fc Allah\u2019\u0131n azab\u0131 en \u015fiddetli ve en kal\u0131c\u0131 olan azapt\u0131r.","footnotes":null},{"id":"6019","sura":"89","aya":"26","arabic_text":"\u0648\u064e\u0644\u064e\u0627 \u064a\u064f\u0648\u062b\u0650\u0642\u064f \u0648\u064e\u062b\u064e\u0627\u0642\u064e\u0647\u064f\u06e5\u0653 \u0623\u064e\u062d\u064e\u062f\u065e","translation":"Ve hi\u00e7 kimse orada k\u00e2firleri ba\u011flad\u0131\u011f\u0131 gibi zincirleri ba\u011flay\u0131p, vuramaz.","footnotes":null},{"id":"6020","sura":"89","aya":"27","arabic_text":"\u064a\u064e\u0670\u0653\u0623\u064e\u064a\u0651\u064e\u062a\u064f\u0647\u064e\u0627 \u0671\u0644\u0646\u0651\u064e\u0641\u06e1\u0633\u064f \u0671\u0644\u06e1\u0645\u064f\u0637\u06e1\u0645\u064e\u0626\u0650\u0646\u0651\u064e\u0629\u064f","translation":"\u00d6l\u00fcm\u00fc esnas\u0131nda ve k\u0131yamet g\u00fcn\u00fc M\u00fcmin kimseye \u015f\u00f6yle denilecek: \u201cEy iman ve salih amelle huzura ermi\u015f nefis!''","footnotes":null},{"id":"6021","sura":"89","aya":"28","arabic_text":"\u0671\u0631\u06e1\u062c\u0650\u0639\u0650\u064a\u0653 \u0625\u0650\u0644\u064e\u0649\u0670 \u0631\u064e\u0628\u0651\u0650\u0643\u0650 \u0631\u064e\u0627\u0636\u0650\u064a\u064e\u0629\u0657 \u0645\u0651\u064e\u0631\u06e1\u0636\u0650\u064a\u0651\u064e\u0629\u0657","translation":"Nail oldu\u011fun b\u00fcy\u00fck m\u00fck\u00e2fatla O'ndan raz\u0131 olmu\u015f ve sahip oldu\u011fun salih amellerle Allah -Subhanehu ve Te\u00e2l\u00e2- kat\u0131nda raz\u0131 olunmu\u015f bir halde Rabbine d\u00f6n!","footnotes":null},{"id":"6022","sura":"89","aya":"29","arabic_text":"\u0641\u064e\u0671\u062f\u06e1\u062e\u064f\u0644\u0650\u064a \u0641\u0650\u064a \u0639\u0650\u0628\u064e\u0670\u062f\u0650\u064a","translation":"Salih kullar\u0131m\u0131n aras\u0131na kat\u0131l!","footnotes":null},{"id":"6023","sura":"89","aya":"30","arabic_text":"\u0648\u064e\u0671\u062f\u06e1\u062e\u064f\u0644\u0650\u064a \u062c\u064e\u0646\u0651\u064e\u062a\u0650\u064a","translation":"Ve onlarla beraber, onlar i\u00e7in haz\u0131rlad\u0131\u011f\u0131m cennetime gir!","footnotes":null}]}