{"result":[{"id":"5623","sura":"77","aya":"1","arabic_text":"\u0648\u064e\u0671\u0644\u06e1\u0645\u064f\u0631\u06e1\u0633\u064e\u0644\u064e\u0670\u062a\u0650 \u0639\u064f\u0631\u06e1\u0641\u0657\u0627","translation":"Y\u00fcce Allah, at yelesi gibi ard\u0131 ard\u0131na gelen r\u00fczg\u00e2rlara yemin etmi\u015ftir.","footnotes":null},{"id":"5624","sura":"77","aya":"2","arabic_text":"\u0641\u064e\u0671\u0644\u06e1\u0639\u064e\u0670\u0635\u0650\u0641\u064e\u0670\u062a\u0650 \u0639\u064e\u0635\u06e1\u0641\u0657\u0627","translation":"\u015eiddetle esip savuran r\u00fczg\u00e2rlara yemin etmi\u015ftir.","footnotes":null},{"id":"5625","sura":"77","aya":"3","arabic_text":"\u0648\u064e\u0671\u0644\u0646\u0651\u064e\u0670\u0634\u0650\u0631\u064e\u0670\u062a\u0650 \u0646\u064e\u0634\u06e1\u0631\u0657\u0627","translation":"Ya\u011fmurlar\u0131 yayan r\u00fczg\u00e2rlara yemin etmi\u015ftir.","footnotes":null},{"id":"5626","sura":"77","aya":"4","arabic_text":"\u0641\u064e\u0671\u0644\u06e1\u0641\u064e\u0670\u0631\u0650\u0642\u064e\u0670\u062a\u0650 \u0641\u064e\u0631\u06e1\u0642\u0657\u0627","translation":"Hak ve bat\u0131l\u0131 birbirinden ay\u0131ran\u0131 indiren meleklere yemin etmi\u015ftir.","footnotes":null},{"id":"5627","sura":"77","aya":"5","arabic_text":"\u0641\u064e\u0671\u0644\u06e1\u0645\u064f\u0644\u06e1\u0642\u0650\u064a\u064e\u0670\u062a\u0650 \u0630\u0650\u0643\u06e1\u0631\u064b\u0627","translation":"Vahyi getiren meleklere yemin etmi\u015ftir.","footnotes":null},{"id":"5628","sura":"77","aya":"6","arabic_text":"\u0639\u064f\u0630\u06e1\u0631\u064b\u0627 \u0623\u064e\u0648\u06e1 \u0646\u064f\u0630\u06e1\u0631\u064b\u0627","translation":"Allah\u2019tan insanlara bir ikaz olarak veya Allah\u2019\u0131n azab\u0131na kar\u015f\u0131 insanlar\u0131 korkutmak i\u00e7in vahiyle inerler.","footnotes":null},{"id":"5629","sura":"77","aya":"7","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0645\u064e\u0627 \u062a\u064f\u0648\u0639\u064e\u062f\u064f\u0648\u0646\u064e \u0644\u064e\u0648\u064e\u0670\u0642\u0650\u0639\u065e","translation":"\u015e\u00fcphesiz size vadedilen yeniden dirili\u015f, hesap ve kar\u015f\u0131l\u0131klar\u0131n verilmesi ka\u00e7\u0131n\u0131lmaz olarak muhakkak ger\u00e7ekle\u015fecektir.","footnotes":null},{"id":"5630","sura":"77","aya":"8","arabic_text":"\u0641\u064e\u0625\u0650\u0630\u064e\u0627 \u0671\u0644\u0646\u0651\u064f\u062c\u064f\u0648\u0645\u064f \u0637\u064f\u0645\u0650\u0633\u064e\u062a\u06e1","translation":"Y\u0131ld\u0131zlar\u0131n par\u0131lt\u0131s\u0131 silinip \u0131\u015f\u0131\u011f\u0131 kayboldu\u011fu zaman.","footnotes":null},{"id":"5631","sura":"77","aya":"9","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0627\u0653\u0621\u064f \u0641\u064f\u0631\u0650\u062c\u064e\u062a\u06e1","translation":"G\u00f6ky\u00fcz\u00fc, meleklerin ini\u015fi sebebiyle par\u00e7aland\u0131\u011f\u0131 zaman.","footnotes":null},{"id":"5632","sura":"77","aya":"10","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0671\u0644\u06e1\u062c\u0650\u0628\u064e\u0627\u0644\u064f \u0646\u064f\u0633\u0650\u0641\u064e\u062a\u06e1","translation":"Da\u011flar yerlerinden s\u00f6k\u00fcl\u00fcp toz tanelerine d\u00f6n\u00fc\u015f\u00fcnceye kadar parampar\u00e7a edildi\u011fi zaman.","footnotes":null},{"id":"5633","sura":"77","aya":"11","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0671\u0644\u0631\u0651\u064f\u0633\u064f\u0644\u064f \u0623\u064f\u0642\u0651\u0650\u062a\u064e\u062a\u06e1","translation":"Peygamberler belli bir vakit i\u00e7in topland\u0131\u011f\u0131 zaman.","footnotes":null},{"id":"5634","sura":"77","aya":"12","arabic_text":"\u0644\u0650\u0623\u064e\u064a\u0651\u0650 \u064a\u064e\u0648\u06e1\u0645\u064d \u0623\u064f\u062c\u0651\u0650\u0644\u064e\u062a\u06e1","translation":"\u00c7ok b\u00fcy\u00fck bir g\u00fcn i\u00e7in, \u00fcmmetlerine kar\u015f\u0131 \u015fahitlikleri ertelenmi\u015ftir.","footnotes":null},{"id":"5635","sura":"77","aya":"13","arabic_text":"\u0644\u0650\u064a\u064e\u0648\u06e1\u0645\u0650 \u0671\u0644\u06e1\u0641\u064e\u0635\u06e1\u0644\u0650","translation":"Kullar\u0131n aras\u0131nda ayr\u0131m\u0131n (h\u00fckm\u00fcn) olaca\u011f\u0131 g\u00fcn i\u00e7in (ertelenmi\u015ftir). B\u00f6ylece hakl\u0131 olan haks\u0131z olandan ve mutlu olan bedbaht olandan ayr\u0131larak ortaya \u00e7\u0131kacakt\u0131r.","footnotes":null},{"id":"5636","sura":"77","aya":"14","arabic_text":"\u0648\u064e\u0645\u064e\u0627\u0653 \u0623\u064e\u062f\u06e1\u0631\u064e\u0649\u0670\u0643\u064e \u0645\u064e\u0627 \u064a\u064e\u0648\u06e1\u0645\u064f \u0671\u0644\u06e1\u0641\u064e\u0635\u06e1\u0644\u0650","translation":"-Ey Peygamber!- H\u00fck\u00fcm g\u00fcn\u00fcn\u00fcn ne oldu\u011funu sana ne \u00f6\u011fretti?","footnotes":null},{"id":"5637","sura":"77","aya":"15","arabic_text":"\u0648\u064e\u064a\u06e1\u0644\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u0650\u0644\u06e1\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e","translation":"O g\u00fcn; helak, azap ve h\u00fcsran peygamberlerinin Allah\u2019\u0131n kat\u0131ndan getirdiklerini yalanlayan o ink\u00e2rc\u0131lar\u0131n \u00fczerine olsun!","footnotes":null},{"id":"5638","sura":"77","aya":"16","arabic_text":"\u0623\u064e\u0644\u064e\u0645\u06e1 \u0646\u064f\u0647\u06e1\u0644\u0650\u0643\u0650 \u0671\u0644\u06e1\u0623\u064e\u0648\u0651\u064e\u0644\u0650\u064a\u0646\u064e","translation":"Biz, Allah'a kar\u015f\u0131 ink\u00e2rc\u0131 olduklar\u0131 ve resulleri yalanlad\u0131klar\u0131 zaman ge\u00e7mi\u015f \u00fcmmetleri helak etmedik mi?","footnotes":null},{"id":"5639","sura":"77","aya":"17","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0646\u064f\u062a\u06e1\u0628\u0650\u0639\u064f\u0647\u064f\u0645\u064f \u0671\u0644\u06e1\u0623\u0653\u062e\u0650\u0631\u0650\u064a\u0646\u064e","translation":"Ard\u0131ndan, sonradan gelenleri de o ink\u00e2rc\u0131lara kataca\u011f\u0131z ve onlar\u0131 helak etti\u011fimiz gibi onlar\u0131 da helak edece\u011fiz.","footnotes":null},{"id":"5640","sura":"77","aya":"18","arabic_text":"\u0643\u064e\u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0646\u064e\u0641\u06e1\u0639\u064e\u0644\u064f \u0628\u0650\u0671\u0644\u06e1\u0645\u064f\u062c\u06e1\u0631\u0650\u0645\u0650\u064a\u0646\u064e","translation":"Muhammed -sallallahu aleyhi ve sellem-'in getirdiklerini yalanlayan m\u00fccrim kimseleri, o \u00fcmmetlerin helak edildi\u011fi gibi helak edece\u011fiz.","footnotes":null},{"id":"5641","sura":"77","aya":"19","arabic_text":"\u0648\u064e\u064a\u06e1\u0644\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u0650\u0644\u06e1\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e","translation":"O g\u00fcn; helak, azap ve h\u00fcsran Y\u00fcce Allah\u2019\u0131n g\u00fcnahk\u00e2rlar\u0131 cezaland\u0131rma vaadini yalanlayanlar\u0131n \u00fczerine olsun!","footnotes":null},{"id":"5642","sura":"77","aya":"20","arabic_text":"\u0623\u064e\u0644\u064e\u0645\u06e1 \u0646\u064e\u062e\u06e1\u0644\u064f\u0642\u0643\u0651\u064f\u0645 \u0645\u0651\u0650\u0646 \u0645\u0651\u064e\u0627\u0653\u0621\u0656 \u0645\u0651\u064e\u0647\u0650\u064a\u0646\u0656","translation":"Ey insanlar! Sizleri meni damlas\u0131 olan de\u011fersiz az\u0131c\u0131k bir sudan yaratmad\u0131k m\u0131?","footnotes":null},{"id":"5643","sura":"77","aya":"21","arabic_text":"\u0641\u064e\u062c\u064e\u0639\u064e\u0644\u06e1\u0646\u064e\u0670\u0647\u064f \u0641\u0650\u064a \u0642\u064e\u0631\u064e\u0627\u0631\u0656 \u0645\u0651\u064e\u0643\u0650\u064a\u0646\u064d","translation":"Bu de\u011fersiz suyu korunakl\u0131 bir yer olan kad\u0131n\u0131n rahmine yerle\u015ftirmedik mi?","footnotes":null},{"id":"5644","sura":"77","aya":"22","arabic_text":"\u0625\u0650\u0644\u064e\u0649\u0670 \u0642\u064e\u062f\u064e\u0631\u0656 \u0645\u0651\u064e\u0639\u06e1\u0644\u064f\u0648\u0645\u0656","translation":"Bilinen bir s\u00fcre olan hamilelik d\u00f6nemine kadar.","footnotes":null},{"id":"5645","sura":"77","aya":"23","arabic_text":"\u0641\u064e\u0642\u064e\u062f\u064e\u0631\u06e1\u0646\u064e\u0627 \u0641\u064e\u0646\u0650\u0639\u06e1\u0645\u064e \u0671\u0644\u06e1\u0642\u064e\u0670\u062f\u0650\u0631\u064f\u0648\u0646\u064e","translation":"Biz; do\u011fan \u00e7ocu\u011fun vas\u0131flar\u0131n\u0131, boyunu, rengini ve bunlar d\u0131\u015f\u0131ndaki her \u015feyi takdir ettik. Biz b\u00fct\u00fcn bunlar\u0131 ne g\u00fczel takdir ederiz.","footnotes":null},{"id":"5646","sura":"77","aya":"24","arabic_text":"\u0648\u064e\u064a\u06e1\u0644\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u0650\u0644\u06e1\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e","translation":"O g\u00fcn; helak, azap ve h\u00fcsran Allah\u2019\u0131n kudretini yalanlayanlar\u0131n \u00fczerine olsun!","footnotes":null},{"id":"5647","sura":"77","aya":"25","arabic_text":"\u0623\u064e\u0644\u064e\u0645\u06e1 \u0646\u064e\u062c\u06e1\u0639\u064e\u0644\u0650 \u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u064e \u0643\u0650\u0641\u064e\u0627\u062a\u064b\u0627","translation":"Biz, yery\u00fcz\u00fcn\u00fc t\u00fcm insanlar\u0131 i\u00e7ine alacak bir \u015fekilde yaratmad\u0131k m\u0131?","footnotes":null},{"id":"5648","sura":"77","aya":"26","arabic_text":"\u0623\u064e\u062d\u06e1\u064a\u064e\u0627\u0653\u0621\u0657 \u0648\u064e\u0623\u064e\u0645\u06e1\u0648\u064e\u0670\u062a\u0657\u0627","translation":"Yery\u00fcz\u00fc, \u00fczerinde hayat s\u00fcren insanlar\u0131 ve topra\u011fa g\u00f6m\u00fclen \u00f6l\u00fcleri kapsamaktad\u0131r.","footnotes":null},{"id":"5649","sura":"77","aya":"27","arabic_text":"\u0648\u064e\u062c\u064e\u0639\u064e\u0644\u06e1\u0646\u064e\u0627 \u0641\u0650\u064a\u0647\u064e\u0627 \u0631\u064e\u0648\u064e\u0670\u0633\u0650\u064a\u064e \u0634\u064e\u0670\u0645\u0650\u062e\u064e\u0670\u062a\u0656 \u0648\u064e\u0623\u064e\u0633\u06e1\u0642\u064e\u064a\u06e1\u0646\u064e\u0670\u0643\u064f\u0645 \u0645\u0651\u064e\u0627\u0653\u0621\u0657 \u0641\u064f\u0631\u064e\u0627\u062a\u0657\u0627","translation":"-Ey insanlar!- Yery\u00fcz\u00fcn\u00fcn sars\u0131lmas\u0131n\u0131 \u00f6nleyen y\u00fcksek sabit da\u011flar yaratt\u0131k ve sizlere tatl\u0131 su verdik. Bunlar\u0131 yaratan sizleri tekrar diriltmekten aciz de\u011fildir.","footnotes":null},{"id":"5650","sura":"77","aya":"28","arabic_text":"\u0648\u064e\u064a\u06e1\u0644\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u0650\u0644\u06e1\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e","translation":"O g\u00fcn; helak, azap ve h\u00fcsran Allah\u2019\u0131n onlara verdi\u011fi nimetleri yalanlayanlar\u0131n \u00fczerine olsun!","footnotes":null},{"id":"5651","sura":"77","aya":"29","arabic_text":"\u0671\u0646\u0637\u064e\u0644\u0650\u0642\u064f\u0648\u0653\u0627\u0652 \u0625\u0650\u0644\u064e\u0649\u0670 \u0645\u064e\u0627 \u0643\u064f\u0646\u062a\u064f\u0645 \u0628\u0650\u0647\u0650\u06e6 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064f\u0648\u0646\u064e","translation":"Peygamberlerinin getirmi\u015f olduklar\u0131n\u0131 yalanlayanlara \u015f\u00f6yle denir: \"-Ey yalanlayanlar!- Yalanlay\u0131p durdu\u011funuz azaba girin bakal\u0131m!''","footnotes":null},{"id":"5652","sura":"77","aya":"30","arabic_text":"\u0671\u0646\u0637\u064e\u0644\u0650\u0642\u064f\u0648\u0653\u0627\u0652 \u0625\u0650\u0644\u064e\u0649\u0670 \u0638\u0650\u0644\u0651\u0656 \u0630\u0650\u064a \u062b\u064e\u0644\u064e\u0670\u062b\u0650 \u0634\u064f\u0639\u064e\u0628\u0656","translation":"\u00dc\u00e7 kola ayr\u0131lm\u0131\u015f ate\u015fin duman\u0131n\u0131n g\u00f6lgesine do\u011fru y\u00fcr\u00fcy\u00fcn bakal\u0131m!","footnotes":null},{"id":"5653","sura":"77","aya":"31","arabic_text":"\u0644\u0651\u064e\u0627 \u0638\u064e\u0644\u0650\u064a\u0644\u0656 \u0648\u064e\u0644\u064e\u0627 \u064a\u064f\u063a\u06e1\u0646\u0650\u064a \u0645\u0650\u0646\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064e\u0628\u0650","translation":"Orada g\u00f6lge so\u011fuk de\u011fildir. O g\u00f6lge, ate\u015fin alevinin ve s\u0131cakl\u0131\u011f\u0131n\u0131n size ula\u015fmas\u0131n\u0131 engellemez.","footnotes":null},{"id":"5654","sura":"77","aya":"32","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064e\u0627 \u062a\u064e\u0631\u06e1\u0645\u0650\u064a \u0628\u0650\u0634\u064e\u0631\u064e\u0631\u0656 \u0643\u064e\u0671\u0644\u06e1\u0642\u064e\u0635\u06e1\u0631\u0650","translation":"Ate\u015f, k\u0131v\u0131lc\u0131mlar savurur ve onun her bir k\u0131v\u0131lc\u0131m\u0131n\u0131n b\u00fcy\u00fckl\u00fc\u011f\u00fc sanki bir saray kadard\u0131r.","footnotes":null},{"id":"5655","sura":"77","aya":"33","arabic_text":"\u0643\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u06e5 \u062c\u0650\u0645\u064e\u0670\u0644\u064e\u062a\u065e \u0635\u064f\u0641\u06e1\u0631\u065e","translation":"Savurdu\u011fu k\u0131v\u0131lc\u0131mlar karanl\u0131k ve b\u00fcy\u00fckl\u00fck olarak sanki kara develer gibidir.","footnotes":null},{"id":"5656","sura":"77","aya":"34","arabic_text":"\u0648\u064e\u064a\u06e1\u0644\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u0650\u0644\u06e1\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e","translation":"O g\u00fcn helak, azap ve h\u00fcsran Allah\u2019\u0131n azab\u0131n\u0131 yalanlayanlar\u0131n \u00fczerine olsun!","footnotes":null},{"id":"5657","sura":"77","aya":"35","arabic_text":"\u0647\u064e\u0670\u0630\u064e\u0627 \u064a\u064e\u0648\u06e1\u0645\u064f \u0644\u064e\u0627 \u064a\u064e\u0646\u0637\u0650\u0642\u064f\u0648\u0646\u064e","translation":"Kendilerine izin de verilmez ki \u00f6z\u00fcr bildirsinler.","footnotes":null},{"id":"5658","sura":"77","aya":"36","arabic_text":"\u0648\u064e\u0644\u064e\u0627 \u064a\u064f\u0624\u06e1\u0630\u064e\u0646\u064f \u0644\u064e\u0647\u064f\u0645\u06e1 \u0641\u064e\u064a\u064e\u0639\u06e1\u062a\u064e\u0630\u0650\u0631\u064f\u0648\u0646\u064e","translation":"Onlar\u0131n k\u00fcf\u00fcrleri ve k\u00f6t\u00fcl\u00fcklerinden \u00f6t\u00fcr\u00fc Rablerinden \u00f6z\u00fcr dilemelerine dahi izin verilmez ki, O'ndan \u00f6z\u00fcr dileyebilsinler.","footnotes":null},{"id":"5659","sura":"77","aya":"37","arabic_text":"\u0648\u064e\u064a\u06e1\u0644\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u0650\u0644\u06e1\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e","translation":"O g\u00fcn; helak, azap ve h\u00fcsran o g\u00fcn hakk\u0131ndaki haberleri yalanlayanlar\u0131n \u00fczerine olsun!","footnotes":null},{"id":"5660","sura":"77","aya":"38","arabic_text":"\u0647\u064e\u0670\u0630\u064e\u0627 \u064a\u064e\u0648\u06e1\u0645\u064f \u0671\u0644\u06e1\u0641\u064e\u0635\u06e1\u0644\u0650\u06d6 \u062c\u064e\u0645\u064e\u0639\u06e1\u0646\u064e\u0670\u0643\u064f\u0645\u06e1 \u0648\u064e\u0671\u0644\u06e1\u0623\u064e\u0648\u0651\u064e\u0644\u0650\u064a\u0646\u064e","translation":"\u0130\u015fte bu, kullar\u0131n aras\u0131n\u0131n birbirinden ayr\u0131laca\u011f\u0131 g\u00fcnd\u00fcr. Sizleri ve ge\u00e7mi\u015f \u00fcmmetleri bir alanda toplar\u0131z.","footnotes":null},{"id":"5661","sura":"77","aya":"39","arabic_text":"\u0641\u064e\u0625\u0650\u0646 \u0643\u064e\u0627\u0646\u064e \u0644\u064e\u0643\u064f\u0645\u06e1 \u0643\u064e\u064a\u06e1\u062f\u065e \u0641\u064e\u0643\u0650\u064a\u062f\u064f\u0648\u0646\u0650","translation":"E\u011fer Allah\u2019\u0131n azab\u0131ndan kurtulmak i\u00e7in kurnazca ba\u015fvuraca\u011f\u0131n\u0131z bir hileniz varsa, durmay\u0131n hile yap\u0131n!","footnotes":null},{"id":"5662","sura":"77","aya":"40","arabic_text":"\u0648\u064e\u064a\u06e1\u0644\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u0650\u0644\u06e1\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e","translation":"O g\u00fcn; helak, azap ve h\u00fcsran ayr\u0131m\/h\u00fck\u00fcm g\u00fcn\u00fcn\u00fc yalanlayanlar\u0131n \u00fczerine olsun!","footnotes":null},{"id":"5663","sura":"77","aya":"41","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u06e1\u0645\u064f\u062a\u0651\u064e\u0642\u0650\u064a\u0646\u064e \u0641\u0650\u064a \u0638\u0650\u0644\u064e\u0670\u0644\u0656 \u0648\u064e\u0639\u064f\u064a\u064f\u0648\u0646\u0656","translation":"\u015e\u00fcphesiz emirlerini yerine getirip yasaklar\u0131ndan sak\u0131nmak suretiyle Rablerinden korkan kimseler cennet a\u011fa\u00e7lar\u0131n\u0131n yapraklar\u0131n\u0131n geni\u015f g\u00f6lgeliklerinde ve akan tatl\u0131 su p\u0131narlar\u0131nda olacaklard\u0131r.","footnotes":null},{"id":"5664","sura":"77","aya":"42","arabic_text":"\u0648\u064e\u0641\u064e\u0648\u064e\u0670\u0643\u0650\u0647\u064e \u0645\u0650\u0645\u0651\u064e\u0627 \u064a\u064e\u0634\u06e1\u062a\u064e\u0647\u064f\u0648\u0646\u064e","translation":"Ve de yemeyi arzulad\u0131klar\u0131 meyvelerin aras\u0131ndad\u0131rlar.","footnotes":null},{"id":"5665","sura":"77","aya":"43","arabic_text":"\u0643\u064f\u0644\u064f\u0648\u0627\u0652 \u0648\u064e\u0671\u0634\u06e1\u0631\u064e\u0628\u064f\u0648\u0627\u0652 \u0647\u064e\u0646\u0650\u064a\u0653\u0640\u0654\u064e\u06e2\u0627 \u0628\u0650\u0645\u064e\u0627 \u0643\u064f\u0646\u062a\u064f\u0645\u06e1 \u062a\u064e\u0639\u06e1\u0645\u064e\u0644\u064f\u0648\u0646\u064e","translation":"Onlara \u015f\u00f6yle denir: \u201cD\u00fcnyada yapm\u0131\u015f oldu\u011funuz salih ameller sebebi ile, tertemiz yiyeceklerden yiyin ve i\u00e7inde rahats\u0131z edici bir \u015fey bulunmayan i\u00e7eceklerden afiyetle i\u00e7in.''","footnotes":null},{"id":"5666","sura":"77","aya":"44","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0627 \u0643\u064e\u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0646\u064e\u062c\u06e1\u0632\u0650\u064a \u0671\u0644\u06e1\u0645\u064f\u062d\u06e1\u0633\u0650\u0646\u0650\u064a\u0646\u064e","translation":"Muhakkak biz, sizi \u00f6d\u00fcllendirdi\u011fimiz bu m\u00fck\u00e2fat\u0131n ayn\u0131s\u0131yla, amellerinde ihsan sahibi olan kimseleri de \u00f6d\u00fcllendirece\u011fiz.","footnotes":null},{"id":"5667","sura":"77","aya":"45","arabic_text":"\u0648\u064e\u064a\u06e1\u0644\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u0650\u0644\u06e1\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e","translation":"O g\u00fcn helak, azap ve h\u00fcsran; Allah\u2019\u0131n takva sahipleri i\u00e7in haz\u0131rlad\u0131klar\u0131n\u0131 yalanlayanlar\u0131n \u00fczerine olsun!","footnotes":null},{"id":"5668","sura":"77","aya":"46","arabic_text":"\u0643\u064f\u0644\u064f\u0648\u0627\u0652 \u0648\u064e\u062a\u064e\u0645\u064e\u062a\u0651\u064e\u0639\u064f\u0648\u0627\u0652 \u0642\u064e\u0644\u0650\u064a\u0644\u064b\u0627 \u0625\u0650\u0646\u0651\u064e\u0643\u064f\u0645 \u0645\u0651\u064f\u062c\u06e1\u0631\u0650\u0645\u064f\u0648\u0646\u064e","translation":"Yalanlayanlara da \u015f\u00f6yle denir: \u201cSizler de yiyin ve az bir s\u00fcre d\u00fcnya hayat\u0131n\u0131n lezzetlerinden faydalan\u0131n bakal\u0131m. Ku\u015fkusuz siz, Allah\u2019a kar\u015f\u0131 olan ink\u00e2r\u0131n\u0131z ve resullerini yalanlaman\u0131z sebebiyle g\u00fcnahk\u00e2r kimselersiniz.''","footnotes":null},{"id":"5669","sura":"77","aya":"47","arabic_text":"\u0648\u064e\u064a\u06e1\u0644\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u0650\u0644\u06e1\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e","translation":"O g\u00fcn helak, azap ve h\u00fcsran; hesap g\u00fcn\u00fc kendilerine verilecek cezalar\u0131 yalanlayanlar\u0131n \u00fczerine olsun!","footnotes":null},{"id":"5670","sura":"77","aya":"48","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0642\u0650\u064a\u0644\u064e \u0644\u064e\u0647\u064f\u0645\u064f \u0671\u0631\u06e1\u0643\u064e\u0639\u064f\u0648\u0627\u0652 \u0644\u064e\u0627 \u064a\u064e\u0631\u06e1\u0643\u064e\u0639\u064f\u0648\u0646\u064e","translation":"O yalanlayanlara; \"Allah i\u00e7in namaz k\u0131l\u0131n\u0131z!\u201d denildi\u011fi zaman, O'nun i\u00e7in namaz k\u0131lmazlard\u0131.","footnotes":null},{"id":"5671","sura":"77","aya":"49","arabic_text":"\u0648\u064e\u064a\u06e1\u0644\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u0650\u0644\u06e1\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e","translation":"O g\u00fcn helak, azap ve h\u00fcsran; peygamberlerinin Allah\u2019\u0131n kat\u0131ndan getirdiklerini yalanlayan o ink\u00e2rc\u0131lar\u0131n \u00fczerine olsun!","footnotes":null},{"id":"5672","sura":"77","aya":"50","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u062d\u064e\u062f\u0650\u064a\u062b\u0650\u06ed \u0628\u064e\u0639\u06e1\u062f\u064e\u0647\u064f\u06e5 \u064a\u064f\u0624\u06e1\u0645\u0650\u0646\u064f\u0648\u0646\u064e","translation":"Onlar, Rablerinden indirilmi\u015f olan bu Kur\u2019an\u2019a iman etmeyeceklerse, ondan ba\u015fka hangi s\u00f6ze iman edecekler?","footnotes":null}]}