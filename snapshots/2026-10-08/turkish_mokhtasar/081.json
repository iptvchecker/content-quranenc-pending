er tutu\u015fturulup bir ate\u015fe d\u00f6nd\u00fc\u011f\u00fc zaman,","footnotes":null},{"id":"5807","sura":"81","aya":"7","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0671\u0644\u0646\u0651\u064f\u0641\u064f\u0648\u0633\u064f \u0632\u064f\u0648\u0651\u0650\u062c\u064e\u062a\u06e1","translation":"\u0130nsanlar; kendi benzeri kimselerle e\u015fle\u015ftirilerek su\u00e7lular su\u00e7lularla, takva sahipleri de takva sahipleriyle e\u015fle\u015ftirildi\u011fi zaman.","footnotes":null},{"id":"5808","sura":"81","aya":"8","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0671\u0644\u06e1\u0645\u064e\u0648\u06e1\u0621\u064f\u06e5\u062f\u064e\u0629\u064f \u0633\u064f\u0626\u0650\u0644\u064e\u062a\u06e1","translation":"Allah, diri diri g\u00f6m\u00fclen k\u0131z \u00e7ocu\u011funa sordu\u011fu zaman.","footnotes":null},{"id":"5809","sura":"81","aya":"9","arabic_text":"\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0630\u064e\u0646\u06e2\u0628\u0656 \u0642\u064f\u062a\u0650\u0644\u064e\u062a\u06e1","translation":"Seni \u00f6ld\u00fcren ki\u015fi hangi su\u00e7tan \u00f6t\u00fcr\u00fc seni \u00f6ld\u00fcrd\u00fc (diye)?","footnotes":null},{"id":"5810","sura":"81","aya":"10","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0671\u0644\u0635\u0651\u064f\u062d\u064f\u0641\u064f \u0646\u064f\u0634\u0650\u0631\u064e\u062a\u06e1","translation":"Herkes amel defterini okusun diye, kullar\u0131n amel defterleri a\u00e7\u0131ld\u0131\u011f\u0131 zaman.","footnotes":null},{"id":"5811","sura":"81","aya":"11","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0627\u0653\u0621\u064f \u0643\u064f\u0634\u0650\u0637\u064e\u062a\u06e1","translation":"G\u00f6ky\u00fcz\u00fc, derinin koyundan soyulup \u00e7\u0131kar\u0131ld\u0131\u011f\u0131 gibi s\u00f6k\u00fcl\u00fcp at\u0131ld\u0131\u011f\u0131 zaman.","footnotes":null},{"id":"5812","sura":"81","aya":"12","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0671\u0644\u06e1\u062c\u064e\u062d\u0650\u064a\u0645\u064f \u0633\u064f\u0639\u0651\u0650\u0631\u064e\u062a\u06e1","translation":"Cehennem ate\u015fi tutu\u015fturuldu\u011fu zaman.","footnotes":null},{"id":"5813","sura":"81","aya":"13","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0671\u0644\u06e1\u062c\u064e\u0646\u0651\u064e\u0629\u064f \u0623\u064f\u0632\u06e1\u0644\u0650\u0641\u064e\u062a\u06e1","translation":"Cennet takva sahipleri i\u00e7in yak\u0131nla\u015ft\u0131r\u0131ld\u0131\u011f\u0131 zaman.","footnotes":null},{"id":"5814","sura":"81","aya":"14","arabic_text":"\u0639\u064e\u0644\u0650\u0645\u064e\u062a\u06e1 \u0646\u064e\u0641\u06e1\u0633\u065e \u0645\u0651\u064e\u0627\u0653 \u0623\u064e\u062d\u06e1\u0636\u064e\u0631\u064e\u062a\u06e1","translation":"B\u00fct\u00fcn bunlar oldu\u011fu zaman art\u0131k herkes o g\u00fcn i\u00e7in yapt\u0131\u011f\u0131 amelleri bilecektir.","footnotes":null},{"id":"5815","sura":"81","aya":"15","arabic_text":"\u0641\u064e\u0644\u064e\u0627\u0653 \u0623\u064f\u0642\u06e1\u0633\u0650\u0645\u064f \u0628\u0650\u0671\u0644\u06e1\u062e\u064f\u0646\u0651\u064e\u0633\u0650","translation":"Allah Te\u00e2l\u00e2, gece ortaya \u00e7\u0131kmadan \u00f6nce gizlenen y\u0131ld\u0131zlara yemin etmi\u015ftir.","footnotes":null},{"id":"5816","sura":"81","aya":"16","arabic_text":"\u0671\u0644\u06e1\u062c\u064e\u0648\u064e\u0627\u0631\u0650 \u0671\u0644\u06e1\u0643\u064f\u0646\u0651\u064e\u0633\u0650","translation":"Sabah\u0131n do\u011fu\u015fuyla kaybolan, ma\u011faras\u0131na yani yuvas\u0131na giren bir ceylan gibi y\u00f6r\u00fcngesinde ak\u0131p giden y\u0131ld\u0131zlara.","footnotes":null},{"id":"5817","sura":"81","aya":"17","arabic_text":"\u0648\u064e\u0671\u0644\u0651\u064e\u064a\u06e1\u0644\u0650 \u0625\u0650\u0630\u064e\u0627 \u0639\u064e\u0633\u06e1\u0639\u064e\u0633\u064e","translation":"Yakla\u015fmakta olan gecenin ba\u015flang\u0131c\u0131na ve gitmekte olan gecenin sonuna yemin etmi\u015ftir.","footnotes":null},{"id":"5818","sura":"81","aya":"18","arabic_text":"\u0648\u064e\u0671\u0644\u0635\u0651\u064f\u0628\u06e1\u062d\u0650 \u0625\u0650\u0630\u064e\u0627 \u062a\u064e\u0646\u064e\u0641\u0651\u064e\u0633\u064e","translation":"I\u015f\u0131\u011f\u0131 ortaya \u00e7\u0131kt\u0131\u011f\u0131nda sabaha yemin etmi\u015ftir.","footnotes":null},{"id":"5819","sura":"81","aya":"19","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0644\u064e\u0642\u064e\u0648\u06e1\u0644\u064f \u0631\u064e\u0633\u064f\u0648\u0644\u0656 \u0643\u064e\u0631\u0650\u064a\u0645\u0656","translation":"Muhammed -sallallahu aleyhi ve sellem-'e inen Kur'an, pek g\u00fcvenilir bir melek olan Cebrail -aleyhisselam-'\u0131n tebli\u011f etti\u011fi Allah kelam\u0131d\u0131r. Allah Kur'an'\u0131 ona emanet etmi\u015ftir.","footnotes":null},{"id":"5820","sura":"81","aya":"20","arabic_text":"\u0630\u0650\u064a \u0642\u064f\u0648\u0651\u064e\u0629\u064d \u0639\u0650\u0646\u062f\u064e \u0630\u0650\u064a \u0671\u0644\u06e1\u0639\u064e\u0631\u06e1\u0634\u0650 \u0645\u064e\u0643\u0650\u064a\u0646\u0656","translation":"O, kuvvet sahibidir. Ar\u015f\u0131n Rabbi olan Allah -Subh\u00e2nehu ve Te\u00e2l\u00e2- kat\u0131nda y\u00fcce bir makama sahiptir.","footnotes":null},{"id":"5821","sura":"81","aya":"21","arabic_text":"\u0645\u0651\u064f\u0637\u064e\u0627\u0639\u0656 \u062b\u064e\u0645\u0651\u064e \u0623\u064e\u0645\u0650\u064a\u0646\u0656","translation":"G\u00f6ky\u00fcz\u00fc ahalisi ona itaat eder, ayr\u0131ca bildirdi\u011fi vahiy konusunda g\u00fcvenilirdir.","footnotes":null},{"id":"5822","sura":"81","aya":"22","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u0635\u064e\u0627\u062d\u0650\u0628\u064f\u0643\u064f\u0645 \u0628\u0650\u0645\u064e\u062c\u06e1\u0646\u064f\u0648\u0646\u0656","translation":"S\u00fcrekli yan\u0131n\u0131zda olan, g\u00fcvenilirli\u011fini ve do\u011fru s\u00f6zl\u00fc oldu\u011funu bildi\u011finiz Muhammed -sallallahu aleyhi ve sellem- sizin iftira at\u0131p, iddia etti\u011finiz gibi bir deli de\u011fildir.","footnotes":null},{"id":"5823","sura":"81","aya":"23","arabic_text":"\u0648\u064e\u0644\u064e\u0642\u064e\u062f\u06e1 \u0631\u064e\u0621\u064e\u0627\u0647\u064f \u0628\u0650\u0671\u0644\u06e1\u0623\u064f\u0641\u064f\u0642\u0650 \u0671\u0644\u06e1\u0645\u064f\u0628\u0650\u064a\u0646\u0650","translation":"\u015e\u00fcphesiz arkada\u015f\u0131n\u0131z, Cebrail\u2019i yarat\u0131ld\u0131\u011f\u0131 surette g\u00f6ky\u00fcz\u00fcn\u00fcn ufkunda a\u00e7\u0131k\u00e7a g\u00f6rd\u00fc.","footnotes":null},{"id":"5824","sura":"81","aya":"24","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u0647\u064f\u0648\u064e \u0639\u064e\u0644\u064e\u0649 \u0671\u0644\u06e1\u063a\u064e\u064a\u06e1\u0628\u0650 \u0628\u0650\u0636\u064e\u0646\u0650\u064a\u0646\u0656","translation":"Arkada\u015f\u0131n\u0131z, kendisi arac\u0131l\u0131\u011f\u0131yla size bildirilmesi emredilmi\u015f olan \u015feyi tebli\u011f etmede size kar\u015f\u0131 cimrilik yapmaz. K\u00e2hinlerin ald\u0131\u011f\u0131 gibi bir \u00fccret de almaz.","footnotes":null},{"id":"5825","sura":"81","aya":"25","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u0647\u064f\u0648\u064e \u0628\u0650\u0642\u064e\u0648\u06e1\u0644\u0650 \u0634\u064e\u064a\u06e1\u0637\u064e\u0670\u0646\u0656 \u0631\u0651\u064e\u062c\u0650\u064a\u0645\u0656","translation":"Bu Kur\u2019an, Allah\u2019\u0131n rahmetinden kovulmu\u015f olan \u015feytan\u0131n s\u00f6z\u00fc de de\u011fildir.","footnotes":null},{"id":"5826","sura":"81","aya":"26","arabic_text":"\u0641\u064e\u0623\u064e\u064a\u06e1\u0646\u064e \u062a\u064e\u0630\u06e1\u0647\u064e\u0628\u064f\u0648\u0646\u064e","translation":"Bu delillerinden sonra onun Allah Te\u00e2l\u00e2 taraf\u0131ndan oldu\u011funu ink\u00e2r etmek i\u00e7in hangi yola ba\u015fvuruyorsunuz?","footnotes":null},{"id":"5827","sura":"81","aya":"27","arabic_text":"\u0625\u0650\u0646\u06e1 \u0647\u064f\u0648\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0630\u0650\u0643\u06e1\u0631\u065e \u0644\u0651\u0650\u0644\u06e1\u0639\u064e\u0670\u0644\u064e\u0645\u0650\u064a\u0646\u064e","translation":"Kur'an, cinler ve insanlar i\u00e7in yaln\u0131zca bir \u00f6\u011f\u00fct ve nasihattir.","footnotes":null},{"id":"5828","sura":"81","aya":"28","arabic_text":"\u0644\u0650\u0645\u064e\u0646 \u0634\u064e\u0627\u0653\u0621\u064e \u0645\u0650\u0646\u0643\u064f\u0645\u06e1 \u0623\u064e\u0646 \u064a\u064e\u0633\u06e1\u062a\u064e\u0642\u0650\u064a\u0645\u064e","translation":"Sizin i\u00e7inizden hak yolda dosdo\u011fru olmay\u0131 dileyen kimseler i\u00e7in.","footnotes":null},{"id":"5829","sura":"81","aya":"29","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u062a\u064e\u0634\u064e\u0627\u0653\u0621\u064f\u0648\u0646\u064e \u0625\u0650\u0644\u0651\u064e\u0627\u0653 \u0623\u064e\u0646 \u064a\u064e\u0634\u064e\u0627\u0653\u0621\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0631\u064e\u0628\u0651\u064f \u0671\u0644\u06e1\u0639\u064e\u0670\u0644\u064e\u0645\u0650\u064a\u0646\u064e","translation":"B\u00fct\u00fcn varl\u0131klar\u0131n Rabbi olan Allah dilemedik\u00e7e, siz dosdo\u011fru olmay\u0131 veya ba\u015fka bir \u015feyi dileyemezsiniz.","footnotes":null}]}