{"result":[{"id":"6059","sura":"92","aya":"1","arabic_text":"\u0648\u064e\u0671\u0644\u0651\u064e\u064a\u06e1\u0644\u0650 \u0625\u0650\u0630\u064e\u0627 \u064a\u064e\u063a\u06e1\u0634\u064e\u0649\u0670","translation":"Y\u00fcce Allah, g\u00f6ky\u00fcz\u00fcyle yery\u00fcz\u00fcn\u00fcn aras\u0131n\u0131 karanl\u0131\u011f\u0131yla kaplad\u0131\u011f\u0131 zaman geceye yemin etmi\u015ftir.","footnotes":null},{"id":"6060","sura":"92","aya":"2","arabic_text":"\u0648\u064e\u0671\u0644\u0646\u0651\u064e\u0647\u064e\u0627\u0631\u0650 \u0625\u0650\u0630\u064e\u0627 \u062a\u064e\u062c\u064e\u0644\u0651\u064e\u0649\u0670","translation":"Ve ortaya \u00e7\u0131k\u0131p g\u00f6r\u00fcnd\u00fc\u011f\u00fcnde g\u00fcnd\u00fcze yemin etmi\u015ftir.","footnotes":null},{"id":"6061","sura":"92","aya":"3","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u062e\u064e\u0644\u064e\u0642\u064e \u0671\u0644\u0630\u0651\u064e\u0643\u064e\u0631\u064e \u0648\u064e\u0671\u0644\u06e1\u0623\u064f\u0646\u062b\u064e\u0649\u0670\u0653","translation":"Yaratt\u0131\u011f\u0131 iki t\u00fcr \u00fczerine yemin etmi\u015ftir. Bu t\u00fcr erkek ve di\u015fidir.","footnotes":null},{"id":"6062","sura":"92","aya":"4","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0633\u064e\u0639\u06e1\u064a\u064e\u0643\u064f\u0645\u06e1 \u0644\u064e\u0634\u064e\u062a\u0651\u064e\u0649\u0670","translation":"-Ey insanlar!- \u015e\u00fcphesiz yapt\u0131klar\u0131n\u0131z birbirinden farkl\u0131d\u0131r. Bir k\u0131sm\u0131 cennete girme sebebi olan iyiliklerden, bir k\u0131sm\u0131 da cehenneme girme sebebi olan k\u00f6t\u00fcl\u00fcklerdendir.","footnotes":null},{"id":"6063","sura":"92","aya":"5","arabic_text":"\u0641\u064e\u0623\u064e\u0645\u0651\u064e\u0627 \u0645\u064e\u0646\u06e1 \u0623\u064e\u0639\u06e1\u0637\u064e\u0649\u0670 \u0648\u064e\u0671\u062a\u0651\u064e\u0642\u064e\u0649\u0670","translation":"Kim vermesi gereken zek\u00e2t, nafaka ve sadakas\u0131n\u0131 verir ve Allah\u2019\u0131n yasaklad\u0131\u011f\u0131 \u015feylerden sak\u0131n\u0131rsa.","footnotes":null},{"id":"6064","sura":"92","aya":"6","arabic_text":"\u0648\u064e\u0635\u064e\u062f\u0651\u064e\u0642\u064e \u0628\u0650\u0671\u0644\u06e1\u062d\u064f\u0633\u06e1\u0646\u064e\u0649\u0670","translation":"Y\u00fcce Allah\u2019\u0131n ki\u015fiye \u00f6l\u00fcm\u00fcn\u00fcn ard\u0131ndan vadetti\u011fi cenneti tasdik ederse.","footnotes":null},{"id":"6065","sura":"92","aya":"7","arabic_text":"\u0641\u064e\u0633\u064e\u0646\u064f\u064a\u064e\u0633\u0651\u0650\u0631\u064f\u0647\u064f\u06e5 \u0644\u0650\u0644\u06e1\u064a\u064f\u0633\u06e1\u0631\u064e\u0649\u0670","translation":"Biz de ona, salih ameller i\u015flemeyi ve Allah yolunda infak etmeyi kolayla\u015ft\u0131raca\u011f\u0131z.","footnotes":null},{"id":"6066","sura":"92","aya":"8","arabic_text":"\u0648\u064e\u0623\u064e\u0645\u0651\u064e\u0627 \u0645\u064e\u0646\u06e2 \u0628\u064e\u062e\u0650\u0644\u064e \u0648\u064e\u0671\u0633\u06e1\u062a\u064e\u063a\u06e1\u0646\u064e\u0649\u0670","translation":"Fakat her kim de mal\u0131nda cimrilik ederse ve \u00fczerine farz olan yerlerde onu harcamaz, mal\u0131ndan \u00f6t\u00fcr\u00fc Allah\u2019a kar\u015f\u0131 kendini yeterli g\u00f6r\u00fcr ve Allah\u2019\u0131n kereminden hi\u00e7bir \u015fey istemezse.","footnotes":null},{"id":"6067","sura":"92","aya":"9","arabic_text":"\u0648\u064e\u0643\u064e\u0630\u0651\u064e\u0628\u064e \u0628\u0650\u0671\u0644\u06e1\u062d\u064f\u0633\u06e1\u0646\u064e\u0649\u0670","translation":"Mal\u0131n\u0131 Allah yolunda infak etmesine kar\u015f\u0131l\u0131k Allah Te\u00e2l\u00e2'n\u0131n vadetti\u011fi ve kendisinin ard\u0131ndan gelecek olan\u0131 ve sevab\u0131 yalanlarsa.","footnotes":null},{"id":"6068","sura":"92","aya":"10","arabic_text":"\u0641\u064e\u0633\u064e\u0646\u064f\u064a\u064e\u0633\u0651\u0650\u0631\u064f\u0647\u064f\u06e5 \u0644\u0650\u0644\u06e1\u0639\u064f\u0633\u06e1\u0631\u064e\u0649\u0670","translation":"Ona; k\u00f6t\u00fc amelleri kolayla\u015ft\u0131r\u0131p, hay\u0131rl\u0131 amelleri zorla\u015ft\u0131r\u0131r\u0131z.","footnotes":null},{"id":"6069","sura":"92","aya":"11","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u064a\u064f\u063a\u06e1\u0646\u0650\u064a \u0639\u064e\u0646\u06e1\u0647\u064f \u0645\u064e\u0627\u0644\u064f\u0647\u064f\u06e5\u0653 \u0625\u0650\u0630\u064e\u0627 \u062a\u064e\u0631\u064e\u062f\u0651\u064e\u0649\u0670\u0653","translation":"\u00d6l\u00fcp cehenneme girdi\u011finde, cimrilik yapt\u0131\u011f\u0131 mal\u0131 ona herhangi bir fayda vermeyecek.","footnotes":null},{"id":"6070","sura":"92","aya":"12","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0639\u064e\u0644\u064e\u064a\u06e1\u0646\u064e\u0627 \u0644\u064e\u0644\u06e1\u0647\u064f\u062f\u064e\u0649\u0670","translation":"Muhakkak bizim g\u00f6revimiz, hak yolu bat\u0131l yoldan ay\u0131r\u0131p beyan etmektir.","footnotes":null},{"id":"6071","sura":"92","aya":"13","arabic_text":"\u0648\u064e\u0625\u0650\u0646\u0651\u064e \u0644\u064e\u0646\u064e\u0627 \u0644\u064e\u0644\u06e1\u0623\u0653\u062e\u0650\u0631\u064e\u0629\u064e \u0648\u064e\u0671\u0644\u06e1\u0623\u064f\u0648\u0644\u064e\u0649\u0670","translation":"Muhakkak ahiret hayat\u0131 da d\u00fcnya hayat\u0131 da bize aittir. Buralarda diledi\u011fimiz gibi tasarrufta bulunuruz. Bunu bizden ba\u015fka hi\u00e7 kimse yapamaz.","footnotes":null},{"id":"6072","sura":"92","aya":"14","arabic_text":"\u0641\u064e\u0623\u064e\u0646\u0630\u064e\u0631\u06e1\u062a\u064f\u0643\u064f\u0645\u06e1 \u0646\u064e\u0627\u0631\u0657\u0627 \u062a\u064e\u0644\u064e\u0638\u0651\u064e\u0649\u0670","translation":"-Ey insanlar!- Allah\u2019a kar\u015f\u0131 gelmeniz durumunda, tutu\u015fturulmu\u015f ate\u015fe kar\u015f\u0131 sizi uyard\u0131m.","footnotes":null},{"id":"6073","sura":"92","aya":"15","arabic_text":"\u0644\u064e\u0627 \u064a\u064e\u0635\u06e1\u0644\u064e\u0649\u0670\u0647\u064e\u0627\u0653 \u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0644\u06e1\u0623\u064e\u0634\u06e1\u0642\u064e\u0649","translation":"Bu ate\u015fin s\u0131cakl\u0131\u011f\u0131n\u0131n \u0131zd\u0131rab\u0131n\u0131, k\u00e2fir olan en bahts\u0131z\/azg\u0131n kimseden ba\u015fkas\u0131 \u00e7ekmeyecektir.","footnotes":null},{"id":"6074","sura":"92","aya":"16","arabic_text":"\u0671\u0644\u0651\u064e\u0630\u0650\u064a \u0643\u064e\u0630\u0651\u064e\u0628\u064e \u0648\u064e\u062a\u064e\u0648\u064e\u0644\u0651\u064e\u0649\u0670","translation":"Peygamber -sallallahu aleyhi ve sellem-'in getirdiklerini yalanlam\u0131\u015f ve Allah\u2019\u0131n emirlerini yerine getirmekten y\u00fcz \u00e7evirmi\u015ftir.","footnotes":null},{"id":"6075","sura":"92","aya":"17","arabic_text":"\u0648\u064e\u0633\u064e\u064a\u064f\u062c\u064e\u0646\u0651\u064e\u0628\u064f\u0647\u064e\u0627 \u0671\u0644\u06e1\u0623\u064e\u062a\u06e1\u0642\u064e\u0649","translation":"\u0130nsanlar\u0131n en takval\u0131s\u0131 olan Ebu Bekir -rad\u0131yallahu anh- oradan uzak tutulacakt\u0131r.","footnotes":null},{"id":"6076","sura":"92","aya":"18","arabic_text":"\u0671\u0644\u0651\u064e\u0630\u0650\u064a \u064a\u064f\u0624\u06e1\u062a\u0650\u064a \u0645\u064e\u0627\u0644\u064e\u0647\u064f\u06e5 \u064a\u064e\u062a\u064e\u0632\u064e\u0643\u0651\u064e\u0649\u0670","translation":"G\u00fcnahlar\u0131ndan temizlenmek i\u00e7in mal\u0131n\u0131 iyilik yolunda infak eden.","footnotes":null},{"id":"6077","sura":"92","aya":"19","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u0644\u0650\u0623\u064e\u062d\u064e\u062f\u064d \u0639\u0650\u0646\u062f\u064e\u0647\u064f\u06e5 \u0645\u0650\u0646 \u0646\u0651\u0650\u0639\u06e1\u0645\u064e\u0629\u0656 \u062a\u064f\u062c\u06e1\u0632\u064e\u0649\u0670\u0653","translation":"O; mal\u0131ndan infak ettiklerini, birinin ona verdi\u011fi bir nimete kar\u015f\u0131l\u0131k olarak, infak etmemi\u015ftir.","footnotes":null},{"id":"6078","sura":"92","aya":"20","arabic_text":"\u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0628\u06e1\u062a\u0650\u063a\u064e\u0627\u0653\u0621\u064e \u0648\u064e\u062c\u06e1\u0647\u0650 \u0631\u064e\u0628\u0651\u0650\u0647\u0650 \u0671\u0644\u06e1\u0623\u064e\u0639\u06e1\u0644\u064e\u0649\u0670","translation":"O kimse infak etti\u011fi mal\u0131yla t\u00fcm canl\u0131lar\u0131n \u00fczerinde olan Rabbinin vechini isteyip, arzular.","footnotes":null},{"id":"6079","sura":"92","aya":"21","arabic_text":"\u0648\u064e\u0644\u064e\u0633\u064e\u0648\u06e1\u0641\u064e \u064a\u064e\u0631\u06e1\u0636\u064e\u0649\u0670","translation":"Allah Te\u00e2l\u00e2\u2019n\u0131n ona verece\u011fi de\u011ferli m\u00fck\u00e2fattan elbette o da raz\u0131 olacakt\u0131r.","footnotes":null}]}