{"result":[{"id":"5324","sura":"69","aya":"1","arabic_text":"\u0671\u0644\u06e1\u062d\u064e\u0627\u0653\u0642\u0651\u064e\u0629\u064f","translation":"Allah Te\u00e2l\u00e2, herkes \u00fczerinde ger\u00e7ekle\u015fecek olan yeniden dirili\u015f saatini zikrediyor.","footnotes":null},{"id":"5325","sura":"69","aya":"2","arabic_text":"\u0645\u064e\u0627 \u0671\u0644\u06e1\u062d\u064e\u0627\u0653\u0642\u0651\u064e\u0629\u064f","translation":"Sonra da; \u201cGer\u00e7ekle\u015fecek olan o k\u0131yamet nedir?\u201d sorusuyla onun durumunu y\u00fcceltiyor.","footnotes":null},{"id":"5326","sura":"69","aya":"3","arabic_text":"\u0648\u064e\u0645\u064e\u0627\u0653 \u0623\u064e\u062f\u06e1\u0631\u064e\u0649\u0670\u0643\u064e \u0645\u064e\u0627 \u0671\u0644\u06e1\u062d\u064e\u0627\u0653\u0642\u0651\u064e\u0629\u064f","translation":"Ger\u00e7ekle\u015fecek olan bu k\u0131yametin ne oldu\u011funu sana ne \u00f6\u011fretti?","footnotes":null},{"id":"5327","sura":"69","aya":"4","arabic_text":"\u0643\u064e\u0630\u0651\u064e\u0628\u064e\u062a\u06e1 \u062b\u064e\u0645\u064f\u0648\u062f\u064f \u0648\u064e\u0639\u064e\u0627\u062f\u064f\u06e2 \u0628\u0650\u0671\u0644\u06e1\u0642\u064e\u0627\u0631\u0650\u0639\u064e\u0629\u0650","translation":"Salih\u2019in kavmi Sem\u00fbd ve H\u00fbd\u2019un kavmi \u00c2d, deh\u015fetinin \u015fiddeti sebebiyle b\u00fct\u00fcn insanlar\u0131n korkuya kap\u0131ld\u0131\u011f\u0131 k\u0131yameti ink\u00e2r ettiler.","footnotes":null},{"id":"5328","sura":"69","aya":"5","arabic_text":"\u0641\u064e\u0623\u064e\u0645\u0651\u064e\u0627 \u062b\u064e\u0645\u064f\u0648\u062f\u064f \u0641\u064e\u0623\u064f\u0647\u06e1\u0644\u0650\u0643\u064f\u0648\u0627\u0652 \u0628\u0650\u0671\u0644\u0637\u0651\u064e\u0627\u063a\u0650\u064a\u064e\u0629\u0650","translation":"Bu y\u00fczden Allah, Sem\u00fbd kavmini \u015fiddet ve korku vermede son haddine ula\u015fm\u0131\u015f bir \u00e7\u0131\u011fl\u0131kla helak etti.","footnotes":null},{"id":"5329","sura":"69","aya":"6","arabic_text":"\u0648\u064e\u0623\u064e\u0645\u0651\u064e\u0627 \u0639\u064e\u0627\u062f\u065e \u0641\u064e\u0623\u064f\u0647\u06e1\u0644\u0650\u0643\u064f\u0648\u0627\u0652 \u0628\u0650\u0631\u0650\u064a\u062d\u0656 \u0635\u064e\u0631\u06e1\u0635\u064e\u0631\u064d \u0639\u064e\u0627\u062a\u0650\u064a\u064e\u0629\u0656","translation":"Allah Te\u00e2l\u00e2, \u00c2d kavmini de \u00fczerlerine \u015fiddetle esen so\u011fuk bir r\u00fczg\u00e2r g\u00f6ndererek helak etti.","footnotes":null},{"id":"5330","sura":"69","aya":"7","arabic_text":"\u0633\u064e\u062e\u0651\u064e\u0631\u064e\u0647\u064e\u0627 \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u0650\u0645\u06e1 \u0633\u064e\u0628\u06e1\u0639\u064e \u0644\u064e\u064a\u064e\u0627\u0644\u0656 \u0648\u064e\u062b\u064e\u0645\u064e\u0670\u0646\u0650\u064a\u064e\u0629\u064e \u0623\u064e\u064a\u0651\u064e\u0627\u0645\u064d \u062d\u064f\u0633\u064f\u0648\u0645\u0657\u0627\u06d6 \u0641\u064e\u062a\u064e\u0631\u064e\u0649 \u0671\u0644\u06e1\u0642\u064e\u0648\u06e1\u0645\u064e \u0641\u0650\u064a\u0647\u064e\u0627 \u0635\u064e\u0631\u06e1\u0639\u064e\u0649\u0670 \u0643\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u0645\u06e1 \u0623\u064e\u0639\u06e1\u062c\u064e\u0627\u0632\u064f \u0646\u064e\u062e\u06e1\u0644\u064d \u062e\u064e\u0627\u0648\u0650\u064a\u064e\u0629\u0656","translation":"Y\u00fcce Allah, o r\u00fczg\u00e2r\u0131 yedi gece sekiz g\u00fcnd\u00fcz boyunca onlara g\u00f6ndererek istisnas\u0131z olarak herkesi yok etti. \u0130nsanlar\u0131 yurtlar\u0131nda helak olmu\u015f, yerlerde sersefil g\u00f6r\u00fcrs\u00fcn. Onlar helak olmalar\u0131n\u0131n ard\u0131ndan sanki yere devrilmi\u015f \u00e7\u00fcr\u00fcm\u00fc\u015f bir hurma a\u011fac\u0131 g\u00f6vdesi gibiydi.","footnotes":null},{"id":"5331","sura":"69","aya":"8","arabic_text":"\u0641\u064e\u0647\u064e\u0644\u06e1 \u062a\u064e\u0631\u064e\u0649\u0670 \u0644\u064e\u0647\u064f\u0645 \u0645\u0651\u0650\u0646\u06e2 \u0628\u064e\u0627\u0642\u0650\u064a\u064e\u0629\u0656","translation":"Kendilerine azab\u0131n isabet etmesinin ard\u0131ndan geride kalan bir kimse g\u00f6r\u00fcyor musun?","footnotes":null},{"id":"5332","sura":"69","aya":"9","arabic_text":"\u0648\u064e\u062c\u064e\u0627\u0653\u0621\u064e \u0641\u0650\u0631\u06e1\u0639\u064e\u0648\u06e1\u0646\u064f \u0648\u064e\u0645\u064e\u0646 \u0642\u064e\u0628\u06e1\u0644\u064e\u0647\u064f\u06e5 \u0648\u064e\u0671\u0644\u06e1\u0645\u064f\u0624\u06e1\u062a\u064e\u0641\u0650\u0643\u064e\u0670\u062a\u064f \u0628\u0650\u0671\u0644\u06e1\u062e\u064e\u0627\u0637\u0650\u0626\u064e\u0629\u0650","translation":"Firavun ve ondan \u00f6nce gelmi\u015f baz\u0131 milletler alt \u00fcst edilerek azap olundular. Onlar Lut'un kavmiydi. \u015eirk ve g\u00fcnahlardan olu\u015fan \u00e7ok yanl\u0131\u015f ameller i\u015flediler.","footnotes":null},{"id":"5333","sura":"69","aya":"10","arabic_text":"\u0641\u064e\u0639\u064e\u0635\u064e\u0648\u06e1\u0627\u0652 \u0631\u064e\u0633\u064f\u0648\u0644\u064e \u0631\u064e\u0628\u0651\u0650\u0647\u0650\u0645\u06e1 \u0641\u064e\u0623\u064e\u062e\u064e\u0630\u064e\u0647\u064f\u0645\u06e1 \u0623\u064e\u062e\u06e1\u0630\u064e\u0629\u0657 \u0631\u0651\u064e\u0627\u0628\u0650\u064a\u064e\u0629\u064b","translation":"Onlardan her biri kendilerine g\u00f6nderilen el\u00e7iye kar\u015f\u0131 geldi ve onu yalanlad\u0131. Allah Te\u00e2l\u00e2 da helak olmalar\u0131n\u0131 sa\u011flayan \u015fiddetli bir azapla onlar\u0131 yakalay\u0131verdi.","footnotes":null},{"id":"5334","sura":"69","aya":"11","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0627 \u0644\u064e\u0645\u0651\u064e\u0627 \u0637\u064e\u063a\u064e\u0627 \u0671\u0644\u06e1\u0645\u064e\u0627\u0653\u0621\u064f \u062d\u064e\u0645\u064e\u0644\u06e1\u0646\u064e\u0670\u0643\u064f\u0645\u06e1 \u0641\u0650\u064a \u0671\u0644\u06e1\u062c\u064e\u0627\u0631\u0650\u064a\u064e\u0629\u0650","translation":"Elbette biz, su y\u00fckselip, ta\u015ft\u0131\u011f\u0131 zaman Nuh -aleyhisselam-'\u0131n emrimizle in\u015fa etti\u011fi ve suda ak\u0131p giden gemi i\u00e7inde onlar\u0131 ta\u015f\u0131d\u0131k. Sonras\u0131nda sizler onlar\u0131n soyundan meydana geldiniz. Asl\u0131nda bu sizin ta\u015f\u0131nman\u0131z say\u0131l\u0131rd\u0131.","footnotes":null},{"id":"5335","sura":"69","aya":"12","arabic_text":"\u0644\u0650\u0646\u064e\u062c\u06e1\u0639\u064e\u0644\u064e\u0647\u064e\u0627 \u0644\u064e\u0643\u064f\u0645\u06e1 \u062a\u064e\u0630\u06e1\u0643\u0650\u0631\u064e\u0629\u0657 \u0648\u064e\u062a\u064e\u0639\u0650\u064a\u064e\u0647\u064e\u0627\u0653 \u0623\u064f\u0630\u064f\u0646\u065e \u0648\u064e\u0670\u0639\u0650\u064a\u064e\u0629\u065e","translation":"Biz, elbette gemiyi ve onun hikayesini k\u00e2firlerin helak olaca\u011f\u0131 ve iman ehlinin kurtulaca\u011f\u0131n\u0131n kan\u0131t\u0131 olarak sunulan bir \u00f6\u011f\u00fct k\u0131laca\u011f\u0131z. Ve kulaklar o k\u0131ssay\u0131 duydu\u011fu zaman eksiksiz olarak ezberleyip, anlayacaklar.","footnotes":null},{"id":"5336","sura":"69","aya":"13","arabic_text":"\u0641\u064e\u0625\u0650\u0630\u064e\u0627 \u0646\u064f\u0641\u0650\u062e\u064e \u0641\u0650\u064a \u0671\u0644\u0635\u0651\u064f\u0648\u0631\u0650 \u0646\u064e\u0641\u06e1\u062e\u064e\u0629\u065e \u0648\u064e\u0670\u062d\u0650\u062f\u064e\u0629\u065e","translation":"S\u00fbr'a yani boynuza \u00fcflemeyle sorumlu melek, ikinci \u00fcfleyi\u015finde S\u00fbr'a bir defa \u00fcfledi\u011fi zaman.","footnotes":null},{"id":"5337","sura":"69","aya":"14","arabic_text":"\u0648\u064e\u062d\u064f\u0645\u0650\u0644\u064e\u062a\u0650 \u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u064f \u0648\u064e\u0671\u0644\u06e1\u062c\u0650\u0628\u064e\u0627\u0644\u064f \u0641\u064e\u062f\u064f\u0643\u0651\u064e\u062a\u064e\u0627 \u062f\u064e\u0643\u0651\u064e\u0629\u0657 \u0648\u064e\u0670\u062d\u0650\u062f\u064e\u0629\u0657","translation":"Yery\u00fcz\u00fc ve da\u011flar kald\u0131r\u0131l\u0131p \u015fiddetli bir \u015fekilde tek bir defa birbirine vurulup da yery\u00fcz\u00fcn\u00fcn ve da\u011flar\u0131n par\u00e7alar\u0131 ufalanarak par\u00e7a par\u00e7a da\u011f\u0131ld\u0131\u011f\u0131nda.","footnotes":null},{"id":"5338","sura":"69","aya":"15","arabic_text":"\u0641\u064e\u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0648\u064e\u0642\u064e\u0639\u064e\u062a\u0650 \u0671\u0644\u06e1\u0648\u064e\u0627\u0642\u0650\u0639\u064e\u0629\u064f","translation":"Bunlar\u0131n hepsi meydana geldi\u011fi o g\u00fcn k\u0131yamet ger\u00e7ekle\u015fmi\u015f olacakt\u0131r.","footnotes":null},{"id":"5339","sura":"69","aya":"16","arabic_text":"\u0648\u064e\u0671\u0646\u0634\u064e\u0642\u0651\u064e\u062a\u0650 \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0627\u0653\u0621\u064f \u0641\u064e\u0647\u0650\u064a\u064e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0648\u064e\u0627\u0647\u0650\u064a\u064e\u0629\u065e","translation":"O g\u00fcn meleklerin oradan inmeleri sebebiyle g\u00f6ky\u00fcz\u00fc yar\u0131l\u0131r. G\u00f6ky\u00fcz\u00fc sa\u011flam ve s\u0131ms\u0131k\u0131 olmas\u0131n\u0131n ard\u0131ndan art\u0131k o g\u00fcn \u00e7ok zay\u0131ft\u0131r.","footnotes":null},{"id":"5340","sura":"69","aya":"17","arabic_text":"\u0648\u064e\u0671\u0644\u06e1\u0645\u064e\u0644\u064e\u0643\u064f \u0639\u064e\u0644\u064e\u0649\u0670\u0653 \u0623\u064e\u0631\u06e1\u062c\u064e\u0627\u0653\u0626\u0650\u0647\u064e\u0627\u06da \u0648\u064e\u064a\u064e\u062d\u06e1\u0645\u0650\u0644\u064f \u0639\u064e\u0631\u06e1\u0634\u064e \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0641\u064e\u0648\u06e1\u0642\u064e\u0647\u064f\u0645\u06e1 \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u062b\u064e\u0645\u064e\u0670\u0646\u0650\u064a\u064e\u0629\u065e","translation":"Melekler de g\u00f6ky\u00fcz\u00fcn\u00fcn \u00e7evresinde ve kenar\u0131ndad\u0131rlar ve o b\u00fcy\u00fck g\u00fcn Rabbinin ar\u015f\u0131n\u0131 meleklerden yak\u0131n k\u0131l\u0131nm\u0131\u015f sekiz melek ta\u015f\u0131r.","footnotes":null},{"id":"5341","sura":"69","aya":"18","arabic_text":"\u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u062a\u064f\u0639\u06e1\u0631\u064e\u0636\u064f\u0648\u0646\u064e \u0644\u064e\u0627 \u062a\u064e\u062e\u06e1\u0641\u064e\u0649\u0670 \u0645\u0650\u0646\u0643\u064f\u0645\u06e1 \u062e\u064e\u0627\u0641\u0650\u064a\u064e\u0629\u065e","translation":"-Ey insanlar!- O g\u00fcn Allah\u2019\u0131n huzuruna sunulacaks\u0131n\u0131z. Ne olursa olsun, Allah\u2019a hi\u00e7bir s\u0131rr\u0131n\u0131z gizli kalmaz. Bilakis Allah; her \u015feyi bilir, onlardan haberdard\u0131r.","footnotes":null},{"id":"5342","sura":"69","aya":"19","arabic_text":"\u0641\u064e\u0623\u064e\u0645\u0651\u064e\u0627 \u0645\u064e\u0646\u06e1 \u0623\u064f\u0648\u062a\u0650\u064a\u064e \u0643\u0650\u062a\u064e\u0670\u0628\u064e\u0647\u064f\u06e5 \u0628\u0650\u064a\u064e\u0645\u0650\u064a\u0646\u0650\u0647\u0650\u06e6 \u0641\u064e\u064a\u064e\u0642\u064f\u0648\u0644\u064f \u0647\u064e\u0627\u0653\u0624\u064f\u0645\u064f \u0671\u0642\u06e1\u0631\u064e\u0621\u064f\u0648\u0627\u0652 \u0643\u0650\u062a\u064e\u0670\u0628\u0650\u064a\u064e\u0647\u06e1","translation":"Amel kitaplar\u0131 sa\u011f\u0131ndan verilen kimse mutluluk ve ne\u015feyle \u015f\u00f6yle der: \u201cAl\u0131n, amel kitab\u0131m\u0131 okuyun!\u201d","footnotes":null},{"id":"5343","sura":"69","aya":"20","arabic_text":"\u0625\u0650\u0646\u0651\u0650\u064a \u0638\u064e\u0646\u064e\u0646\u062a\u064f \u0623\u064e\u0646\u0651\u0650\u064a \u0645\u064f\u0644\u064e\u0670\u0642\u064d \u062d\u0650\u0633\u064e\u0627\u0628\u0650\u064a\u064e\u0647\u06e1","translation":"\"\u015e\u00fcphesiz ben, yeniden diriltilece\u011fimi ve m\u00fck\u00e2fat\u0131m\u0131 alaca\u011f\u0131m\u0131 d\u00fcnyada iken biliyor ve yakinen inan\u0131yordum.\"","footnotes":null},{"id":"5344","sura":"69","aya":"21","arabic_text":"\u0641\u064e\u0647\u064f\u0648\u064e \u0641\u0650\u064a \u0639\u0650\u064a\u0634\u064e\u0629\u0656 \u0631\u0651\u064e\u0627\u0636\u0650\u064a\u064e\u0629\u0656","translation":"S\u00fcrekli olarak g\u00f6rece\u011fi nimetlerden \u00f6t\u00fcr\u00fc, art\u0131k onun i\u00e7in ho\u015fnut olaca\u011f\u0131 bir hayat vard\u0131r.","footnotes":null},{"id":"5345","sura":"69","aya":"22","arabic_text":"\u0641\u0650\u064a \u062c\u064e\u0646\u0651\u064e\u0629\u064d \u0639\u064e\u0627\u0644\u0650\u064a\u064e\u0629\u0656","translation":"Yeri ve de\u011feri y\u00fcksek olan bir cennettedir.","footnotes":null},{"id":"5346","sura":"69","aya":"23","arabic_text":"\u0642\u064f\u0637\u064f\u0648\u0641\u064f\u0647\u064e\u0627 \u062f\u064e\u0627\u0646\u0650\u064a\u064e\u0629\u065e","translation":"Onlar\u0131 yemek isteyen kimseler i\u00e7in cennet meyveleri \u00e7ok yak\u0131nd\u0131r.","footnotes":null},{"id":"5347","sura":"69","aya":"24","arabic_text":"\u0643\u064f\u0644\u064f\u0648\u0627\u0652 \u0648\u064e\u0671\u0634\u06e1\u0631\u064e\u0628\u064f\u0648\u0627\u0652 \u0647\u064e\u0646\u0650\u064a\u0653\u0640\u0654\u064e\u06e2\u0627 \u0628\u0650\u0645\u064e\u0627\u0653 \u0623\u064e\u0633\u06e1\u0644\u064e\u0641\u06e1\u062a\u064f\u0645\u06e1 \u0641\u0650\u064a \u0671\u0644\u06e1\u0623\u064e\u064a\u0651\u064e\u0627\u0645\u0650 \u0671\u0644\u06e1\u062e\u064e\u0627\u0644\u0650\u064a\u064e\u0629\u0650","translation":"Onlara ikram olarak \u015f\u00f6yle denilir: \u201cD\u00fcnyadaki ge\u00e7mi\u015f g\u00fcnlerinizde i\u015flemi\u015f oldu\u011funuz salih ameller sebebiyle diledi\u011finiz kadar yiyip i\u00e7iniz! Bunlarda hi\u00e7bir eza yoktur.''","footnotes":null},{"id":"5348","sura":"69","aya":"25","arabic_text":"\u0648\u064e\u0623\u064e\u0645\u0651\u064e\u0627 \u0645\u064e\u0646\u06e1 \u0623\u064f\u0648\u062a\u0650\u064a\u064e \u0643\u0650\u062a\u064e\u0670\u0628\u064e\u0647\u064f\u06e5 \u0628\u0650\u0634\u0650\u0645\u064e\u0627\u0644\u0650\u0647\u0650\u06e6 \u0641\u064e\u064a\u064e\u0642\u064f\u0648\u0644\u064f \u064a\u064e\u0670\u0644\u064e\u064a\u06e1\u062a\u064e\u0646\u0650\u064a \u0644\u064e\u0645\u06e1 \u0623\u064f\u0648\u062a\u064e \u0643\u0650\u062a\u064e\u0670\u0628\u0650\u064a\u064e\u0647\u06e1","translation":"Fakat amel kitab\u0131 solundan verilen kimseler pi\u015fmanl\u0131klar\u0131n\u0131n a\u015f\u0131r\u0131l\u0131\u011f\u0131ndan dolay\u0131 \u015f\u00f6yle derler: \u201cEyvah! \u0130\u00e7inde bulunup, azap g\u00f6rmemi zorunlu k\u0131lan k\u00f6t\u00fc ameller sebebiyle ke\u015fke amel kitab\u0131m hi\u00e7 verilmeseydi.''","footnotes":null},{"id":"5349","sura":"69","aya":"26","arabic_text":"\u0648\u064e\u0644\u064e\u0645\u06e1 \u0623\u064e\u062f\u06e1\u0631\u0650 \u0645\u064e\u0627 \u062d\u0650\u0633\u064e\u0627\u0628\u0650\u064a\u064e\u0647\u06e1","translation":"\"Ke\u015fke hesab\u0131mda nelerin oldu\u011funu hi\u00e7 bilmeseydim.\"","footnotes":null},{"id":"5350","sura":"69","aya":"27","arabic_text":"\u064a\u064e\u0670\u0644\u064e\u064a\u06e1\u062a\u064e\u0647\u064e\u0627 \u0643\u064e\u0627\u0646\u064e\u062a\u0650 \u0671\u0644\u06e1\u0642\u064e\u0627\u0636\u0650\u064a\u064e\u0629\u064e","translation":"\"Ke\u015fke; \u00f6lm\u00fc\u015f oldu\u011fum bu \u00f6l\u00fcm, ard\u0131ndan yeniden dirili\u015fin olmad\u0131\u011f\u0131 bir \u00f6l\u00fcm olsayd\u0131.\"","footnotes":null},{"id":"5351","sura":"69","aya":"28","arabic_text":"\u0645\u064e\u0627\u0653 \u0623\u064e\u063a\u06e1\u0646\u064e\u0649\u0670 \u0639\u064e\u0646\u0651\u0650\u064a \u0645\u064e\u0627\u0644\u0650\u064a\u064e\u0647\u06e1\u06dc","translation":"\"Sahip oldu\u011fum servetim de Allah\u2019\u0131n azab\u0131ndan hi\u00e7bir \u015feyi benden savu\u015fturamad\u0131.\"","footnotes":null},{"id":"5352","sura":"69","aya":"29","arabic_text":"\u0647\u064e\u0644\u064e\u0643\u064e \u0639\u064e\u0646\u0651\u0650\u064a \u0633\u064f\u0644\u06e1\u0637\u064e\u0670\u0646\u0650\u064a\u064e\u0647\u06e1","translation":"\"Kan\u0131t\u0131m, kendisine g\u00fcvendi\u011fim g\u00fc\u00e7 ve itibar\u0131m yok oldu gitti.\"","footnotes":null},{"id":"5353","sura":"69","aya":"30","arabic_text":"\u062e\u064f\u0630\u064f\u0648\u0647\u064f \u0641\u064e\u063a\u064f\u0644\u0651\u064f\u0648\u0647\u064f","translation":"Bu kimse hakk\u0131nda Meleklere, onu tutun ve ellerini boynunda toplay\u0131n! diye emir verilir.","footnotes":null},{"id":"5354","sura":"69","aya":"31","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0671\u0644\u06e1\u062c\u064e\u062d\u0650\u064a\u0645\u064e \u0635\u064e\u0644\u0651\u064f\u0648\u0647\u064f","translation":"Sonra da s\u0131cakl\u0131\u011f\u0131n\u0131n \u0131zd\u0131rab\u0131n\u0131 \u00e7ekmesi i\u00e7in onu cehenneme at\u0131n.","footnotes":null},{"id":"5355","sura":"69","aya":"32","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0641\u0650\u064a \u0633\u0650\u0644\u06e1\u0633\u0650\u0644\u064e\u0629\u0656 \u0630\u064e\u0631\u06e1\u0639\u064f\u0647\u064e\u0627 \u0633\u064e\u0628\u06e1\u0639\u064f\u0648\u0646\u064e \u0630\u0650\u0631\u064e\u0627\u0639\u0657\u0627 \u0641\u064e\u0671\u0633\u06e1\u0644\u064f\u0643\u064f\u0648\u0647\u064f","translation":"Sonra da onu, uzunlu\u011fu yetmi\u015f ar\u015f\u0131n olan bir zincire vurun.","footnotes":null},{"id":"5356","sura":"69","aya":"33","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0643\u064e\u0627\u0646\u064e \u0644\u064e\u0627 \u064a\u064f\u0624\u06e1\u0645\u0650\u0646\u064f \u0628\u0650\u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0671\u0644\u06e1\u0639\u064e\u0638\u0650\u064a\u0645\u0650","translation":"\u00c7\u00fcnk\u00fc o, Y\u00fcce Allah\u2019a iman etmiyordu.","footnotes":null},{"id":"5357","sura":"69","aya":"34","arabic_text":"\u0648\u064e\u0644\u064e\u0627 \u064a\u064e\u062d\u064f\u0636\u0651\u064f \u0639\u064e\u0644\u064e\u0649\u0670 \u0637\u064e\u0639\u064e\u0627\u0645\u0650 \u0671\u0644\u06e1\u0645\u0650\u0633\u06e1\u0643\u0650\u064a\u0646\u0650","translation":"Ba\u015fka kimseleri de yoksullar\u0131 doyurmaya te\u015fvik etmiyordu.","footnotes":null},{"id":"5358","sura":"69","aya":"35","arabic_text":"\u0641\u064e\u0644\u064e\u064a\u06e1\u0633\u064e \u0644\u064e\u0647\u064f \u0671\u0644\u06e1\u064a\u064e\u0648\u06e1\u0645\u064e \u0647\u064e\u0670\u0647\u064f\u0646\u064e\u0627 \u062d\u064e\u0645\u0650\u064a\u0645\u065e","translation":"K\u0131yamet g\u00fcn\u00fc ondan azab\u0131 savu\u015fturacak hi\u00e7bir yak\u0131n\u0131 da olmayacakt\u0131r.","footnotes":null},{"id":"5359","sura":"69","aya":"36","arabic_text":"\u0648\u064e\u0644\u064e\u0627 \u0637\u064e\u0639\u064e\u0627\u0645\u064c \u0625\u0650\u0644\u0651\u064e\u0627 \u0645\u0650\u0646\u06e1 \u063a\u0650\u0633\u06e1\u0644\u0650\u064a\u0646\u0656","translation":"O kimse i\u00e7in, cehennem ehlinin bedenlerinden \u00e7\u0131kan su ve irinden ba\u015fka yiyece\u011fi bir yeme\u011fi de yoktur.","footnotes":null},{"id":"5360","sura":"69","aya":"37","arabic_text":"\u0644\u0651\u064e\u0627 \u064a\u064e\u0623\u06e1\u0643\u064f\u0644\u064f\u0647\u064f\u06e5\u0653 \u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0644\u06e1\u062e\u064e\u0670\u0637\u0650\u0640\u0654\u064f\u0648\u0646\u064e","translation":"Bu yeme\u011fi yaln\u0131zca g\u00fcnahk\u00e2r ve su\u00e7lular yer.","footnotes":null},{"id":"5361","sura":"69","aya":"38","arabic_text":"\u0641\u064e\u0644\u064e\u0627\u0653 \u0623\u064f\u0642\u06e1\u0633\u0650\u0645\u064f \u0628\u0650\u0645\u064e\u0627 \u062a\u064f\u0628\u06e1\u0635\u0650\u0631\u064f\u0648\u0646\u064e","translation":"Allah Te\u00e2l\u00e2, g\u00f6rd\u00fcklerinize yemin etmektedir.","footnotes":null},{"id":"5362","sura":"69","aya":"39","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u0644\u064e\u0627 \u062a\u064f\u0628\u06e1\u0635\u0650\u0631\u064f\u0648\u0646\u064e","translation":"Y\u00fcce Allah g\u00f6rmediklerinize de yemin etmektedir.","footnotes":null},{"id":"5363","sura":"69","aya":"40","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0644\u064e\u0642\u064e\u0648\u06e1\u0644\u064f \u0631\u064e\u0633\u064f\u0648\u0644\u0656 \u0643\u064e\u0631\u0650\u064a\u0645\u0656","translation":"\u015e\u00fcphesiz Kur\u2019an, Allah\u2019\u0131n kelam\u0131d\u0131r. Onun de\u011ferli Peygamberi ise onu insanlara okumaktad\u0131r.","footnotes":null},{"id":"5364","sura":"69","aya":"41","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u0647\u064f\u0648\u064e \u0628\u0650\u0642\u064e\u0648\u06e1\u0644\u0650 \u0634\u064e\u0627\u0639\u0650\u0631\u0656\u06da \u0642\u064e\u0644\u0650\u064a\u0644\u0657\u0627 \u0645\u0651\u064e\u0627 \u062a\u064f\u0624\u06e1\u0645\u0650\u0646\u064f\u0648\u0646\u064e","translation":"O, bir \u015fair s\u00f6z\u00fc de\u011fildir. \u00c7\u00fcnk\u00fc o, \u015fiir beyit d\u00fczeni \u00fczere de\u011fildir. Ne kadar da az iman etmektesiniz.","footnotes":null},{"id":"5365","sura":"69","aya":"42","arabic_text":"\u0648\u064e\u0644\u064e\u0627 \u0628\u0650\u0642\u064e\u0648\u06e1\u0644\u0650 \u0643\u064e\u0627\u0647\u0650\u0646\u0656\u06da \u0642\u064e\u0644\u0650\u064a\u0644\u0657\u0627 \u0645\u0651\u064e\u0627 \u062a\u064e\u0630\u064e\u0643\u0651\u064e\u0631\u064f\u0648\u0646\u064e","translation":"Bir k\u00e2hinin s\u00f6z\u00fc de de\u011fildir. \u00c7\u00fcnk\u00fc k\u00e2hin s\u00f6z\u00fc, bu Kur\u2019an\u2019dan ba\u015fka bir \u015feydir. Ne kadar da az \u00f6\u011f\u00fct al\u0131yorsunuz.","footnotes":null},{"id":"5366","sura":"69","aya":"43","arabic_text":"\u062a\u064e\u0646\u0632\u0650\u064a\u0644\u065e \u0645\u0651\u0650\u0646 \u0631\u0651\u064e\u0628\u0651\u0650 \u0671\u0644\u06e1\u0639\u064e\u0670\u0644\u064e\u0645\u0650\u064a\u0646\u064e","translation":"Fakat o, b\u00fct\u00fcn mahlukat\u0131n Rabbinden indirilmi\u015ftir.","footnotes":null},{"id":"5367","sura":"69","aya":"44","arabic_text":"\u0648\u064e\u0644\u064e\u0648\u06e1 \u062a\u064e\u0642\u064e\u0648\u0651\u064e\u0644\u064e \u0639\u064e\u0644\u064e\u064a\u06e1\u0646\u064e\u0627 \u0628\u064e\u0639\u06e1\u0636\u064e \u0671\u0644\u06e1\u0623\u064e\u0642\u064e\u0627\u0648\u0650\u064a\u0644\u0650","translation":"E\u011fer Muhammed bizim ad\u0131m\u0131za s\u00f6ylemedi\u011fimiz baz\u0131 s\u00f6zler uydurmu\u015f olsayd\u0131;","footnotes":null},{"id":"5368","sura":"69","aya":"45","arabic_text":"\u0644\u064e\u0623\u064e\u062e\u064e\u0630\u06e1\u0646\u064e\u0627 \u0645\u0650\u0646\u06e1\u0647\u064f \u0628\u0650\u0671\u0644\u06e1\u064a\u064e\u0645\u0650\u064a\u0646\u0650","translation":"Elbette ondan intikam al\u0131r ve sahip oldu\u011fumuz kuvvet ve kudretle onu yakalay\u0131verirdik.","footnotes":null},{"id":"5369","sura":"69","aya":"46","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0644\u064e\u0642\u064e\u0637\u064e\u0639\u06e1\u0646\u064e\u0627 \u0645\u0650\u0646\u06e1\u0647\u064f \u0671\u0644\u06e1\u0648\u064e\u062a\u0650\u064a\u0646\u064e","translation":"Sonra da elbette onun kalbe giden damar\u0131n\u0131 kopart\u0131rd\u0131k.","footnotes":null},{"id":"5370","sura":"69","aya":"47","arabic_text":"\u0641\u064e\u0645\u064e\u0627 \u0645\u0650\u0646\u0643\u064f\u0645 \u0645\u0651\u0650\u0646\u06e1 \u0623\u064e\u062d\u064e\u062f\u064d \u0639\u064e\u0646\u06e1\u0647\u064f \u062d\u064e\u0670\u062c\u0650\u0632\u0650\u064a\u0646\u064e","translation":"Sizlerden hi\u00e7 kimse de bize engel olamazd\u0131. Onun, bizim ad\u0131m\u0131za sizin i\u00e7in s\u00f6zler uydurmas\u0131 imk\u00e2ns\u0131zd\u0131r.","footnotes":null},{"id":"5371","sura":"69","aya":"48","arabic_text":"\u0648\u064e\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0644\u064e\u062a\u064e\u0630\u06e1\u0643\u0650\u0631\u064e\u0629\u065e \u0644\u0651\u0650\u0644\u06e1\u0645\u064f\u062a\u0651\u064e\u0642\u0650\u064a\u0646\u064e","translation":"Muhakkak Kur\u2019an, emirlerini yerine getirip yasaklar\u0131ndan sak\u0131narak Rablerine kar\u015f\u0131 takval\u0131 olanlar i\u00e7in elbette bir \u00f6\u011f\u00fctt\u00fcr.","footnotes":null},{"id":"5372","sura":"69","aya":"49","arabic_text":"\u0648\u064e\u0625\u0650\u0646\u0651\u064e\u0627 \u0644\u064e\u0646\u064e\u0639\u06e1\u0644\u064e\u0645\u064f \u0623\u064e\u0646\u0651\u064e \u0645\u0650\u0646\u0643\u064f\u0645 \u0645\u0651\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e","translation":"Sizin i\u00e7inizden bu Kur\u2019an\u2019\u0131 yalanlayan kimselerin oldu\u011funu biz elbette biliyoruz.","footnotes":null},{"id":"5373","sura":"69","aya":"50","arabic_text":"\u0648\u064e\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0644\u064e\u062d\u064e\u0633\u06e1\u0631\u064e\u0629\u064c \u0639\u064e\u0644\u064e\u0649 \u0671\u0644\u06e1\u0643\u064e\u0670\u0641\u0650\u0631\u0650\u064a\u0646\u064e","translation":"\u015e\u00fcphesiz Kur\u2019an\u2019\u0131 yalanlamak, k\u0131yamet g\u00fcn\u00fc b\u00fcy\u00fck bir pi\u015fmanl\u0131k olacakt\u0131r.","footnotes":null},{"id":"5374","sura":"69","aya":"51","arabic_text":"\u0648\u064e\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0644\u064e\u062d\u064e\u0642\u0651\u064f \u0671\u0644\u06e1\u064a\u064e\u0642\u0650\u064a\u0646\u0650","translation":"Kur\u2019an\u2019\u0131n Allah\u2019\u0131n kat\u0131ndan oldu\u011fu, \u015f\u00fcphesiz ve ku\u015fkusuz kesin bir ger\u00e7ektir.","footnotes":null},{"id":"5375","sura":"69","aya":"52","arabic_text":"\u0641\u064e\u0633\u064e\u0628\u0651\u0650\u062d\u06e1 \u0628\u0650\u0671\u0633\u06e1\u0645\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0671\u0644\u06e1\u0639\u064e\u0638\u0650\u064a\u0645\u0650","translation":"Ey Peygamber! Rabbini ona lay\u0131k olmayan \u015feylerden tenzih et ve Y\u00fcce Rabbinin ismini zikret!","footnotes":null}]}