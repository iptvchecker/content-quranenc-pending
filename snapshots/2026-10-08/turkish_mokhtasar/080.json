6\u06e1 \u0623\u064e\u062e\u0650\u064a\u0647\u0650","translation":"O g\u00fcn ki\u015fi karde\u015finden ka\u00e7ar.","footnotes":null},{"id":"5793","sura":"80","aya":"35","arabic_text":"\u0648\u064e\u0623\u064f\u0645\u0651\u0650\u0647\u0650\u06e6 \u0648\u064e\u0623\u064e\u0628\u0650\u064a\u0647\u0650","translation":"Annesinden ve babas\u0131ndan ka\u00e7ar.","footnotes":null},{"id":"5794","sura":"80","aya":"36","arabic_text":"\u0648\u064e\u0635\u064e\u0670\u062d\u0650\u0628\u064e\u062a\u0650\u0647\u0650\u06e6 \u0648\u064e\u0628\u064e\u0646\u0650\u064a\u0647\u0650","translation":"Kar\u0131s\u0131ndan ve \u00e7ocuklar\u0131ndan ka\u00e7ar.","footnotes":null},{"id":"5795","sura":"80","aya":"37","arabic_text":"\u0644\u0650\u0643\u064f\u0644\u0651\u0650 \u0671\u0645\u06e1\u0631\u0650\u064a\u0655\u0656 \u0645\u0651\u0650\u0646\u06e1\u0647\u064f\u0645\u06e1 \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0634\u064e\u0623\u06e1\u0646\u065e \u064a\u064f\u063a\u06e1\u0646\u0650\u064a\u0647\u0650","translation":"O g\u00fcn\u00fcn s\u0131k\u0131nt\u0131s\u0131n\u0131n \u015fiddeti sebebiyle, onlardan her birini ba\u015fkalar\u0131ndan al\u0131koyan bir me\u015fguliyeti vard\u0131r.","footnotes":null},{"id":"5796","sura":"80","aya":"38","arabic_text":"\u0648\u064f\u062c\u064f\u0648\u0647\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0645\u0651\u064f\u0633\u06e1\u0641\u0650\u0631\u064e\u0629\u065e","translation":"O g\u00fcn iyilerin y\u00fczleri \u0131\u015f\u0131k sa\u00e7ar.","footnotes":null},{"id":"5797","sura":"80","aya":"39","arabic_text":"\u0636\u064e\u0627\u062d\u0650\u0643\u064e\u0629\u065e \u0645\u0651\u064f\u0633\u06e1\u062a\u064e\u0628\u06e1\u0634\u0650\u0631\u064e\u0629\u065e","translation":"Y\u00fcce Allah\u2019\u0131n kendi rahmetinden onlar i\u00e7in haz\u0131rlad\u0131\u011f\u0131 \u015feylerden \u00f6t\u00fcr\u00fc mutlu olup, g\u00fclecekler.","footnotes":null},{"id":"5798","sura":"80","aya":"40","arabic_text":"\u0648\u064e\u0648\u064f\u062c\u064f\u0648\u0647\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u064d \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u064e\u0627 \u063a\u064e\u0628\u064e\u0631\u064e\u0629\u065e","translation":"Ve o g\u00fcn k\u00f6t\u00fclerin y\u00fczleri toz toprak i\u00e7indedir.","footnotes":null},{"id":"5799","sura":"80","aya":"41","arabic_text":"\u062a\u064e\u0631\u06e1\u0647\u064e\u0642\u064f\u0647\u064e\u0627 \u0642\u064e\u062a\u064e\u0631\u064e\u0629\u064c","translation":"O y\u00fczleri bir karanl\u0131k kaplayacak.","footnotes":null},{"id":"5800","sura":"80","aya":"42","arabic_text":"\u0623\u064f\u0648\u0652\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064e \u0647\u064f\u0645\u064f \u0671\u0644\u06e1\u0643\u064e\u0641\u064e\u0631\u064e\u0629\u064f \u0671\u0644\u06e1\u0641\u064e\u062c\u064e\u0631\u064e\u0629\u064f","translation":"\u0130\u015fte bu vas\u0131flarla nitelenen o kimseler, k\u00fcf\u00fcr ve f\u00fccuru bir araya toplam\u0131\u015f kimselerdir.","footnotes":null}]}