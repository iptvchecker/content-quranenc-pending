{"result":[{"id":"5759","sura":"80","aya":"1","arabic_text":"\u0639\u064e\u0628\u064e\u0633\u064e \u0648\u064e\u062a\u064e\u0648\u064e\u0644\u0651\u064e\u0649\u0670\u0653","translation":"Ras\u00fblullah -sallallahu aleyhi ve sellem- y\u00fcz\u00fcn\u00fc buru\u015fturdu ve arkas\u0131n\u0131 d\u00f6nd\u00fc.","footnotes":null},{"id":"5760","sura":"80","aya":"2","arabic_text":"\u0623\u064e\u0646 \u062c\u064e\u0627\u0653\u0621\u064e\u0647\u064f \u0671\u0644\u06e1\u0623\u064e\u0639\u06e1\u0645\u064e\u0649\u0670","translation":"Peygamber -sallallahu aleyhi ve sellem- hidayet bulmalar\u0131 \u00fcmidiyle m\u00fc\u015friklerin ileri gelenleriyle me\u015fgul oldu\u011fu bir esnada, g\u00f6zleri g\u00f6rmeyen bir kimse olan Abdullah b. \u00dcmm\u00fc Mektum, do\u011fru yola hidayet bulmak i\u00e7in geldi. Bu sebeple Peygamber -sallallahu aleyhi ve sellem- y\u00fcz\u00fcn\u00fc ek\u015fitti.","footnotes":null},{"id":"5761","sura":"80","aya":"3","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u064a\u064f\u062f\u06e1\u0631\u0650\u064a\u0643\u064e \u0644\u064e\u0639\u064e\u0644\u0651\u064e\u0647\u064f\u06e5 \u064a\u064e\u0632\u0651\u064e\u0643\u0651\u064e\u0649\u0670\u0653","translation":"-Ey Peygamber!- Ne biliyorsun? Belki de bu \u00e2m\u00e2 adam g\u00fcnahlar\u0131ndan ar\u0131nacak.","footnotes":null},{"id":"5762","sura":"80","aya":"4","arabic_text":"\u0623\u064e\u0648\u06e1 \u064a\u064e\u0630\u0651\u064e\u0643\u0651\u064e\u0631\u064f \u0641\u064e\u062a\u064e\u0646\u0641\u064e\u0639\u064e\u0647\u064f \u0671\u0644\u0630\u0651\u0650\u0643\u06e1\u0631\u064e\u0649\u0670\u0653","translation":"Veyahut senden duydu\u011fu nasihatlerden \u00f6\u011f\u00fct alacak ve onlardan faydalanacakt\u0131.","footnotes":null},{"id":"5763","sura":"80","aya":"5","arabic_text":"\u0623\u064e\u0645\u0651\u064e\u0627 \u0645\u064e\u0646\u0650 \u0671\u0633\u06e1\u062a\u064e\u063a\u06e1\u0646\u064e\u0649\u0670","translation":"Fakat sahip oldu\u011fu servetinden \u00f6t\u00fcr\u00fc, senin getirdiklerine iman etmekten kendini m\u00fcsta\u011fni g\u00f6ren kimseye gelince;","footnotes":null},{"id":"5764","sura":"80","aya":"6","arabic_text":"\u0641\u064e\u0623\u064e\u0646\u062a\u064e \u0644\u064e\u0647\u064f\u06e5 \u062a\u064e\u0635\u064e\u062f\u0651\u064e\u0649\u0670","translation":"Sen ona d\u00f6n\u00fcyor ve y\u00f6neliyorsun.","footnotes":null},{"id":"5765","sura":"80","aya":"7","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u0639\u064e\u0644\u064e\u064a\u06e1\u0643\u064e \u0623\u064e\u0644\u0651\u064e\u0627 \u064a\u064e\u0632\u0651\u064e\u0643\u0651\u064e\u0649\u0670","translation":"O, Allah\u2019a t\u00f6vbe ederek g\u00fcnahlar\u0131ndan temizlenmiyorsa sana ne d\u00fc\u015fer ki?","footnotes":null},{"id":"5766","sura":"80","aya":"8","arabic_text":"\u0648\u064e\u0623\u064e\u0645\u0651\u064e\u0627 \u0645\u064e\u0646 \u062c\u064e\u0627\u0653\u0621\u064e\u0643\u064e \u064a\u064e\u0633\u06e1\u0639\u064e\u0649\u0670","translation":"Fakat ko\u015farak gelen kimse hay\u0131r arayarak sana geldi ise;","footnotes":null},{"id":"5767","sura":"80","aya":"9","arabic_text":"\u0648\u064e\u0647\u064f\u0648\u064e \u064a\u064e\u062e\u06e1\u0634\u064e\u0649\u0670","translation":"Rabbinden korktu\u011fu halde,","footnotes":null},{"id":"5768","sura":"80","aya":"10","arabic_text":"\u0641\u064e\u0623\u064e\u0646\u062a\u064e \u0639\u064e\u0646\u06e1\u0647\u064f \u062a\u064e\u0644\u064e\u0647\u0651\u064e\u0649\u0670","translation":"Sen; ba\u015fkas\u0131yla, m\u00fc\u015friklerin ileri gelenlerinden biriyle oyalan\u0131yorsun.","footnotes":null},{"id":"5769","sura":"80","aya":"11","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627\u0653 \u0625\u0650\u0646\u0651\u064e\u0647\u064e\u0627 \u062a\u064e\u0630\u06e1\u0643\u0650\u0631\u064e\u0629\u065e","translation":"Bu i\u015f hi\u00e7te \u00f6yle de\u011fildir. \u015e\u00fcphesiz o, kabul edenler i\u00e7in ancak bir \u00f6\u011f\u00fct ve hat\u0131rlatmad\u0131r.","footnotes":null},{"id":"5770","sura":"80","aya":"12","arabic_text":"\u0641\u064e\u0645\u064e\u0646 \u0634\u064e\u0627\u0653\u0621\u064e \u0630\u064e\u0643\u064e\u0631\u064e\u0647\u064f\u06e5","translation":"Kim Allah\u2019\u0131 anmak isterse onu ans\u0131n ve bu Kur\u2019an\u2019da bulunan nasihatlerden \u00f6\u011f\u00fct als\u0131n.","footnotes":null},{"id":"5771","sura":"80","aya":"13","arabic_text":"\u0641\u0650\u064a \u0635\u064f\u062d\u064f\u0641\u0656 \u0645\u0651\u064f\u0643\u064e\u0631\u0651\u064e\u0645\u064e\u0629\u0656","translation":"Bu Kur\u2019an, meleklerin kat\u0131nda bulunan de\u011ferli sayfalardad\u0131r.","footnotes":null},{"id":"5772","sura":"80","aya":"14","arabic_text":"\u0645\u0651\u064e\u0631\u06e1\u0641\u064f\u0648\u0639\u064e\u0629\u0656 \u0645\u0651\u064f\u0637\u064e\u0647\u0651\u064e\u0631\u064e\u0629\u0650\u06ed","translation":"Y\u00fcce bir mek\u00e2na y\u00fckseltilmi\u015f, kendisine hi\u00e7bir kir ve leke bula\u015fmam\u0131\u015f, tertemizdir.","footnotes":null},{"id":"5773","sura":"80","aya":"15","arabic_text":"\u0628\u0650\u0623\u064e\u064a\u06e1\u062f\u0650\u064a \u0633\u064e\u0641\u064e\u0631\u064e\u0629\u0656","translation":"O, el\u00e7i meleklerin ellerindedir.","footnotes":null},{"id":"5774","sura":"80","aya":"16","arabic_text":"\u0643\u0650\u0631\u064e\u0627\u0645\u0650\u06ed \u0628\u064e\u0631\u064e\u0631\u064e\u0629\u0656","translation":"Rablerinin kat\u0131nda de\u011ferli, pek \u00e7ok iyi i\u015fler yapan ve itaatk\u00e2r Melekler.","footnotes":null},{"id":"5775","sura":"80","aya":"17","arabic_text":"\u0642\u064f\u062a\u0650\u0644\u064e \u0671\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u064f \u0645\u064e\u0627\u0653 \u0623\u064e\u0643\u06e1\u0641\u064e\u0631\u064e\u0647\u064f\u06e5","translation":"K\u00e2fir olan insana lanet edilmi\u015ftir. \u0130nsan Allah'a kar\u015f\u0131 ne kadar da \u00e7ok ink\u00e2rc\u0131d\u0131r!","footnotes":null},{"id":"5776","sura":"80","aya":"18","arabic_text":"\u0645\u0650\u0646\u06e1 \u0623\u064e\u064a\u0651\u0650 \u0634\u064e\u064a\u06e1\u0621\u064d \u062e\u064e\u0644\u064e\u0642\u064e\u0647\u064f\u06e5","translation":"Allah onu hangi \u015feyden yaratt\u0131 da yery\u00fcz\u00fcnde kibirleniyor ve Allah\u2019\u0131 ink\u00e2r ediyor?","footnotes":null},{"id":"5777","sura":"80","aya":"19","arabic_text":"\u0645\u0650\u0646 \u0646\u0651\u064f\u0637\u06e1\u0641\u064e\u0629\u064d \u062e\u064e\u0644\u064e\u0642\u064e\u0647\u064f\u06e5 \u0641\u064e\u0642\u064e\u062f\u0651\u064e\u0631\u064e\u0647\u064f\u06e5","translation":"Onu, az bir sudan yaratt\u0131 ve yarad\u0131l\u0131\u015f\u0131n\u0131 a\u015fama a\u015fama takdir etti.","footnotes":null},{"id":"5778","sura":"80","aya":"20","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0671\u0644\u0633\u0651\u064e\u0628\u0650\u064a\u0644\u064e \u064a\u064e\u0633\u0651\u064e\u0631\u064e\u0647\u064f\u06e5","translation":"Sonra ona, bu a\u015famalar\u0131n ard\u0131ndan annesinin karn\u0131ndan \u00e7\u0131k\u0131\u015f\u0131 kolayla\u015ft\u0131rd\u0131.","footnotes":null},{"id":"5779","sura":"80","aya":"21","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0623\u064e\u0645\u064e\u0627\u062a\u064e\u0647\u064f\u06e5 \u0641\u064e\u0623\u064e\u0642\u06e1\u0628\u064e\u0631\u064e\u0647\u064f\u06e5","translation":"Sonra ona, hayatta belli bir \u00f6mr\u00fc takdir etmesinin ard\u0131ndan onu \u00f6ld\u00fcrd\u00fc. Ve ona yeniden diriltilece\u011fi zamana kadar i\u00e7inde kalaca\u011f\u0131 bir kabir k\u0131ld\u0131.","footnotes":null},{"id":"5780","sura":"80","aya":"22","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0625\u0650\u0630\u064e\u0627 \u0634\u064e\u0627\u0653\u0621\u064e \u0623\u064e\u0646\u0634\u064e\u0631\u064e\u0647\u064f\u06e5","translation":"Sonra diledi\u011fi zaman hesap sormak ve kar\u015f\u0131l\u0131\u011f\u0131n\u0131 vermek \u00fczere onu yeniden diriltecek.","footnotes":null},{"id":"5781","sura":"80","aya":"23","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627 \u0644\u064e\u0645\u0651\u064e\u0627 \u064a\u064e\u0642\u06e1\u0636\u0650 \u0645\u064e\u0627\u0653 \u0623\u064e\u0645\u064e\u0631\u064e\u0647\u064f\u06e5","translation":"Bu mesele o k\u00e2firin zannetti\u011fi gibi de\u011fildir. O, Rabbinin \u00fczerine y\u00fckledi\u011fi haklar\u0131 yerine getirmedi\u011fi gibi, Rabbinin ona zorunlu k\u0131ld\u0131\u011f\u0131 farzlar\u0131 da yerine getirmi\u015f de\u011fildir.","footnotes":null},{"id":"5782","sura":"80","aya":"24","arabic_text":"\u0641\u064e\u0644\u06e1\u064a\u064e\u0646\u0638\u064f\u0631\u0650 \u0671\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u064f \u0625\u0650\u0644\u064e\u0649\u0670 \u0637\u064e\u0639\u064e\u0627\u0645\u0650\u0647\u0650\u06e6\u0653","translation":"Y\u00fcce Allah'a iman etmeyip k\u00e2fir olan insan, yedi\u011fi yeme\u011fin nas\u0131l haz\u0131r hale geldi\u011fine bir baks\u0131n!","footnotes":null},{"id":"5783","sura":"80","aya":"25","arabic_text":"\u0623\u064e\u0646\u0651\u064e\u0627 \u0635\u064e\u0628\u064e\u0628\u06e1\u0646\u064e\u0627 \u0671\u0644\u06e1\u0645\u064e\u0627\u0653\u0621\u064e \u0635\u064e\u0628\u0651\u0657\u0627","translation":"Suyun asl\u0131, g\u00f6ky\u00fcz\u00fcnden kuvvetle ve bolca inen ya\u011fmurdan gelir.","footnotes":null},{"id":"5784","sura":"80","aya":"26","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0634\u064e\u0642\u064e\u0642\u06e1\u0646\u064e\u0627 \u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u064e \u0634\u064e\u0642\u0651\u0657\u0627","translation":"Sonra topra\u011f\u0131 a\u00e7t\u0131k ki b\u00f6ylece bitkiler i\u00e7in yar\u0131l\u0131p, a\u00e7\u0131ld\u0131.","footnotes":null},{"id":"5785","sura":"80","aya":"27","arabic_text":"\u0641\u064e\u0623\u064e\u0646\u06e2\u0628\u064e\u062a\u06e1\u0646\u064e\u0627 \u0641\u0650\u064a\u0647\u064e\u0627 \u062d\u064e\u0628\u0651\u0657\u0627","translation":"B\u00f6ylece toprakta bu\u011fday, m\u0131s\u0131r ve di\u011fer tah\u0131llardan yeti\u015ftirdik.","footnotes":null},{"id":"5786","sura":"80","aya":"28","arabic_text":"\u0648\u064e\u0639\u0650\u0646\u064e\u0628\u0657\u0627 \