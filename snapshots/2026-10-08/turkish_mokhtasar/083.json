{"result":[{"id":"5849","sura":"83","aya":"1","arabic_text":"\u0648\u064e\u064a\u06e1\u0644\u065e \u0644\u0651\u0650\u0644\u06e1\u0645\u064f\u0637\u064e\u0641\u0651\u0650\u0641\u0650\u064a\u0646\u064e","translation":"\u00d6l\u00e7\u00fcde hile yapanlar i\u00e7in h\u00fcsran ve helak vard\u0131r.","footnotes":null},{"id":"5850","sura":"83","aya":"2","arabic_text":"\u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0625\u0650\u0630\u064e\u0627 \u0671\u0643\u06e1\u062a\u064e\u0627\u0644\u064f\u0648\u0627\u0652 \u0639\u064e\u0644\u064e\u0649 \u0671\u0644\u0646\u0651\u064e\u0627\u0633\u0650 \u064a\u064e\u0633\u06e1\u062a\u064e\u0648\u06e1\u0641\u064f\u0648\u0646\u064e","translation":"Onlar, ba\u015fkalar\u0131ndan ald\u0131klar\u0131n\u0131 \u00f6l\u00e7t\u00fcklerinde haklar\u0131na tastamam eksiksiz olarak ba\u011fl\u0131l\u0131k g\u00f6sterenlerdir.","footnotes":null},{"id":"5851","sura":"83","aya":"3","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0643\u064e\u0627\u0644\u064f\u0648\u0647\u064f\u0645\u06e1 \u0623\u064e\u0648 \u0648\u0651\u064e\u0632\u064e\u0646\u064f\u0648\u0647\u064f\u0645\u06e1 \u064a\u064f\u062e\u06e1\u0633\u0650\u0631\u064f\u0648\u0646\u064e","translation":"\u0130nsanlara \u00f6l\u00e7t\u00fcklerinde veya tartt\u0131klar\u0131nda ise \u00f6l\u00e7\u00fcy\u00fc ve tart\u0131y\u0131 eksik tutarlar. Peygamber -sallallahu aleyhi ve sellem- Medine \u015fehrine hicret etti\u011fi zaman Medine halk\u0131n\u0131n hali i\u015fte b\u00f6yleydi.","footnotes":null},{"id":"5852","sura":"83","aya":"4","arabic_text":"\u0623\u064e\u0644\u064e\u0627 \u064a\u064e\u0638\u064f\u0646\u0651\u064f \u0623\u064f\u0648\u0652\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064e \u0623\u064e\u0646\u0651\u064e\u0647\u064f\u0645 \u0645\u0651\u064e\u0628\u06e1\u0639\u064f\u0648\u062b\u064f\u0648\u0646\u064e","translation":"Bu m\u00fcnkeri i\u015flemekte olan bu kimseler Allah\u2019\u0131n huzurunda yeniden diriltileceklerini yakinen bilmiyorlar m\u0131?","footnotes":null},{"id":"5853","sura":"83","aya":"5","arabic_text":"\u0644\u0650\u064a\u064e\u0648\u06e1\u0645\u064d \u0639\u064e\u0638\u0650\u064a\u0645\u0656","translation":"\u0130\u00e7inde bulunan s\u0131k\u0131nt\u0131lar ve korkular sebebiyle \u00e7ok b\u00fcy\u00fck olan bir g\u00fcnde hesap vermek ve kar\u015f\u0131l\u0131\u011f\u0131n\u0131 g\u00f6rmek i\u00e7in diriltilecekler.","footnotes":null},{"id":"5854","sura":"83","aya":"6","arabic_text":"\u064a\u064e\u0648\u06e1\u0645\u064e \u064a\u064e\u0642\u064f\u0648\u0645\u064f \u0671\u0644\u0646\u0651\u064e\u0627\u0633\u064f \u0644\u0650\u0631\u064e\u0628\u0651\u0650 \u0671\u0644\u06e1\u0639\u064e\u0670\u0644\u064e\u0645\u0650\u064a\u0646\u064e","translation":"O g\u00fcn insanlar, b\u00fct\u00fcn varl\u0131klar\u0131n Rabbine hesap vermek i\u00e7in kalkarlar.","footnotes":null},{"id":"5855","sura":"83","aya":"7","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627\u0653 \u0625\u0650\u0646\u0651\u064e \u0643\u0650\u062a\u064e\u0670\u0628\u064e \u0671\u0644\u06e1\u0641\u064f\u062c\u0651\u064e\u0627\u0631\u0650 \u0644\u064e\u0641\u0650\u064a \u0633\u0650\u062c\u0651\u0650\u064a\u0646\u0656","translation":"\u00d6l\u00fcmden sonra yeniden dirili\u015fin olmad\u0131\u011f\u0131n\u0131 san\u0131yorsunuz ama durum hi\u00e7 de \u00f6yle de\u011fildir. K\u00e2fir ve m\u00fcnaf\u0131k g\u00fcnahk\u00e2rlar\u0131n kitab\u0131 kesinlikle yerin en alt\u0131nda h\u00fcsrandad\u0131r.","footnotes":null},{"id":"5856","sura":"83","aya":"8","arabic_text":"\u0648\u064e\u0645\u064e\u0627\u0653 \u0623\u064e\u062f\u06e1\u0631\u064e\u0649\u0670\u0643\u064e \u0645\u064e\u0627 \u0633\u0650\u062c\u0651\u0650\u064a\u0646\u065e","translation":"-Ey Peygamber!- Siccin'in ne oldu\u011funu sana ne \u00f6\u011fretti?","footnotes":null},{"id":"5857","sura":"83","aya":"9","arabic_text":"\u0643\u0650\u062a\u064e\u0670\u0628\u065e \u0645\u0651\u064e\u0631\u06e1\u0642\u064f\u0648\u0645\u065e","translation":"\u015e\u00fcphesiz onlar\u0131n kitab\u0131 yaz\u0131l\u0131d\u0131r, silinmeyecektir. Ona bir \u015fey eklenemez veya eksiltilemez.","footnotes":null},{"id":"5858","sura":"83","aya":"10","arabic_text":"\u0648\u064e\u064a\u06e1\u0644\u065e \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u0650\u0644\u06e1\u0645\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u0650\u064a\u0646\u064e","translation":"Yalanlayanlar i\u00e7in o g\u00fcnde helak ve h\u00fcsran vard\u0131r.","footnotes":null},{"id":"5859","sura":"83","aya":"11","arabic_text":"\u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u064a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064f\u0648\u0646\u064e \u0628\u0650\u064a\u064e\u0648\u06e1\u0645\u0650 \u0671\u0644\u062f\u0651\u0650\u064a\u0646\u0650","translation":"Onlar, Allah\u2019\u0131n kullar\u0131na d\u00fcnyadaki amellerinin kar\u015f\u0131l\u0131\u011f\u0131n\u0131 verece\u011fi ceza g\u00fcn\u00fcn\u00fc yalanlayan kimselerdir.","footnotes":null},{"id":"5860","sura":"83","aya":"12","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u064a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064f \u0628\u0650\u0647\u0650\u06e6\u0653 \u0625\u0650\u0644\u0651\u064e\u0627 \u0643\u064f\u0644\u0651\u064f \u0645\u064f\u0639\u06e1\u062a\u064e\u062f\u064d \u0623\u064e\u062b\u0650\u064a\u0645\u064d","translation":"O g\u00fcn\u00fc ancak Allah\u2019\u0131n s\u0131n\u0131rlar\u0131n\u0131 \u00e7i\u011fnemi\u015f, \u00e7ok g\u00fcnahk\u00e2r olan kimselerden ba\u015fkas\u0131 yalanlamaz.","footnotes":null},{"id":"5861","sura":"83","aya":"13","arabic_text":"\u0625\u0650\u0630\u064e\u0627 \u062a\u064f\u062a\u06e1\u0644\u064e\u0649\u0670 \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u0650 \u0621\u064e\u0627\u064a\u064e\u0670\u062a\u064f\u0646\u064e\u0627 \u0642\u064e\u0627\u0644\u064e \u0623\u064e\u0633\u064e\u0670\u0637\u0650\u064a\u0631\u064f \u0671\u0644\u06e1\u0623\u064e\u0648\u0651\u064e\u0644\u0650\u064a\u0646\u064e","translation":"Ona, peygamberimize indirilen ayetlerimiz okundu\u011fu zaman \u015f\u00f6yle der: \u201cBunlar \u00f6nceki milletlerin k\u0131ssalar\u0131d\u0131r ve Allah\u2019\u0131n kat\u0131ndan gelmi\u015f de\u011fildirler.\u201d","footnotes":null},{"id":"5862","sura":"83","aya":"14","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627\u06d6 \u0628\u064e\u0644\u06e1\u06dc \u0631\u064e\u0627\u0646\u064e \u0639\u064e\u0644\u064e\u0649\u0670 \u0642\u064f\u0644\u064f\u0648\u0628\u0650\u0647\u0650\u0645 \u0645\u0651\u064e\u0627 \u0643\u064e\u0627\u0646\u064f\u0648\u0627\u0652 \u064a\u064e\u0643\u06e1\u0633\u0650\u0628\u064f\u0648\u0646\u064e","translation":"Durum o yalanlayanlar\u0131n zannetti\u011fi gibi de\u011fildir. Bilakis, i\u015flemi\u015f olduklar\u0131 g\u00fcnahlar onlar\u0131n ak\u0131llar\u0131na \u00fcst\u00fcn gelerek onu kaplam\u0131\u015f ve b\u00f6ylece kalpleriyle hakk\u0131 g\u00f6rememi\u015flerdir.","footnotes":null},{"id":"5863","sura":"83","aya":"15","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627\u0653 \u0625\u0650\u0646\u0651\u064e\u0647\u064f\u0645\u06e1 \u0639\u064e\u0646 \u0631\u0651\u064e\u0628\u0651\u0650\u0647\u0650\u0645\u06e1 \u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u064e\u0645\u064e\u062d\u06e1\u062c\u064f\u0648\u0628\u064f\u0648\u0646\u064e","translation":"Ger\u00e7ek \u015fu ki, onlar k\u0131yamet g\u00fcn\u00fc Rablerini g\u00f6rmekten al\u0131konulacaklard\u0131r.","footnotes":null},{"id":"5864","sura":"83","aya":"16","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0625\u0650\u0646\u0651\u064e\u0647\u064f\u0645\u06e1 \u0644\u064e\u0635\u064e\u0627\u0644\u064f\u0648\u0627\u0652 \u0671\u0644\u06e1\u062c\u064e\u062d\u0650\u064a\u0645\u0650","translation":"Ard\u0131ndan da muhakkak cehennem ate\u015fine sokulacaklar ve s\u0131ca\u011f\u0131n\u0131n \u0131zd\u0131rab\u0131n\u0131 \u00e7ekeceklerdir.","footnotes":null},{"id":"5865","sura":"83","aya":"17","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u064a\u064f\u0642\u064e\u0627\u0644\u064f \u0647\u064e\u0670\u0630\u064e\u0627 \u0671\u0644\u0651\u064e\u0630\u0650\u064a \u0643\u064f\u0646\u062a\u064f\u0645 \u0628\u0650\u0647\u0650\u06e6 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064f\u0648\u0646\u064e","translation":"Sonra da k\u0131yamet g\u00fcn\u00fc onlara bir azarlama olarak \u015f\u00f6yle denilecektir: \u201cKar\u015f\u0131la\u015ft\u0131\u011f\u0131n\u0131z bu azap, peygamberinizin size d\u00fcnyada iken bildirdi\u011fi zaman yalanlam\u0131\u015f oldu\u011funuz azapt\u0131r.''","footnotes":null},{"id":"5866","sura":"83","aya":"18","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627\u0653 \u0625\u0650\u0646\u0651\u064e \u0643\u0650\u062a\u064e\u0670\u0628\u064e \u0671\u0644\u06e1\u0623\u064e\u0628\u06e1\u0631\u064e\u0627\u0631\u0650 \u0644\u064e\u0641\u0650\u064a \u0639\u0650\u0644\u0651\u0650\u064a\u0651\u0650\u064a\u0646\u064e","translation":"Durum, hesap ve kar\u015f\u0131l\u0131\u011f\u0131n olmad\u0131\u011f\u0131n\u0131 tasavvur etti\u011finiz gibi de\u011fildir. Do\u011frusu itaatk\u00e2r kullar\u0131n kitab\u0131 \u0130lliyyin'dedir.","footnotes":null},{"id":"5867","sura":"83","aya":"19","arabic_text":"\u0648\u064e\u0645\u064e\u0627\u0653 \u0623\u064e\u062f\u06e1\u0631\u064e\u0649\u0670\u0643\u064e \u0645\u064e\u0627 \u0639\u0650\u0644\u0651\u0650\u064a\u0651\u064f\u0648\u0646\u064e","translation":"-Ey Peygamber!- \u0130lliyyun'un ne oldu\u011funu sana ne \u00f6\u011fretti?","footnotes":null},{"id":"5868","sura":"83","aya":"20","arabic_text":"\u0643\u0650\u062a\u064e\u0670\u0628\u065e \u0645\u0651\u064e\u0631\u06e1\u0642\u064f\u0648\u0645\u065e","translation":"\u015e\u00fcphesiz onlar\u0131n kitab\u0131 silinmeyecek \u015fekilde yaz\u0131l\u0131d\u0131r. Ona bir \u015fey eklenemez veya eksiltilemez.","footnotes":null},{"id":"5869","sura":"83","aya":"21","arabic_text":"\u064a\u064e\u0634\u06e1\u0647\u064e\u062f\u064f\u0647\u064f \u0671\u0644\u06e1\u0645\u064f\u0642\u064e\u0631\u0651\u064e\u0628\u064f\u0648\u0646\u064e","translation":"Bu kitab\u0131n yan\u0131na yak\u0131n k\u0131l\u0131nm\u0131\u015f b\u00fct\u00fcn sema melekleri gelir.","footnotes":null},{"id":"5870","sura":"83","aya":"22","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u06e1\u0623\u064e\u0628\u06e1\u0631\u064e\u0627\u0631\u064e \u0644\u064e\u0641\u0650\u064a \u0646\u064e\u0639\u0650\u064a\u0645\u064d","translation":"\u015e\u00fcphesiz \u00e7ok itaatk\u00e2r olanlar, k\u0131yamet g\u00fcn\u00fc kal\u0131c\u0131 nimetler i\u00e7inde olacaklard\u0131r.","footnotes":null},{"id":"5871","sura":"83","aya":"23","arabic_text":"\u0639\u064e\u0644\u064e\u0649 \u0671\u0644\u06e1\u0623\u064e\u0631\u064e\u0627\u0653\u0626\u0650\u0643\u0650 \u064a\u064e\u0646\u0638\u064f\u0631\u064f\u0648\u0646\u064e","translation":"S\u00fcsl\u00fc d\u00f6\u015fekler \u00fczerinde Rablerine, onlar\u0131 mutlu eden ve sevindiren \u015feylere nazar edip, bakarlar.","footnotes":null},{"id":"5872","sura":"83","aya":"24","arabic_text":"\u062a\u064e\u0639\u06e1\u0631\u0650\u0641\u064f \u0641\u0650\u064a \u0648\u064f\u062c\u064f\u0648\u0647\u0650\u0647\u0650\u0645\u06e1 \u0646\u064e\u0636\u06e1\u0631\u064e\u0629\u064e \u0671\u0644\u0646\u0651\u064e\u0639\u0650\u064a\u0645\u0650","translation":"Onlar\u0131 g\u00f6rd\u00fc\u011f\u00fcn zaman y\u00fczlerinde g\u00fczellik ve zarafet olarak nimetlerin eserini g\u00f6r\u00fcrs\u00fcn.","footnotes":null},{"id":"5873","sura":"83","aya":"25","arabic_text":"\u064a\u064f\u0633\u06e1\u0642\u064e\u0648\u06e1\u0646\u064e \u0645\u0650\u0646 \u0631\u0651\u064e\u062d\u0650\u064a\u0642\u0656 \u0645\u0651\u064e\u062e\u06e1\u062a\u064f\u0648\u0645\u064d","translation":"Hizmet\u00e7ileri onlara, \u015fi\u015felerin \u00fczeri m\u00fch\u00fcrlenmi\u015f i\u00e7kilerden i\u00e7irirler.","footnotes":null},{"id":"5874","sura":"83","aya":"26","arabic_text":"\u062e\u0650\u062a\u064e\u0670\u0645\u064f\u0647\u064f\u06e5 \u0645\u0650\u0633\u06e1\u0643\u065e\u06da \u0648\u064e\u0641\u0650\u064a \u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0641\u064e\u0644\u06e1\u064a\u064e\u062a\u064e\u0646\u064e\u0627\u0641\u064e\u0633\u0650 \u0671\u0644\u06e1\u0645\u064f\u062a\u064e\u0646\u064e\u0670\u0641\u0650\u0633\u064f\u0648\u0646\u064e","translation":"Ondan yay\u0131lan miskin kokusu sonuna kadar yay\u0131l\u0131r. Yar\u0131\u015fmakta olanlar\u0131n bu de\u011ferli m\u00fck\u00e2fat i\u00e7in Allah'\u0131n raz\u0131 olaca\u011f\u0131 ameli yaparak ve \u00f6fkelenece\u011fi ameli terk ederek yar\u0131\u015fmalar\u0131 gerekir.","footnotes":null},{"id":"5875","sura":"83","aya":"27","arabic_text":"\u0648\u064e\u0645\u0650\u0632\u064e\u0627\u062c\u064f\u0647\u064f\u06e5 \u0645\u0650\u0646 \u062a\u064e\u0633\u06e1\u0646\u0650\u064a\u0645\u064d","translation":"Bu m\u00fch\u00fcrlenmi\u015f i\u00e7kiye Tesnim p\u0131nar\u0131ndan kar\u0131\u015ft\u0131r\u0131l\u0131r.","footnotes":null},{"id":"5876","sura":"83","aya":"28","arabic_text":"\u0639\u064e\u064a\u06e1\u0646\u0657\u0627 \u064a\u064e\u0634\u06e1\u0631\u064e\u0628\u064f \u0628\u0650\u0647\u064e\u0627 \u0671\u0644\u06e1\u0645\u064f\u0642\u064e\u0631\u0651\u064e\u0628\u064f\u0648\u0646\u064e","translation":"O, cennetin en \u00fcst\u00fcnde yak\u0131n k\u0131l\u0131nm\u0131\u015f; pak, ihlasl\u0131 kimselerin i\u00e7ti\u011fi bir p\u0131nard\u0131r. Di\u011fer M\u00fcminler de ba\u015fka \u015feylerle kar\u0131\u015ft\u0131r\u0131lm\u0131\u015f olarak ondan i\u00e7erler.","footnotes":null},{"id":"5877","sura":"83","aya":"29","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0623\u064e\u062c\u06e1\u0631\u064e\u0645\u064f\u0648\u0627\u0652 \u0643\u064e\u0627\u0646\u064f\u0648\u0627\u0652 \u0645\u0650\u0646\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0627\u0652 \u064a\u064e\u0636\u06e1\u062d\u064e\u0643\u064f\u0648\u0646\u064e","translation":"\u0130\u00e7inde bulunduklar\u0131 k\u00fcf\u00fcr su\u00e7unu i\u015flemi\u015f olanlar, iman edenlerle alay ederek onlara g\u00fcl\u00fcyorlard\u0131.","footnotes":null},{"id":"5878","sura":"83","aya":"30","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0645\u064e\u0631\u0651\u064f\u0648\u0627\u0652 \u0628\u0650\u0647\u0650\u0645\u06e1 \u064a\u064e\u062a\u064e\u063a\u064e\u0627\u0645\u064e\u0632\u064f\u0648\u0646\u064e","translation":"Onlar M\u00fcminlerin yan\u0131ndan ge\u00e7erlerken, alay ederek ve e\u011flenerek birbirlerine ka\u015f g\u00f6z i\u015fareti yaparlard\u0131.","footnotes":null},{"id":"5879","sura":"83","aya":"31","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0671\u0646\u0642\u064e\u0644\u064e\u0628\u064f\u0648\u0653\u0627\u0652 \u0625\u0650\u0644\u064e\u0649\u0670\u0653 \u0623\u064e\u0647\u06e1\u0644\u0650\u0647\u0650\u0645\u064f \u0671\u0646\u0642\u064e\u0644\u064e\u0628\u064f\u0648\u0627\u0652 \u0641\u064e\u0643\u0650\u0647\u0650\u064a\u0646\u064e","translation":"Ailelerinin yan\u0131na d\u00f6nd\u00fcklerinde de k\u00fcfrederek ve M\u00fcminlerle alay ederek sevin\u00e7li bir \u015fekilde d\u00f6nerlerdi.","footnotes":null},{"id":"5880","sura":"83","aya":"32","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0631\u064e\u0623\u064e\u0648\u06e1\u0647\u064f\u0645\u06e1 \u0642\u064e\u0627\u0644\u064f\u0648\u0653\u0627\u0652 \u0625\u0650\u0646\u0651\u064e \u0647\u064e\u0670\u0653\u0624\u064f\u0644\u064e\u0627\u0653\u0621\u0650 \u0644\u064e\u0636\u064e\u0627\u0653\u0644\u0651\u064f\u0648\u0646\u064e","translation":"M\u00fcsl\u00fcmanlar\u0131 g\u00f6rd\u00fckleri zaman \u015f\u00f6yle derler: \u201cMuhakkak bunlar do\u011fru yoldan sapm\u0131\u015flard\u0131r. \u00c7\u00fcnk\u00fc babalar\u0131n\u0131n dinini terk ettiler.''","footnotes":null},{"id":"5881","sura":"83","aya":"33","arabic_text":"\u0648\u064e\u0645\u064e\u0627\u0653 \u0623\u064f\u0631\u06e1\u0633\u0650\u0644\u064f\u0648\u0627\u0652 \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u0650\u0645\u06e1 \u062d\u064e\u0670\u0641\u0650\u0638\u0650\u064a\u0646\u064e","translation":"H\u00e2lbuki Allah Te\u00e2l\u00e2 onlar\u0131, M\u00fcminlerin amellerini kaydetmeleri i\u00e7in sorumlu k\u0131lmad\u0131 ki, bu s\u00f6zleri s\u00f6yl\u00fcyorlar.","footnotes":null},{"id":"5882","sura":"83","aya":"34","arabic_text":"\u0641\u064e\u0671\u0644\u06e1\u064a\u064e\u0648\u06e1\u0645\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0627\u0652 \u0645\u0650\u0646\u064e \u0671\u0644\u06e1\u0643\u064f\u0641\u0651\u064e\u0627\u0631\u0650 \u064a\u064e\u0636\u06e1\u062d\u064e\u0643\u064f\u0648\u0646\u064e","translation":"K\u00e2firlerin d\u00fcnyada iman edenlere g\u00fcld\u00fckleri gibi, k\u0131yamet g\u00fcn\u00fc de Allah\u2019a iman edenler k\u00e2firlere g\u00fcleceklerdir.","footnotes":null},{"id":"5883","sura":"83","aya":"35","arabic_text":"\u0639\u064e\u0644\u064e\u0649 \u0671\u0644\u06e1\u0623\u064e\u0631\u064e\u0627\u0653\u0626\u0650\u0643\u0650 \u064a\u064e\u0646\u0638\u064f\u0631\u064f\u0648\u0646\u064e","translation":"S\u00fcsl\u00fc d\u00f6\u015fekler\/koltuklar \u00fczerinden Allah Te\u00e2l\u00e2\u2019n\u0131n onlar i\u00e7in haz\u0131rlad\u0131\u011f\u0131 kal\u0131c\u0131 nimetleri seyrederler.","footnotes":null},{"id":"5884","sura":"83","aya":"36","arabic_text":"\u0647\u064e\u0644\u06e1 \u062b\u064f\u0648\u0651\u0650\u0628\u064e \u0671\u0644\u06e1\u0643\u064f\u0641\u0651\u064e\u0627\u0631\u064f \u0645\u064e\u0627 \u0643\u064e\u0627\u0646\u064f\u0648\u0627\u0652 \u064a\u064e\u0641\u06e1\u0639\u064e\u0644\u064f\u0648\u0646\u064e","translation":"K\u00e2firlerin d\u00fcnyada yapt\u0131klar\u0131 amellerinin kar\u015f\u0131l\u0131\u011f\u0131 al\u00e7alt\u0131c\u0131 bir azapla (ahirette) muhakkak verilecektir.","footnotes":null}]}