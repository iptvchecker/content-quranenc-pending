{"result":[{"id":"4785","sura":"53","aya":"1","arabic_text":"\u0648\u064e\u0671\u0644\u0646\u0651\u064e\u062c\u06e1\u0645\u0650 \u0625\u0650\u0630\u064e\u0627 \u0647\u064e\u0648\u064e\u0649\u0670","translation":"Allah -Subhanehu ve Te\u00e2l\u00e2- y\u0131ld\u0131z\u0131n bat\u0131\u015f\u0131na yemin etmi\u015ftir.","footnotes":null},{"id":"4786","sura":"53","aya":"2","arabic_text":"\u0645\u064e\u0627 \u0636\u064e\u0644\u0651\u064e \u0635\u064e\u0627\u062d\u0650\u0628\u064f\u0643\u064f\u0645\u06e1 \u0648\u064e\u0645\u064e\u0627 \u063a\u064e\u0648\u064e\u0649\u0670","translation":"Allah'\u0131n resul\u00fc Muhammed -sallallahu aleyhi ve sellem- do\u011fru yoldan \u00e7\u0131kmad\u0131, sap\u0131tmad\u0131. O ancak hak yolu izleyen bir kimsedir.","footnotes":null},{"id":"4787","sura":"53","aya":"3","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u064a\u064e\u0646\u0637\u0650\u0642\u064f \u0639\u064e\u0646\u0650 \u0671\u0644\u06e1\u0647\u064e\u0648\u064e\u0649\u0670\u0653","translation":"Bu Kur'an (ayetleri) ile konu\u015fmas\u0131, hev\u00e2s\u0131na uydu\u011fu i\u00e7in de\u011fildir.","footnotes":null},{"id":"4788","sura":"53","aya":"4","arabic_text":"\u0625\u0650\u0646\u06e1 \u0647\u064f\u0648\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0648\u064e\u062d\u06e1\u064a\u065e \u064a\u064f\u0648\u062d\u064e\u0649\u0670","translation":"Bu Kur'an, Y\u00fcce Allah'\u0131n Cebrail -aleyhisselam- arac\u0131l\u0131\u011f\u0131 ile ona vahyetti\u011fi vahiyden ba\u015fka bir \u015fey de\u011fildir.","footnotes":null},{"id":"4789","sura":"53","aya":"5","arabic_text":"\u0639\u064e\u0644\u0651\u064e\u0645\u064e\u0647\u064f\u06e5 \u0634\u064e\u062f\u0650\u064a\u062f\u064f \u0671\u0644\u06e1\u0642\u064f\u0648\u064e\u0649\u0670","translation":"Kendisine onu \u00e7ok g\u00fc\u00e7l\u00fc bir melek olan Cebrail -aleyhisselam- \u00f6\u011fretti.","footnotes":null},{"id":"4790","sura":"53","aya":"6","arabic_text":"\u0630\u064f\u0648 \u0645\u0650\u0631\u0651\u064e\u0629\u0656 \u0641\u064e\u0671\u0633\u06e1\u062a\u064e\u0648\u064e\u0649\u0670","translation":"Cebrail -aleyhisselam- g\u00fczel g\u00f6r\u00fcn\u00fc\u015fl\u00fcd\u00fcr. Cebrail -aleyhisselam- Nebi -sallallahu aleyhi ve sellem-'in kar\u015f\u0131s\u0131nda Allah'\u0131n yaratt\u0131\u011f\u0131 hal \u00fczere a\u00e7\u0131k bir \u015fekilde g\u00f6r\u00fcn\u00fcp (en y\u00fcksek ufukta) y\u00fckseliverdi.","footnotes":null},{"id":"4791","sura":"53","aya":"7","arabic_text":"\u0648\u064e\u0647\u064f\u0648\u064e \u0628\u0650\u0671\u0644\u06e1\u0623\u064f\u0641\u064f\u0642\u0650 \u0671\u0644\u06e1\u0623\u064e\u0639\u06e1\u0644\u064e\u0649\u0670","translation":"Cebrail g\u00f6ky\u00fcz\u00fcndeki en y\u00fcksek ufukta idi.","footnotes":null},{"id":"4792","sura":"53","aya":"8","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u062f\u064e\u0646\u064e\u0627 \u0641\u064e\u062a\u064e\u062f\u064e\u0644\u0651\u064e\u0649\u0670","translation":"Sonra Cebrail -aleyhisselam- Nebi -sallallahu aleyhi ve sellem-e yakla\u015ft\u0131. Derken daha da yak\u0131nla\u015ft\u0131.","footnotes":null},{"id":"4793","sura":"53","aya":"9","arabic_text":"\u0641\u064e\u0643\u064e\u0627\u0646\u064e \u0642\u064e\u0627\u0628\u064e \u0642\u064e\u0648\u06e1\u0633\u064e\u064a\u06e1\u0646\u0650 \u0623\u064e\u0648\u06e1 \u0623\u064e\u062f\u06e1\u0646\u064e\u0649\u0670","translation":"(Cebrail'in) yak\u0131nl\u0131\u011f\u0131 iki yay boyu kadard\u0131 veya daha yak\u0131nd\u0131.","footnotes":null},{"id":"4794","sura":"53","aya":"10","arabic_text":"\u0641\u064e\u0623\u064e\u0648\u06e1\u062d\u064e\u0649\u0670\u0653 \u0625\u0650\u0644\u064e\u0649\u0670 \u0639\u064e\u0628\u06e1\u062f\u0650\u0647\u0650\u06e6 \u0645\u064e\u0627\u0653 \u0623\u064e\u0648\u06e1\u062d\u064e\u0649\u0670","translation":"Cebrail, Allah'\u0131n kulu Muhammed -sallallahu aleyhi ve sellem-'e vahyedilmesi gerekeni vahyetti.","footnotes":null},{"id":"4795","sura":"53","aya":"11","arabic_text":"\u0645\u064e\u0627 \u0643\u064e\u0630\u064e\u0628\u064e \u0671\u0644\u06e1\u0641\u064f\u0624\u064e\u0627\u062f\u064f \u0645\u064e\u0627 \u0631\u064e\u0623\u064e\u0649\u0670\u0653","translation":"Muhammed -sallallahu aleyhi ve sellem-'in kalbi g\u00f6zleri ile g\u00f6rd\u00fc\u011f\u00fcn\u00fc yalanlamad\u0131.","footnotes":null},{"id":"4796","sura":"53","aya":"12","arabic_text":"\u0623\u064e\u0641\u064e\u062a\u064f\u0645\u064e\u0670\u0631\u064f\u0648\u0646\u064e\u0647\u064f\u06e5 \u0639\u064e\u0644\u064e\u0649\u0670 \u0645\u064e\u0627 \u064a\u064e\u0631\u064e\u0649\u0670","translation":"-Ey m\u00fc\u015frikler!- \u015eimdi, \u0130sra gecesi Y\u00fcce Allah'\u0131n ona g\u00f6sterdi\u011fi \u015fey hakk\u0131nda onunla tart\u0131\u015f\u0131yor musunuz?","footnotes":null},{"id":"4797","sura":"53","aya":"13","arabic_text":"\u0648\u064e\u0644\u064e\u0642\u064e\u062f\u06e1 \u0631\u064e\u0621\u064e\u0627\u0647\u064f \u0646\u064e\u0632\u06e1\u0644\u064e\u0629\u064b \u0623\u064f\u062e\u06e1\u0631\u064e\u0649\u0670","translation":"Kendisinin g\u00f6t\u00fcr\u00fcld\u00fc\u011f\u00fc \u0130sra gecesi Muhammed -sallallahu aleyhi ve sellem- Cebrail'i asl\u00ee suretinde bir kere daha g\u00f6rm\u00fc\u015ft\u00fc.","footnotes":null},{"id":"4798","sura":"53","aya":"14","arabic_text":"\u0639\u0650\u0646\u062f\u064e \u0633\u0650\u062f\u06e1\u0631\u064e\u0629\u0650 \u0671\u0644\u06e1\u0645\u064f\u0646\u062a\u064e\u0647\u064e\u0649\u0670","translation":"Sidre-i M\u00fcnteh\u00e2\u2019n\u0131n yan\u0131nda yedinci semada bulunan \u00e7ok b\u00fcy\u00fck bir a\u011fa\u00e7t\u0131r.","footnotes":null},{"id":"4799","sura":"53","aya":"15","arabic_text":"\u0639\u0650\u0646\u062f\u064e\u0647\u064e\u0627 \u062c\u064e\u0646\u0651\u064e\u0629\u064f \u0671\u0644\u06e1\u0645\u064e\u0623\u06e1\u0648\u064e\u0649\u0670\u0653","translation":"Cennet\u00fc'l-Me'va da bu a\u011fac\u0131n yan\u0131ndad\u0131r.","footnotes":null},{"id":"4800","sura":"53","aya":"16","arabic_text":"\u0625\u0650\u0630\u06e1 \u064a\u064e\u063a\u06e1\u0634\u064e\u0649 \u0671\u0644\u0633\u0651\u0650\u062f\u06e1\u0631\u064e\u0629\u064e \u0645\u064e\u0627 \u064a\u064e\u063a\u06e1\u0634\u064e\u0649\u0670","translation":"Y\u00fcce Allah'\u0131n emri ile Sidre'yi b\u00fcy\u00fck bir \u015fey kaplad\u0131. \u0130\u015fin asl\u0131n\u0131 Y\u00fcce Allah'tan ba\u015fkas\u0131 bilmez.","footnotes":null},{"id":"4801","sura":"53","aya":"17","arabic_text":"\u0645\u064e\u0627 \u0632\u064e\u0627\u063a\u064e \u0671\u0644\u06e1\u0628\u064e\u0635\u064e\u0631\u064f \u0648\u064e\u0645\u064e\u0627 \u0637\u064e\u063a\u064e\u0649\u0670","translation":"Nebi -sallallahu aleyhi ve sellem-'in g\u00f6z\u00fc sa\u011fa sola kaymad\u0131. Kendisine belirlenen s\u0131n\u0131r\u0131 a\u015fmad\u0131.","footnotes":null},{"id":"4802","sura":"53","aya":"18","arabic_text":"\u0644\u064e\u0642\u064e\u062f\u06e1 \u0631\u064e\u0623\u064e\u0649\u0670 \u0645\u0650\u0646\u06e1 \u0621\u064e\u0627\u064a\u064e\u0670\u062a\u0650 \u0631\u064e\u0628\u0651\u0650\u0647\u0650 \u0671\u0644\u06e1\u0643\u064f\u0628\u06e1\u0631\u064e\u0649\u0670\u0653","translation":"Ant olsun, Muhammed -sallallahu aleyhi ve sellem- Mirac'a \u00e7\u0131kar\u0131ld\u0131\u011f\u0131 gece Rabbinin kudretine delalet eden b\u00fcy\u00fck ayetlerden\/mucizelerden baz\u0131s\u0131n\u0131 g\u00f6rd\u00fc. Cenneti, cehennemi ve bunun d\u0131\u015f\u0131ndaki \u015feyleri de g\u00f6rd\u00fc.","footnotes":null},{"id":"4803","sura":"53","aya":"19","arabic_text":"\u0623\u064e\u0641\u064e\u0631\u064e\u0621\u064e\u064a\u06e1\u062a\u064f\u0645\u064f \u0671\u0644\u0644\u0651\u064e\u0670\u062a\u064e \u0648\u064e\u0671\u0644\u06e1\u0639\u064f\u0632\u0651\u064e\u0649\u0670","translation":"-Ey m\u00fc\u015frikler!- Allah'tan ba\u015fka ibadet etti\u011finiz bu putlar\u0131; Lat ve Uzza'y\u0131 g\u00f6rd\u00fcn\u00fcz m\u00fc?","footnotes":null},{"id":"4804","sura":"53","aya":"20","arabic_text":"\u0648\u064e\u0645\u064e\u0646\u064e\u0648\u0670\u0629\u064e \u0671\u0644\u062b\u0651\u064e\u0627\u0644\u0650\u062b\u064e\u0629\u064e \u0671\u0644\u06e1\u0623\u064f\u062e\u06e1\u0631\u064e\u0649\u0670\u0653","translation":"Putlar\u0131n\u0131zdan di\u011fer \u00fc\u00e7\u00fcnc\u00fcs\u00fc Menat'\u0131 (g\u00f6rd\u00fcn\u00fcz m\u00fc?).Bana haber verin. Onlar size bir fayda ya da zarar vermeye malik midirler?","footnotes":null},{"id":"4805","sura":"53","aya":"21","arabic_text":"\u0623\u064e\u0644\u064e\u0643\u064f\u0645\u064f \u0671\u0644\u0630\u0651\u064e\u0643\u064e\u0631\u064f \u0648\u064e\u0644\u064e\u0647\u064f \u0671\u0644\u06e1\u0623\u064f\u0646\u062b\u064e\u0649\u0670","translation":"-Ey m\u00fc\u015frikler!- O sevdi\u011finiz erkek \u00e7ocuklar sizin; o sizin k\u00f6t\u00fc g\u00f6rd\u00fc\u011f\u00fcn\u00fcz k\u0131z \u00e7ocuklar Allah -Subhanehu ve Te\u00e2l\u00e2-'n\u0131n \u00f6yle mi?","footnotes":null},{"id":"4806","sura":"53","aya":"22","arabic_text":"\u062a\u0650\u0644\u06e1\u0643\u064e \u0625\u0650\u0630\u0657\u0627 \u0642\u0650\u0633\u06e1\u0645\u064e\u0629\u065e \u0636\u0650\u064a\u0632\u064e\u0649\u0670\u0653","translation":"Hev\u00e2n\u0131za uyarak taksim etti\u011finiz bu payla\u015ft\u0131rma, ne adaletsiz bir taksimdir.","footnotes":null},{"id":"4807","sura":"53","aya":"23","arabic_text":"\u0625\u0650\u0646\u06e1 \u0647\u0650\u064a\u064e \u0625\u0650\u0644\u0651\u064e\u0627\u0653 \u0623\u064e\u0633\u06e1\u0645\u064e\u0627\u0653\u0621\u065e \u0633\u064e\u0645\u0651\u064e\u064a\u06e1\u062a\u064f\u0645\u064f\u0648\u0647\u064e\u0627\u0653 \u0623\u064e\u0646\u062a\u064f\u0645\u06e1 \u0648\u064e\u0621\u064e\u0627\u0628\u064e\u0627\u0653\u0624\u064f\u0643\u064f\u0645 \u0645\u0651\u064e\u0627\u0653 \u0623\u064e\u0646\u0632\u064e\u0644\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0628\u0650\u0647\u064e\u0627 \u0645\u0650\u0646 \u0633\u064f\u0644\u06e1\u0637\u064e\u0670\u0646\u064d\u06da \u0625\u0650\u0646 \u064a\u064e\u062a\u0651\u064e\u0628\u0650\u0639\u064f\u0648\u0646\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0644\u0638\u0651\u064e\u0646\u0651\u064e \u0648\u064e\u0645\u064e\u0627 \u062a\u064e\u0647\u06e1\u0648\u064e\u0649 \u0671\u0644\u06e1\u0623\u064e\u0646\u0641\u064f\u0633\u064f\u06d6 \u0648\u064e\u0644\u064e\u0642\u064e\u062f\u06e1 \u062c\u064e\u0627\u0653\u0621\u064e\u0647\u064f\u0645 \u0645\u0651\u0650\u0646 \u0631\u0651\u064e\u0628\u0651\u0650\u0647\u0650\u0645\u064f \u0671\u0644\u06e1\u0647\u064f\u062f\u064e\u0649\u0670\u0653","translation":"Bu putlar manas\u0131 bo\u015f isimlerden ba\u015fka bir \u015fey de\u011fildir. \u0130lahl\u0131k s\u0131fatlar\u0131ndan hi\u00e7bir paylar\u0131 yoktur. Onlar\u0131, siz ve atalar\u0131n\u0131z kendi nefislerinizden uydurarak isimlendirdiniz. Y\u00fcce Allah, bu hususta hi\u00e7bir delil indirmemi\u015ftir. \u0130tikatlar\u0131 sadece zan ve nefislerinin arzusuna uygun olarak \u015feytan\u0131n kalplerini s\u00fcsledi\u011fi m\u00fc\u015friklere uymay\u0131n. Peygamber -sallallahu aleyhi ve sellem-'in lisan\u0131 ile Rableri taraf\u0131ndan kendilerine hidayet gelmi\u015ftir. Ancak onlar bununla hidayet bulmam\u0131\u015flard\u0131r.","footnotes":null},{"id":"4808","sura":"53","aya":"24","arabic_text":"\u0623\u064e\u0645\u06e1 \u0644\u0650\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u0650 \u0645\u064e\u0627 \u062a\u064e\u0645\u064e\u0646\u0651\u064e\u0649\u0670","translation":"Yoksa insan i\u00e7in Allah'\u0131n kat\u0131nda temenni etti\u011fi putlar\u0131n \u015fefaati mi vard\u0131r?","footnotes":null},{"id":"4809","sura":"53","aya":"25","arabic_text":"\u0641\u064e\u0644\u0650\u0644\u0651\u064e\u0647\u0650 \u0671\u0644\u06e1\u0623\u0653\u062e\u0650\u0631\u064e\u0629\u064f \u0648\u064e\u0671\u0644\u06e1\u0623\u064f\u0648\u0644\u064e\u0649\u0670","translation":"Hay\u0131r! \u0130nsan i\u00e7in temenni etti\u011fi her \u015fey onun olmaz. D\u00fcnya ve ahiret yaln\u0131zca Allah'\u0131nd\u0131r. Diledi\u011fine o ikisinden verir ve diledi\u011fine vermez.","footnotes":null},{"id":"4810","sura":"53","aya":"26","arabic_text":"\u06de\u00a0\u0648\u064e\u0643\u064e\u0645 \u0645\u0651\u0650\u0646 \u0645\u0651\u064e\u0644\u064e\u0643\u0656 \u0641\u0650\u064a \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0670\u0648\u064e\u0670\u062a\u0650 \u0644\u064e\u0627 \u062a\u064f\u063a\u06e1\u0646\u0650\u064a \u0634\u064e\u0641\u064e\u0670\u0639\u064e\u062a\u064f\u0647\u064f\u0645\u06e1 \u0634\u064e\u064a\u06e1\u0640\u0654\u064b\u0627 \u0625\u0650\u0644\u0651\u064e\u0627 \u0645\u0650\u0646\u06e2 \u0628\u064e\u0639\u06e1\u062f\u0650 \u0623\u064e\u0646 \u064a\u064e\u0623\u06e1\u0630\u064e\u0646\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0644\u0650\u0645\u064e\u0646 \u064a\u064e\u0634\u064e\u0627\u0653\u0621\u064f \u0648\u064e\u064a\u064e\u0631\u06e1\u0636\u064e\u0649\u0670\u0653","translation":"G\u00f6klerde nice melekler vard\u0131r ki, bir kimseye \u015fefaat etmek istediklerinde \u015fefaatleri ona bir fayda sa\u011flamaz. Ancak Allah'\u0131n onlardan diledi\u011fine \u015fefaat edilmesi i\u00e7in izin verdikleri ve kendisine \u015fefaat edilmesinden raz\u0131 oldu\u011fu kimse bundan m\u00fcstesnad\u0131r. Y\u00fcce Allah, \u015firk ko\u015fan kimseye \u015fefaat edilmesi i\u00e7in izin vermez ve Allah Te\u00e2l\u00e2'n\u0131n d\u0131\u015f\u0131nda ba\u015fka ilahlara ibadet eden kimseden asla raz\u0131 olmaz.","footnotes":null},{"id":"4811","sura":"53","aya":"27","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0644\u064e\u0627 \u064a\u064f\u0624\u06e1\u0645\u0650\u0646\u064f\u0648\u0646\u064e \u0628\u0650\u0671\u0644\u06e1\u0623\u0653\u062e\u0650\u0631\u064e\u0629\u0650 \u0644\u064e\u064a\u064f\u0633\u064e\u0645\u0651\u064f\u0648\u0646\u064e \u0671\u0644\u06e1\u0645\u064e\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064e\u0629\u064e \u062a\u064e\u0633\u06e1\u0645\u0650\u064a\u064e\u0629\u064e \u0671\u0644\u06e1\u0623\u064f\u0646\u062b\u064e\u0649\u0670","translation":"Ahirette yeniden dirili\u015fe iman etmeyenler, Allah'\u0131n k\u0131zlar\u0131 oldu\u011funa inand\u0131klar\u0131 i\u00e7in melekleri di\u015fi isimleriyle isimlendiriyorlard\u0131. Y\u00fcce Allah onlar\u0131n bu s\u00f6z\u00fcnden y\u00fcce ve b\u00fcy\u00fckt\u00fcr.","footnotes":null},{"id":"4812","sura":"53","aya":"28","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u0644\u064e\u0647\u064f\u0645 \u0628\u0650\u0647\u0650\u06e6 \u0645\u0650\u0646\u06e1 \u0639\u0650\u0644\u06e1\u0645\u064d\u06d6 \u0625\u0650\u0646 \u064a\u064e\u062a\u0651\u064e\u0628\u0650\u0639\u064f\u0648\u0646\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0644\u0638\u0651\u064e\u0646\u0651\u064e\u06d6 \u0648\u064e\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u0638\u0651\u064e\u0646\u0651\u064e \u0644\u064e\u0627 \u064a\u064f\u063a\u06e1\u0646\u0650\u064a \u0645\u0650\u0646\u064e \u0671\u0644\u06e1\u062d\u064e\u0642\u0651\u0650 \u0634\u064e\u064a\u06e1\u0640\u0654\u0657\u0627","translation":"Onlar\u0131n melekleri di\u015fi olarak isimlendirmelerinde dayand\u0131klar\u0131 hi\u00e7 bir delil yoktur. Bu hususta ancak yalan ve zanna tabi olmaktad\u0131rlar. Hi\u00e7 \u015f\u00fcphe yok ki zan ise hakk\u0131n yerine ge\u00e7ip bir \u015fey ifade etmez.","footnotes":null},{"id":"4813","sura":"53","aya":"29","arabic_text":"\u0641\u064e\u0623\u064e\u0639\u06e1\u0631\u0650\u0636\u06e1 \u0639\u064e\u0646 \u0645\u0651\u064e\u0646 \u062a\u064e\u0648\u064e\u0644\u0651\u064e\u0649\u0670 \u0639\u064e\u0646 \u0630\u0650\u0643\u06e1\u0631\u0650\u0646\u064e\u0627 \u0648\u064e\u0644\u064e\u0645\u06e1 \u064a\u064f\u0631\u0650\u062f\u06e1 \u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0644\u06e1\u062d\u064e\u064a\u064e\u0648\u0670\u0629\u064e \u0671\u0644\u062f\u0651\u064f\u0646\u06e1\u064a\u064e\u0627","translation":"-Ey Resul!- Allah'\u0131 zikretmekten y\u00fcz \u00e7eviren ve ona ald\u0131r\u0131\u015f etmeyen, d\u00fcnya hayat\u0131ndan ba\u015fka bir \u015fey istemeyen kimseden y\u00fcz \u00e7evir. O kimse ahireti i\u00e7in amel etmez. \u00c7\u00fcnk\u00fc ona iman etmez.","footnotes":null},{"id":"4814","sura":"53","aya":"30","arabic_text":"\u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0645\u064e\u0628\u06e1\u0644\u064e\u063a\u064f\u0647\u064f\u0645 \u0645\u0651\u0650\u0646\u064e \u0671\u0644\u06e1\u0639\u0650\u0644\u06e1\u0645\u0650\u06da \u0625\u0650\u0646\u0651\u064e \u0631\u064e\u0628\u0651\u064e\u0643\u064e \u0647\u064f\u0648\u064e \u0623\u064e\u0639\u06e1\u0644\u064e\u0645\u064f \u0628\u0650\u0645\u064e\u0646 \u0636\u064e\u0644\u0651\u064e \u0639\u064e\u0646 \u0633\u064e\u0628\u0650\u064a\u0644\u0650\u0647\u0650\u06e6 \u0648\u064e\u0647\u064f\u0648\u064e \u0623\u064e\u0639\u06e1\u0644\u064e\u0645\u064f \u0628\u0650\u0645\u064e\u0646\u0650 \u0671\u0647\u06e1\u062a\u064e\u062f\u064e\u0649\u0670","translation":"M\u00fc\u015friklerin s\u00f6yledikleri bu s\u00f6z -melekleri di\u015fi olarak isimlendirmek- onlar\u0131n ula\u015fabilecekleri ilmin son s\u0131n\u0131r\u0131d\u0131r. \u00c7\u00fcnk\u00fc onlar cahillerdir, ger\u00e7ek ilme ula\u015famam\u0131\u015flard\u0131r. -Ey Resul!- Senin Rabbin hak yolundan sapanlar\u0131 en iyi bilendir ve kimin de kendi yolunda hidayet \u00fczere oldu\u011funu en iyi bilendir. Bu hususta hi\u00e7bir \u015fey O'na gizli kalmaz.","footnotes":null},{"id":"4815","sura":"53","aya":"31","arabic_text":"\u0648\u064e\u0644\u0650\u0644\u0651\u064e\u0647\u0650 \u0645\u064e\u0627 \u0641\u0650\u064a \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0670\u0648\u064e\u0670\u062a\u0650 \u0648\u064e\u0645\u064e\u0627 \u0641\u0650\u064a \u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u0650 \u0644\u0650\u064a\u064e\u062c\u06e1\u0632\u0650\u064a\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0623\u064e\u0633\u064e\u0670\u0653\u0640\u0654\u064f\u0648\u0627\u0652 \u0628\u0650\u0645\u064e\u0627 \u0639\u064e\u0645\u0650\u0644\u064f\u0648\u0627\u0652 \u0648\u064e\u064a\u064e\u062c\u06e1\u0632\u0650\u064a\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0623\u064e\u062d\u06e1\u0633\u064e\u0646\u064f\u0648\u0627\u0652 \u0628\u0650\u0671\u0644\u06e1\u062d\u064f\u0633\u06e1\u0646\u064e\u0649","translation":"G\u00f6klerdeki ve yerdeki her \u015fey; m\u00fclk, yaratma ve idare etme bak\u0131m\u0131ndan yaln\u0131zca Y\u00fcce Allah'a aittir. D\u00fcnyada k\u00f6t\u00fc amel i\u015fleyenleri hak ettikleri azap ile cezaland\u0131racak ve iyi amel i\u015fleyen M\u00fcminleri de cennet ile m\u00fck\u00e2fatland\u0131racakt\u0131r.","footnotes":null},{"id":"4816","sura":"53","aya":"32","arabic_text":"\u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u064a\u064e\u062c\u06e1\u062a\u064e\u0646\u0650\u0628\u064f\u0648\u0646\u064e \u0643\u064e\u0628\u064e\u0670\u0653\u0626\u0650\u0631\u064e \u0671\u0644\u06e1\u0625\u0650\u062b\u06e1\u0645\u0650 \u0648\u064e\u0671\u0644\u06e1\u0641\u064e\u0648\u064e\u0670\u062d\u0650\u0634\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0644\u0644\u0651\u064e\u0645\u064e\u0645\u064e\u06da \u0625\u0650\u0646\u0651\u064e \u0631\u064e\u0628\u0651\u064e\u0643\u064e \u0648\u064e\u0670\u0633\u0650\u0639\u064f \u0671\u0644\u06e1\u0645\u064e\u063a\u06e1\u0641\u0650\u0631\u064e\u0629\u0650\u06da \u0647\u064f\u0648\u064e \u0623\u064e\u0639\u06e1\u0644\u064e\u0645\u064f \u0628\u0650\u0643\u064f\u0645\u06e1 \u0625\u0650\u0630\u06e1 \u0623\u064e\u0646\u0634\u064e\u0623\u064e\u0643\u064f\u0645 \u0645\u0651\u0650\u0646\u064e \u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u0650 \u0648\u064e\u0625\u0650\u0630\u06e1 \u0623\u064e\u0646\u062a\u064f\u0645\u06e1 \u0623\u064e\u062c\u0650\u0646\u0651\u064e\u0629\u065e \u0641\u0650\u064a \u0628\u064f\u0637\u064f\u0648\u0646\u0650 \u0623\u064f\u0645\u0651\u064e\u0647\u064e\u0670\u062a\u0650\u0643\u064f\u0645\u06e1\u06d6 \u0641\u064e\u0644\u064e\u0627 \u062a\u064f\u0632\u064e\u0643\u0651\u064f\u0648\u0653\u0627\u0652 \u0623\u064e\u0646\u0641\u064f\u0633\u064e\u0643\u064f\u0645\u06e1\u06d6 \u0647\u064f\u0648\u064e \u0623\u064e\u0639\u06e1\u0644\u064e\u0645\u064f \u0628\u0650\u0645\u064e\u0646\u0650 \u0671\u062a\u0651\u064e\u0642\u064e\u0649\u0670\u0653","translation":"Onlar; k\u00fc\u00e7\u00fck g\u00fcnahlar d\u0131\u015f\u0131nda, b\u00fcy\u00fck g\u00fcnahlardan ve \u00e7irkin i\u015flerden uzak duran kimselerdir. Bu k\u00fc\u00e7\u00fck g\u00fcnahlar b\u00fcy\u00fckleri terk edip, itaatleri art\u0131rmak suretiyle ba\u011f\u0131\u015flan\u0131r. -Ey Ras\u00fbl!- \u015e\u00fcphesiz ki Rabbin, ma\u011ffireti bol olan, t\u00f6vbe eden kullar\u0131n\u0131n g\u00fcnahlar\u0131n\u0131 ba\u011f\u0131\u015flayand\u0131r. O -Subh\u00e2neh\u00fb ve Te\u00e2l\u00e2- baban\u0131z Adem'i topraktan yaratt\u0131\u011f\u0131nda ve annelerinizin karn\u0131nda yarat\u0131l\u0131\u015f evrelerinde iken ahvalinizi ve i\u015flerinizi en iyi bilendir. Bundan hi\u00e7bir \u015fey O'na gizli kalmaz. Kendi nefislerinizi takva ile methederek \u00f6vmeyiniz. Allah -Subh\u00e2neh\u00fb ve Te\u00e2l\u00e2- emirlerini yerine getirip yasaklar\u0131ndan sak\u0131narak kendisine kar\u015f\u0131 takval\u0131 olanlar\u0131 hakk\u0131yla bilir.","footnotes":null},{"id":"4817","sura":"53","aya":"33","arabic_text":"\u0623\u064e\u0641\u064e\u0631\u064e\u0621\u064e\u064a\u06e1\u062a\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a \u062a\u064e\u0648\u064e\u0644\u0651\u064e\u0649\u0670","translation":"\u0130slam'a yak\u0131nla\u015ft\u0131ktan sonra ondan y\u00fcz \u00e7eviren kimsenin halinin ne kadar \u00e7irkin oldu\u011funu g\u00f6rd\u00fcn m\u00fc?","footnotes":null},{"id":"4818","sura":"53","aya":"34","arabic_text":"\u0648\u064e\u0623\u064e\u0639\u06e1\u0637\u064e\u0649\u0670 \u0642\u064e\u0644\u0650\u064a\u0644\u0657\u0627 \u0648\u064e\u0623\u064e\u0643\u06e1\u062f\u064e\u0649\u0670\u0653","translation":"Mal\u0131ndan az\u0131c\u0131k verip sonra men eder. \u00c7\u00fcnk\u00fc cimrilik onun tabiat\u0131d\u0131r. Bununla beraber kendi nefsini temize \u00e7\u0131kar\u0131r.","footnotes":null},{"id":"4819","sura":"53","aya":"35","arabic_text":"\u0623\u064e\u0639\u0650\u0646\u062f\u064e\u0647\u064f\u06e5 \u0639\u0650\u0644\u06e1\u0645\u064f \u0671\u0644\u06e1\u063a\u064e\u064a\u06e1\u0628\u0650 \u0641\u064e\u0647\u064f\u0648\u064e \u064a\u064e\u0631\u064e\u0649\u0670\u0653","translation":"Gayb\u0131n ilmi onun yan\u0131nda da, o g\u00f6r\u00fcyor ve gaybtan haber mi veriyor?","footnotes":null},{"id":"4820","sura":"53","aya":"36","arabic_text":"\u0623\u064e\u0645\u06e1 \u0644\u064e\u0645\u06e1 \u064a\u064f\u0646\u064e\u0628\u0651\u064e\u0623\u06e1 \u0628\u0650\u0645\u064e\u0627 \u0641\u0650\u064a \u0635\u064f\u062d\u064f\u0641\u0650 \u0645\u064f\u0648\u0633\u064e\u0649\u0670","translation":"Yoksa o Allah'a iftira m\u0131 at\u0131yor? Yoksa Allah ad\u0131na yalan uyduran bu kimseye Y\u00fcce Allah'\u0131n Musa'ya indirdi\u011fi ilk sahifelerde olanlar haber verilmedi mi?","footnotes":null},{"id":"4821","sura":"53","aya":"37","arabic_text":"\u0648\u064e\u0625\u0650\u0628\u06e1\u0631\u064e\u0670\u0647\u0650\u064a\u0645\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a \u0648\u064e\u0641\u0651\u064e\u0649\u0670\u0653","translation":"Rabbinin kendisini sorumlu tuttu\u011fu g\u00f6revi tamamlayan \u0130brahim'in sahifelerinde olanlar (haber verilmedi mi?)","footnotes":null},{"id":"4822","sura":"53","aya":"38","arabic_text":"\u0623\u064e\u0644\u0651\u064e\u0627 \u062a\u064e\u0632\u0650\u0631\u064f \u0648\u064e\u0627\u0632\u0650\u0631\u064e\u0629\u065e \u0648\u0650\u0632\u06e1\u0631\u064e \u0623\u064f\u062e\u06e1\u0631\u064e\u0649\u0670","translation":"\u015e\u00fcphesiz hi\u00e7bir insan ba\u015fkas\u0131n\u0131n g\u00fcnah\u0131n\u0131 y\u00fcklenemez.","footnotes":null},{"id":"4823","sura":"53","aya":"39","arabic_text":"\u0648\u064e\u0623\u064e\u0646 \u0644\u0651\u064e\u064a\u06e1\u0633\u064e \u0644\u0650\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u0650 \u0625\u0650\u0644\u0651\u064e\u0627 \u0645\u064e\u0627 \u0633\u064e\u0639\u064e\u0649\u0670","translation":"\u0130nsan i\u00e7in ancak i\u015flemi\u015f oldu\u011fu amelin kar\u015f\u0131l\u0131\u011f\u0131 vard\u0131r.","footnotes":null},{"id":"4824","sura":"53","aya":"40","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u0651\u064e \u0633\u064e\u0639\u06e1\u064a\u064e\u0647\u064f\u06e5 \u0633\u064e\u0648\u06e1\u0641\u064e \u064a\u064f\u0631\u064e\u0649\u0670","translation":"\u015e\u00fcphesiz k\u0131yamet g\u00fcn\u00fc ameli ayan beyan g\u00f6r\u00fclecektir.","footnotes":null},{"id":"4825","sura":"53","aya":"41","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u064a\u064f\u062c\u06e1\u0632\u064e\u0649\u0670\u0647\u064f \u0671\u0644\u06e1\u062c\u064e\u0632\u064e\u0627\u0653\u0621\u064e \u0671\u0644\u06e1\u0623\u064e\u0648\u06e1\u0641\u064e\u0649\u0670","translation":"Sonra i\u015flemi\u015f oldu\u011fu amelinin kar\u015f\u0131l\u0131\u011f\u0131 tastamam eksiksiz olarak kendisine verilecektir.","footnotes":null},{"id":"4826","sura":"53","aya":"42","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u0651\u064e \u0625\u0650\u0644\u064e\u0649\u0670 \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0671\u0644\u06e1\u0645\u064f\u0646\u062a\u064e\u0647\u064e\u0649\u0670","translation":"-Ey Rasul!- \u00d6ld\u00fckten sonra kullar\u0131n varaca\u011f\u0131 yer ve d\u00f6n\u00fc\u015fleri ancak Rabbinedir.","footnotes":null},{"id":"4827","sura":"53","aya":"43","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u06e5 \u0647\u064f\u0648\u064e \u0623\u064e\u0636\u06e1\u062d\u064e\u0643\u064e \u0648\u064e\u0623\u064e\u0628\u06e1\u0643\u064e\u0649\u0670","translation":"\u015e\u00fcphesiz O diledi\u011fini mutlu edip g\u00fcld\u00fcren ve diledi\u011fini h\u00fcz\u00fcnlendirip a\u011flatand\u0131r.","footnotes":null},{"id":"4828","sura":"53","aya":"44","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u06e5 \u0647\u064f\u0648\u064e \u0623\u064e\u0645\u064e\u0627\u062a\u064e \u0648\u064e\u0623\u064e\u062d\u06e1\u064a\u064e\u0627","translation":"D\u00fcnyada canl\u0131lar\u0131 \u00f6ld\u00fcren ve yeniden dirilterek \u00f6l\u00fclere hayat veren O'dur.","footnotes":null},{"id":"4829","sura":"53","aya":"45","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u06e5 \u062e\u064e\u0644\u064e\u0642\u064e \u0671\u0644\u0632\u0651\u064e\u0648\u06e1\u062c\u064e\u064a\u06e1\u0646\u0650 \u0671\u0644\u0630\u0651\u064e\u0643\u064e\u0631\u064e \u0648\u064e\u0671\u0644\u06e1\u0623\u064f\u0646\u062b\u064e\u0649\u0670","translation":"Erkek ve di\u015fi olarak iki s\u0131n\u0131f\u0131 yaratan O\u2019dur.","footnotes":null},{"id":"4830","sura":"53","aya":"46","arabic_text":"\u0645\u0650\u0646 \u0646\u0651\u064f\u0637\u06e1\u0641\u064e\u0629\u064d \u0625\u0650\u0630\u064e\u0627 \u062a\u064f\u0645\u06e1\u0646\u064e\u0649\u0670","translation":"Bir nutfeden rahime konuldu\u011fu zaman.","footnotes":null},{"id":"4831","sura":"53","aya":"47","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u0651\u064e \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u0650 \u0671\u0644\u0646\u0651\u064e\u0634\u06e1\u0623\u064e\u0629\u064e \u0671\u0644\u06e1\u0623\u064f\u062e\u06e1\u0631\u064e\u0649\u0670","translation":"\u00d6ld\u00fckten sonra yeniden dirili\u015f i\u00e7in o ikisinin tekrardan yarat\u0131lmas\u0131 O'na aittir.","footnotes":null},{"id":"4832","sura":"53","aya":"48","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u06e5 \u0647\u064f\u0648\u064e \u0623\u064e\u063a\u06e1\u0646\u064e\u0649\u0670 \u0648\u064e\u0623\u064e\u0642\u06e1\u0646\u064e\u0649\u0670","translation":"Mal m\u00fclk vererek kullar\u0131ndan diledi\u011fini zengin k\u0131lan ve insanlar\u0131n kazan\u00e7 olarak elde ettikleri maldan onlara verendir.","footnotes":null},{"id":"4833","sura":"53","aya":"49","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u06e5 \u0647\u064f\u0648\u064e \u0631\u064e\u0628\u0651\u064f \u0671\u0644\u0634\u0651\u0650\u0639\u06e1\u0631\u064e\u0649\u0670","translation":"\u015e\u00fcphesiz \u015ei'r\u00e2 y\u0131ld\u0131z\u0131n\u0131n da Rabbi O'dur. Bu, baz\u0131 m\u00fc\u015friklerin Y\u00fcce Allah ile beraber ibadet ettikleri bir y\u0131ld\u0131zd\u0131r.","footnotes":null},{"id":"4834","sura":"53","aya":"50","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u06e5\u0653 \u0623\u064e\u0647\u06e1\u0644\u064e\u0643\u064e \u0639\u064e\u0627\u062f\u064b\u0627 \u0671\u0644\u06e1\u0623\u064f\u0648\u0644\u064e\u0649\u0670","translation":"H\u00fbd'un kavmi olan \u00f6nceki \u00c2d'\u0131 helak eden O'dur. Onlar k\u00fcf\u00fcrlerinde \u0131srar ettikleri i\u00e7in helak edilmi\u015flerdir.","footnotes":null},{"id":"4835","sura":"53","aya":"51","arabic_text":"\u0648\u064e\u062b\u064e\u0645\u064f\u0648\u062f\u064e\u0627\u0652 \u0641\u064e\u0645\u064e\u0627\u0653 \u0623\u064e\u0628\u06e1\u0642\u064e\u0649\u0670","translation":"Salih'in kavmi Sem\u00fbd'u da helak eden O'dur. Onlardan hi\u00e7birini b\u0131rakmad\u0131.","footnotes":null},{"id":"4836","sura":"53","aya":"52","arabic_text":"\u0648\u064e\u0642\u064e\u0648\u06e1\u0645\u064e \u0646\u064f\u0648\u062d\u0656 \u0645\u0651\u0650\u0646 \u0642\u064e\u0628\u06e1\u0644\u064f\u06d6 \u0625\u0650\u0646\u0651\u064e\u0647\u064f\u0645\u06e1 \u0643\u064e\u0627\u0646\u064f\u0648\u0627\u0652 \u0647\u064f\u0645\u06e1 \u0623\u064e\u0638\u06e1\u0644\u064e\u0645\u064e \u0648\u064e\u0623\u064e\u0637\u06e1\u063a\u064e\u0649\u0670","translation":"\u00c2d ve Sem\u00fbd kavimlerinden \u00f6nce Nuh'un kavmini helak etmi\u015fti. Nuh'un kavmi, \u00c2d ve Sem\u00fbd kavimlerinden daha zalim ve azg\u0131n kimselerdi. \u00c7\u00fcnk\u00fc Nuh -aleyhisselam- dokuz y\u00fcz elli sene onlar\u0131n aras\u0131nda kald\u0131 ve onlar\u0131 Allah'\u0131 birlemeye davet etti. Ancak ona icabet etmediler.","footnotes":null},{"id":"4837","sura":"53","aya":"53","arabic_text":"\u0648\u064e\u0671\u0644\u06e1\u0645\u064f\u0624\u06e1\u062a\u064e\u0641\u0650\u0643\u064e\u0629\u064e \u0623\u064e\u0647\u06e1\u0648\u064e\u0649\u0670","translation":"Lut kavminin \u015fehirlerini g\u00f6ky\u00fcz\u00fcne kald\u0131rd\u0131, sonra ters \u00e7evirdi, sonra da yery\u00fcz\u00fcne ge\u00e7irdi.","footnotes":null},{"id":"4838","sura":"53","aya":"54","arabic_text":"\u0641\u064e\u063a\u064e\u0634\u0651\u064e\u0649\u0670\u0647\u064e\u0627 \u0645\u064e\u0627 \u063a\u064e\u0634\u0651\u064e\u0649\u0670","translation":"G\u00f6ky\u00fcz\u00fcne kald\u0131r\u0131p yere ge\u00e7irdikten sonra onlara ta\u015flar isabet edip (azap) b\u00fcr\u00fcd\u00fc.","footnotes":null},{"id":"4839","sura":"53","aya":"55","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u062a\u064e\u062a\u064e\u0645\u064e\u0627\u0631\u064e\u0649\u0670","translation":"-Ey insan!- \u015eimdi Rabbinin kudretine delalet eden hangi nimetine kar\u015f\u0131 koyarak ondan \u00f6\u011f\u00fct alm\u0131yorsun?","footnotes":null},{"id":"4840","sura":"53","aya":"56","arabic_text":"\u0647\u064e\u0670\u0630\u064e\u0627 \u0646\u064e\u0630\u0650\u064a\u0631\u065e \u0645\u0651\u0650\u0646\u064e \u0671\u0644\u0646\u0651\u064f\u0630\u064f\u0631\u0650 \u0671\u0644\u06e1\u0623\u064f\u0648\u0644\u064e\u0649\u0670\u0653","translation":"Size g\u00f6nderilen bu resul daha \u00f6nceden g\u00f6nderilen resullerdendir.","footnotes":null},{"id":"4841","sura":"53","aya":"57","arabic_text":"\u0623\u064e\u0632\u0650\u0641\u064e\u062a\u0650 \u0671\u0644\u06e1\u0623\u0653\u0632\u0650\u0641\u064e\u0629\u064f","translation":"Yak\u0131n olan o k\u0131yamet yakla\u015ft\u0131.","footnotes":null},{"id":"4842","sura":"53","aya":"58","arabic_text":"\u0644\u064e\u064a\u06e1\u0633\u064e \u0644\u064e\u0647\u064e\u0627 \u0645\u0650\u0646 \u062f\u064f\u0648\u0646\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0643\u064e\u0627\u0634\u0650\u0641\u064e\u0629\u064c","translation":"Y\u00fcce Allah'tan ba\u015fka onu defedecek ve onu bilecek kimse yoktur.","footnotes":null},{"id":"4843","sura":"53","aya":"59","arabic_text":"\u0623\u064e\u0641\u064e\u0645\u0650\u0646\u06e1 \u0647\u064e\u0670\u0630\u064e\u0627 \u0671\u0644\u06e1\u062d\u064e\u062f\u0650\u064a\u062b\u0650 \u062a\u064e\u0639\u06e1\u062c\u064e\u0628\u064f\u0648\u0646\u064e","translation":"\u015eimdi siz, kendinize okunan bu Kur'an'\u0131n Allah kat\u0131ndan oldu\u011funa m\u0131 \u015fa\u015f\u0131r\u0131yorsunuz?","footnotes":null},{"id":"4844","sura":"53","aya":"60","arabic_text":"\u0648\u064e\u062a\u064e\u0636\u06e1\u062d\u064e\u0643\u064f\u0648\u0646\u064e \u0648\u064e\u0644\u064e\u0627 \u062a\u064e\u0628\u06e1\u0643\u064f\u0648\u0646\u064e","translation":"Onunla alay edip g\u00fcl\u00fcyor ve i\u00e7indeki \u00f6\u011f\u00fctleri duyunca a\u011flam\u0131yorsunuz?","footnotes":null},{"id":"4845","sura":"53","aya":"61","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u062a\u064f\u0645\u06e1 \u0633\u064e\u0670\u0645\u0650\u062f\u064f\u0648\u0646\u064e","translation":"Ve sizler onu \u00f6nemsemiyor, ihtimam da g\u00f6stermiyorsunuz!","footnotes":null},{"id":"4846","sura":"53","aya":"62","arabic_text":"\u0641\u064e\u0671\u0633\u06e1\u062c\u064f\u062f\u064f\u0648\u0627\u0652\u06e4 \u0644\u0650\u0644\u0651\u064e\u0647\u0650\u06e4 \u0648\u064e\u0671\u0639\u06e1\u0628\u064f\u062f\u064f\u0648\u0627\u0652\u06e9","translation":"O halde yaln\u0131zca Y\u00fcce Allah'a secde edin ve ibadeti O'na has k\u0131l\u0131n.","footnotes":null}]}