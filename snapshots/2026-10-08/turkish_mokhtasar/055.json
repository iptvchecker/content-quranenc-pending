1\u0644\u06e1\u062c\u064e\u0648\u064e\u0627\u0631\u0650 \u0671\u0644\u06e1\u0645\u064f\u0646\u0634\u064e\u0640\u0654\u064e\u0627\u062a\u064f \u0641\u0650\u064a \u0671\u0644\u06e1\u0628\u064e\u062d\u06e1\u0631\u0650 \u0643\u064e\u0671\u0644\u06e1\u0623\u064e\u0639\u06e1\u0644\u064e\u0670\u0645\u0650","translation":"Denizde y\u00fcksek da\u011flar gibi y\u00fckselmi\u015f y\u00fcz\u00fcp, giden gemilerin tasarrufu da yaln\u0131zca Allah -Subhanehu ve Te\u00e2l\u00e2-'ya aittir.","footnotes":null},{"id":"4926","sura":"55","aya":"25","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"O halde siz (insan ve cin toplulu\u011fu), Allah'\u0131n size bah\u015fetti\u011fi o bol nimetlerden hangisini yalanl\u0131yorsunuz?","footnotes":null},{"id":"4927","sura":"55","aya":"26","arabic_text":"\u0643\u064f\u0644\u0651\u064f \u0645\u064e\u0646\u06e1 \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u064e\u0627 \u0641\u064e\u0627\u0646\u0656","translation":"Yery\u00fcz\u00fcnde bulunan b\u00fct\u00fcn canl\u0131lar kesinlikle yok olacakt\u0131r.","footnotes":null},{"id":"4928","sura":"55","aya":"27","arabic_text":"\u0648\u064e\u064a\u064e\u0628\u06e1\u0642\u064e\u0649\u0670 \u0648\u064e\u062c\u06e1\u0647\u064f \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0630\u064f\u0648 \u0671\u0644\u06e1\u062c\u064e\u0644\u064e\u0670\u0644\u0650 \u0648\u064e\u0671\u0644\u06e1\u0625\u0650\u0643\u06e1\u0631\u064e\u0627\u0645\u0650","translation":"-Ey Resul!- Kullar\u0131na l\u00fctufta ve ihsanda bulunan azamet sahibi Rabbinin y\u00fcz\u00fc bakidir. Kesinlikle fani olmak O'na isabet etmez.","footnotes":null},{"id":"4929","sura":"55","aya":"28","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"O halde siz (insan ve cin toplulu\u011fu), Allah'\u0131n size bah\u015fetti\u011fi o bol nimetlerden hangisini yalanl\u0131yorsunuz?","footnotes":null},{"id":"4930","sura":"55","aya":"29","arabic_text":"\u064a\u064e\u0633\u06e1\u0640\u0654\u064e\u0644\u064f\u0647\u064f\u06e5 \u0645\u064e\u0646 \u0641\u0650\u064a \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0670\u0648\u064e\u0670\u062a\u0650 \u0648\u064e\u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u0650\u06da \u0643\u064f\u0644\u0651\u064e \u064a\u064e\u0648\u06e1\u0645\u064d \u0647\u064f\u0648\u064e \u0641\u0650\u064a \u0634\u064e\u0623\u06e1\u0646\u0656","translation":"G\u00f6klerde bulunan her melek ve yery\u00fcz\u00fcnde bulunan her insan ve cin ihtiya\u00e7lar\u0131n\u0131 O'ndan isterler. O; her g\u00fcn yaratma, \u00f6ld\u00fcrme, r\u0131z\u0131k vb. gibi kullar\u0131n\u0131n i\u015fleri i\u00e7in bir ilahi tasarruftad\u0131r.","footnotes":null},{"id":"4931","sura":"55","aya":"30","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"O halde siz (insan ve cin toplulu\u011fu), Allah'\u0131n size bah\u015fetti\u011fi o bol nimetlerden hangisini yalanl\u0131yorsunuz?","footnotes":null},{"id":"4932","sura":"55","aya":"31","arabic_text":"\u0633\u064e\u0646\u064e\u0641\u06e1\u0631\u064f\u063a\u064f \u0644\u064e\u0643\u064f\u0645\u06e1 \u0623\u064e\u064a\u0651\u064f\u0647\u064e \u0671\u0644\u062b\u0651\u064e\u0642\u064e\u0644\u064e\u0627\u0646\u0650","translation":"-Ey insanlar ve cinler!- Sizin hesab\u0131n\u0131z\u0131 g\u00f6rece\u011fiz. Herkese hak etti\u011finin kar\u015f\u0131l\u0131\u011f\u0131 olan m\u00fck\u00e2fat\u0131 ve cezay\u0131 verece\u011fiz.","footnotes":null},{"id":"4933","sura":"55","aya":"32","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"O halde siz (insan ve cin toplulu\u011fu), Allah'\u0131n size bah\u015fetti\u011fi o bol nimetlerden hangisini yalanl\u0131yorsunuz?","footnotes":null},{"id":"4934","sura":"55","aya":"33","arabic_text":"\u064a\u064e\u0670\u0645\u064e\u0639\u06e1\u0634\u064e\u0631\u064e \u0671\u0644\u06e1\u062c\u0650\u0646\u0651\u0650 \u0648\u064e\u0671\u0644\u06e1\u0625\u0650\u0646\u0633\u0650 \u0625\u0650\u0646\u0650 \u0671\u0633\u06e1\u062a\u064e\u0637\u064e\u0639\u06e1\u062a\u064f\u0645\u06e1 \u0623\u064e\u0646 \u062a\u064e\u0646\u0641\u064f\u0630\u064f\u0648\u0627\u0652 \u0645\u0650\u0646\u06e1 \u0623\u064e\u0642\u06e1\u0637\u064e\u0627\u0631\u0650 \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0670\u0648\u064e\u0670\u062a\u0650 \u0648\u064e\u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u0650 \u0641\u064e\u0671\u0646\u0641\u064f\u0630\u064f\u0648\u0627\u0652\u06da \u0644\u064e\u0627 \u062a\u064e\u0646\u0641\u064f\u0630\u064f\u0648\u0646\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0628\u0650\u0633\u064f\u0644\u06e1\u0637\u064e\u0670\u0646\u0656","translation":"K\u0131yamet g\u00fcn\u00fc insanlar\u0131 ve cinleri bir araya toplad\u0131\u011f\u0131nda Y\u00fcce Allah \u015f\u00f6yle diyecektir: \"Ey insan ve cin topluluklar\u0131! G\u00f6klerde ve yerde \u00e7\u0131kmak i\u00e7in kendinize bir yer bulabiliyorsan\u0131z hi\u00e7 durmay\u0131n bunu yap\u0131n. B\u00fcy\u00fck bir g\u00fc\u00e7 ve mucize olmadan bunu yapmaya g\u00fc\u00e7 yetiremezsiniz, bunu nas\u0131l yapacaks\u0131n\u0131z?\"","footnotes":null},{"id":"4935","sura":"55","aya":"34","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"O halde siz (insan ve cin toplulu\u011fu), Allah'\u0131n size bah\u015fetti\u011fi o bol nimetlerden hangisini yalanl\u0131yorsunuz?","footnotes":null},{"id":"4936","sura":"55","aya":"35","arabic_text":"\u064a\u064f\u0631\u06e1\u0633\u064e\u0644\u064f \u0639\u064e\u0644\u064e\u064a\u06e1\u0643\u064f\u0645\u064e\u0627 \u0634\u064f\u0648\u064e\u0627\u0638\u065e \u0645\u0651\u0650\u0646 \u0646\u0651\u064e\u0627\u0631\u0656 \u0648\u064e\u0646\u064f\u062d\u064e\u0627\u0633\u065e \u0641\u064e\u0644\u064e\u0627 \u062a\u064e\u0646\u062a\u064e\u0635\u0650\u0631\u064e\u0627\u0646\u0650","translation":"-Ey insanlar ve cinler!- \u00dczerinize yal\u0131n alev ve alevi olmayan duman g\u00f6nderilir de ondan ka\u00e7\u0131nmaya g\u00fc\u00e7 yetiremezsiniz.","footnotes":null},{"id":"4937","sura":"55","aya":"36","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"O halde siz (insan ve cin toplulu\u011fu), Allah'\u0131n size bah\u015fetti\u011fi o bol nimetlerden hangisini yalanl\u0131yorsunuz?","footnotes":null},{"id":"4938","sura":"55","aya":"37","arabic_text":"\u0641\u064e\u0625\u0650\u0630\u064e\u0627 \u0671\u0646\u0634\u064e\u0642\u0651\u064e\u062a\u0650 \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0627\u0653\u0621\u064f \u0641\u064e\u0643\u064e\u0627\u0646\u064e\u062a\u06e1 \u0648\u064e\u0631\u06e1\u062f\u064e\u0629\u0657 \u0643\u064e\u0671\u0644\u062f\u0651\u0650\u0647\u064e\u0627\u0646\u0650","translation":"Meleklerin inmesi i\u00e7in g\u00f6k yar\u0131l\u0131p da, k\u0131zar\u0131p rengi parlayan ya\u011f gibi oldu\u011fu zaman.","footnotes":null},{"id":"4939","sura":"55","aya":"38","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"O halde siz (insan ve cin toplulu\u011fu), Allah'\u0131n size bah\u015fetti\u011fi o bol nimetlerden hangisini yalanl\u0131yorsunuz?","footnotes":null},{"id":"4940","sura":"55","aya":"39","arabic_text":"\u0641\u064e\u064a\u064e\u0648\u06e1\u0645\u064e\u0626\u0650\u0630\u0656 \u0644\u0651\u064e\u0627 \u064a\u064f\u0633\u06e1\u0640\u0654\u064e\u0644\u064f \u0639\u064e\u0646 \u0630\u064e\u0646\u06e2\u0628\u0650\u0647\u0650\u06e6\u0653 \u0625\u0650\u0646\u0633\u065e \u0648\u064e\u0644\u064e\u0627 \u062c\u064e\u0627\u0653\u0646\u0651\u065e","translation":"\u0130\u015fte o b\u00fcy\u00fck g\u00fcn Y\u00fcce Allah'\u0131n onlar\u0131n neler yapt\u0131klar\u0131n\u0131 \u00e7ok iyi bilmesinden dolay\u0131 hi\u00e7bir insana ve cine g\u00fcnah\u0131 sorulmaz.","footnotes":null},{"id":"4941","sura":"55","aya":"40","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"O halde siz (insan ve cin toplulu\u011fu), Allah'\u0131n size bah\u015fetti\u011fi o bol nimetlerden hangisini yalanl\u0131yorsunuz?","footnotes":null},{"id":"4942","sura":"55","aya":"41","arabic_text":"\u064a\u064f\u0639\u06e1\u0631\u064e\u0641\u064f \u0671\u0644\u06e1\u0645\u064f\u062c\u06e1\u0631\u0650\u0645\u064f\u0648\u0646\u064e \u0628\u0650\u0633\u0650\u064a\u0645\u064e\u0670\u0647\u064f\u0645\u06e1 \u0641\u064e\u064a\u064f\u0624\u06e1\u062e\u064e\u0630\u064f \u0628\u0650\u0671\u0644\u0646\u0651\u064e\u0648\u064e\u0670\u0635\u0650\u064a \u0648\u064e\u0671\u0644\u06e1\u0623\u064e\u0642\u06e1\u062f\u064e\u0627\u0645\u0650","translation":"K\u0131yamet g\u00fcn\u00fc su\u00e7lular y\u00fczlerinin kara ve g\u00f6zlerinin mavi olmas\u0131 gibi alametlerden tan\u0131n\u0131r. Per\u00e7emleri ayaklar\u0131 ile bir araya getirilip cehenneme at\u0131l\u0131rlar.","footnotes":null},{"id":"4943","sura":"55","aya":"42","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"O halde siz (insan ve cin toplulu\u011fu), Allah'\u0131n size bah\u015fetti\u011fi o bol nimetlerden hangisini yalanl\u0131yorsunuz?","footnotes":null},{"id":"4944","sura":"55","aya":"43","arabic_text":"\u0647\u064e\u0670\u0630\u0650\u0647\u0650\u06e6 \u062c\u064e\u0647\u064e\u0646\u0651\u064e\u0645\u064f \u0671\u0644\u0651\u064e\u062a\u0650\u064a \u064a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064f \u0628\u0650\u0647\u064e\u0627 \u0671\u0644\u06e1\u0645\u064f\u062c\u06e1\u0631\u0650\u0645\u064f\u0648\u0646\u064e","translation":"Azarlamak i\u00e7in onlara \u015f\u00f6yle denilir: \u0130\u015fte bu d\u00fcnyada iken g\u00fcnahk\u00e2rlar\u0131n yalanlad\u0131\u011f\u0131 cehennemdir. Art\u0131k g\u00f6zlerinin \u00f6n\u00fcndedir, onu ink\u00e2r edemezler.","footnotes":null},{"id":"4945","sura":"55","aya":"44","arabic_text":"\u064a\u064e\u0637\u064f\u0648\u0641\u064f\u0648\u0646\u064e \u0628\u064e\u064a\u06e1\u0646\u064e\u0647\u064e\u0627 \u0648\u064e\u0628\u064e\u064a\u06e1\u0646\u064e \u062d\u064e\u0645\u0650\u064a\u0645\u064d \u0621\u064e\u0627\u0646\u0656","translation":"Onlar cehennem ve y\u00fcksek derecede kaynar su aras\u0131nda gidip gelirler.","footnotes":null},{"id":"4946","sura":"55","aya":"45","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u