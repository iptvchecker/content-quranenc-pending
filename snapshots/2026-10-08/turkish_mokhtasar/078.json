{"result":[{"id":"5673","sura":"78","aya":"1","arabic_text":"\u0639\u064e\u0645\u0651\u064e \u064a\u064e\u062a\u064e\u0633\u064e\u0627\u0653\u0621\u064e\u0644\u064f\u0648\u0646\u064e","translation":"Y\u00fcce Allah kendilerine, Peygamber -sallallahu aleyhi ve sellem-'i g\u00f6nderdikten sonra, bu m\u00fc\u015frikler h\u00e2l\u00e2 hangi \u015fey hakk\u0131nda soru sorup duruyorlar?","footnotes":null},{"id":"5674","sura":"78","aya":"2","arabic_text":"\u0639\u064e\u0646\u0650 \u0671\u0644\u0646\u0651\u064e\u0628\u064e\u0625\u0650 \u0671\u0644\u06e1\u0639\u064e\u0638\u0650\u064a\u0645\u0650","translation":"Onlar birbirine b\u00fcy\u00fck bir haber hakk\u0131nda soruyorlar. O da, yeniden dirili\u015f haberini bar\u0131nd\u0131ran peygamberlerine indirilmi\u015f olan bu Kur'an\u2019d\u0131r.","footnotes":null},{"id":"5675","sura":"78","aya":"3","arabic_text":"\u0671\u0644\u0651\u064e\u0630\u0650\u064a \u0647\u064f\u0645\u06e1 \u0641\u0650\u064a\u0647\u0650 \u0645\u064f\u062e\u06e1\u062a\u064e\u0644\u0650\u0641\u064f\u0648\u0646\u064e","translation":"Onlar bu Kur\u2019an\u2019\u0131; sihir, \u015fiir, kehanet veya eskilerin hik\u00e2yeleri olarak nitelendirirken kendi aralar\u0131nda ihtilaf etmektedirler.","footnotes":null},{"id":"5676","sura":"78","aya":"4","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627 \u0633\u064e\u064a\u064e\u0639\u06e1\u0644\u064e\u0645\u064f\u0648\u0646\u064e","translation":"Bu durum hi\u00e7 de onlar\u0131n iddia etti\u011fi gibi de\u011fildir. Kur'an'\u0131 yalanlayan o kimseler, yak\u0131nda yalanlamalar\u0131n\u0131n k\u00f6t\u00fc ak\u0131betini \u00f6\u011frenecekler.","footnotes":null},{"id":"5677","sura":"78","aya":"5","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0643\u064e\u0644\u0651\u064e\u0627 \u0633\u064e\u064a\u064e\u0639\u06e1\u0644\u064e\u0645\u064f\u0648\u0646\u064e","translation":"Sonra bu, onlar i\u00e7in kesin olacak.","footnotes":null},{"id":"5678","sura":"78","aya":"6","arabic_text":"\u0623\u064e\u0644\u064e\u0645\u06e1 \u0646\u064e\u062c\u06e1\u0639\u064e\u0644\u0650 \u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u064e \u0645\u0650\u0647\u064e\u0670\u062f\u0657\u0627","translation":"Yery\u00fcz\u00fcn\u00fc onlar i\u00e7in yay\u0131lm\u0131\u015f, \u00fczerinde karar k\u0131lmalar\u0131na elveri\u015fli bir hale d\u00f6n\u00fc\u015ft\u00fcrmedik mi?","footnotes":null},{"id":"5679","sura":"78","aya":"7","arabic_text":"\u0648\u064e\u0671\u0644\u06e1\u062c\u0650\u0628\u064e\u0627\u0644\u064e \u0623\u064e\u0648\u06e1\u062a\u064e\u0627\u062f\u0657\u0627","translation":"Ve yery\u00fcz\u00fcnde da\u011flar\u0131, onun sars\u0131lmas\u0131n\u0131 engelleyen kaz\u0131klar k\u0131ld\u0131k.","footnotes":null},{"id":"5680","sura":"78","aya":"8","arabic_text":"\u0648\u064e\u062e\u064e\u0644\u064e\u0642\u06e1\u0646\u064e\u0670\u0643\u064f\u0645\u06e1 \u0623\u064e\u0632\u06e1\u0648\u064e\u0670\u062c\u0657\u0627","translation":"-Ey insanlar!- Baz\u0131lar\u0131n\u0131z\u0131 erkek, baz\u0131lar\u0131n\u0131z\u0131 da di\u015fi olarak s\u0131n\u0131f s\u0131n\u0131f yaratt\u0131k.","footnotes":null},{"id":"5681","sura":"78","aya":"9","arabic_text":"\u0648\u064e\u062c\u064e\u0639\u064e\u0644\u06e1\u0646\u064e\u0627 \u0646\u064e\u0648\u06e1\u0645\u064e\u0643\u064f\u0645\u06e1 \u0633\u064f\u0628\u064e\u0627\u062a\u0657\u0627","translation":"Uykunuzu da, i\u015flerinizden dinlenmeniz i\u00e7in bir istirahat sebebi k\u0131ld\u0131k.","footnotes":null},{"id":"5682","sura":"78","aya":"10","arabic_text":"\u0648\u064e\u062c\u064e\u0639\u064e\u0644\u06e1\u0646\u064e\u0627 \u0671\u0644\u0651\u064e\u064a\u06e1\u0644\u064e \u0644\u0650\u0628\u064e\u0627\u0633\u0657\u0627","translation":"Avretlerinizi \u00f6rtt\u00fc\u011f\u00fcn\u00fcz elbiseler gibi geceyi de karanl\u0131\u011f\u0131yla \u00f6rten bir \u00f6rt\u00fc k\u0131ld\u0131k.","footnotes":null},{"id":"5683","sura":"78","aya":"11","arabic_text":"\u0648\u064e\u062c\u064e\u0639\u064e\u0644\u06e1\u0646\u064e\u0627 \u0671\u0644\u0646\u0651\u064e\u0647\u064e\u0627\u0631\u064e \u0645\u064e\u0639\u064e\u0627\u0634\u0657\u0627","translation":"Ve g\u00fcnd\u00fcz\u00fc de bir kazan\u00e7 ve r\u0131z\u0131k arama sahas\u0131 k\u0131ld\u0131k.","footnotes":null},{"id":"5684","sura":"78","aya":"12","arabic_text":"\u0648\u064e\u0628\u064e\u0646\u064e\u064a\u06e1\u0646\u064e\u0627 \u0641\u064e\u0648\u06e1\u0642\u064e\u0643\u064f\u0645\u06e1 \u0633\u064e\u0628\u06e1\u0639\u0657\u0627 \u0634\u0650\u062f\u064e\u0627\u062f\u0657\u0627","translation":"\u00dczerinize de dayan\u0131kl\u0131 ve sa\u011flamla\u015ft\u0131r\u0131lm\u0131\u015f yap\u0131l\u0131 yedi kat g\u00f6k bina ettik.","footnotes":null},{"id":"5685","sura":"78","aya":"13","arabic_text":"\u0648\u064e\u062c\u064e\u0639\u064e\u0644\u06e1\u0646\u064e\u0627 \u0633\u0650\u0631\u064e\u0627\u062c\u0657\u0627 \u0648\u064e\u0647\u0651\u064e\u0627\u062c\u0657\u0627","translation":"Ve G\u00fcne\u015fi de, g\u00fc\u00e7l\u00fc alevli ve ayd\u0131nlatan bir lamba yapt\u0131k.","footnotes":null},{"id":"5686","sura":"78","aya":"14","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u0632\u064e\u0644\u06e1\u0646\u064e\u0627 \u0645\u0650\u0646\u064e \u0671\u0644\u06e1\u0645\u064f\u0639\u06e1\u0635\u0650\u0631\u064e\u0670\u062a\u0650 \u0645\u064e\u0627\u0653\u0621\u0657 \u062b\u064e\u062c\u0651\u064e\u0627\u062c\u0657\u0627","translation":"Ve ya\u011fmur ya\u011fd\u0131rmas\u0131n\u0131n vakti gelmi\u015f bulutlardan bolca d\u00f6k\u00fclen su indirdik.","footnotes":null},{"id":"5687","sura":"78","aya":"15","arabic_text":"\u0644\u0651\u0650\u0646\u064f\u062e\u06e1\u0631\u0650\u062c\u064e \u0628\u0650\u0647\u0650\u06e6 \u062d\u064e\u0628\u0651\u0657\u0627 \u0648\u064e\u0646\u064e\u0628\u064e\u0627\u062a\u0657\u0627","translation":"Onunla \u00e7e\u015fitli tohumlar ve \u00e7e\u015fitli bitkiler \u00e7\u0131karal\u0131m diye.","footnotes":null},{"id":"5688","sura":"78","aya":"16","arabic_text":"\u0648\u064e\u062c\u064e\u0646\u0651\u064e\u0670\u062a\u064d \u0623\u064e\u0644\u06e1\u0641\u064e\u0627\u0641\u064b\u0627","translation":"Ve a\u011fa\u00e7 dallar\u0131n\u0131n birbirine girip, dola\u015fm\u0131\u015f bah\u00e7eler yeti\u015ftirelim.","footnotes":null},{"id":"5689","sura":"78","aya":"17","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u064a\u064e\u0648\u06e1\u0645\u064e \u0671\u0644\u06e1\u0641\u064e\u0635\u06e1\u0644\u0650 \u0643\u064e\u0627\u0646\u064e \u0645\u0650\u064a\u0642\u064e\u0670\u062a\u0657\u0627","translation":"\u015e\u00fcphesiz mahlukat\u0131n aras\u0131nda h\u00fck\u00fcm verilip, ay\u0131rt etme g\u00fcn\u00fc, hi\u00e7 kimsenin ge\u00e7 kalmayaca\u011f\u0131 sabit bir bulu\u015fma vaktidir.","footnotes":null},{"id":"5690","sura":"78","aya":"18","arabic_text":"\u064a\u064e\u0648\u06e1\u0645\u064e \u064a\u064f\u0646\u0641\u064e\u062e\u064f \u0641\u0650\u064a \u0671\u0644\u0635\u0651\u064f\u0648\u0631\u0650 \u0641\u064e\u062a\u064e\u0623\u06e1\u062a\u064f\u0648\u0646\u064e \u0623\u064e\u0641\u06e1\u0648\u064e\u0627\u062c\u0657\u0627","translation":"-Ey insanlar!- O g\u00fcn melek, ikinci defa boynuza \u00fcfleyecek ve siz b\u00f6l\u00fck b\u00f6l\u00fck geleceksiniz.","footnotes":null},{"id":"5691","sura":"78","aya":"19","arabic_text":"\u0648\u064e\u0641\u064f\u062a\u0650\u062d\u064e\u062a\u0650 \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0627\u0653\u0621\u064f \u0641\u064e\u0643\u064e\u0627\u0646\u064e\u062a\u06e1 \u0623\u064e\u0628\u06e1\u0648\u064e\u0670\u0628\u0657\u0627","translation":"Ve g\u00f6ky\u00fcz\u00fc a\u00e7\u0131l\u0131r ve i\u00e7inde a\u00e7\u0131k kap\u0131lar gibi gedik ve yar\u0131klar olu\u015fur.","footnotes":null},{"id":"5692","sura":"78","aya":"20","arabic_text":"\u0648\u064e\u0633\u064f\u064a\u0651\u0650\u0631\u064e\u062a\u0650 \u0671\u0644\u06e1\u062c\u0650\u0628\u064e\u0627\u0644\u064f \u0641\u064e\u0643\u064e\u0627\u0646\u064e\u062a\u06e1 \u0633\u064e\u0631\u064e\u0627\u0628\u064b\u0627","translation":"Da\u011flar, sa\u00e7\u0131lm\u0131\u015f toz topra\u011fa d\u00f6n\u00fc\u015f\u00fcnceye kadar y\u00fcr\u00fct\u00fcl\u00fcr ve t\u0131pk\u0131 bir serap gibi olur.","footnotes":null},{"id":"5693","sura":"78","aya":"21","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u062c\u064e\u0647\u064e\u0646\u0651\u064e\u0645\u064e \u0643\u064e\u0627\u0646\u064e\u062a\u06e1 \u0645\u0650\u0631\u06e1\u0635\u064e\u0627\u062f\u0657\u0627","translation":"\u015e\u00fcphesiz cehennem de pusuda bekleyen bir g\u00f6zc\u00fcd\u00fcr.","footnotes":null},{"id":"5694","sura":"78","aya":"22","arabic_text":"\u0644\u0651\u0650\u0644\u0637\u0651\u064e\u0670\u063a\u0650\u064a\u0646\u064e \u0645\u064e\u0640\u0654\u064e\u0627\u0628\u0657\u0627","translation":"Zalimlerin kendisine d\u00f6necekleri d\u00f6n\u00fc\u015f yeridir.","footnotes":null},{"id":"5695","sura":"78","aya":"23","arabic_text":"\u0644\u0651\u064e\u0670\u0628\u0650\u062b\u0650\u064a\u0646\u064e \u0641\u0650\u064a\u0647\u064e\u0627\u0653 \u0623\u064e\u062d\u06e1\u0642\u064e\u0627\u0628\u0657\u0627","translation":"Orada sonu olmayan \u00e7a\u011flar ve as\u0131rlar boyunca kalacaklar.","footnotes":null},{"id":"5696","sura":"78","aya":"24","arabic_text":"\u0644\u0651\u064e\u0627 \u064a\u064e\u0630\u064f\u0648\u0642\u064f\u0648\u0646\u064e \u0641\u0650\u064a\u0647\u064e\u0627 \u0628\u064e\u0631\u06e1\u062f\u0657\u0627 \u0648\u064e\u0644\u064e\u0627 \u0634\u064e\u0631\u064e\u0627\u0628\u064b\u0627","translation":"Orada, onlardan ate\u015fin s\u0131cakl\u0131\u011f\u0131n\u0131 giderecek ne so\u011fuk bir hava, ne de tat al\u0131nan bir i\u00e7ecek tadacaklar.","footnotes":null},{"id":"5697","sura":"78","aya":"25","arabic_text":"\u0625\u0650\u0644\u0651\u064e\u0627 \u062d\u064e\u0645\u0650\u064a\u0645\u0657\u0627 \u0648\u064e\u063a\u064e\u0633\u0651\u064e\u0627\u0642\u0657\u0627","translation":"\u00c7ok s\u0131cak su ve cehennem halk\u0131ndan akan irinler d\u0131\u015f\u0131nda bir \u015fey tatmayacaklar.","footnotes":null},{"id":"5698","sura":"78","aya":"26","arabic_text":"\u062c\u064e\u0632\u064e\u0627\u0653\u0621\u0657 \u0648\u0650\u0641\u064e\u0627\u0642\u064b\u0627","translation":"\u0130\u00e7inde bulunduklar\u0131 k\u00fcf\u00fcr ve sap\u0131kl\u0131\u011fa \u00e7ok uygun bir ceza.","footnotes":null},{"id":"5699","sura":"78","aya":"27","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u0645\u06e1 \u0643\u064e\u0627\u0646\u064f\u0648\u0627\u0652 \u0644\u064e\u0627 \u064a\u064e\u0631\u06e1\u062c\u064f\u0648\u0646\u064e \u062d\u0650\u0633\u064e\u0627\u0628\u0657\u0627","translation":"Onlar d\u00fcnyadayken, ahirette Allah\u2019\u0131n onlar\u0131 hesaba \u00e7ekece\u011finden korkmuyorlard\u0131. \u00c7\u00fcnk\u00fc onlar yeniden dirili\u015fe inanm\u0131yorlard\u0131. E\u011fer yeniden dirili\u015ften korksalard\u0131, elbette Allah\u2019a iman eder ve salih ameller i\u015flerlerdi.","footnotes":null},{"id":"5700","sura":"78","aya":"28","arabic_text":"\u0648\u064e\u0643\u064e\u0630\u0651\u064e\u0628\u064f\u0648\u0627\u0652 \u0628\u0650\u0640\u0654\u064e\u0627\u064a\u064e\u0670\u062a\u0650\u0646\u064e\u0627 \u0643\u0650\u0630\u0651\u064e\u0627\u0628\u0657\u0627","translation":"G\u00f6nderdi\u011fimiz el\u00e7iye inen ayetlerimizi yalanlad\u0131k\u00e7a yalanlad\u0131lar.","footnotes":null},{"id":"5701","sura":"78","aya":"29","arabic_text":"\u0648\u064e\u0643\u064f\u0644\u0651\u064e \u0634\u064e\u064a\u06e1\u0621\u064d \u0623\u064e\u062d\u06e1\u0635\u064e\u064a\u06e1\u0646\u064e\u0670\u0647\u064f \u0643\u0650\u062a\u064e\u0670\u0628\u0657\u0627","translation":"Yapt\u0131klar\u0131 her \u015feyi kay\u0131t ettik ve sayd\u0131k. O onlar\u0131n amel kitaplar\u0131nda yaz\u0131l\u0131d\u0131r.","footnotes":null},{"id":"5702","sura":"78","aya":"30","arabic_text":"\u0641\u064e\u0630\u064f\u0648\u0642\u064f\u0648\u0627\u0652 \u0641\u064e\u0644\u064e\u0646 \u0646\u0651\u064e\u0632\u0650\u064a\u062f\u064e\u0643\u064f\u0645\u06e1 \u0625\u0650\u0644\u0651\u064e\u0627 \u0639\u064e\u0630\u064e\u0627\u0628\u064b\u0627","translation":"-Ey azg\u0131nlar!- Bu elem verici ebed\u00ee azab\u0131 tad\u0131n bakal\u0131m! Sizlere, azab\u0131n\u0131z \u00fczerine eklenen azaptan ba\u015fka bir \u015fey art\u0131r\u0131lmayacak.","footnotes":null},{"id":"5703","sura":"78","aya":"31","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0644\u0650\u0644\u06e1\u0645\u064f\u062a\u0651\u064e\u0642\u0650\u064a\u0646\u064e \u0645\u064e\u0641\u064e\u0627\u0632\u064b\u0627","translation":"Emirlerini yerine getirerek ve yasaklar\u0131ndan sak\u0131narak Rablerine kar\u015f\u0131 takva sahibi olanlar i\u00e7in istedikleri kazanc\u0131 elde ettikleri kazanma yeri vard\u0131r. \u0130\u015fte oras\u0131 cennettir.","footnotes":null},{"id":"5704","sura":"78","aya":"32","arabic_text":"\u062d\u064e\u062f\u064e\u0627\u0653\u0626\u0650\u0642\u064e \u0648\u064e\u0623\u064e\u0639\u06e1\u0646\u064e\u0670\u0628\u0657\u0627","translation":"Bah\u00e7eler ve \u00fcz\u00fcm ba\u011flar\u0131 vard\u0131r.","footnotes":null},{"id":"5705","sura":"78","aya":"33","arabic_text":"\u0648\u064e\u0643\u064e\u0648\u064e\u0627\u0639\u0650\u0628\u064e \u0623\u064e\u062a\u06e1\u0631\u064e\u0627\u0628\u0657\u0627","translation":"G\u00f6\u011f\u00fcsleri belirgin ayn\u0131 ya\u015fta kad\u0131nlar vard\u0131r.","footnotes":null},{"id":"5706","sura":"78","aya":"34","arabic_text":"\u0648\u064e\u0643\u064e\u0623\u06e1\u0633\u0657\u0627 \u062f\u0650\u0647\u064e\u0627\u0642\u0657\u0627","translation":"Ve i\u00e7ki dolu kadehler vard\u0131r.","footnotes":null},{"id":"5707","sura":"78","aya":"35","arabic_text":"\u0644\u0651\u064e\u0627 \u064a\u064e\u0633\u06e1\u0645\u064e\u0639\u064f\u0648\u0646\u064e \u0641\u0650\u064a\u0647\u064e\u0627 \u0644\u064e\u063a\u06e1\u0648\u0657\u0627 \u0648\u064e\u0644\u064e\u0627 \u0643\u0650\u0630\u0651\u064e\u0670\u0628\u0657\u0627","translation":"Cennette bat\u0131l ve yalan bir s\u00f6z i\u015fitmez ve birbirlerine yalan s\u00f6ylemezler.","footnotes":null},{"id":"5708","sura":"78","aya":"36","arabic_text":"\u062c\u064e\u0632\u064e\u0627\u0653\u0621\u0657 \u0645\u0651\u0650\u0646 \u0631\u0651\u064e\u0628\u0651\u0650\u0643\u064e \u0639\u064e\u0637\u064e\u0627\u0653\u0621\u064b \u062d\u0650\u0633\u064e\u0627\u0628\u0657\u0627","translation":"Bunlar\u0131n hepsi Allah\u2019\u0131n size ba\u011f\u0131\u015flad\u0131\u011f\u0131, yeterli olan ihsan ve hediyesidir.","footnotes":null},{"id":"5709","sura":"78","aya":"37","arabic_text":"\u0631\u0651\u064e\u0628\u0651\u0650 \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0670\u0648\u064e\u0670\u062a\u0650 \u0648\u064e\u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u0650 \u0648\u064e\u0645\u064e\u0627 \u0628\u064e\u064a\u06e1\u0646\u064e\u0647\u064f\u0645\u064e\u0627 \u0671\u0644\u0631\u0651\u064e\u062d\u06e1\u0645\u064e\u0670\u0646\u0650\u06d6 \u0644\u064e\u0627 \u064a\u064e\u0645\u06e1\u0644\u0650\u0643\u064f\u0648\u0646\u064e \u0645\u0650\u0646\u06e1\u0647\u064f \u062e\u0650\u0637\u064e\u0627\u0628\u0657\u0627","translation":"G\u00f6klerin, yery\u00fcz\u00fcn\u00fcn ve ikisinin aras\u0131nda bulunan her \u015feyin Rabbi olan d\u00fcnya ve ahiret hayat\u0131n\u0131n Rahman'\u0131 Y\u00fcce Allah'\u0131n izni olmadan yery\u00fcz\u00fcnde ve g\u00f6ky\u00fcz\u00fcnde bulunanlar\u0131n hi\u00e7biri O'ndan bir \u015fey isteme hakk\u0131na sahip de\u011fildirler.","footnotes":null},{"id":"5710","sura":"78","aya":"38","arabic_text":"\u064a\u064e\u0648\u06e1\u0645\u064e \u064a\u064e\u0642\u064f\u0648\u0645\u064f \u0671\u0644\u0631\u0651\u064f\u0648\u062d\u064f \u0648\u064e\u0671\u0644\u06e1\u0645\u064e\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064e\u0629\u064f \u0635\u064e\u0641\u0651\u0657\u0627\u06d6 \u0644\u0651\u064e\u0627 \u064a\u064e\u062a\u064e\u0643\u064e\u0644\u0651\u064e\u0645\u064f\u0648\u0646\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0645\u064e\u0646\u06e1 \u0623\u064e\u0630\u0650\u0646\u064e \u0644\u064e\u0647\u064f \u0671\u0644\u0631\u0651\u064e\u062d\u06e1\u0645\u064e\u0670\u0646\u064f \u0648\u064e\u0642\u064e\u0627\u0644\u064e \u0635\u064e\u0648\u064e\u0627\u0628\u0657\u0627","translation":"Cebrail ve meleklerin saf olmu\u015f bir halde k\u0131yama durdu\u011fu g\u00fcn, Rahman olan Allah\u2019\u0131n \u015fefaat etmesine izin verdi\u011fi kimseler d\u0131\u015f\u0131nda hi\u00e7 kimse \u015fefaat etmek i\u00e7in konu\u015famaz ve ancak kelime-i tevhit gibi dosdo\u011fru olan s\u00f6z s\u00f6ylerler.","footnotes":null},{"id":"5711","sura":"78","aya":"39","arabic_text":"\u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0671\u0644\u06e1\u064a\u064e\u0648\u06e1\u0645\u064f \u0671\u0644\u06e1\u062d\u064e\u0642\u0651\u064f\u06d6 \u0641\u064e\u0645\u064e\u0646 \u0634\u064e\u0627\u0653\u0621\u064e \u0671\u062a\u0651\u064e\u062e\u064e\u0630\u064e \u0625\u0650\u0644\u064e\u0649\u0670 \u0631\u064e\u0628\u0651\u0650\u0647\u0650\u06e6 \u0645\u064e\u0640\u0654\u064e\u0627\u0628\u064b\u0627","translation":"Size tarif edilen o g\u00fcn, vuku bulaca\u011f\u0131 hususunda hi\u00e7bir \u015f\u00fcphe olmayan bir g\u00fcnd\u00fcr. Kim bu g\u00fcnde Allah\u2019\u0131n azab\u0131ndan kurtulmay\u0131 diliyorsa, Rabbini raz\u0131 eden salih amellerden buna g\u00f6t\u00fcren bir yol edinsin.","footnotes":null},{"id":"5712","sura":"78","aya":"40","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0627\u0653 \u0623\u064e\u0646\u0630\u064e\u0631\u06e1\u0646\u064e\u0670\u0643\u064f\u0645\u06e1 \u0639\u064e\u0630\u064e\u0627\u0628\u0657\u0627 \u0642\u064e\u0631\u0650\u064a\u0628\u0657\u0627 \u064a\u064e\u0648\u06e1\u0645\u064e \u064a\u064e\u0646\u0638\u064f\u0631\u064f \u0671\u0644\u06e1\u0645\u064e\u0631\u06e1\u0621\u064f \u0645\u064e\u0627 \u0642\u064e\u062f\u0651\u064e\u0645\u064e\u062a\u06e1 \u064a\u064e\u062f\u064e\u0627\u0647\u064f \u0648\u064e\u064a\u064e\u0642\u064f\u0648\u0644\u064f \u0671\u0644\u06e1\u0643\u064e\u0627\u0641\u0650\u0631\u064f \u064a\u064e\u0670\u0644\u064e\u064a\u06e1\u062a\u064e\u0646\u0650\u064a \u0643\u064f\u0646\u062a\u064f \u062a\u064f\u0631\u064e\u0670\u0628\u064e\u06e2\u0627","translation":"Ey insanlar! Biz sizi \u00e7ok yak\u0131nda olacak bir azaba kar\u015f\u0131 uyard\u0131k. O g\u00fcn herkes, d\u00fcnyada yapm\u0131\u015f oldu\u011fu amellerine bakacak ve k\u00e2firler azaptan kurtulmay\u0131 temenni ederek \u015f\u00f6yle diyecekler: \"K\u0131yamet g\u00fcn\u00fc hayvanlara \"Art\u0131k toprak olun!\" denildi\u011fi zaman ke\u015fke ben de hayvanlar gibi topra\u011fa d\u00f6n\u00fc\u015fseydim.\u201d","footnotes":null}]}