s et aux visages agr\u00e9ables.","footnotes":null},{"id":"4972","sura":"55","aya":"71","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"Lesquels des nombreux bienfaits d\u2019Allah nierez-vous, \u00f4 ensemble des humains et des djinns?","footnotes":null},{"id":"4973","sura":"55","aya":"72","arabic_text":"\u062d\u064f\u0648\u0631\u065e \u0645\u0651\u064e\u0642\u06e1\u0635\u064f\u0648\u0631\u064e\u0670\u062a\u065e \u0641\u0650\u064a \u0671\u0644\u06e1\u062e\u0650\u064a\u064e\u0627\u0645\u0650","translation":"Des houris pr\u00e9serv\u00e9es des regards dans des tentes.","footnotes":null},{"id":"4974","sura":"55","aya":"73","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"Lesquels des nombreux bienfaits d\u2019Allah nierez-vous, \u00f4 ensemble des humains et des djinns?","footnotes":null},{"id":"4975","sura":"55","aya":"74","arabic_text":"\u0644\u064e\u0645\u06e1 \u064a\u064e\u0637\u06e1\u0645\u0650\u062b\u06e1\u0647\u064f\u0646\u0651\u064e \u0625\u0650\u0646\u0633\u065e \u0642\u064e\u0628\u06e1\u0644\u064e\u0647\u064f\u0645\u06e1 \u0648\u064e\u0644\u064e\u0627 \u062c\u064e\u0627\u0653\u0646\u0651\u065e","translation":"Nul humain ou djinn ne les d\u00e9florera avant leurs \u00e9poux.","footnotes":null},{"id":"4976","sura":"55","aya":"75","arabic_text":"\u0641\u064e\u0628\u0650\u0623\u064e\u064a\u0651\u0650 \u0621\u064e\u0627\u0644\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064f\u0645\u064e\u0627 \u062a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064e\u0627\u0646\u0650","translation":"Lesquels des nom