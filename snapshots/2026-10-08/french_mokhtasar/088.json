us, tu n\u2019as pas \u00e0 les dominer ni \u00e0 les contraindre \u00e0 avoir la foi.","footnotes":null},{"id":"5990","sura":"88","aya":"23","arabic_text":"\u0625\u0650\u0644\u0651\u064e\u0627 \u0645\u064e\u0646 \u062a\u064e\u0648\u064e\u0644\u0651\u064e\u0649\u0670 \u0648\u064e\u0643\u064e\u0641\u064e\u0631\u064e","translation":"Except\u00e9 celui parmi eux qui se d\u00e9tourne de la foi et m\u00e9croit en Allah et en Son Messager,","footnotes":null},{"id":"5991","sura":"88","aya":"24","arabic_text":"\u0641\u064e\u064a\u064f\u0639\u064e\u0630\u0651\u0650\u0628\u064f\u0647\u064f \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0671\u0644\u06e1\u0639\u064e\u0630\u064e\u0627\u0628\u064e \u0671\u0644\u06e1\u0623\u064e\u0643\u06e1\u0628\u064e\u0631\u064e","translation":"Allah lui infligera le ch\u00e2timent supr\u00eame le Jour de la R\u00e9surrection en le faisant entrer en Enfer pour y demeurer \u00e9ternellement.","footnotes":null},{"id":"5992","sura":"88","aya":"25","arabic_text":"\u0625\u0650\u0646\u0651\u064e \u0625\u0650\u0644\u064e\u064a\u06e1\u0646\u064e\u0627\u0653 \u0625\u0650\u064a\u064e\u0627\u0628\u064e\u0647\u064f\u0645\u06e1","translation":"C\u2019est vers Nous Seul qu\u2019ils retourneront apr\u00e8s leur mort,","footnotes":null},{"id":"5993","sura":"88","aya":"26","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0625\u0650\u0646\u0651\u064e \u0639\u064e\u0644\u064e\u064a\u06e1\u0646\u064e\u0627 \u062d\u0650\u0633\u064e\u0627\u0628\u064e\u0647\u064f\u0645","translation":"puis c\u2019est \u00e0 Nous Seul qu\u2019il appartient de leur demander des comptes pour leurs \u0153uvres. Ce n\u2019est ni \u00e0 toi ni \u00e0 personne d\u2019autre.","footnotes":null}]}