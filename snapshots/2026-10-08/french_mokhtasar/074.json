u062d\u064e\u0670\u0628\u064e \u0671\u0644\u0646\u0651\u064e\u0627\u0631\u0650 \u0625\u0650\u0644\u0651\u064e\u0627 \u0645\u064e\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064e\u0629\u0657\u06d6 \u0648\u064e\u0645\u064e\u0627 \u062c\u064e\u0639\u064e\u0644\u06e1\u0646\u064e\u0627 \u0639\u0650\u062f\u0651\u064e\u062a\u064e\u0647\u064f\u0645\u06e1 \u0625\u0650\u0644\u0651\u064e\u0627 \u0641\u0650\u062a\u06e1\u0646\u064e\u0629\u0657 \u0644\u0651\u0650\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0643\u064e\u0641\u064e\u0631\u064f\u0648\u0627\u0652 \u0644\u0650\u064a\u064e\u0633\u06e1\u062a\u064e\u064a\u06e1\u0642\u0650\u0646\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0623\u064f\u0648\u062a\u064f\u0648\u0627\u0652 \u0671\u0644\u06e1\u0643\u0650\u062a\u064e\u0670\u0628\u064e \u0648\u064e\u064a\u064e\u0632\u06e1\u062f\u064e\u0627\u062f\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0653\u0627\u0652 \u0625\u0650\u064a\u0645\u064e\u0670\u0646\u0657\u0627 \u0648\u064e\u0644\u064e\u0627 \u064a\u064e\u0631\u06e1\u062a\u064e\u0627\u0628\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0623\u064f\u0648\u062a\u064f\u0648\u0627\u0652 \u0671\u0644\u06e1\u0643\u0650\u062a\u064e\u0670\u0628\u064e \u0648\u064e\u0671\u0644\u06e1\u0645\u064f\u0624\u06e1\u0645\u0650\u0646\u064f\u0648\u0646\u064e \u0648\u064e\u0644\u0650\u064a\u064e\u0642\u064f\u0648\u0644\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0641\u0650\u064a \u0642\u064f\u0644\u064f\u0648\u0628\u0650\u0647\u0650\u0645 \u0645\u0651\u064e\u0631\u064e\u0636\u065e \u0648\u064e\u0671\u0644\u06e1\u0643\u064e\u0670\u0641\u0650\u0631\u064f\u0648\u0646\u064e \u0645\u064e\u0627\u0630\u064e\u0627\u0653 \u0623\u064e\u0631\u064e\u0627\u062f\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0628\u0650\u0647\u064e\u0670\u0630\u064e\u0627 \u0645\u064e\u062b\u064e\u0644\u0657\u0627\u06da \u0643\u064e\u0630\u064e\u0670\u0644\u0650\u0643\u064e \u064a\u064f\u0636\u0650\u0644\u0651\u064f \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0645\u064e\u0646 \u064a\u064e\u0634\u064e\u0627\u0653\u0621\u064f \u0648\u064e\u064a\u064e\u0647\u06e1\u062f\u0650\u064a \u0645\u064e\u0646 \u064a\u064e\u0634\u064e\u0627\u0653\u0621\u064f\u06da \u0648\u064e\u0645\u064e\u0627 \u064a\u064e\u0639\u06e1\u0644\u064e\u0645\u064f \u062c\u064f\u0646\u064f\u0648\u062f\u064e \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0647\u064f\u0648\u064e\u06da \u0648\u064e\u0645\u064e\u0627 \u0647\u0650\u064a\u064e \u0625\u0650\u0644\u0651\u064e\u0627 \u0630\u0650\u0643\u06e1\u0631\u064e\u0649\u0670 \u0644\u0650\u0644\u06e1\u0628\u064e\u0634\u064e\u0631\u0650","translation":"Les gardiens de l\u2019Enfer ne sont autres que des anges, car les humains ne pourraient assumer cette charge. `Ab\u00fb Jahl mentit lorsqu\u2019il pr\u00e9tendit que lui et les siens auront le pouvoir de les vaincre et de sortir de l\u2019Enfer. Nous n\u2019avons d\u00e9termin\u00e9 ce nombre de gardiens qu\u2019\u00e0 titre d\u2019\u00e9preuve pour ceux qui m\u00e9croient en Allah ; afin qu\u2019ils disent ce qu\u2019ils ont dit et que leur ch\u00e2timent soit doubl\u00e9 ; afin que soient convaincus les juifs, \u00e0 qui la Torah a \u00e9t\u00e9 donn\u00e9e, et les chr\u00e9tiens, \u00e0 qui l\u2019Evangile a \u00e9t\u00e9 donn\u00e9e, lorsque le Coran confirme ce que contiennent leurs deux livres ; afin que la foi des croyants s\u2019accroisse lorsqu\u2019ils verront que les Gens du Livre les corroborent; afin que les juifs les chr\u00e9tiens et les croyants ne soient pas saisis de doutes ; et afin que les ind\u00e9cis et les m\u00e9cr\u00e9ants disent: Quelle est la fin voulue par Allah en \u00e9non\u00e7ant ce nombre \u00e9trange? Tout comme ce nombre \u00e9gare celui qui le nie et guide celui qui y croit, Allah \u00e9gare qui Il veut \u00e9garer et guide qui Il veut guider. Tellement le nombre de Ses soldats est grand, Allah est le Seul \u00e0 le conna\u00eetre. Que `Ab\u00fb Jahl sache cela, lui qui dit en guise de d\u00e9menti et de d\u00e9rision: \u00ab Mu\u0127ammad ne peut-il compter que sur dix-neuf aides \u00bb. Le Feu n\u2019est qu\u2019un rappel adress\u00e9 aux humains afin qu\u2019ils prennent conscience de l\u2019\u00e9minence d\u2019Allah. ","footnotes":null},{"id":"5527","sura":"74","aya":"32","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627 \u0648\u064e\u0671\u0644\u06e1\u0642\u064e\u0645\u064e\u0631\u0650","translation":"Il n\u2019arrivera pas, comme le pr\u00e9tend un certain polyth\u00e9iste, que ses compagnons viendront \u00e0 bout des gardiens de l\u2019Enfer et qu\u2019ils finiront par en sortir. Allah pr\u00eate ici serment par la lune.","footnotes":null},{"id":"5528","sura":"74","aya":"33","arabic_text":"\u0648\u064e\u0671\u0644\u0651\u064e\u064a\u06e1\u0644\u0650 \u0625\u0650\u0630\u06e1 \u0623\u064e\u062f\u06e1\u0628\u064e\u0631\u064e","translation":"Puis il pr\u00eate serment par la nuit qui se termine","footnotes":null},{"id":"5529","sura":"74","aya":"34","arabic_text":"\u0648\u064e\u0671\u0644\u0635\u0651\u064f\u0628\u06e1\u062d\u0650 \u0625\u0650\u0630\u064e\u0627\u0653 \u0623\u064e\u0633\u06e1\u0641\u064e\u0631\u064e","translation":"et par l\u2019aube qui appara\u00eet.","footnotes":null},{"id":"5530","sura":"74","aya":"35","arabic_text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064e\u0627 \u0644\u064e\u0625\u0650\u062d\u06e1\u062f\u064e\u0649 \u0671\u0644\u06e1\u0643\u064f\u0628\u064e\u0631\u0650","translation":"Le Feu de l\u2019Enfer est un des plus grands malheurs","footnotes":null},{"id":"5531","sura":"74","aya":"36","arabic_text":"\u0646\u064e\u0630\u0650\u064a\u0631\u0657\u0627 \u0644\u0651\u0650\u0644\u06e1\u0628\u064e\u0634\u064e\u0631\u0650","translation":"et un avertissement qui menace et effraie les humains.","footnotes":null},{"id":"5532","sura":"74","aya":"37","arabic_text":"\u0644\u0650\u0645\u064e\u0646 \u0634\u064e\u0627\u0653\u0621\u064e \u0645\u0650\u0646\u0643\u064f\u0645\u06e1 \u0623\u064e\u0646 \u064a\u064e\u062a\u064e\u0642\u064e\u062f\u0651\u064e\u0645\u064e \u0623\u064e\u0648\u06e1 \u064a\u064e\u062a\u064e\u0623\u064e\u062e\u0651\u064e\u0631\u064e","translation":"Pour qui d\u2019entre vous, \u00f4 gens, d\u00e9sire avancer dans la foi et les bonnes \u0153uvres ou bien reculer dans la m\u00e9cr\u00e9ance et les p\u00e9ch\u00e9s.","footnotes":null},{"id":"5533","sura":"74","aya":"38","arabic_text":"\u0643\u064f\u0644\u0651\u064f \u0646\u064e\u0641\u06e1\u0633\u0650\u06ed \u0628\u0650\u0645\u064e\u0627 \u0643\u064e\u0633\u064e\u0628\u064e\u062a\u06e1 \u0631\u064e\u0647\u0650\u064a\u0646\u064e\u0629\u064c","translation":"Toute \u00e2me est l\u2019otage de ses \u0153uvres: soit elles la damnent, soit elles la sauvent et lui \u00e9pargnent la perdition.","footnotes":null},{"id":"5534","sura":"74","aya":"39","arabic_text":"\u0625\u0650\u0644\u0651\u064e\u0627\u0653 \u0623\u064e\u0635\u06e1\u062d\u064e\u0670\u0628\u064e \u0671\u0644\u06e1\u064a\u064e\u0645\u0650\u064a\u0646\u0650","translation":"Exception faite des croyants qui ne seront pas ch\u00e2ti\u00e9s pour leurs p\u00e9ch\u00e9s. Allah les leur pardonnera plut\u00f4t pour leurs bonnes \u0153uvres.","footnotes":null},{"id":"5535","sura":"74","aya":"40","arabic_text":"\u0641\u0650\u064a \u062c\u064e\u0646\u0651\u064e\u0670\u062a\u0656 \u064a\u064e\u062a\u064e\u0633\u064e\u0627\u0653\u0621\u064e\u0644\u064f\u0648\u0646\u064e","translation":"Le Jour de la R\u00e9surrection, ils seront dans des Jardins o\u00f9 ils se questionneront les uns les autres","footnotes":null},{"id":"5536","sura":"74","aya":"41","arabic_text":"\u0639\u064e\u0646\u0650 \u0671\u0644\u06e1\u0645\u064f\u062c\u06e1\u0631\u0650\u0645\u0650\u064a\u0646\u064e","translation":"au sujet des criminels qui se sont conduits eux-m\u00eames en p\u00e9chant, \u00e0 la perdition.","footnotes":null},{"id":"5537","sura":"74","aya":"42","arabic_text":"\u0645\u064e\u0627 \u0633\u064e\u0644\u064e\u0643\u064e\u0643\u064f\u0645\u06e1 \u0641\u0650\u064a \u0633\u064e\u0642\u064e\u0631\u064e","translation":"Ils leur diront: Quelle est la raison de votre entr\u00e9e en Enfer?","footnotes":null},{"id":"5538","sura":"74","aya":"43","arabic_text":"\u0642\u064e\u0627\u0644\u064f\u0648\u0627\u0652 \u0644\u064e\u0645\u06e1 \u0646\u064e\u0643\u064f \u0645\u0650\u0646\u064e \u0671\u0644\u06e1\u0645\u064f\u0635\u064e\u0644\u0651\u0650\u064a\u0646\u064e","translation":"Les m\u00e9cr\u00e9ants r\u00e9pondront: Nous n\u2019\u00e9tions pas du nombre de ceux qui accomplissaient les pri\u00e8res obligatoires dans le bas monde","footnotes":null},{"id":"5539","sura":"74","aya":"44","arabic_text":"\u0648\u064e\u0644\u064e\u0645\u06e1 \u0646\u064e\u0643\u064f \u0646\u064f\u0637\u06e1\u0639\u0650\u0645\u064f \u0671\u0644\u06e1\u0645\u0650\u0633\u06e1\u0643\u0650\u064a\u0646\u064e","translation":"et nous ne nourrissions pas les pauvres avec ce dont Allah nous a fait don.","footnotes":null},{"id":"5540","sura":"74","aya":"45","arabic_text":"\u0648\u064e\u0643\u064f\u0646\u0651\u064e\u0627 \u0646\u064e\u062e\u064f\u0648\u0636\u064f \u0645\u064e\u0639\u064e \u0671\u0644\u06e1\u062e\u064e\u0627\u0653\u0626\u0650\u0636\u0650\u064a\u0646\u064e","translation":"Nous fr\u00e9quentions les adeptes du faux que nous suivions partout, nous conversions avec les \u00e9gar\u00e9s et les fourvoy\u00e9s","footnotes":null},{"id":"5541","sura":"74","aya":"46","arabic_text":"\u0648\u064e\u0643\u064f\u0646\u0651\u064e\u0627 \u0646\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064f \u0628\u0650\u064a\u064e\u0648\u06e1\u0645\u0650 \u0671\u0644\u062f\u0651\u0650\u064a\u0646\u0650","translation":"et nous traitions de mensonge le Jour de la R\u00e9tribution.","footnotes":null},{"id":"5542","sura":"74","aya":"47","arabic_text":"\u062d\u064e\u062a\u0651\u064e\u0649\u0670\u0653 \u0623\u064e\u062a\u064e\u0649\u0670\u0646\u064e\u0627 \u0671\u0644\u06e1\u064a\u064e\u0642\u0650\u064a\u0646\u064f","translation":"Nous exag\u00e9rions dans cette attitude jusqu\u2019\u00e0 ce que la mort survint \u00e0 nous et s\u2019interposa entre nous et le repentir.","footnotes":null},{"id":"5543","sura":"74","aya":"48","arabic_text":"\u0641\u064e\u0645\u064e\u0627 \u062a\u064e\u0646\u0641\u064e\u0639\u064f\u0647\u064f\u0645\u06e1 \u0634\u064e\u0641\u064e\u0670\u0639\u064e\u0629\u064f \u0671\u0644\u0634\u0651\u064e\u0670\u0641\u0650\u0639\u0650\u064a\u0646\u064e","translation":"Le Jour de la R\u00e9surrection, l\u2019intercession des anges, des proph\u00e8tes et des pieux ne leur profitera pas, car l\u2019une des conditions de l\u2019acceptation de l\u2019intercession est que le b\u00e9n\u00e9ficiaire de cette intercession soit agr\u00e9\u00e9.","footnotes":null},{"id":"5544","sura":"74","aya":"49","arabic_text":"\u0641\u064e\u0645\u064e\u0627 \u0644\u064e\u0647\u064f\u0645\u06e1 \u0639\u064e\u0646\u0650 \u0671\u0644\u062a\u0651\u064e\u0630\u06e1\u0643\u0650\u0631\u064e\u0629\u0650 \u0645\u064f\u0639\u06e1\u0631\u0650\u0636\u0650\u064a\u0646\u064e","translation":"Pour quelle raison ces polyth\u00e9istes se d\u00e9tournent-ils du Coran?","footnotes":null},{"id":"5545","sura":"74","aya":"50","arabic_text":"\u0643\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u0645\u06e1 \u062d\u064f\u0645\u064f\u0631\u065e \u0645\u0651\u064f\u0633\u06e1\u062a\u064e\u0646\u0641\u0650\u0631\u064e\u0629\u065e","translation":"Dans leur refus de l\u2019accepter, ils sont tels des \u00e2nes sauvages farouches","footnotes":null},{"id":"5546","sura":"74","aya":"51","arabic_text":"\u0641\u064e\u0631\u0651\u064e\u062a\u06e1 \u0645\u0650\u0646 \u0642\u064e\u0633\u06e1\u0648\u064e\u0631\u064e\u0629\u0650\u06ed","translation":"qui fuient un lion.","footnotes":null},{"id":"5547","sura":"74","aya":"52","arabic_text":"\u0628\u064e\u0644\u06e1 \u064a\u064f\u0631\u0650\u064a\u062f\u064f \u0643\u064f\u0644\u0651\u064f \u0671\u0645\u06e1\u0631\u0650\u064a\u0655\u0656 \u0645\u0651\u0650\u0646\u06e1\u0647\u064f\u0645\u06e1 \u0623\u064e\u0646 \u064a\u064f\u0624\u06e1\u062a\u064e\u0649\u0670 \u0635\u064f\u062d\u064f\u0641\u0657\u0627 \u0645\u0651\u064f\u0646\u064e\u0634\u0651\u064e\u0631\u064e\u0629\u0657","translation":"Chacun de ces polyth\u00e9istes voudrait trouver un matin pr\u00e8s de sa t\u00eate, un livre \u00e9tal\u00e9 lui apprenant que Mu\u0127ammad est un messager envoy\u00e9 par Allah. Ce n\u2019est pas par manque de preuves ou par faiblesse des arguments qu\u2019ils se conduisent ainsi, mais par ent\u00eatement et orgueil.","footnotes":null},{"id":"5548","sura":"74","aya":"53","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627\u06d6 \u0628\u064e\u0644 \u0644\u0651\u064e\u0627 \u064a\u064e\u062e\u064e\u0627\u0641\u064f\u0648\u0646\u064e \u0671\u0644\u06e1\u0623\u0653\u062e\u0650\u0631\u064e\u0629\u064e","translation":"Cela n\u2019arrivera pas. La raison de leur \u00e9garement exag\u00e9r\u00e9 est qu\u2019ils ne croient pas au ch\u00e2timent de l\u2019au-del\u00e0, demeurant de ce fait m\u00e9cr\u00e9ants.","footnotes":null},{"id":"5549","sura":"74","aya":"54","arabic_text":"\u0643\u064e\u0644\u0651\u064e\u0627\u0653 \u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u062a\u064e\u0630\u06e1\u0643\u0650\u0631\u064e\u0629\u065e","translation":"Ce Coran est une exhortation et un rappel.","footnotes":null},{"id":"5550","sura":"74","aya":"55","arabic_text":"\u0641\u064e\u0645\u064e\u0646 \u0634\u064e\u0627\u0653\u0621\u064e \u0630\u064e\u0643\u064e\u0631\u064e\u0647\u064f\u06e5","translation":"Quiconque veut lire le Coran et en tirer des enseignements, qu\u2019il le lise et en tire des enseignements.","footnotes":null},{"id":"5551","sura":"74","aya":"56","arabic_text":"\u0648\u064e\u0645\u064e\u0627 \u064a\u064e\u0630\u06e1\u0643\u064f\u0631\u064f\u0648\u0646\u064e \u0625\u0650\u0644\u0651\u064e\u0627\u0653 \u0623\u064e\u0646 \u064a\u064e\u0634\u064e\u0627\u0653\u0621\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f\u06da \u0647\u064f\u0648\u064e \u0623\u064e\u0647\u06e1\u0644\u064f \u0671\u0644\u062a\u0651\u064e\u0642\u06e1\u0648\u064e\u0649\u0670 \u0648\u064e\u0623\u064e\u0647\u06e1\u0644\u064f \u0671\u0644\u06e1\u0645\u064e\u063a\u06e1\u0641\u0650\u0631\u064e\u0629\u0650","translation":"Or ils n\u2019en tireront des enseignements que si Allah le veut. Il est le plus digne d\u2019\u00eatre craint et qu\u2019on se conforme \u00e0 Ses commandements et qu'on renonce \u00e0 Ses interdits. Il est \u00e9galement le plus digne d\u2019\u00eatre craint et d\u2019\u00eatre Celui qui pardonne les p\u00e9ch\u00e9s de Ses serviteurs lorsqu\u2019ils se repentent \u00e0 Lui.","footnotes":null}]}